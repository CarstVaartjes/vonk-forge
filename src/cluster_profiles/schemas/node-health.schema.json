{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.local/schemas/node-health.schema.json",
  "title": "GPU node cluster live health",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_at", "status", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "captured_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "status": {"enum": ["healthy", "warning", "critical"]},
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(?:spk_[0-9a-f]{32}|node[12])$": {"$ref": "#/$defs/node"}
      }
    }
  },
  "$defs": {
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "nullableNumber": {"type": ["number", "null"]},
    "nullablePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "nullableString": {"type": ["string", "null"], "maxLength": 256},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings", "identity", "cpu", "memory", "swap", "root_filesystem", "accelerator", "thermal_zones", "fabric", "services"],
      "properties": {
        "status": {"enum": ["healthy", "warning", "critical", "unreachable"]},
        "errors": {"$ref": "#/$defs/codes"},
        "warnings": {"$ref": "#/$defs/codes"},
        "identity": {"anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
        "cpu": {"anyOf": [{"$ref": "#/$defs/cpu"}, {"type": "null"}]},
        "memory": {"anyOf": [{"$ref": "#/$defs/memory"}, {"type": "null"}]},
        "swap": {"anyOf": [{"$ref": "#/$defs/swap"}, {"type": "null"}]},
        "root_filesystem": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
        "accelerator": {"anyOf": [{"$ref": "#/$defs/accelerator"}, {"type": "null"}]},
        "thermal_zones": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/thermal"}},
        "fabric": {"anyOf": [{"$ref": "#/$defs/fabric"}, {"type": "null"}]},
        "services": {"anyOf": [{"$ref": "#/$defs/services"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unreachable"}}, "required": ["status"]},
          "then": {"properties": {
            "identity": {"type": "null"}, "cpu": {"type": "null"},
            "memory": {"type": "null"}, "swap": {"type": "null"},
            "root_filesystem": {"type": "null"}, "accelerator": {"type": "null"},
            "thermal_zones": {"maxItems": 0}, "fabric": {"type": "null"},
            "services": {"type": "null"}
          }}
        },
        {
          "if": {"properties": {"status": {"enum": ["healthy", "warning"]}}, "required": ["status"]},
          "then": {"properties": {
            "identity": {"type": "object"}, "cpu": {"type": "object"},
            "memory": {"type": "object"}, "swap": {"type": "object"},
            "root_filesystem": {"type": "object"}, "accelerator": {"type": "object"},
            "fabric": {"type": "object"}, "services": {"type": "object"}
          }}
        }
      ]
    },
    "codes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64}
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["hostname", "boot_id", "uptime_seconds"],
      "properties": {
        "hostname": {"type": "string", "maxLength": 256},
        "boot_id": {"$ref": "#/$defs/nullableString"},
        "uptime_seconds": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "cpu": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_processors", "utilization_percent", "load_1", "load_5", "load_15"],
      "properties": {
        "logical_processors": {"type": "integer", "minimum": 0},
        "utilization_percent": {"$ref": "#/$defs/nullablePercent"},
        "load_1": {"$ref": "#/$defs/nullableNumber"},
        "load_5": {"$ref": "#/$defs/nullableNumber"},
        "load_15": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["total_bytes", "available_bytes", "used_bytes", "used_percent"],
      "properties": {
        "total_bytes": {"$ref": "#/$defs/nullableInteger"},
        "available_bytes": {"$ref": "#/$defs/nullableInteger"},
        "used_bytes": {"$ref": "#/$defs/nullableInteger"},
        "used_percent": {"$ref": "#/$defs/nullablePercent"}
      }
    },
    "swap": {
      "type": "object", "additionalProperties": false,
      "required": ["total_bytes", "free_bytes", "used_bytes", "used_percent"],
      "properties": {
        "total_bytes": {"$ref": "#/$defs/nullableInteger"},
        "free_bytes": {"$ref": "#/$defs/nullableInteger"},
        "used_bytes": {"$ref": "#/$defs/nullableInteger"},
        "used_percent": {"$ref": "#/$defs/nullablePercent"}
      }
    },
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["total_bytes", "available_bytes", "used_bytes", "used_percent", "read_only"],
      "properties": {
        "total_bytes": {"$ref": "#/$defs/nullableInteger"},
        "available_bytes": {"$ref": "#/$defs/nullableInteger"},
        "used_bytes": {"$ref": "#/$defs/nullableInteger"},
        "used_percent": {"$ref": "#/$defs/nullablePercent"},
        "read_only": {"type": ["boolean", "null"]}
      }
    },
    "accelerator": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "name", "driver_version", "utilization_percent", "temperature_c", "performance_state", "power_watts"],
      "properties": {
        "available": {"type": "boolean"},
        "name": {"$ref": "#/$defs/nullableString"},
        "driver_version": {"type": ["string", "null"], "maxLength": 64},
        "utilization_percent": {"$ref": "#/$defs/nullablePercent"},
        "temperature_c": {"$ref": "#/$defs/nullableNumber"},
        "performance_state": {"type": ["string", "null"], "maxLength": 32},
        "power_watts": {"$ref": "#/$defs/nullableNumber"},
        "active_nvidia_compute_processes": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535}
      }
    },
    "thermal": {
      "type": "object", "additionalProperties": false,
      "required": ["zone", "type", "temperature_c", "trip_points"],
      "properties": {
        "zone": {"type": "string", "maxLength": 64},
        "type": {"type": "string", "minLength": 1, "maxLength": 256},
        "temperature_c": {"type": "number"},
        "trip_points": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/trip"}}
      }
    },
    "trip": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "temperature_c", "reached"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "temperature_c": {"type": "number"},
        "reached": {"type": "boolean"}
      }
    },
    "fabric": {
      "type": "object", "additionalProperties": false,
      "required": ["functions"],
      "properties": {"functions": {"type": "array", "minItems": 0, "maxItems": 16, "items": {"$ref": "#/$defs/function"}}}
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["interface", "hca", "operstate", "carrier", "speed_mbps", "mtu", "rdma_interface", "rdma_state", "counters"],
      "properties": {
        "interface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 64},
        "hca": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 64},
        "operstate": {"type": ["string", "null"], "maxLength": 32},
        "carrier": {"$ref": "#/$defs/nullableInteger"},
        "speed_mbps": {"$ref": "#/$defs/nullableInteger"},
        "mtu": {"$ref": "#/$defs/nullableInteger"},
        "rdma_interface": {"type": ["string", "null"], "maxLength": 64},
        "rdma_state": {"type": ["string", "null"], "maxLength": 32},
        "counters": {"$ref": "#/$defs/counters"}
      }
    },
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["out_of_buffer", "out_of_sequence", "duplicate_request", "rnr_nak_retry_err", "packet_seq_err", "implied_nak_seq_err", "local_ack_timeout_err", "resp_local_length_error", "resp_cqe_error", "req_cqe_error", "req_remote_invalid_request", "req_remote_access_errors", "resp_remote_access_errors", "resp_cqe_flush_error", "req_cqe_flush_error", "req_transport_retries_exceeded", "req_rnr_retries_exceeded", "roce_adp_retrans", "roce_adp_retrans_to"],
      "properties": {
        "out_of_buffer": {"$ref": "#/$defs/nullableInteger"}, "out_of_sequence": {"$ref": "#/$defs/nullableInteger"}, "duplicate_request": {"$ref": "#/$defs/nullableInteger"},
        "rnr_nak_retry_err": {"$ref": "#/$defs/nullableInteger"}, "packet_seq_err": {"$ref": "#/$defs/nullableInteger"}, "implied_nak_seq_err": {"$ref": "#/$defs/nullableInteger"},
        "local_ack_timeout_err": {"$ref": "#/$defs/nullableInteger"}, "resp_local_length_error": {"$ref": "#/$defs/nullableInteger"}, "resp_cqe_error": {"$ref": "#/$defs/nullableInteger"},
        "req_cqe_error": {"$ref": "#/$defs/nullableInteger"}, "req_remote_invalid_request": {"$ref": "#/$defs/nullableInteger"}, "req_remote_access_errors": {"$ref": "#/$defs/nullableInteger"},
        "resp_remote_access_errors": {"$ref": "#/$defs/nullableInteger"}, "resp_cqe_flush_error": {"$ref": "#/$defs/nullableInteger"}, "req_cqe_flush_error": {"$ref": "#/$defs/nullableInteger"},
        "req_transport_retries_exceeded": {"$ref": "#/$defs/nullableInteger"}, "req_rnr_retries_exceeded": {"$ref": "#/$defs/nullableInteger"}, "roce_adp_retrans": {"$ref": "#/$defs/nullableInteger"},
        "roce_adp_retrans_to": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "services": {
      "type": "object", "additionalProperties": false,
      "required": ["docker_available", "docker_version", "earlyoom_load_state", "earlyoom_enabled", "earlyoom_active"],
      "properties": {
        "docker_available": {"type": "boolean"},
        "docker_version": {"type": ["string", "null"], "maxLength": 256},
        "earlyoom_load_state": {"type": ["string", "null"], "maxLength": 256},
        "earlyoom_enabled": {"type": ["boolean", "null"]},
        "earlyoom_active": {"type": ["boolean", "null"]}
      }
    }
  }
}
