{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.local/schemas/node-health-raw.schema.json",
  "title": "GPU node raw node health telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_at", "identity", "cpu", "memory", "swap", "root_filesystem", "accelerator", "thermal_zones", "fabric", "services"],
  "properties": {
    "schema_version": {"const": 1},
    "captured_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "identity": {"$ref": "#/$defs/identity"},
    "cpu": {"$ref": "#/$defs/cpu"},
    "memory": {"$ref": "#/$defs/memory"},
    "swap": {"$ref": "#/$defs/swap"},
    "root_filesystem": {"$ref": "#/$defs/rootFilesystem"},
    "accelerator": {"$ref": "#/$defs/accelerator"},
    "thermal_zones": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/thermalZone"}},
    "fabric": {"$ref": "#/$defs/fabric"},
    "services": {"$ref": "#/$defs/services"}
  },
  "$defs": {
    "nullableNonNegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "nullableNumber": {"type": ["number", "null"]},
    "nullablePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "nullableShortString": {"type": ["string", "null"], "maxLength": 256},
    "identity": {"type": "object", "additionalProperties": false, "required": ["hostname", "boot_id", "uptime_seconds"], "properties": {"hostname": {"type": "string", "maxLength": 256}, "boot_id": {"$ref": "#/$defs/nullableShortString"}, "uptime_seconds": {"$ref": "#/$defs/nullableNonNegativeInteger"}}},
    "cpu": {"type": "object", "additionalProperties": false, "required": ["logical_processors", "utilization_percent", "load_1", "load_5", "load_15"], "properties": {"logical_processors": {"type": "integer", "minimum": 0}, "utilization_percent": {"$ref": "#/$defs/nullablePercent"}, "load_1": {"$ref": "#/$defs/nullableNumber"}, "load_5": {"$ref": "#/$defs/nullableNumber"}, "load_15": {"$ref": "#/$defs/nullableNumber"}}},
    "memory": {"type": "object", "additionalProperties": false, "required": ["total_bytes", "available_bytes", "used_bytes", "used_percent"], "properties": {"total_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "available_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "used_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "used_percent": {"$ref": "#/$defs/nullablePercent"}}},
    "swap": {"type": "object", "additionalProperties": false, "required": ["total_bytes", "free_bytes", "used_bytes", "used_percent"], "properties": {"total_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "free_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "used_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "used_percent": {"$ref": "#/$defs/nullablePercent"}}},
    "rootFilesystem": {"type": "object", "additionalProperties": false, "required": ["total_bytes", "available_bytes", "used_bytes", "used_percent", "read_only"], "properties": {"total_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "available_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "used_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "used_percent": {"$ref": "#/$defs/nullablePercent"}, "read_only": {"type": ["boolean", "null"]}}},
    "accelerator": {"type": "object", "additionalProperties": false, "required": ["available", "name", "driver_version", "utilization_percent", "temperature_c", "performance_state", "power_watts"], "properties": {"available": {"type": "boolean"}, "name": {"$ref": "#/$defs/nullableShortString"}, "driver_version": {"type": ["string", "null"], "maxLength": 64}, "utilization_percent": {"$ref": "#/$defs/nullablePercent"}, "temperature_c": {"$ref": "#/$defs/nullableNumber"}, "performance_state": {"type": ["string", "null"], "maxLength": 32}, "power_watts": {"$ref": "#/$defs/nullableNumber"}, "active_nvidia_compute_processes": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535}}},
    "thermalZone": {"type": "object", "additionalProperties": false, "required": ["zone", "type", "temperature_c", "trip_points"], "properties": {"zone": {"type": "string", "maxLength": 64}, "type": {"type": "string", "minLength": 1, "maxLength": 256}, "temperature_c": {"type": "number"}, "trip_points": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/tripPoint"}}}},
    "tripPoint": {"type": "object", "additionalProperties": false, "required": ["type", "temperature_c", "reached"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 64}, "temperature_c": {"type": "number"}, "reached": {"type": "boolean"}}},
    "fabric": {"type": "object", "additionalProperties": false, "required": ["functions"], "properties": {"functions": {"type": "array", "minItems": 0, "maxItems": 16, "items": {"$ref": "#/$defs/fabricFunction"}}}},
    "fabricFunction": {"type": "object", "additionalProperties": false, "required": ["interface", "hca", "operstate", "carrier", "speed_mbps", "mtu", "rdma_interface", "rdma_state", "counters"], "properties": {"interface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 64}, "hca": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 64}, "operstate": {"type": ["string", "null"], "maxLength": 32}, "carrier": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "speed_mbps": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "mtu": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "rdma_interface": {"type": ["string", "null"], "maxLength": 64}, "rdma_state": {"type": ["string", "null"], "maxLength": 32}, "counters": {"$ref": "#/$defs/rdmaCounters"}}},
    "rdmaCounters": {"type": "object", "additionalProperties": false, "required": ["out_of_buffer", "out_of_sequence", "duplicate_request", "rnr_nak_retry_err", "packet_seq_err", "implied_nak_seq_err", "local_ack_timeout_err", "resp_local_length_error", "resp_cqe_error", "req_cqe_error", "req_remote_invalid_request", "req_remote_access_errors", "resp_remote_access_errors", "resp_cqe_flush_error", "req_cqe_flush_error", "req_transport_retries_exceeded", "req_rnr_retries_exceeded", "roce_adp_retrans", "roce_adp_retrans_to"], "properties": {"out_of_buffer": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "out_of_sequence": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "duplicate_request": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "rnr_nak_retry_err": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "packet_seq_err": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "implied_nak_seq_err": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "local_ack_timeout_err": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "resp_local_length_error": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "resp_cqe_error": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "req_cqe_error": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "req_remote_invalid_request": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "req_remote_access_errors": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "resp_remote_access_errors": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "resp_cqe_flush_error": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "req_cqe_flush_error": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "req_transport_retries_exceeded": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "req_rnr_retries_exceeded": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "roce_adp_retrans": {"$ref": "#/$defs/nullableNonNegativeInteger"}, "roce_adp_retrans_to": {"$ref": "#/$defs/nullableNonNegativeInteger"}}},
    "services": {"type": "object", "additionalProperties": false, "required": ["docker_available", "docker_version", "earlyoom_load_state", "earlyoom_enabled", "earlyoom_active"], "properties": {"docker_available": {"type": "boolean"}, "docker_version": {"type": ["string", "null"], "maxLength": 256}, "earlyoom_load_state": {"type": ["string", "null"], "maxLength": 256}, "earlyoom_enabled": {"type": ["boolean", "null"]}, "earlyoom_active": {"type": ["boolean", "null"]}}}
  }
}
