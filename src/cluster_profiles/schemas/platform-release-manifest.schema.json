{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.invalid/schemas/platform-release-manifest.schema.json",
  "title": "Vonk Forge platform release manifest",
  "$comment": "Schema-only validation is not authorization. Consumers MUST use PlatformRelease.from_bytes so cross-field digest, range, package, and target-identity invariants are enforced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform_version",
    "build_digest",
    "deployment_bundle",
    "control",
    "database",
    "agent_packages"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "platform_version": {"$ref": "#/$defs/semanticVersion"},
    "build_digest": {"$ref": "#/$defs/prefixedDigest"},
    "deployment_bundle": {"$ref": "#/$defs/ociDeploymentBundle"},
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_version", "protocol", "images", "assets"],
      "properties": {
        "config_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "protocol": {"$ref": "#/$defs/protocolRange"},
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker"],
          "properties": {
            "api": {"$ref": "#/$defs/artifact"},
            "worker": {"$ref": "#/$defs/artifact"}
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": {"$ref": "#/$defs/token"}
      }
    },
    "agent_packages": {"$ref": "#/$defs/debianPackages"}
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "architecture": {
      "type": "string",
      "enum": ["linux-amd64", "linux-arm64"]
    },
    "protocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1, "maximum": 65535},
        "maximum": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ociDeploymentBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "manifest_digest",
        "manifest_size",
        "manifest_media_type",
        "layer_digest",
        "layer_size",
        "layer_media_type"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {"$ref": "#/$defs/prefixedDigest"},
        "manifest_size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "manifest_media_type": {"const": "application/vnd.oci.image.manifest.v1+json"},
        "layer_digest": {"$ref": "#/$defs/prefixedDigest"},
        "layer_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "layer_media_type": {"const": "application/vnd.vonk-forge.control-deployment.v1.tar"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference",
        "sha256",
        "size",
        "sbom_sha256",
        "provenance_sha256"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "reference": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[0-9a-f]{64}$"
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "sbom_sha256": {"$ref": "#/$defs/digest"},
        "provenance_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "debianPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "name",
        "version",
        "filename",
        "sha256",
        "size",
        "sbom_sha256",
        "provenance_sha256",
        "sigstore_bundle_sha256"
      ],
      "properties": {
        "architecture": {"$ref": "#/$defs/architecture"},
        "name": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "filename": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*\\.deb$",
          "maxLength": 256
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "sbom_sha256": {"$ref": "#/$defs/digest"},
        "provenance_sha256": {"$ref": "#/$defs/digest"},
        "sigstore_bundle_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "debianPackages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": {"properties": {"architecture": {"const": "linux-arm64"}}},
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {"properties": {"architecture": {"const": "linux-amd64"}}},
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {"$ref": "#/$defs/debianPackage"}
    }
  }
}
