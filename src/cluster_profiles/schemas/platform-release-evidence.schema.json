{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.invalid/schemas/platform-release-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate", "status", "evidence_sha256", "evidence_kinds", "physical_evidence_key_id", "physical_update_gates", "missing_gates", "digest"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["passed", "blocked"]},
    "evidence_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "evidence_kinds": {
      "type": "object",
      "additionalProperties": {
        "enum": ["assertion", "invalid", "missing", "physical", "simulated", "unclassified"]
      }
    },
    "physical_evidence_key_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "physical_update_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_host_update_recovery", "signed_platform_update_manifest", "node_canary_and_rollback"],
      "properties": {
        "control_host_update_recovery": {"type": "boolean"},
        "signed_platform_update_manifest": {"type": "boolean"},
        "node_canary_and_rollback": {"type": "boolean"}
      }
    },
    "missing_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
