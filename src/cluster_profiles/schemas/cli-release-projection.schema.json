{
  "$defs": {
    "CliReleaseArtifacts": {
      "description": "Only the artifact consumed by the self-updater; other artifacts may grow.",
      "properties": {
        "cli-wheel": {
          "$ref": "#/$defs/CliWheelProjection"
        }
      },
      "required": [
        "cli-wheel"
      ],
      "title": "CliReleaseArtifacts",
      "type": "object"
    },
    "CliWheelProjection": {
      "description": "Validate wheel identity and bounds while allowing signed descriptor metadata.",
      "properties": {
        "path": {
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "CliWheelProjection",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Signed updater ingress, independent of the complete installer graph.\n\nFuture installer schemas remain updateable through this stable projection.\nIgnored fields stay covered by the original bytes' signature and digest.",
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/CliReleaseArtifacts"
    },
    "channel": {
      "enum": [
        "dev",
        "stable"
      ],
      "title": "Channel",
      "type": "string"
    },
    "generation": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generation",
      "type": "string"
    },
    "schema_version": {
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Sha",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z.+:~-]{0,126}[0-9A-Za-z])?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "channel",
    "generation",
    "version",
    "source_sha",
    "artifacts"
  ],
  "title": "CliReleaseProjection",
  "type": "object"
}
