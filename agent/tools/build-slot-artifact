#!/usr/bin/python3
"""Build one native self-contained Vonk Forge agent slot ELF."""

from __future__ import annotations

import argparse
import email.parser
import hashlib
import io
import json
import os
import platform
import secrets
import shutil
import stat
import struct
import subprocess
import tempfile
import zipfile
from pathlib import Path

MACHINES = {"x86_64": 62, "aarch64": 183}
MAX_WHEEL = 256 * 1024 * 1024
MAX_ARTIFACT = 256 * 1024 * 1024
MAX_BUILD_ATTEMPTS = 3
PYINSTALLER = "6.15.0"
LOCK_SHA256 = "ddc887c5e45503d5cab4904143de19cd5e4156cb410473928526e0765134cbcd"
PACKAGING_DISTRIBUTIONS = {
    "altgraph": "0.17.5",
    "attrs": "26.1.0",
    "cffi": "2.1.1",
    "cryptography": "50.0.0",
    "iniconfig": "2.3.0",
    "jsonschema": "4.25.1",
    "jsonschema-specifications": "2025.9.1",
    "packaging": "26.2",
    "pluggy": "1.6.0",
    "pycparser": "3.0",
    "pygments": "2.20.0",
    "pyinstaller": "6.15.0",
    "pyinstaller-hooks-contrib": "2026.6",
    "pytest": "8.4.2",
    "referencing": "0.37.0",
    "rpds-py": "2026.6.3",
    "securesystemslib": "1.4.0",
    "setuptools": "83.0.0",
    "vonk-cluster-profiles": "0.1.0",
    "tuf": "7.0.0",
    "typing-extensions": "4.16.0",
    "urllib3": "2.7.0",
}
INPUT_DISTRIBUTIONS = {
    "agent wheel": ("vonk-forge-agent", "0.1.0"),
    "protocol wheel": ("vonk-agent-protocol", "2.1.0"),
    "platform wheel": ("vonk-cluster-profiles", "0.1.0"),
}


class BuildError(RuntimeError):
    pass


def _native() -> str:
    machine = platform.machine()
    if machine == "AMD64":
        machine = "x86_64"
    elif machine == "arm64":
        machine = "aarch64"
    if machine not in MACHINES:
        raise BuildError("builder architecture is unsupported")
    return machine


def _input(path: Path, label: str) -> bytes:
    if not path.is_absolute():
        raise BuildError(f"{label} must be absolute")
    descriptor = os.open(
        path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid not in {0, os.geteuid()}
            or before.st_mode & 0o022
            or not 0 < before.st_size <= MAX_WHEEL
        ):
            raise BuildError(f"{label} is unsafe")
        chunks: list[bytes] = []
        remaining = MAX_WHEEL + 1
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        identity = lambda item: (
            item.st_dev,
            item.st_ino,
            item.st_size,
            item.st_mtime_ns,
            item.st_ctime_ns,
        )
        if len(raw) > MAX_WHEEL or identity(before) != identity(after):
            raise BuildError(f"{label} changed while being snapshotted")
        return raw
    except OSError as error:
        raise BuildError(f"{label} is unavailable") from error
    finally:
        os.close(descriptor)


def _extract_wheel(raw: bytes, destination: Path, label: str) -> None:
    try:
        archive = zipfile.ZipFile(io.BytesIO(raw))
    except zipfile.BadZipFile as error:
        raise BuildError(f"{label} is not a wheel archive") from error
    destination.mkdir(mode=0o700)
    with archive:
        infos = archive.infolist()
        if len(infos) > 4096 or sum(info.file_size for info in infos) > MAX_WHEEL:
            raise BuildError(f"{label} expands beyond its bound")
        seen: set[str] = set()
        for info in infos:
            name = info.filename
            parts = Path(name).parts
            if (
                not name
                or name.startswith("/")
                or "\\" in name
                or any(part in {"", ".", ".."} for part in parts)
                or name in seen
                or stat.S_ISLNK((info.external_attr >> 16) & 0xFFFF)
            ):
                raise BuildError(f"{label} contains an unsafe member")
            seen.add(name)
            target = destination.joinpath(*parts)
            if info.is_dir():
                target.mkdir(parents=True, exist_ok=True, mode=0o700)
                continue
            target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            target.write_bytes(archive.read(info))
            target.chmod(0o400)


def _validate_wheel(raw: bytes, label: str) -> None:
    expected_name, expected_version = INPUT_DISTRIBUTIONS[label]
    try:
        with zipfile.ZipFile(io.BytesIO(raw)) as archive:
            names = archive.namelist()
            metadata_names = [
                name for name in names if name.endswith(".dist-info/METADATA")
            ]
            if len(metadata_names) != 1:
                raise BuildError(f"{label} distribution metadata is invalid")
            metadata = email.parser.BytesParser().parsebytes(
                archive.read(metadata_names[0])
            )
    except (zipfile.BadZipFile, KeyError, ValueError) as error:
        raise BuildError(f"{label} distribution metadata is invalid") from error
    if (
        metadata.get("Name", "").lower().replace("_", "-") != expected_name
        or metadata.get("Version") != expected_version
    ):
        raise BuildError(f"{label} distribution identity is not reviewed")
    if label == "platform wheel":
        required = {
            "cluster_profiles/platform_release.py",
            "cluster_profiles/update_trust.py",
            "cluster_profiles/schemas/platform-update-manifest.schema.json",
        }
        if not required.issubset(names):
            raise BuildError("platform wheel release closure is incomplete")


def _packaging_python() -> Path:
    project = Path(__file__).resolve().parents[1]
    lock = project / "uv.lock"
    if (
        hashlib.sha256(_input(lock, "frozen dependency lock")).hexdigest()
        != LOCK_SHA256
    ):
        raise BuildError("frozen dependency lock is not reviewed")
    python = project / ".venv/bin/python"
    try:
        resolved = python.resolve(strict=True)
        metadata = python.lstat()
    except OSError as error:
        raise BuildError("fixed packaging environment is unavailable") from error
    if not stat.S_ISLNK(metadata.st_mode) or resolved != Path("/usr/bin/python3.12"):
        raise BuildError("fixed packaging interpreter is unsafe")
    checked = subprocess.run(
        [
            str(python),
            "-I",
            "-c",
            (
                "import importlib.metadata as m,json;"
                "print(json.dumps({n:m.version(n) for n in "
                "json.loads(__import__('sys').argv[1])},sort_keys=True))"
            ),
            json.dumps(sorted(PACKAGING_DISTRIBUTIONS)),
        ],
        env={"HOME": "/nonexistent", "LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"},
        text=True,
        capture_output=True,
        check=False,
    )
    if checked.returncode != 0:
        raise BuildError("fixed packaging distributions are unavailable")
    try:
        installed = json.loads(checked.stdout)
    except json.JSONDecodeError as error:
        raise BuildError("fixed packaging distribution report is invalid") from error
    if installed != PACKAGING_DISTRIBUTIONS:
        raise BuildError("fixed packaging distributions differ from the frozen lock")
    return python


def _verify_elf(path: Path, architecture: str) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or not 64 <= metadata.st_size <= MAX_ARTIFACT
        ):
            raise BuildError("packaging output is not a bounded regular ELF")
        header = os.read(descriptor, 64)
    finally:
        os.close(descriptor)
    if header[:7] != b"\x7fELF\x02\x01\x01":
        raise BuildError("packaging output is not ELF64 little-endian")
    elf_type, machine = struct.unpack_from("<HH", header, 16)
    if elf_type not in {2, 3} or machine != MACHINES[architecture]:
        raise BuildError("packaging output architecture is invalid")


def _verify_packaged_runtime(path: Path, home: Path) -> None:
    """Exercise every entry point before an artifact can be published.

    PyInstaller one-file archives can be syntactically valid ELF files while
    still containing a damaged compressed member (for example after a
    transient builder crash).  Running the same isolated commands used by
    the install-time smoke test catches that class of corruption before the
    artifact becomes the next slot image.
    """

    environment = {
        "HOME": str(home),
        "LANG": "C.UTF-8",
        "PATH": "/usr/bin:/bin",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": "/nonexistent",
    }
    for arguments in (
        ("--help",),
        ("--packaged-module-smoke",),
        ("--package-helper", "--help"),
    ):
        try:
            checked = subprocess.run(
                [str(path), *arguments],
                cwd=home,
                env=environment,
                text=True,
                capture_output=True,
                check=False,
                timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise BuildError(
                f"packaged runtime smoke failed for {' '.join(arguments)}"
            ) from error
        if checked.returncode != 0:
            detail = checked.stderr.strip() or checked.stdout.strip()
            suffix = f": {detail[:240]}" if detail else ""
            raise BuildError(
                f"packaged runtime smoke failed for {' '.join(arguments)}"
                f" (exit {checked.returncode}){suffix}"
            )


def _publish(source: Path, output: Path, architecture: str) -> None:
    if not output.is_absolute() or output.name in {"", ".", ".."}:
        raise BuildError("output must be an absolute file path")
    try:
        if output.lstat():
            raise BuildError("output already exists")
    except FileNotFoundError:
        pass
    if not output.parent.is_dir() or output.parent.is_symlink():
        raise BuildError("output directory is unsafe")
    directory = os.open(
        output.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    )
    temporary = f".{output.name}.{secrets.token_hex(8)}.new"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o500,
            dir_fd=directory,
        )
        with source.open("rb") as stream:
            while chunk := stream.read(1024 * 1024):
                view = memoryview(chunk)
                while view:
                    written = os.write(descriptor, view)
                    view = view[written:]
        os.fchmod(descriptor, 0o555)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        staged = output.parent / temporary
        _verify_elf(staged, architecture)
        os.link(
            temporary,
            output.name,
            src_dir_fd=directory,
            dst_dir_fd=directory,
            follow_symlinks=False,
        )
        os.unlink(temporary, dir_fd=directory)
        os.fsync(directory)
    except OSError as error:
        raise BuildError("artifact publication failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)


def build(
    agent_wheel: Path,
    protocol_wheel: Path,
    platform_wheel: Path,
    output: Path,
    architecture: str,
) -> None:
    if architecture not in MACHINES or architecture != _native():
        raise BuildError("cross-architecture packaging is forbidden")
    agent_snapshot = _input(agent_wheel, "agent wheel")
    protocol_snapshot = _input(protocol_wheel, "protocol wheel")
    platform_snapshot = _input(platform_wheel, "platform wheel")
    _validate_wheel(agent_snapshot, "agent wheel")
    _validate_wheel(protocol_snapshot, "protocol wheel")
    _validate_wheel(platform_snapshot, "platform wheel")
    entry = Path(__file__).resolve().parents[1] / "packaging/slot_entry.py"
    entry_snapshot = _input(entry, "packaging entry")
    substitute = os.environ.get("VONK_SLOT_SUBSTITUTE_INPUT_TEST")
    if substitute is not None:
        if substitute != "1" or "PYTEST_CURRENT_TEST" not in os.environ:
            raise BuildError("wheel substitution hook is invalid")
        agent_wheel.write_bytes(b"substituted after descriptor snapshot")
    python = _packaging_python()
    with tempfile.TemporaryDirectory(prefix="vonk-slot-build-") as raw:
        root = Path(raw)
        agent_source = root / "agent-wheel"
        protocol_source = root / "protocol-wheel"
        platform_source = root / "platform-wheel"
        _extract_wheel(agent_snapshot, agent_source, "agent wheel")
        _extract_wheel(protocol_snapshot, protocol_source, "protocol wheel")
        _extract_wheel(platform_snapshot, platform_source, "platform wheel")
        entry = root / "slot_entry.py"
        entry.write_bytes(entry_snapshot)
        entry.chmod(0o400)
        environment = {
            "HOME": str(root / "home"),
            "LANG": "C.UTF-8",
            "PATH": "/usr/bin:/bin",
            "PYTHONPATH": os.pathsep.join(
                (str(agent_source), str(protocol_source), str(platform_source))
            ),
            "PYTHONNOUSERSITE": "1",
            "PYTHONSAFEPATH": "1",
            "NO_PROXY": "*",
        }
        Path(environment["HOME"]).mkdir(mode=0o700)
        command = [
            str(python),
            "-m",
            "PyInstaller",
            "--clean",
            "--noupx",
            "--onefile",
            "--name",
            "vonk-forge-agent",
            "--distpath",
            str(root / "dist"),
            "--workpath",
            str(root / "work"),
            "--specpath",
            str(root / "spec"),
            "--paths",
            str(agent_source),
            "--paths",
            str(protocol_source),
            "--paths",
            str(platform_source),
            "--hidden-import",
            "vonk_agent.package_helper",
            "--hidden-import",
            "vonk_agent.package_helper_protocol",
            "--hidden-import",
            "vonk_agent.client",
            "--hidden-import",
            "vonk_agent.config",
            "--hidden-import",
            "vonk_agent.deadlines",
            "--hidden-import",
            "vonk_agent.main",
            "--hidden-import",
            "vonk_agent.nvidia_tools",
            "--hidden-import",
            "vonk_agent.oci",
            "--hidden-import",
            "vonk_agent.operations",
            "--hidden-import",
            "vonk_agent.probe",
            "--hidden-import",
            "vonk_agent.readiness",
            "--hidden-import",
            "vonk_agent.releases",
            "--hidden-import",
            "vonk_agent.runtime_policy",
            "--hidden-import",
            "vonk_agent.state",
            "--hidden-import",
            "vonk_agent.update_trust",
            "--hidden-import",
            "vonk_agent.workloads",
            "--hidden-import",
            "cluster_profiles.platform_release",
            "--hidden-import",
            "cluster_profiles.update_trust",
            "--add-data",
            (
                f"{platform_source / 'cluster_profiles/schemas/platform-update-manifest.schema.json'}"
                ":cluster_profiles/schemas"
            ),
            str(entry),
        ]
        last_error: Exception | None = None
        for attempt in range(MAX_BUILD_ATTEMPTS):
            if attempt:
                # A crashed PyInstaller process can leave a truncated archive
                # in its output directories.  Keep every retry isolated from
                # that partial state while remaining inside this private
                # temporary build root.
                for partial in (root / "dist", root / "work", root / "spec"):
                    shutil.rmtree(partial, ignore_errors=True)
            try:
                subprocess.run(command, check=True, cwd=root, env=environment)
                built = root / "dist/vonk-forge-agent"
                _verify_elf(built, architecture)
                _verify_packaged_runtime(built, Path(environment["HOME"]))
            except (BuildError, OSError, subprocess.CalledProcessError) as error:
                last_error = error
                continue
            _publish(built, output, architecture)
            return
        if last_error is None:
            raise BuildError("packaging failed without a diagnostic")
        raise BuildError(
            f"packaging failed after {MAX_BUILD_ATTEMPTS} attempts: {last_error}"
        ) from last_error


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--agent-wheel", type=Path, required=True)
    parser.add_argument("--protocol-wheel", type=Path, required=True)
    parser.add_argument("--platform-wheel", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--architecture", choices=tuple(MACHINES), required=True)
    arguments = parser.parse_args()
    try:
        build(
            arguments.agent_wheel,
            arguments.protocol_wheel,
            arguments.platform_wheel,
            arguments.output,
            arguments.architecture,
        )
    except (BuildError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"build-slot-artifact: {error}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
