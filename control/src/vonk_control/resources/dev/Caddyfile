{
	admin off
	auto_https disable_redirects
}

http://127.0.0.1:2019 {
	bind 127.0.0.1
	respond /healthz 200
	respond 404
}

(edge_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

(edge_guards) {
	request_body {
		max_size 1MB
	}
	import edge_headers
}

(agent_edge_guards) {
	# Recipe OCI layouts are the only large inbound agent body. The API streams,
	# hashes, and enforces this same 16 TiB protocol ceiling.
	@recipe_image_upload {
		method PUT
		path /agent/v1/recipe-builds/*/image
	}
	@ordinary_agent_request not {
		method PUT
		path /agent/v1/recipe-builds/*/image
	}
	request_body @ordinary_agent_request {
		max_size 1MB
	}
	request_body @recipe_image_upload {
		max_size 17592186044416
	}
	import edge_headers
}

(litellm_route_lease) {
	forward_auth litellm:4001 {
		uri /vonk/route-lease
	}
}

# BEGIN PRIVATE BROWSER EDGE
(browser_proxy_headers) {
	# Tailscale owns the browser's HTTPS boundary. Never forward caller-supplied
	# proxy or agent identity metadata to either application upstream.
	request_header -Forwarded
	request_header -X-Forwarded-*
	request_header -X-Vonk-Agent-*
}

(browser_control_proxy) {
	import browser_proxy_headers
	reverse_proxy control-api:8000
}

# Tailscale Services terminates HTTPS before this private Docker listener. The
# service MagicDNS name is exactly vonk-forge.<tailnet-name>.ts.net; every
# other Host fails before it can reach the browser API or UI.
:8080 {
	@canonical_browser_host host {$VONK_CONTROL_HOSTNAME}
	handle @canonical_browser_host {
		import edge_guards
		handle /healthz {
			respond 200
		}
		@agent_path path /agent/v1/*
		handle @agent_path {
			respond 404
		}
		@internal_path path /internal/*
		handle @internal_path {
			respond 404
		}
		handle /v1/* {
			import browser_proxy_headers
			import litellm_route_lease
			reverse_proxy litellm:4000
		}
		@litellm_repository_authority {
			method POST PUT PATCH DELETE
			path /litellm/model /litellm/model/* /litellm/model_group /litellm/model_group/* /litellm/config /litellm/config/*
		}
		handle @litellm_repository_authority {
			respond 403
		}
		handle_path /litellm/* {
			import browser_proxy_headers
			import litellm_route_lease
			reverse_proxy litellm:4000
		}
		handle /grafana/* {
			import browser_proxy_headers
			reverse_proxy grafana:3000
		}
		handle {
			import browser_control_proxy
		}
	}
	respond 421
}
# END PRIVATE BROWSER EDGE

# Internal inference clients use the same request-time lease authority without
# exposing LiteLLM's native listener or management routes.
:8081 {
	handle /v1/* {
		import litellm_route_lease
		reverse_proxy litellm:4000
	}
	respond 404
}

https://{$VONK_AGENT_ENROLL_HOSTNAME}:{$VONK_BACKEND_PORT} {
	import edge_guards
	tls /run/secrets/controller-server-certificate /run/secrets/controller-server-key

	@managed remote_ip {$VONK_MANAGEMENT_CIDRS}
	@enrollment {
		method POST
		path /agent/v1/enroll
	}
	handle @managed {
		handle @enrollment {
			reverse_proxy control-api:8000 {
				header_up -X-Vonk-Agent-*
			}
		}
		respond 404
	}
	respond 403
}

https://{$VONK_AGENT_HOSTNAME}:{$VONK_BACKEND_PORT} {
	import agent_edge_guards
	tls /run/secrets/controller-server-certificate /run/secrets/controller-server-key {
		client_auth {
			trust_pool file /run/secrets/agent-ca-certificate
			mode require_and_verify
		}
	}
	map {tls_client_subject} {vonk_agent_node} {
		~^CN=(spk_[0-9a-f]{32})$ "${1}"
		default ""
	}

	@managed remote_ip {$VONK_MANAGEMENT_CIDRS}
	@agent_api {
		path /agent/v1/*
		not path /agent/v1/enroll
	}
	handle @managed {
		handle @agent_api {
			request_header -X-Vonk-Agent-*
			reverse_proxy control-api:8000 {
				header_up X-Vonk-Agent-Node {vonk_agent_node}
				header_up X-Vonk-Agent-Serial {tls_client_serial}
				header_up X-Vonk-Agent-Fingerprint {tls_client_fingerprint}
				header_up X-Vonk-Agent-Verified "1"
				import /tmp/vonk-agent-proxy-auth.caddy
				header_up X-Vonk-Agent-Source {http.request.remote.host}
			}
		}
		respond 404
	}
	respond 403
}
