 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "The model's native DSpark prediction layers draft tokens (upstream default, SPEC_ALGO=DSPARK).",
     "label": "DSpark (default)",
     "value": "dspark"
    },
    {
     "env": {
      "SPEC_ALGO": "off"
     },
     "help": "No speculative decoding (boot.py SPEC_ALGO=off); the upstream launcher accepts it, upstream publishes no figures for it.",
     "label": "Off",
     "value": "off"
    }
   ],
   "help": "Whether DSpark speculative decoding drafts tokens for the target to verify; chosen at boot. Upstream (sparkDash, greedy, thinking off, three Sparks) measured 37.9 tok/s prose at one stream with DSpark on.",
   "label": "Speculative decoding",
   "name": "speculation"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "DSPARK_BLOCK_SIZE=5 and DSV41_VERIFY_CAP=conf:0.1: upstream reports code +10 % and prose neutral against block 3.",
     "label": "Block 5 with confidence cap (default)",
     "value": "k5-capped"
    },
    {
     "env": {
      "DSPARK_BLOCK_SIZE": "3",
      "DSV41_VERIFY_CAP": "0"
     },
     "help": "Upstream's documented rollback; block 5 without the cap loses 8-16 % on prose upstream.",
     "label": "Block 3, no cap",
     "value": "k3"
    }
   ],
   "help": "How many tokens DSpark drafts per step. Upstream default is 5 together with the confidence cap; its documented rollback is 3 without the cap.",
   "label": "Draft block size",
   "name": "draft-block"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "Every rank holds a third of every expert's intermediate width; upstream measured NCCL 12.9 to 5.6 ms per step and single-stream decode +8-12 % over EP 3 (2026-09-24).",
     "label": "Sliced experts, EP 1 (default)",
     "value": "ep1"
    },
    {
     "env": {
      "EP_SIZE": "3"
     },
     "help": "Upstream's documented rollback: each rank holds whole experts.",
     "label": "Whole experts, EP 3",
     "value": "ep3"
    }
   ],
   "help": "How the routed experts are placed across the three ranks.",
   "label": "Expert layout",
   "name": "expert-parallel"
  }
