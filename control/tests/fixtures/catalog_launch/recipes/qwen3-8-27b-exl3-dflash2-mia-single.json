 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "Upstream default.",
     "label": "MTP head",
     "value": "mtp"
    },
    {
     "args": [
      {
       "name": "draft_model",
       "value": "/models/draft"
      }
     ],
     "help": "Drafts up to 7 tokens per step with the mounted DFlash2 EXL3 5.0 bpw draft.",
     "label": "DFlash2 draft",
     "value": "dflash2"
    },
    {
     "args": [
      {
       "name": "draft_model",
       "value": "none"
      }
     ],
     "help": "Upstream: slowest per token, no extra memory.",
     "label": "No drafting",
     "value": "none"
    }
   ],
   "help": "How tokens are drafted. MTP uses the draft head inside the target checkpoint (no extra weights, about 20% less KV per token); DFlash2 uses the separate 1.4 GB draft (upstream claims about 15% faster, at the cost of its weights and draft KV). Speed statements are upstream claims until measured on Vonk hardware.",
   "label": "Speculative decoding",
   "name": "speculation"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "Upstream default and recommendation (about 18 KB per token).",
     "label": "NVFP4 (about 4.5 bits)",
     "value": "nvfp4"
    },
    {
     "args": [
      {
       "name": "cache_quant",
       "value": "fp8"
      }
     ],
     "help": "Raw E4M3 cache.",
     "label": "FP8 E4M3 (8 bits)",
     "value": "fp8"
    },
    {
     "args": [
      {
       "name": "cache_quant",
       "value": "8"
      }
     ],
     "help": "Upstream cache_quant 8.",
     "label": "INT8 Hadamard (about 8.5 bits)",
     "value": "int8"
    },
    {
     "args": [
      {
       "name": "cache_quant",
       "value": "8,4"
      }
     ],
     "help": "Upstream cache_quant 8,4 (asymmetric).",
     "label": "INT8 keys, INT4 values (Hadamard)",
     "value": "int8-int4"
    },
    {
     "args": [
      {
       "name": "cache_quant",
       "value": "4"
      }
     ],
     "help": "Upstream cache_quant 4; documented for Ampere GPUs that cannot compile the NVFP4/FP8 kernels.",
     "label": "INT4 Hadamard (about 4.5 bits)",
     "value": "int4"
    },
    {
     "args": [
      {
       "name": "cache_quant",
       "value": "none"
      }
     ],
     "help": "No KV quantization (about 64 KB per token); the wrapper omits --cache_quant as upstream does for CACHE_QUANT=none.",
     "label": "FP16 (16 bits)",
     "value": "fp16"
    }
   ],
   "help": "Format of the attention KV cache. NVFP4 and FP8 are the fork's software-packed lanes and need compute capability 8.9 or newer (GB10 qualifies); upstream measured NVFP4 lossless at generation level. Bits per element are upstream figures.",
   "label": "KV cache format",
   "name": "kv-cache"
  }
