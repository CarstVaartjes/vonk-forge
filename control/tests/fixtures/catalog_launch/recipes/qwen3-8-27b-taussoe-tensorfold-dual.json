 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "Draft with z-lab/Qwen3.8-27B-DFlash2 (upstream default).",
     "label": "DFlash2 draft trees",
     "value": "dflash2"
    },
    {
     "args": [
      {
       "name": "no-drafts",
       "value": true
      }
     ],
     "help": "Serial one-token-at-a-time reference decoding (--no-drafts); same output, about a quarter of the speed.",
     "label": "No drafting",
     "value": "serial"
    }
   ],
   "help": "DFlash2 proposes token trees that the target verifies against its own serial sample, so replies are unchanged by drafting (upstream claim). Upstream measures serial decoding at 13.1 tok/s on one Spark against 49-59 drafted. The CUDA engine requires the draft model unless --no-drafts is set.",
   "label": "Speculative drafting",
   "name": "drafting"
  }
 ],
