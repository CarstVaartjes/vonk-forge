 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "Up to 15 MTP drafts a round, each chain stopping where the next verify row would cost more than its draft saves; window and level costs are measured at startup on this GPU (upstream default on CUDA since 0.6.5).",
     "label": "MTP, cost-chosen depth",
     "value": "mtp-auto"
    },
    {
     "args": [
      {
       "name": "mtp-drafts",
       "value": 3
      }
     ],
     "help": "At most 3 MTP drafts a round (--mtp-drafts 3; TensorFold's CUDA default before 0.6.5); speed unmeasured.",
     "label": "MTP, 3 drafts",
     "value": "mtp-3"
    },
    {
     "args": [
      {
       "name": "mtp-drafts",
       "value": 1
      }
     ],
     "help": "At most 1 MTP draft a round (--mtp-drafts 1); speed unmeasured.",
     "label": "MTP, 1 draft",
     "value": "mtp-1"
    },
    {
     "args": [
      {
       "name": "mtp-drafts",
       "value": 6
      }
     ],
     "help": "At most 6 MTP drafts a round (--mtp-drafts 6); speed unmeasured.",
     "label": "MTP, 6 drafts",
     "value": "mtp-6"
    },
    {
     "args": [
      {
       "name": "no-drafts",
       "value": true
      }
     ],
     "help": "Serial one-token-at-a-time reference decoding (--no-drafts); slower (upstream measured 108 to 110 tok/s serial against 123 to 146 with MTP on a 64 GB M5 Pro, an MLX result).",
     "label": "No drafting",
     "value": "serial"
    }
   ],
   "help": "The model's own MTP head drafts tokens and the target verifies each against its serial sample, so outputs are unchanged by drafting (upstream claim). On CUDA the default chain depth comes from measured row costs; --mtp-drafts caps it at 0 to 15.",
   "label": "MTP drafting",
   "name": "drafting"
  }
