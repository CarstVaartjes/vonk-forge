 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "Open a think block by default (upstream default: --thinking).",
     "label": "Think first",
     "value": "thinking"
    },
    {
     "args": [
      {
       "name": "thinking",
       "value": false
      },
      {
       "name": "no-thinking",
       "value": true
      }
     ],
     "help": "Answer without a think block unless a request asks for one.",
     "label": "Answer directly",
     "value": "direct"
    }
   ],
   "help": "Whether the chat template opens a think block by default. A request can still set chat_template_kwargs.enable_thinking; reasoning comes back separately from the answer.",
   "label": "Thinking",
   "name": "thinking"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "At most 3 MTP drafts a round (upstream default).",
     "label": "MTP, 3 drafts",
     "value": "mtp-3"
    },
    {
     "args": [
      {
       "name": "mtp-drafts",
       "value": 1
      }
     ],
     "help": "At most 1 MTP draft a round (--mtp-drafts 1); speed unmeasured.",
     "label": "MTP, 1 draft",
     "value": "mtp-1"
    },
    {
     "args": [
      {
       "name": "mtp-drafts",
       "value": 6
      }
     ],
     "help": "At most 6 MTP drafts a round (--mtp-drafts 6); speed unmeasured.",
     "label": "MTP, 6 drafts",
     "value": "mtp-6"
    },
    {
     "args": [
      {
       "name": "no-drafts",
       "value": true
      }
     ],
     "help": "Serial one-token-at-a-time reference decoding (--no-drafts); slower (upstream measured 108 to 110 tok/s serial against 123 to 146 with MTP on a 64 GB M5 Pro, an MLX result).",
     "label": "No drafting",
     "value": "serial"
    }
   ],
   "help": "The model's own MTP head drafts tokens and the target verifies each against its serial sample, so outputs are unchanged by drafting (upstream claim). On CUDA drafts continue while the running head confidence stays at or above 20 percent (the first draft is always kept); --mtp-drafts takes 0 to 8.",
   "label": "MTP drafting",
   "name": "drafting"
  }
