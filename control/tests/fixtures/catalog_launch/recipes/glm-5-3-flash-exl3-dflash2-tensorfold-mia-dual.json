 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "IncoAI's DFlash2 drafter with up to 7 drafts a round, plus copy drafts; up to 4 concurrent requests (upstream default). Upstream claims +5-10% decode over MTP.",
     "label": "DFlash2 and copy drafts",
     "value": "dflash2"
    },
    {
     "args": [
      {
       "name": "drafter",
       "value": "none"
      },
      {
       "name": "parallel",
       "value": 1
      }
     ],
     "help": "The checkpoint's own MTP head, one request at a time (upstream DRAFTER=mtp, which requires PARALLEL=1); the concurrency setting is overridden to 1. The DFlash2 files are still downloaded as part of the recipe's model closure but unused.",
     "label": "Checkpoint MTP head",
     "value": "mtp"
    }
   ],
   "help": "Which draft source speeds up decoding. The DFlash2 drafter is IncoAI's (CC BY-NC-ND 4.0, non-commercial: licence information only, nothing here enforces it). The checkpoint's own MTP head serves one request at a time. Replies are verified against the model's own samples either way (upstream claim).",
   "label": "Speculative drafter",
   "name": "drafter"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "Think before answering (upstream default).",
     "label": "Think first",
     "value": "thinking"
    },
    {
     "args": [
      {
       "name": "thinking",
       "value": false
      },
      {
       "name": "no-thinking",
       "value": true
      }
     ],
     "help": "Answer without a think block unless a request asks for one.",
     "label": "Answer directly",
     "value": "direct"
    }
   ],
   "help": "Whether the chat template opens a think block by default. A request can still set reasoning_effort or chat_template_kwargs.enable_thinking; reasoning comes back in reasoning_content.",
   "label": "Thinking",
   "name": "thinking"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "Vision tower loaded; data URLs only (upstream default).",
     "label": "Images and video",
     "value": "vision"
    },
    {
     "args": [
      {
       "name": "vision",
       "value": false
      }
     ],
     "help": "No vision tower (upstream VISION=0).",
     "label": "Text only",
     "value": "text-only"
    }
   ],
   "help": "Serve image_url and video_url parts with GLM's own vision tower on rank 0 (1.05 GiB of weights and 0.75 GiB of workspace), or text only. Text only leaves that memory to the KV cache (upstream VISION=0).",
   "label": "Image and video input",
   "name": "images_video"
  }
 ],
