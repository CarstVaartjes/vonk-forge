 "options": [
  {
   "choices": [
    {
     "default": true,
     "help": "4-bit KV with the DiffKV Triton backend and WMMA decode (upstream default).",
     "label": "NVFP4 (default)",
     "value": "nvfp4"
    },
    {
     "args": [
      {
       "name": "kv-cache-dtype",
       "setting": null,
       "value": "fp8_e4m3"
      }
     ],
     "env": {
      "VLLM_NVFP4_INLINE": "0",
      "VLLM_WMMA_DECODE": "0"
     },
     "help": "8-bit KV without the NVFP4 inline and WMMA decode paths, as in upstream's frozen FP8 configuration.",
     "label": "FP8",
     "value": "fp8"
    }
   ],
   "help": "Precision of the attention KV cache. Upstream: NVFP4 gives about 3.5x the KV pool of FP8 at a 1M-token request (10.59M against 3.06M tokens) for a few percent of decode speed (36.4 against 38.2 tok/s); the FP8 path is the earlier public TP3 configuration.",
   "label": "KV cache precision",
   "name": "kv-cache"
  },
  {
   "choices": [
    {
     "default": true,
     "help": "Two drafted tokens per step (upstream default).",
     "label": "MTP 2 (default)",
     "value": "mtp2"
    },
    {
     "args": [
      {
       "name": "speculative-config",
       "setting": null,
       "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":1}"
      }
     ],
     "help": "One drafted token per step (the two-Spark upstream default; not measured upstream on three Sparks).",
     "label": "MTP 1",
     "value": "mtp1"
    },
    {
     "env": {
      "VONK_MIMO_SPEC": "off"
     },
     "help": "No speculative decoding.",
     "label": "Off",
     "value": "off"
    }
   ],
   "help": "MTP drafting with the checkpoint's bundled MTP head. Upstream's TP3 recipes use two drafted tokens.",
   "label": "Speculative decoding",
