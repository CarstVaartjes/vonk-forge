#!/usr/bin/env python3
"""Select CI integrations from conservative transitive dependencies."""

from __future__ import annotations

import argparse
import ast
import json
import re
import sys
from collections.abc import Iterable
from pathlib import Path

AREAS = (
    "rust",
    "repository",
    "control",
    "web",
    "compose",
    "generated",
    "nas_install",
    "agent_package",
)


# Events whose changed paths are known: a pull request diff, or a merge-queue
# commit compared with the queue's base commit. Anything else runs everything.
DIFF_EVENTS = ("pull_request", "merge_group")


def _matches(path: str, prefixes: tuple[str, ...], exact: tuple[str, ...] = ()) -> bool:
    return path in exact or path.startswith(prefixes)


# Ordinary pytest modules execute in the complete core suites. They neither
# ship in the images nor run in the installed-system acceptance programs.
# Limit exemptions to reviewed test directories; shared helpers, conftest,
# fixtures, Compose tests and native/acceptance programs stay conservative.
CORE_TEST_DIRECTORIES = frozenset(
    {
        "tests",
        "tests/scripts",
        "tests/control",
        "tests/cluster_profiles",
        "tests/install",
        "tests/nas_setup",
        "control/tests",
        "control/tests/security",
    }
)
# Audited helper used only by control/tests/test_catalog_dry_run.py. New test
# helpers require a dependency review rather than a blanket directory exemption.
CORE_TEST_HELPERS = frozenset({"control/tests/catalog_dry_run.py"})
ROOT = Path(__file__).resolve().parents[1]


def _core_test_input(path: str) -> bool:
    if path in CORE_TEST_HELPERS:
        return True
    test = Path(path)
    if (
        test.parent.as_posix() not in CORE_TEST_DIRECTORIES
        or not test.name.startswith("test_")
        or test.suffix != ".py"
    ):
        return False
    if path.startswith("control/tests/"):
        # The control shards deselect built_image tests. Preserve the image
        # build for changes to those consumers, including newly added tests.
        # Inspect syntax without importing test code or its dependencies. Strings
        # cover marker-expression declarations; attributes cover decorators and
        # module/class markers. Unknown or unavailable source stays conservative.
        try:
            tree = ast.parse((ROOT / path).read_text(encoding="utf-8"))
        except (OSError, UnicodeError, SyntaxError):
            return False
        for node in ast.walk(tree):
            if isinstance(node, ast.Attribute) and node.attr == "built_image":
                return False
            if (
                isinstance(node, ast.Constant)
                and isinstance(node.value, str)
                and re.search(r"\bbuilt_image\b", node.value)
            ):
                return False
    return True


def _lane_input(path: str) -> bool:
    return select([path], "pull_request")["nas_install"]


def lane_selected(paths: Iterable[str], event: str) -> bool:
    """An integration PR accepts its own candidate when it changes what ships."""
    changed = [path.strip().removeprefix("./") for path in paths if path.strip()]
    if event not in DIFF_EVENTS:
        return False
    return not changed or any(_lane_input(path) for path in changed)


# The upgrade carry proves that a workload keeps serving while the Controller
# is redeployed and the agent is upgraded to the candidate. Main's release
# carries every merge before anything is published. A pull request carries
# its own candidate only when it changes what the upgrade itself is made of:
# the agent, its packaging and installers, the deployment, the protocol
# between Controller and agent, and the scripts, actions and workflows that
# assemble and accept a candidate. Controller, web, test, tooling and
# documentation changes get the clean NAS and Spark exercises on the pull
# request and the carry on main. An unfamiliar path carries, like any other
# unknown input.
CARRY_INPUTS = (
    "rust/",
    "packaging/",
    "install/",
    "deploy/",
    "inventory/",
    "nas_setup/",
    "agent_protocol/",
    "schemas/",
    "scripts/",
    ".github/actions/",
    ".github/workflows/installer-",
    ".github/workflows/release-",
    ".github/workflows/spark-upgrade-acceptance.yml",
)
CARRY_EXEMPT = (
    "control/",
    "tools/",
    "tests/",
    "docs/",
    ".github/ISSUE_TEMPLATE/",
    ".github/workflows/ci.yml",
    ".github/workflows/ci-image-mirror.yml",
    ".github/workflows/dev-images.yml",
)


def carry_selected(paths: Iterable[str], event: str) -> bool:
    """Whether this run's candidate acceptance includes the upgrade carry."""
    changed = [path.strip().removeprefix("./") for path in paths if path.strip()]
    if event not in DIFF_EVENTS or not changed:
        return True
    for path in changed:
        if path.startswith(CARRY_INPUTS):
            return True
        top_level_prose = "/" not in path and path.endswith((".md", ".mdx"))
        if not (path.startswith(CARRY_EXEMPT) or top_level_prose):
            return True
    return False


# Always-on suites retain their output names for the aggregate gate and timing
# cache. These are not ownership switches: no PR can deselect them.
FAST_AREAS = ("rust", "repository", "control", "web", "generated")

# Conservative transitive dependency closure, rather than directory ownership:
# - Compose starts control/src, consumes agent_protocol, packages src and the
#   inventory wheels, and runs deploy/compose/tests with shared tests/helpers.
# - NAS installs that Compose graph plus install/, the Python helper and packaging.
# - Agent lifecycle consumes Rust, packaging, protocol, Controller wire peers,
#   shared Python fixtures, and build/materialization scripts.
# Controller PostgreSQL and cross-language/Rust platform checks run every PR:
# their fixture and generated-contract dependencies cross all these boundaries.
# Executable/build inputs remain conservative. Ordinary core test modules and
# known prose are exempt; an unfamiliar path runs every integration.
INTEGRATION_INPUTS = (
    "nas_setup/",
    "control/",
    "agent_protocol/",
    "src/",
    "deploy/",
    "rust/",
    "packaging/",
    "install/",
    "inventory/",
    "scripts/",
    "tests/",
    "tools/",
    "schemas/",
    ".github/",
)


def select(paths: Iterable[str], event: str) -> dict[str, bool]:
    changed = tuple(
        sorted({path.strip().removeprefix("./") for path in paths if path.strip()})
    )
    if event not in DIFF_EVENTS or not changed:
        return {area: True for area in AREAS}
    selected = {area: area in FAST_AREAS for area in AREAS}
    for path in changed:
        if _core_test_input(path):
            continue
        # README prose inside an executable dependency tree is conservative too.
        documentation = path.startswith(("docs/", ".github/ISSUE_TEMPLATE/")) or (
            "/" not in path and path.endswith((".md", ".mdx"))
        )
        if path.startswith(INTEGRATION_INPUTS) or not documentation:
            return {area: True for area in AREAS}
    return selected


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--event", required=True)
    parser.add_argument("--github-output", action="store_true")
    arguments = parser.parse_args()
    changed = sys.stdin.read().splitlines()
    selected = select(changed, arguments.event)
    lane = lane_selected(changed, arguments.event)
    carry = carry_selected(changed, arguments.event)
    if arguments.github_output:
        for area in AREAS:
            print(f"{area}={str(selected[area]).lower()}")
        print("guards=true")
        print(f"lane={str(lane).lower()}")
        print(f"upgrade_carry={str(carry).lower()}")
        print(f"any={str(any(selected.values())).lower()}")
    else:
        print(
            json.dumps(
                {**selected, "guards": True, "lane": lane, "upgrade_carry": carry},
                sort_keys=True,
                separators=(",", ":"),
            )
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
