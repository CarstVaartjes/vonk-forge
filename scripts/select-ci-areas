#!/usr/bin/env python3
"""Select CI integrations from conservative transitive dependencies."""

from __future__ import annotations

import argparse
import ast
import json
import re
import sys
from collections.abc import Iterable
from pathlib import Path

AREAS = (
    "rust",
    "repository",
    "control",
    "web",
    "compose",
    "generated",
    "nas_install",
    "agent_package",
)


# Events whose changed paths are known: a pull request diff, or a merge-queue
# commit compared with the queue's base commit. Anything else runs everything.
DIFF_EVENTS = ("pull_request", "merge_group")


def _matches(path: str, prefixes: tuple[str, ...], exact: tuple[str, ...] = ()) -> bool:
    return path in exact or path.startswith(prefixes)


# Ordinary pytest modules execute in the complete core suites. They neither
# ship in the images nor run in the installed-system acceptance programs.
# Limit exemptions to reviewed test directories; shared helpers, conftest,
# fixtures, Compose tests and native/acceptance programs stay conservative.
CORE_TEST_DIRECTORIES = frozenset(
    {
        "tests",
        "tests/scripts",
        "tests/control",
        "tests/cluster_profiles",
        "tests/install",
        "tests/nas_setup",
        "control/tests",
        "control/tests/security",
    }
)
# Audited helper used only by control/tests/test_catalog_dry_run.py. New test
# helpers require a dependency review rather than a blanket directory exemption.
CORE_TEST_HELPERS = frozenset({"control/tests/catalog_dry_run.py"})
ROOT = Path(__file__).resolve().parents[1]


def _core_test_input(path: str) -> bool:
    if path in CORE_TEST_HELPERS:
        return True
    test = Path(path)
    if (
        test.parent.as_posix() not in CORE_TEST_DIRECTORIES
        or not test.name.startswith("test_")
        or test.suffix != ".py"
    ):
        return False
    if path.startswith("control/tests/"):
        # The control shards deselect built_image tests. Preserve the image
        # build for changes to those consumers, including newly added tests.
        # Inspect syntax without importing test code or its dependencies. Strings
        # cover marker-expression declarations; attributes cover decorators and
        # module/class markers. Unknown or unavailable source stays conservative.
        try:
            tree = ast.parse((ROOT / path).read_text(encoding="utf-8"))
        except (OSError, UnicodeError, SyntaxError):
            return False
        for node in ast.walk(tree):
            if isinstance(node, ast.Attribute) and node.attr == "built_image":
                return False
            if (
                isinstance(node, ast.Constant)
                and isinstance(node.value, str)
                and re.search(r"\bbuilt_image\b", node.value)
            ):
                return False
    return True


# The upgrade carry proves that a workload keeps serving while the Controller
# is redeployed and the agent is upgraded to the candidate. Main's release
# carries every merge before anything is published. A pull request carries
# its own candidate only when it changes what the upgrade itself is made of:
# the agent, its packaging and installers, the deployment, the protocol
# between Controller and agent, and the scripts, actions and workflows that
# assemble and accept a candidate. Controller, web, test, tooling and
# documentation changes leave all acceptance to an integration PR or to main's
# release. An unfamiliar path carries, like any other unknown input.
CARRY_INPUTS = (
    "rust/",
    "packaging/",
    "install/",
    "deploy/",
    "inventory/",
    "nas_setup/",
    "agent_protocol/",
    "schemas/",
    "scripts/",
    ".github/actions/",
    ".github/workflows/installer-",
    ".github/workflows/release-",
    ".github/workflows/spark-upgrade-acceptance.yml",
)
CARRY_EXEMPT = (
    "control/",
    "tools/",
    "tests/",
    "docs/",
    ".github/ISSUE_TEMPLATE/",
    ".github/workflows/ci.yml",
    ".github/workflows/ci-image-mirror.yml",
    ".github/workflows/dev-images.yml",
)


def carry_selected(paths: Iterable[str], event: str) -> bool:
    """Whether this run's candidate acceptance includes the upgrade carry."""
    changed = [path.strip().removeprefix("./") for path in paths if path.strip()]
    if event not in DIFF_EVENTS or not changed:
        return True
    for path in changed:
        if path.startswith(CARRY_INPUTS):
            return True
        top_level_prose = "/" not in path and path.endswith((".md", ".mdx"))
        if not (path.startswith(CARRY_EXEMPT) or top_level_prose):
            return True
    return False


# Candidate acceptance by paths: a change to what the upgrade is made of
# (CARRY_INPUTS) or to the acceptance programs themselves. ci.yml accepts on a
# full pull request (an integration PR, see `full_suites`) regardless of paths,
# never on a member pull request, and by these paths on a merge-queue commit.
# Release accepts every merge: its Spark and refresh steps run when the tested
# PR holds no candidate evidence (release-acceptance-core.yml).
# The canary fixture feeds the Spark lane and the carry, so it accepts too.
LANE_INPUTS = ("tests/acceptance/", "tests/fixtures/canonical-synthetic-canary/")


def lane_selected(paths: Iterable[str], event: str) -> bool:
    """Whether this pull request accepts its own candidate by its paths."""
    changed = [path.strip().removeprefix("./") for path in paths if path.strip()]
    if event not in DIFF_EVENTS:
        return False
    return carry_selected(changed, event) or any(
        path.startswith(LANE_INPUTS) for path in changed
    )


# Suites no path can deselect; they retain their output names for the
# aggregate gate and timing cache. Whether they run at all is `full`'s choice.
FAST_AREAS = ("rust", "repository", "control", "web", "generated")

# Conservative transitive dependency closure, rather than directory ownership:
# - Compose starts control/src, consumes agent_protocol, packages src and the
#   inventory wheels, and runs deploy/compose/tests with shared tests/helpers.
# - NAS installs that Compose graph plus install/, the Python helper and packaging.
# - Agent lifecycle consumes Rust, packaging, protocol, Controller wire peers,
#   shared Python fixtures, and build/materialization scripts.
# Controller PostgreSQL and cross-language/Rust platform checks run on every
# full run: their fixture and generated-contract dependencies cross all these
# boundaries.
# Executable/build inputs remain conservative. Ordinary core test modules and
# known prose are exempt; an unfamiliar path runs every integration.
INTEGRATION_INPUTS = (
    "nas_setup/",
    "control/",
    "agent_protocol/",
    "src/",
    "deploy/",
    "rust/",
    "packaging/",
    "install/",
    "inventory/",
    "scripts/",
    "tests/",
    "tools/",
    "schemas/",
    ".github/",
)


def select(paths: Iterable[str], event: str) -> dict[str, bool]:
    changed = tuple(
        sorted({path.strip().removeprefix("./") for path in paths if path.strip()})
    )
    if event not in DIFF_EVENTS or not changed:
        return {area: True for area in AREAS}
    selected = {area: area in FAST_AREAS for area in AREAS}
    for path in changed:
        if _core_test_input(path):
            continue
        # README prose inside an executable dependency tree is conservative too.
        documentation = path.startswith(("docs/", ".github/ISSUE_TEMPLATE/")) or (
            "/" not in path and path.endswith((".md", ".mdx"))
        )
        if path.startswith(INTEGRATION_INPUTS) or not documentation:
            return {area: True for area in AREAS}
    return selected


# Every change lands through an integration pull request (head branch
# integration/*, labelled release-acceptance), which runs every suite and proof
# once for its whole batch. A member pull request runs only the fast, decisive
# checks. This is the one owner of that rule: ci.yml and the separate proof
# workflows (through ci-scope.yml) read its `full` output. Anything that is not
# positively a member pull request (integration PR, merge queue, main's release,
# a dispatch, an unknown payload) runs everything.
INTEGRATION_HEAD = "integration/"
ACCEPTANCE_LABEL = "release-acceptance"


def full_suites(event: str, payload: dict | None) -> bool:
    """Whether this run carries every suite rather than the member tier."""
    pull = (payload or {}).get("pull_request")
    if event != "pull_request" or not isinstance(pull, dict):
        return True
    labels = {label.get("name") for label in pull.get("labels") or ()}
    head_repository = (pull["head"].get("repo") or {}).get("full_name")
    same_repository = head_repository == pull["base"]["repo"]["full_name"]
    return ACCEPTANCE_LABEL in labels or (
        same_repository and pull["head"]["ref"].startswith(INTEGRATION_HEAD)
    )


# A member pull request builds and tests Rust only when it changes the Rust
# workspace or a file the Rust build or tests read from outside it: the
# build.rs rerun inputs and the include_str!/fixture paths. The one exception
# is build.rs's whole `control/src` input, which almost every PR touches; its
# Rust effect is proven by the integration pull request.
RUST_INPUTS = (
    "rust/",
    ".cargo/",
    "agent_protocol/",
    "scripts/export-agent-wire-schema",
    "scripts/generate-agent-wire",
)
RUST_FILES = (
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "control/uv.lock",
    "scripts/check_environment.py",
    "src/cluster_profiles/__init__.py",
    "src/cluster_profiles/control_limits.py",
    "src/cluster_profiles/runtime_identity.py",
    "control/src/vonk_control/resources/site-ports.json",
    "control/tests/fixtures/compiled_workload_v2.json",
    "tests/acceptance/fixtures/nvidia-smi.sh",
    "control/tests/fixtures/compiled_plan_751.json",
    "control/tests/fixtures/stored_installation_33dc45f0.json",
    "install/installer-release-public.pem",
)


def rust_sources_changed(paths: Iterable[str]) -> bool:
    return any(
        _matches(path.strip().removeprefix("./"), RUST_INPUTS, RUST_FILES)
        for path in paths
    )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--event", required=True)
    parser.add_argument(
        "--event-payload",
        type=Path,
        help="the GitHub event payload (GITHUB_EVENT_PATH); decides `full`",
    )
    parser.add_argument("--github-output", action="store_true")
    arguments = parser.parse_args()
    changed = sys.stdin.read().splitlines()
    payload = (
        json.loads(arguments.event_payload.read_text())
        if arguments.event_payload
        else None
    )
    selected = select(changed, arguments.event)
    full = full_suites(arguments.event, payload)
    # A full pull request (an integration PR) accepts its candidate with the
    # carry regardless of paths; a member pull request accepts nothing.
    full_pull_request = full and arguments.event == "pull_request"
    upgrade_inputs = carry_selected(changed, arguments.event)
    lane = full and (full_pull_request or lane_selected(changed, arguments.event))
    carry = full_pull_request or upgrade_inputs
    rust_sources = rust_sources_changed(changed)
    if arguments.github_output:
        for area in AREAS:
            print(f"{area}={str(selected[area]).lower()}")
        print("guards=true")
        print(f"lane={str(lane).lower()}")
        print(f"upgrade_carry={str(carry).lower()}")
        print(f"upgrade_inputs={str(upgrade_inputs).lower()}")
        print(f"full={str(full).lower()}")
        print(f"rust_sources={str(rust_sources).lower()}")
        print(f"any={str(any(selected.values())).lower()}")
    else:
        print(
            json.dumps(
                {
                    **selected,
                    "guards": True,
                    "lane": lane,
                    "upgrade_carry": carry,
                    "upgrade_inputs": upgrade_inputs,
                    "full": full,
                    "rust_sources": rust_sources,
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
