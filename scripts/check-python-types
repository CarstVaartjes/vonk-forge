#!/usr/bin/env -S uv run --project control --no-sync --offline python
"""Observe Pyright diagnostics against typed, descriptive reviewed allowances.

A complete checker reply is required before source errors are evaluated.
Unavailable processes and malformed nested replies receive one re-observation.
Stale allowances and missing descriptive notes cannot refuse clean source.
The explicit update action preserves known notes and publishes current counts.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # checks never create authored-tree cache files
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from control.tests.registry_storage import observe_registry, write_registry
from tools.checker_contracts import (
    CheckerBaseline,
    CheckerException,
    CheckerFinding,
    CheckerReport,
)

BASELINE = ROOT / "tools/pyright-baseline"
TYPECHECK_TIMEOUT_SECONDS = 600
SELECTED_TYPECHECK_TIMEOUT_SECONDS = 8
CHECKER_CLEANUP_SECONDS = 2


def _run_checker(
    command: list[str], *, env: dict[str, str], timeout: float
) -> subprocess.CompletedProcess[str]:
    # Pyright launches Node. Killing only its Python wrapper leaves Node and
    # inherited output pipes behind, so observation owns the entire process group.
    with subprocess.Popen(
        command,
        cwd=ROOT,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    ) as process:
        try:
            stdout, stderr = process.communicate(timeout=timeout)
        except BaseException:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.communicate(timeout=CHECKER_CLEANUP_SECONDS)
            raise
        return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


def _diagnostics(files: list[str] | None = None) -> list[CheckerFinding]:
    # The complete process/reply/path observation has two attempts. No partial
    # reply can become a clean result and no failure survives a fresh invocation.
    cause: Exception | None = None
    for attempt in range(2):
        try:
            completed = _run_checker(
                [
                    sys.executable,
                    "-m",
                    "pyright",
                    "--outputjson",
                    "--pythonpath",
                    sys.executable,
                    *[str((ROOT / file).resolve()) for file in files or []],
                ],
                env={**os.environ, "PYRIGHT_PYTHON_IGNORE_WARNINGS": "1"},
                timeout=(
                    SELECTED_TYPECHECK_TIMEOUT_SECONDS
                    if files
                    else TYPECHECK_TIMEOUT_SECONDS
                ),
            )
            if completed.returncode not in (0, 1):
                raise subprocess.CalledProcessError(
                    completed.returncode,
                    [sys.executable, "-m", "pyright"],
                    output=completed.stdout,
                    stderr=completed.stderr,
                )
            report = CheckerReport.model_validate_json(completed.stdout)
            findings = []
            for diagnostic in report.generalDiagnostics:
                # Validate paths for all diagnostics, including warnings: a
                # malformed peer reply is not evidence of an error-free check.
                file = Path(diagnostic.file).resolve().relative_to(ROOT).as_posix()
                if diagnostic.severity == "error":
                    findings.append(
                        CheckerFinding(
                            file=file,
                            rule=diagnostic.rule or "unknown",
                            message=diagnostic.message,
                            line=diagnostic.range.start.line + 1,
                            column=diagnostic.range.start.character + 1,
                        )
                    )
            if (completed.returncode == 1) != bool(findings):
                raise ValueError("checker exit status disagrees with its report")
            return findings
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            cause = error
            if attempt == 0:
                continue
    raise SystemExit(f"type-check observation unavailable after two attempts: {cause}")


def _counts(diagnostics: list[CheckerFinding]) -> dict[tuple[str, str], int]:
    counts: dict[tuple[str, str], int] = {}
    for diagnostic in diagnostics:
        key = (diagnostic.file, diagnostic.rule)
        counts[key] = counts.get(key, 0) + 1
    return counts


def _load(path: Path) -> list[CheckerException]:
    return observe_registry(path, _validate_baseline)


def _validate_baseline(document: dict, path: Path) -> list[CheckerException]:
    return CheckerBaseline.model_validate_json(json.dumps(document)).exceptions


def evaluate(
    counts: dict[tuple[str, str], int], exceptions: list[CheckerException]
) -> list[str]:
    """Use observed checker errors; stale descriptive allowances do not refuse."""
    reviewed = {(entry.file, entry.rule): entry.count for entry in exceptions}
    problems = []
    for (file, rule), actual in sorted(counts.items()):
        expected = reviewed.get((file, rule), 0)
        if actual > expected:
            if expected:
                problems.append(
                    f"type errors increased: {file} {rule}: {expected} -> {actual}"
                )
            else:
                problems.append(f"unlisted type error: {file} {rule} ({actual})")
    return problems


def _write(
    counts: dict[tuple[str, str], int], previous: list[CheckerException]
) -> None:
    reasons = {(entry.file, entry.rule): entry.reason for entry in previous}
    document = CheckerBaseline(
        schema_version=1,
        exceptions=[
            CheckerException(
                file=file, rule=rule, count=count, reason=reasons.get((file, rule), "")
            )
            for (file, rule), count in sorted(counts.items())
        ],
    )
    write_registry(BASELINE, document.model_dump(mode="json"))
    missing = sorted(
        f"{entry.file} {entry.rule}"
        for entry in document.exceptions
        if not entry.reason
    )
    print(
        f"baseline updated: {sum(counts.values())} error(s) in {len(counts)} entry(s)"
    )
    if missing:
        print("entries without descriptive notes:", file=sys.stderr)
        for entry in missing:
            print(f"  {entry}", file=sys.stderr)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--update", action="store_true", help="rewrite the baseline")
    parser.add_argument(
        "files", nargs="*", help="check only these files (default: full repository)"
    )
    args = parser.parse_args()
    if args.update and args.files:
        parser.error("--update requires a full repository check")

    diagnostics = _diagnostics(args.files)
    selected = {
        (ROOT / file).resolve().relative_to(ROOT).as_posix() for file in args.files
    }
    if selected:
        diagnostics = [item for item in diagnostics if item.file in selected]
    counts = _counts(diagnostics)
    if args.update:
        _write(counts, _load(BASELINE))
        return 0

    exceptions = _load(BASELINE)
    if selected:
        exceptions = [entry for entry in exceptions if entry.file in selected]
    problems = evaluate(counts, exceptions)
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        reviewed = {(entry.file, entry.rule): entry.count for entry in exceptions}
        for diagnostic in diagnostics:
            key = (diagnostic.file, diagnostic.rule)
            if counts[key] != reviewed.get(key):
                print(
                    f"{diagnostic.file}:{diagnostic.line}:{diagnostic.column}: "
                    f"{diagnostic.rule}: {diagnostic.message}",
                    file=sys.stderr,
                )
        print(
            f"\n{len(problems)} problem(s); {sum(counts.values())} current type "
            f"error(s)",
            file=sys.stderr,
        )
        return 1
    print(
        f"python types: {sum(counts.values())} reviewed exception(s), "
        "no unlisted errors"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
