#!/usr/bin/python3
"""Build a deterministic, signed Vonk Forge agent Debian package."""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "vonk-forge-agent"
BINARIES = ("vonk-agent", "vonk-agent-helper", "oras")
EGRESS_BINARY = "vonk-build-egress"
ORAS_VERSION = "1.3.2"
ARCHITECTURES = {
    "linux-arm64": {
        "debian": "arm64",
        "machine": 183,
        "target": "aarch64-unknown-linux-gnu",
    },
    "linux-amd64": {
        "debian": "amd64",
        "machine": 62,
        "target": "x86_64-unknown-linux-gnu",
    },
}
SEMVER = r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"
PACKAGE_VERSION = re.compile(
    rf"(?:{SEMVER}|{SEMVER}\+lifecycle\.1|"
    rf"{SEMVER}~dev\.(?:0|[1-9][0-9]*)\+g[0-9a-f]{{12}})\Z"
)
DEVELOPMENT_VERSION = re.compile(
    rf"{SEMVER}~dev\.((?:0|[1-9][0-9]*))\+g[0-9a-f]{{12}}\Z"
)
REPAIR_VERSION = re.compile(
    rf"(?P<source>{SEMVER}~dev\.(?:0|[1-9][0-9]*)\+g[0-9a-f]{{12}})"
    rf"\+repair\.spk(?P<node>[0-9a-f]{{32}})\."
    rf"(?P<sequence>[1-9][0-9]*)\Z"
)
ACCEPTANCE_BASELINE_VERSION = re.compile(rf"{SEMVER}~acceptance\.1\+g[0-9a-f]{{12}}\Z")
BUILD_DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")
MAX_EPOCH = 4_102_444_800
MAX_BINARY_BYTES = 512 * 1024 * 1024
ARTIFACT_DOMAIN = b"VONK-HOST-ARTIFACT-V1\x00agent\x00"
PACKAGE_DOMAIN = b"VONK-HOST-ARTIFACT-V1\x00deb\x00"
ED25519_SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")
REPAIR_AUTHORITY_FIELDS = (
    "schema_version",
    "node_id",
    "installed_version",
    "installed_agent_sha256",
    "installed_helper_sha256",
    "installed_agent_unit_sha256",
    "installed_helper_unit_sha256",
    "installed_helper_socket_sha256",
    "source_target_version",
    "source_architecture",
    "source_package_sha256",
    "source_agent_sha256",
    "source_helper_sha256",
    "source_runner_sha256",
    "source_unit_sha256",
    "source_agent_gate_sha256",
    "source_socket_dropin_sha256",
    "source_blocker_sha256",
    "source_pending_sha256",
    "repair_probe_sha256",
    "setpriv_sha256",
    "util_linux_version",
)
REPAIR_DISPATCH_MARKER = b"# VONK_REPAIR_DISPATCH_V1\n"
REPAIR_POSTINST_MARKER = b"# VONK_REPAIR_POSTINST_V1\n"


class BuildError(RuntimeError):
    pass


def valid_package_version(version: str) -> bool:
    if PACKAGE_VERSION.fullmatch(version) is None:
        return False
    development = DEVELOPMENT_VERSION.fullmatch(version)
    return development is None or int(development.group(1)) <= MAX_EPOCH


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def run(
    argv: list[str],
    *,
    cwd: Path = ROOT,
    env: dict[str, str] | None = None,
) -> bytes:
    environment = {
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
    }
    if env:
        environment.update(env)
    completed = subprocess.run(
        argv,
        cwd=cwd,
        env=environment,
        capture_output=True,
        timeout=1800,
        check=False,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace").strip()
        raise BuildError(f"command failed: {Path(argv[0]).name}: {detail}")
    return completed.stdout


def source_at_revision(revision: str, relative: str) -> bytes:
    if (
        re.fullmatch(r"[0-9a-f]{40}", revision) is None
        or re.fullmatch(r"[A-Za-z0-9_./-]+", relative) is None
    ):
        raise BuildError("repair source reference is invalid")
    raw = run(
        [
            "/usr/bin/git",
            "-c",
            f"safe.directory={ROOT}",
            "show",
            f"{revision}:{relative}",
        ]
    )
    if not raw:
        raise BuildError("repair source file is empty")
    return raw


def repair_standard_runner(
    binary_source_revision: str, authority: dict[str, str]
) -> bytes:
    source_recovery_unit = source_at_revision(
        binary_source_revision,
        "packaging/systemd/vonk-forge-package-upgrade-recover.service",
    )
    source_agent_gate = source_at_revision(
        binary_source_revision,
        "packaging/systemd/vonk-forge-agent.service.d/20-package-upgrade-recovery.conf",
    )
    source_preinst = source_at_revision(
        binary_source_revision, "packaging/debian/preinst"
    )
    capsule_placeholders = (
        b"@RECOVERY_CAPSULE_UNIT_SHA256@",
        b"@RECOVERY_CAPSULE_UNIT_BASE64@",
        b"@RECOVERY_CAPSULE_GATE_SHA256@",
        b"@RECOVERY_CAPSULE_GATE_BASE64@",
        b"@RECOVERY_CAPSULE_SUPPRESSION_SHA256@",
        b"@RECOVERY_CAPSULE_SUPPRESSION_BASE64@",
    )
    if (
        any(
            source_preinst.count(placeholder) != 1
            for placeholder in capsule_placeholders
        )
        or source_preinst.count(b'intent_text="schema_version=2\n') != 1
        or source_preinst.count(b'capsule_manifest_text="schema_version=2\n') != 1
        or source_preinst.count(
            b'[ "$(/usr/bin/wc -l < "$intent")" -eq 17 ]'
        )
        != 1
    ):
        raise BuildError("repair source runner does not implement schema-2 recovery")
    source_recovery_capsule_unit = source_at_revision(
        binary_source_revision,
        "packaging/systemd/vonk-forge-package-upgrade-recover-capsule.service",
    )
    source_recovery_capsule_gate = source_at_revision(
        binary_source_revision,
        "packaging/systemd/vonk-forge-agent.service.d/10-package-upgrade-capsule.conf",
    )
    source_recovery_capsule_suppression = source_at_revision(
        binary_source_revision,
        "packaging/systemd/vonk-forge-package-upgrade-recover.service.d/10-capsule-owner.conf",
    )
    capsule_replacements = (
        (
            b"@RECOVERY_CAPSULE_UNIT_SHA256@",
            hashlib.sha256(source_recovery_capsule_unit).hexdigest().encode(),
        ),
        (
            b"@RECOVERY_CAPSULE_UNIT_BASE64@",
            base64.b64encode(source_recovery_capsule_unit),
        ),
        (
            b"@RECOVERY_CAPSULE_GATE_SHA256@",
            hashlib.sha256(source_recovery_capsule_gate).hexdigest().encode(),
        ),
        (
            b"@RECOVERY_CAPSULE_GATE_BASE64@",
            base64.b64encode(source_recovery_capsule_gate),
        ),
        (
            b"@RECOVERY_CAPSULE_SUPPRESSION_SHA256@",
            hashlib.sha256(source_recovery_capsule_suppression).hexdigest().encode(),
        ),
        (
            b"@RECOVERY_CAPSULE_SUPPRESSION_BASE64@",
            base64.b64encode(source_recovery_capsule_suppression),
        ),
    )
    runner = (
        source_preinst.replace(
            b"@VERSION@", authority["source_target_version"].encode()
        )
        .replace(b"@ARCHITECTURE@", authority["source_architecture"].encode())
        .replace(b"@AGENT_SHA256@", authority["source_agent_sha256"].encode())
        .replace(b"@HELPER_SHA256@", authority["source_helper_sha256"].encode())
        .replace(
            b"@RECOVERY_UNIT_SHA256@",
            hashlib.sha256(source_recovery_unit).hexdigest().encode(),
        )
        .replace(b"@RECOVERY_UNIT_BASE64@", base64.b64encode(source_recovery_unit))
        .replace(
            b"@AGENT_GATE_SHA256@",
            hashlib.sha256(source_agent_gate).hexdigest().encode(),
        )
        .replace(b"@AGENT_GATE_BASE64@", base64.b64encode(source_agent_gate))
    )
    for placeholder, value in capsule_replacements:
        runner = runner.replace(
            placeholder,
            value,
        )
    if (
        hashlib.sha256(source_recovery_unit).hexdigest()
        != authority["source_unit_sha256"]
        or hashlib.sha256(source_agent_gate).hexdigest()
        != authority["source_agent_gate_sha256"]
        or hashlib.sha256(runner).hexdigest() != authority["source_runner_sha256"]
        or re.search(rb"@[A-Z0-9_]+@", runner) is not None
    ):
        raise BuildError("repair source runner does not match authority")
    return runner


def cargo_semantic_version() -> str:
    document = tomllib.loads(source("Cargo.toml").decode("utf-8"))
    try:
        version = document["workspace"]["package"]["version"]
    except (KeyError, TypeError) as error:
        raise BuildError("Cargo semantic version is invalid") from error
    if not isinstance(version, str) or re.fullmatch(SEMVER, version) is None:
        raise BuildError("Cargo semantic version is invalid")
    return version


def package_semantic_version(version: str) -> str:
    match = re.match(SEMVER, version)
    if match is None:
        raise BuildError("version is not canonical package version")
    return match.group(0)


def read_release_binary(
    path: Path,
    *,
    machine: int,
    build_digest: str | None = None,
    semantic_version: str | None = None,
    require_static: bool = False,
) -> bytes:
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as error:
        raise BuildError(f"unsafe release binary: {path}") from error
    with os.fdopen(descriptor, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(metadata.st_mode)
            or not 64 <= metadata.st_size <= MAX_BINARY_BYTES
            or metadata.st_mode & 0o022
        ):
            raise BuildError(f"unsafe release binary: {path}")
        before = (
            metadata.st_dev,
            metadata.st_ino,
            metadata.st_nlink,
            metadata.st_size,
            metadata.st_mtime_ns,
            metadata.st_ctime_ns,
        )
        raw = stream.read(MAX_BINARY_BYTES + 1)
        after_metadata = os.fstat(stream.fileno())
        after = (
            after_metadata.st_dev,
            after_metadata.st_ino,
            after_metadata.st_nlink,
            after_metadata.st_size,
            after_metadata.st_mtime_ns,
            after_metadata.st_ctime_ns,
        )
    if before != after or len(raw) != metadata.st_size:
        raise BuildError(f"release binary changed while read: {path}")
    if (
        raw[:7] != b"\x7fELF\x02\x01\x01"
        or struct.unpack_from("<H", raw, 18)[0] != machine
    ):
        raise BuildError(f"release binary architecture is invalid: {path.name}")
    if require_static:
        program_offset = struct.unpack_from("<Q", raw, 32)[0]
        program_size = struct.unpack_from("<H", raw, 54)[0]
        program_count = struct.unpack_from("<H", raw, 56)[0]
        if (
            program_size < 56
            or program_count < 1
            or program_offset + program_size * program_count > len(raw)
            or any(
                struct.unpack_from("<I", raw, program_offset + index * program_size)[0]
                == 3
                for index in range(program_count)
            )
        ):
            raise BuildError(f"release binary is not static: {path.name}")
    if build_digest is not None:
        marker = f"VONK_AGENT_BUILD_DIGEST={build_digest}".encode()
        if marker not in raw:
            raise BuildError("agent embedded build digest does not match package build")
    if semantic_version is not None:
        marker = f"VONK_AGENT_SEMANTIC_VERSION={semantic_version}".encode()
        if marker not in raw:
            raise BuildError("agent embedded semantic version does not match package")
    return raw


def read_release_data(path: Path, maximum_bytes: int) -> bytes:
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as error:
        raise BuildError(f"unsafe release data: {path}") from error
    with os.fdopen(descriptor, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(metadata.st_mode)
            or not 1 <= metadata.st_size <= maximum_bytes
            or metadata.st_mode & 0o022
        ):
            raise BuildError(f"unsafe release data: {path}")
        before = (
            metadata.st_dev,
            metadata.st_ino,
            metadata.st_size,
            metadata.st_mtime_ns,
            metadata.st_ctime_ns,
        )
        raw = stream.read(maximum_bytes + 1)
        after_metadata = os.fstat(stream.fileno())
        after = (
            after_metadata.st_dev,
            after_metadata.st_ino,
            after_metadata.st_size,
            after_metadata.st_mtime_ns,
            after_metadata.st_ctime_ns,
        )
    if before != after or len(raw) != metadata.st_size:
        raise BuildError(f"release data changed while read: {path}")
    return raw


def read_repair_authority(
    path: Path | None,
    *,
    architecture: str,
    target_version: str,
) -> bytes | None:
    if path is None:
        return None
    raw = read_release_data(path, 16 * 1024)
    try:
        text = raw.decode("ascii")
        lines = text.splitlines(keepends=True)
        names = tuple(line.split("=", 1)[0] for line in text.splitlines())
        document = dict(line[:-1].split("=", 1) for line in lines)
    except (UnicodeDecodeError, ValueError) as error:
        raise BuildError("repair authority is invalid") from error
    digest_fields = {
        field for field in REPAIR_AUTHORITY_FIELDS if field.endswith("_sha256")
    }
    if (
        not raw.endswith(b"\n")
        or len(lines) != len(REPAIR_AUTHORITY_FIELDS)
        or names != REPAIR_AUTHORITY_FIELDS
        or len(document) != len(REPAIR_AUTHORITY_FIELDS)
        or document.get("schema_version") != "2"
        or re.fullmatch(r"spk_[0-9a-f]{32}", document.get("node_id", "")) is None
        or PACKAGE_VERSION.fullmatch(document.get("installed_version", "")) is None
        or PACKAGE_VERSION.fullmatch(document.get("source_target_version", "")) is None
        or document.get("source_architecture")
        != str(ARCHITECTURES[architecture]["debian"])
        or any(
            re.fullmatch(r"[0-9a-f]{64}", document.get(field, "")) is None
            for field in digest_fields
        )
        or re.fullmatch(r"[0-9A-Za-z.+~:-]+", document.get("util_linux_version", ""))
        is None
    ):
        raise BuildError("repair authority is invalid")
    for older, newer, message in (
        (
            document["installed_version"],
            document["source_target_version"],
            "repair authority source target must be newer than installed version",
        ),
        (
            document["source_target_version"],
            target_version,
            "repair capsule target must be newer than source target",
        ),
    ):
        if (
            subprocess.run(
                ["/usr/bin/dpkg", "--compare-versions", older, "lt", newer],
                check=False,
            ).returncode
            != 0
        ):
            raise BuildError(message)
    return raw


def compile_binaries(
    epoch: int, architecture: str, build_digest: str, semantic_version: str
) -> Path:
    cargo = shutil.which("cargo")
    if cargo is None:
        raise BuildError("cargo is unavailable")
    environment = {
        "CARGO_INCREMENTAL": "0",
        "SOURCE_DATE_EPOCH": str(epoch),
        "VONK_AGENT_BUILD_DIGEST": build_digest,
        "VONK_AGENT_SEMANTIC_VERSION": semantic_version,
    }
    if architecture == "linux-amd64" and os.uname().machine not in {
        "x86_64",
        "amd64",
    }:
        environment.update(
            {
                "AR_x86_64_unknown_linux_gnu": "x86_64-linux-gnu-ar",
                "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "x86_64-linux-gnu-gcc",
                "CC_x86_64_unknown_linux_gnu": "x86_64-linux-gnu-gcc",
            }
        )
    run(
        [
            cargo,
            "build",
            "--release",
            "--locked",
            "--target",
            str(ARCHITECTURES[architecture]["target"]),
            "--workspace",
        ],
        env=environment,
    )
    static_environment = {
        **environment,
        "RUSTFLAGS": "-C target-feature=+crt-static",
    }
    run(
        [
            cargo,
            "build",
            "--release",
            "--locked",
            "--target",
            str(ARCHITECTURES[architecture]["target"]),
            "--package",
            "vonk-build-egress",
        ],
        env=static_environment,
    )
    return ROOT / "target" / str(ARCHITECTURES[architecture]["target"]) / "release"


def install_file(root: Path, relative: str, raw: bytes, mode: int) -> Path:
    target = root / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(raw)
    target.chmod(mode)
    return target


def source(relative: str) -> bytes:
    path = ROOT / relative
    if not path.is_file() or path.is_symlink():
        raise BuildError(f"required packaging source is unsafe: {relative}")
    return path.read_bytes()


def sign_agent(
    temporary: Path,
    private_key: Path,
    artifact: bytes,
) -> tuple[bytes, bytes]:
    public_der = run(
        [
            "/usr/bin/openssl",
            "pkey",
            "-in",
            str(private_key),
            "-pubout",
            "-outform",
            "DER",
        ],
        cwd=Path("/"),
    )
    if (
        not public_der.startswith(ED25519_SPKI_PREFIX)
        or len(public_der) != len(ED25519_SPKI_PREFIX) + 32
    ):
        raise BuildError("release key is not Ed25519")
    claims = temporary / "artifact.claims"
    claims.write_bytes(ARTIFACT_DOMAIN + hashlib.sha256(artifact).digest())
    signature = run(
        [
            "/usr/bin/openssl",
            "pkeyutl",
            "-sign",
            "-inkey",
            str(private_key),
            "-rawin",
            "-in",
            str(claims),
        ],
        cwd=Path("/"),
    )
    if len(signature) != 64:
        raise BuildError("release signature is invalid")
    return signature.hex().encode() + b"\n", public_der[
        len(ED25519_SPKI_PREFIX) :
    ].hex().encode() + b"\n"


def sign_package(temporary: Path, private_key: Path, digest: str) -> bytes:
    claims = temporary / "package.claims"
    claims.write_bytes(PACKAGE_DOMAIN + bytes.fromhex(digest))
    signature = run(
        [
            "/usr/bin/openssl",
            "pkeyutl",
            "-sign",
            "-inkey",
            str(private_key),
            "-rawin",
            "-in",
            str(claims),
        ],
        cwd=Path("/"),
    )
    if len(signature) != 64:
        raise BuildError("package signature is invalid")
    return signature.hex().encode() + b"\n"


def evidence(
    version: str,
    epoch: int,
    architecture: str,
    build_digest: str,
    binaries: dict[str, bytes],
    repair: dict[str, str] | None = None,
) -> dict[str, bytes]:
    components = [
        {
            "name": name,
            "sha256": hashlib.sha256(raw).hexdigest(),
            "type": "application",
            "version": ORAS_VERSION if name == "oras" else version,
            **(
                {
                    "properties": [
                        {
                            "name": (
                                "vonk:packagingSourceRevision"
                                if name
                                in {
                                    "vonk-forge-docker-firewall",
                                    "vonk-forge-package-upgrade-recover",
                                }
                                else "vonk:binarySourceRevision"
                            ),
                            "value": (
                                repair["packaging_source_revision"]
                                if name
                                in {
                                    "vonk-forge-docker-firewall",
                                    "vonk-forge-package-upgrade-recover",
                                }
                                else repair["binary_source_revision"]
                            ),
                        }
                    ]
                }
                if repair is not None
                else {}
            ),
        }
        for name, raw in sorted(binaries.items())
    ]
    lock = tomllib.loads(source("Cargo.lock").decode("utf-8"))
    crates = [
        {
            "checksum": item.get("checksum"),
            "name": item["name"],
            "source": item.get("source", "workspace"),
            "version": item["version"],
        }
        for item in lock.get("package", [])
    ]
    created = (
        dt.datetime.fromtimestamp(epoch, tz=dt.UTC).isoformat().replace("+00:00", "Z")
    )
    revision = os.environ.get("VONK_SOURCE_REVISION", "unknown")
    repository = os.environ.get(
        "VONK_SOURCE_REPOSITORY", "https://github.com/CarstVaartjes/vonk-forge"
    )
    cyclone_metadata_component: dict[str, object] = {
        "name": PACKAGE,
        "type": "application",
        "version": version,
    }
    if repair is not None:
        cyclone_metadata_component["properties"] = [
            {"name": "vonk:repairAuthoritySha256", "value": repair["authority_sha256"]},
            {"name": "vonk:repairNodeId", "value": repair["node_id"]},
            {
                "name": "vonk:repairPackagingSourceRevision",
                "value": repair["packaging_source_revision"],
            },
        ]
    cyclone = {
        "bomFormat": "CycloneDX",
        "components": [
            {
                "hashes": [{"alg": "SHA-256", "content": item["sha256"]}],
                "name": item["name"],
                "type": item["type"],
                "version": item["version"],
                **({"properties": item["properties"]} if "properties" in item else {}),
            }
            for item in components
        ]
        + [
            {
                "bom-ref": f"pkg:cargo/{item['name']}@{item['version']}",
                "hashes": (
                    [{"alg": "SHA-256", "content": item["checksum"]}]
                    if item["checksum"]
                    else []
                ),
                "name": item["name"],
                "purl": f"pkg:cargo/{item['name']}@{item['version']}",
                "type": "library",
                "version": item["version"],
            }
            for item in crates
        ],
        "metadata": {
            "component": cyclone_metadata_component,
            "timestamp": created,
        },
        "serialNumber": f"urn:uuid:00000000-0000-4000-8000-{hashlib.sha256(version.encode()).hexdigest()[:12]}",
        "specVersion": "1.6",
        "version": 1,
    }
    spdx = {
        "SPDXID": "SPDXRef-DOCUMENT",
        "creationInfo": {"created": created, "creators": ["Organization: Vonk Forge"]},
        "dataLicense": "CC0-1.0",
        "documentNamespace": f"https://vonkforge.ai/sbom/{PACKAGE}/{version}",
        "name": f"{PACKAGE}-{version}",
        "packages": [
            {
                "SPDXID": f"SPDXRef-{item['name']}",
                "checksums": [{"algorithm": "SHA256", "checksumValue": item["sha256"]}],
                "downloadLocation": "NOASSERTION",
                "filesAnalyzed": False,
                "name": item["name"],
                "primaryPackagePurpose": "APPLICATION",
                "versionInfo": item["version"],
                **(
                    {
                        "externalRefs": [
                            {
                                "referenceCategory": "OTHER",
                                "referenceLocator": (
                                    f"{repository}@"
                                    + (
                                        repair["packaging_source_revision"]
                                        if item["name"]
                                        in {
                                            "vonk-forge-docker-firewall",
                                            "vonk-forge-package-upgrade-recover",
                                        }
                                        else repair["binary_source_revision"]
                                    )
                                ),
                                "referenceType": (
                                    "vonk-repair-packaging-source"
                                    if item["name"]
                                    in {
                                        "vonk-forge-docker-firewall",
                                        "vonk-forge-package-upgrade-recover",
                                    }
                                    else "vonk-target-binary-source"
                                ),
                            }
                        ]
                    }
                    if repair is not None
                    else {}
                ),
            }
            for item in components
        ]
        + [
            {
                "SPDXID": "SPDXRef-Crate-"
                + hashlib.sha256(
                    f"{item['name']}@{item['version']}".encode()
                ).hexdigest()[:20],
                "checksums": (
                    [{"algorithm": "SHA256", "checksumValue": item["checksum"]}]
                    if item["checksum"]
                    else []
                ),
                "downloadLocation": item["source"],
                "filesAnalyzed": False,
                "name": item["name"],
                "primaryPackagePurpose": "LIBRARY",
                "versionInfo": item["version"],
            }
            for item in crates
        ],
        "spdxVersion": "SPDX-2.3",
    }
    if repair is not None:
        spdx["documentComment"] = (
            "Vonk repair "
            f"authority_sha256={repair['authority_sha256']} "
            f"node_id={repair['node_id']} "
            f"binary_source_revision={repair['binary_source_revision']} "
            f"packaging_source_revision={repair['packaging_source_revision']}"
        )
    resolved_dependencies = [
        {
            "digest": {"gitCommit": revision},
            "uri": repository,
        }
    ]
    external_parameters: dict[str, object] = {
        "architecture": architecture,
        "build_digest": build_digest,
        "source_date_epoch": epoch,
        "version": version,
    }
    if repair is not None:
        external_parameters["repair"] = {
            "authority_sha256": repair["authority_sha256"],
            "binary_source_revision": repair["binary_source_revision"],
            "node_id": repair["node_id"],
            "packaging_source_revision": repair["packaging_source_revision"],
        }
        resolved_dependencies = [
            {
                "digest": {"gitCommit": repair["packaging_source_revision"]},
                "relationship": "repair-package-source",
                "uri": repository,
            },
            {
                "digest": {"gitCommit": repair["binary_source_revision"]},
                "relationship": "target-binary-source",
                "uri": repository,
            },
        ]
    provenance = {
        "_type": "https://in-toto.io/Statement/v1",
        "predicate": {
            "buildDefinition": {
                "buildType": "https://vonkforge.ai/build-types/rust-deb/v2",
                "externalParameters": external_parameters,
                "resolvedDependencies": resolved_dependencies,
            },
            "runDetails": {"builder": {"id": repository}},
        },
        "predicateType": "https://slsa.dev/provenance/v1",
        "subject": [
            {"digest": {"sha256": item["sha256"]}, "name": item["name"]}
            for item in components
        ],
        "version": version,
    }
    return {
        "sbom.cdx.json": canonical(cyclone),
        "sbom.spdx.json": canonical(spdx),
        "provenance.json": canonical(provenance),
    }


def normalize_tree(root: Path, epoch: int) -> None:
    for path in sorted(root.rglob("*"), key=lambda item: len(item.parts), reverse=True):
        if path.is_dir():
            path.chmod(0o755)
        os.utime(path, (epoch, epoch), follow_symlinks=False)
    root.chmod(0o755)
    os.utime(root, (epoch, epoch))


def atomic_output(path: Path, raw: bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.new")
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC,
        mode,
    )
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)


def build(
    version: str,
    private_key: Path,
    output: Path,
    binaries_dir: Path | None,
    epoch: int,
    architecture: str,
    build_digest: str,
    acceptance_baseline: bool = False,
    repair_authority: Path | None = None,
    repair_probe_binary: Path | None = None,
) -> Path:
    repair_version = REPAIR_VERSION.fullmatch(version)
    if (
        not valid_package_version(version)
        and repair_version is None
        and not (acceptance_baseline and ACCEPTANCE_BASELINE_VERSION.fullmatch(version))
    ):
        raise BuildError("version is not canonical package version")
    cargo_version = cargo_semantic_version()
    semantic_version = package_semantic_version(version)
    semantic_parts = tuple(int(part) for part in semantic_version.split("."))
    cargo_parts = tuple(int(part) for part in cargo_version.split("."))
    if acceptance_baseline and (
        ACCEPTANCE_BASELINE_VERSION.fullmatch(version) is None
        or semantic_parts >= cargo_parts
    ):
        raise BuildError("acceptance baseline must have a lower semantic version")
    if not acceptance_baseline and semantic_version != cargo_version:
        raise BuildError(
            f"package semantic version does not match Cargo semantic version {cargo_version}"
        )
    if architecture not in ARCHITECTURES:
        raise BuildError("package architecture is unsupported")
    if BUILD_DIGEST.fullmatch(build_digest) is None:
        raise BuildError("build digest is invalid")
    if not 0 <= epoch <= MAX_EPOCH:
        raise BuildError("SOURCE_DATE_EPOCH is outside the supported range")
    key_metadata = private_key.lstat()
    if (
        not stat.S_ISREG(key_metadata.st_mode)
        or key_metadata.st_nlink != 1
        or key_metadata.st_mode & 0o077
    ):
        raise BuildError("release private key permissions are unsafe")
    spec = ARCHITECTURES[architecture]
    binary_root = (
        binaries_dir.resolve()
        if binaries_dir
        else compile_binaries(epoch, architecture, build_digest, semantic_version)
    )
    binaries = {
        name: read_release_binary(
            binary_root / name,
            machine=int(spec["machine"]),
            build_digest=build_digest if name == "vonk-agent" else None,
            semantic_version=semantic_version if name == "vonk-agent" else None,
        )
        for name in BINARIES
    }
    oras_license = read_release_data(binary_root / "oras.LICENSE", 1024 * 1024)
    binary_digest = hashlib.sha256(binaries["vonk-agent"]).hexdigest()
    helper_digest = hashlib.sha256(binaries["vonk-agent-helper"]).hexdigest()
    if build_digest == f"sha256:{binary_digest}":
        raise BuildError("build digest must be distinct from binary digest")
    output = output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    debian_architecture = str(spec["debian"])
    repair_authority_raw = read_repair_authority(
        repair_authority,
        architecture=architecture,
        target_version=version,
    )
    if (repair_authority_raw is None) != (repair_probe_binary is None):
        raise BuildError("repair probe binary is required exactly for repair capsules")
    repair_probe = (
        read_release_binary(
            repair_probe_binary,
            machine=int(spec["machine"]),
            build_digest=None,
            semantic_version=None,
        )
        if repair_probe_binary is not None
        else None
    )
    repair_evidence: dict[str, str] | None = None
    if repair_version is not None:
        if repair_authority_raw is None:
            raise BuildError("node-bound repair version requires repair authority")
        repair_document = dict(
            line.split("=", 1)
            for line in repair_authority_raw.decode("ascii").splitlines()
        )
        if (
            repair_version.group("source") != repair_document["source_target_version"]
            or f"spk_{repair_version.group('node')}" != repair_document["node_id"]
            or repair_probe is None
            or hashlib.sha256(repair_probe).hexdigest()
            != repair_document["repair_probe_sha256"]
        ):
            raise BuildError("repair version does not bind repair authority")
        if (
            binary_digest != repair_document["source_agent_sha256"]
            or helper_digest != repair_document["source_helper_sha256"]
        ):
            raise BuildError("repair capsule must reuse exact source target binaries")
        binary_source_revision = os.environ.get(
            "VONK_REPAIR_BINARY_SOURCE_REVISION", ""
        )
        packaging_source_revision = os.environ.get("VONK_SOURCE_REVISION", "")
        source_revision_match = re.search(
            r"\+g([0-9a-f]{12})\Z", repair_version.group("source")
        )
        if (
            re.fullmatch(r"[0-9a-f]{40}", binary_source_revision) is None
            or re.fullmatch(r"[0-9a-f]{40}", packaging_source_revision) is None
            or source_revision_match is None
            or not binary_source_revision.startswith(source_revision_match.group(1))
            or packaging_source_revision == binary_source_revision
        ):
            raise BuildError("repair source revisions are invalid or ambiguous")
        repair_evidence = {
            "authority_sha256": hashlib.sha256(repair_authority_raw).hexdigest(),
            "binary_source_revision": binary_source_revision,
            "node_id": repair_document["node_id"],
            "packaging_source_revision": packaging_source_revision,
        }
    elif repair_authority_raw is not None:
        raise BuildError("repair authority requires node-bound repair version")
    if acceptance_baseline and repair_authority_raw is not None:
        raise BuildError("acceptance baseline cannot be a repair capsule")
    if repair_authority_raw is None:
        binaries[EGRESS_BINARY] = read_release_binary(
            binary_root / EGRESS_BINARY,
            machine=int(spec["machine"]),
            require_static=True,
        )
    package_name = f"{PACKAGE}_{version}_{debian_architecture}.deb"

    with tempfile.TemporaryDirectory(prefix="vonk-agent-deb-") as temporary:
        stage = Path(temporary) / "root"
        stage.mkdir()
        install_file(
            stage,
            "usr/lib/vonk-forge/vonk-agent",
            binaries["vonk-agent"],
            0o555,
        )
        install_file(
            stage,
            "usr/lib/vonk-forge/vonk-agent-helper",
            binaries["vonk-agent-helper"],
            0o555,
        )
        if EGRESS_BINARY in binaries:
            install_file(
                stage,
                "usr/lib/vonk-forge/vonk-build-egress",
                binaries[EGRESS_BINARY],
                0o555,
            )
        install_file(stage, "usr/lib/vonk-forge/oras", binaries["oras"], 0o555)
        install_file(
            stage,
            "usr/share/doc/vonk-forge-agent/oras-LICENSE",
            oras_license,
            0o644,
        )
        artifact_signature, release_public_key = sign_agent(
            Path(temporary), private_key, binaries["vonk-agent"]
        )
        install_file(
            stage,
            "usr/lib/vonk-forge/release/artifact.sig",
            artifact_signature,
            0o644,
        )
        install_file(
            stage,
            "usr/share/keyrings/vonk-forge-release.pub",
            release_public_key,
            0o644,
        )
        install_file(
            stage,
            "etc/vonk-forge-agent/containers-storage.conf",
            source("packaging/config/containers-storage.conf"),
            0o644,
        )
        firewall_helper = source("packaging/bin/vonk-forge-docker-firewall")
        install_file(
            stage,
            "usr/lib/vonk-forge/vonk-forge-docker-firewall",
            firewall_helper,
            0o555,
        )
        recovery_unit = source(
            "packaging/systemd/vonk-forge-package-upgrade-recover.service"
        )
        recovery_unit_digest = hashlib.sha256(recovery_unit).hexdigest()
        recovery_unit_base64 = base64.b64encode(recovery_unit)
        recovery_capsule_unit = source(
            "packaging/systemd/vonk-forge-package-upgrade-recover-capsule.service"
        )
        recovery_capsule_unit_digest = hashlib.sha256(recovery_capsule_unit).hexdigest()
        recovery_capsule_unit_base64 = base64.b64encode(recovery_capsule_unit)
        recovery_capsule_gate = source(
            "packaging/systemd/vonk-forge-agent.service.d/"
            "10-package-upgrade-capsule.conf"
        )
        recovery_capsule_gate_digest = hashlib.sha256(recovery_capsule_gate).hexdigest()
        recovery_capsule_suppression = source(
            "packaging/systemd/vonk-forge-package-upgrade-recover.service.d/"
            "10-capsule-owner.conf"
        )
        recovery_capsule_suppression_digest = hashlib.sha256(
            recovery_capsule_suppression
        ).hexdigest()
        agent_gate = source(
            "packaging/systemd/vonk-forge-agent.service.d/"
            "20-package-upgrade-recovery.conf"
        )
        agent_gate_digest = hashlib.sha256(agent_gate).hexdigest()
        agent_gate_base64 = base64.b64encode(agent_gate)
        preinst = (
            source("packaging/debian/preinst")
            .replace(b"@VERSION@", version.encode())
            .replace(b"@ARCHITECTURE@", debian_architecture.encode())
            .replace(b"@AGENT_SHA256@", binary_digest.encode())
            .replace(b"@HELPER_SHA256@", helper_digest.encode())
            .replace(b"@RECOVERY_UNIT_SHA256@", recovery_unit_digest.encode())
            .replace(b"@RECOVERY_UNIT_BASE64@", recovery_unit_base64)
            .replace(
                b"@RECOVERY_CAPSULE_UNIT_SHA256@",
                recovery_capsule_unit_digest.encode(),
            )
            .replace(b"@RECOVERY_CAPSULE_UNIT_BASE64@", recovery_capsule_unit_base64)
            .replace(
                b"@RECOVERY_CAPSULE_GATE_SHA256@",
                recovery_capsule_gate_digest.encode(),
            )
            .replace(
                b"@RECOVERY_CAPSULE_GATE_BASE64@",
                base64.b64encode(recovery_capsule_gate),
            )
            .replace(
                b"@RECOVERY_CAPSULE_SUPPRESSION_SHA256@",
                recovery_capsule_suppression_digest.encode(),
            )
            .replace(
                b"@RECOVERY_CAPSULE_SUPPRESSION_BASE64@",
                base64.b64encode(recovery_capsule_suppression),
            )
            .replace(b"@AGENT_GATE_SHA256@", agent_gate_digest.encode())
            .replace(b"@AGENT_GATE_BASE64@", agent_gate_base64)
        )
        standard_runner = preinst
        repair_preinst = None
        repair_postinst = None
        if repair_authority_raw is not None:
            source_capsule_unit_digest = hashlib.sha256(
                source_at_revision(
                    binary_source_revision,
                    "packaging/systemd/vonk-forge-package-upgrade-recover-capsule.service",
                )
            ).hexdigest()
            source_capsule_gate_digest = hashlib.sha256(
                source_at_revision(
                    binary_source_revision,
                    "packaging/systemd/vonk-forge-agent.service.d/10-package-upgrade-capsule.conf",
                )
            ).hexdigest()
            source_capsule_suppression_digest = hashlib.sha256(
                source_at_revision(
                    binary_source_revision,
                    "packaging/systemd/vonk-forge-package-upgrade-recover.service.d/10-capsule-owner.conf",
                )
            ).hexdigest()
            standard_runner = repair_standard_runner(
                binary_source_revision, repair_document
            )
            target_agent_unit = source("packaging/systemd/vonk-forge-agent.service")
            target_helper_unit = source(
                "packaging/systemd/vonk-forge-package-helper.service"
            )
            target_helper_socket = source(
                "packaging/systemd/vonk-forge-package-helper.socket"
            )
            repair_preinst = (
                source("packaging/debian/preinst-repair")
                .replace(b"@VERSION@", version.encode())
                .replace(b"@ARCHITECTURE@", debian_architecture.encode())
                .replace(b"@AGENT_SHA256@", binary_digest.encode())
                .replace(b"@HELPER_SHA256@", helper_digest.encode())
                .replace(
                    b"@REPAIR_AUTHORITY_SHA256@",
                    hashlib.sha256(repair_authority_raw).hexdigest().encode(),
                )
                .replace(
                    b"@REPAIR_AUTHORITY_BASE64@",
                    base64.b64encode(repair_authority_raw),
                )
                .replace(
                    b"@STANDARD_RUNNER_SHA256@",
                    hashlib.sha256(standard_runner).hexdigest().encode(),
                )
                .replace(b"@STANDARD_RUNNER_BASE64@", base64.b64encode(standard_runner))
                .replace(
                    b"@TARGET_AGENT_UNIT_SHA256@",
                    hashlib.sha256(target_agent_unit).hexdigest().encode(),
                )
                .replace(
                    b"@TARGET_HELPER_UNIT_SHA256@",
                    hashlib.sha256(target_helper_unit).hexdigest().encode(),
                )
                .replace(
                    b"@TARGET_HELPER_SOCKET_SHA256@",
                    hashlib.sha256(target_helper_socket).hexdigest().encode(),
                )
                .replace(
                    b"@REPAIR_PROBE_SHA256@",
                    hashlib.sha256(repair_probe).hexdigest().encode(),
                )
                .replace(
                    b"@SOURCE_CAPSULE_UNIT_SHA256@",
                    source_capsule_unit_digest.encode(),
                )
                .replace(
                    b"@SOURCE_CAPSULE_GATE_SHA256@",
                    source_capsule_gate_digest.encode(),
                )
                .replace(
                    b"@SOURCE_CAPSULE_SUPPRESSION_SHA256@",
                    source_capsule_suppression_digest.encode(),
                )
            )
            if (
                REPAIR_DISPATCH_MARKER not in repair_preinst
                or re.search(rb"@[A-Z0-9_]+@", repair_preinst) is not None
            ):
                raise BuildError("repair capsule dispatcher is incomplete")
            # A distinct higher repair version cannot use the standard postinst:
            # it must explicitly validate the preserved source intent and repair
            # nonce. Keep repair packaging impossible until that fail-closed
            # postinst exists.
            repair_postinst_source = source("packaging/debian/postinst-repair")
            repair_postinst = repair_postinst_source.replace(
                b"@VERSION@", version.encode()
            ).replace(
                b"@REPAIR_AUTHORITY_SHA256@",
                hashlib.sha256(repair_authority_raw).hexdigest().encode(),
            )
            if (
                REPAIR_POSTINST_MARKER not in repair_postinst
                or re.search(rb"@[A-Z0-9_]+@", repair_postinst) is not None
            ):
                raise BuildError("repair capsule postinst is incomplete")
        install_file(
            stage,
            "usr/lib/vonk-forge/vonk-forge-package-upgrade-recover",
            (
                standard_runner if repair_preinst is not None else preinst
            ),
            0o555,
        )
        if repair_preinst is not None:
            install_file(
                stage,
                "usr/lib/vonk-forge/vonk-forge-package-upgrade-recover.standard",
                standard_runner,
                0o555,
            )
            install_file(
                stage,
                "usr/lib/vonk-forge/repair-authority",
                repair_authority_raw,
                0o644,
            )
        for name in (
            "vonk-forge-agent.service",
            "vonk-forge-docker-firewall.service",
            "vonk-forge-package-helper.service",
            "vonk-forge-package-helper.socket",
            "vonk-forge-package-upgrade-recover.service",
        ):
            install_file(
                stage,
                f"lib/systemd/system/{name}",
                source(f"packaging/systemd/{name}"),
                0o644,
            )
        install_file(
            stage,
            "lib/systemd/system/vonk-forge-agent.service.d/"
            "20-package-upgrade-recovery.conf",
            agent_gate,
            0o644,
        )
        evidence_binaries = {
            **binaries,
            "vonk-forge-docker-firewall": firewall_helper,
            "vonk-forge-package-upgrade-recover": preinst,
        }
        if repair_preinst is not None:
            evidence_binaries["vonk-forge-package-upgrade-recover"] = (
                standard_runner
            )
            evidence_binaries["vonk-forge-package-upgrade-recover.standard"] = (
                standard_runner
            )
        documents = evidence(
            version,
            epoch,
            architecture,
            build_digest,
            evidence_binaries,
            repair_evidence,
        )
        for name, raw in documents.items():
            install_file(stage, f"usr/share/doc/{PACKAGE}/{name}", raw, 0o644)

        control = (
            source("packaging/debian/control")
            .replace(b"@VERSION@", version.encode())
            .replace(b"@ARCHITECTURE@", debian_architecture.encode())
        )
        install_file(stage, "DEBIAN/control", control, 0o644)
        install_file(
            stage, "DEBIAN/conffiles", source("packaging/debian/conffiles"), 0o644
        )
        for name in ("prerm",):
            install_file(
                stage, f"DEBIAN/{name}", source(f"packaging/debian/{name}"), 0o755
            )
        postinst = repair_postinst or source("packaging/debian/postinst").replace(
            b"@VERSION@", version.encode()
        )
        install_file(stage, "DEBIAN/postinst", postinst, 0o755)
        if repair_probe is not None:
            install_file(
                stage,
                "DEBIAN/vonk-repair-helper.probe",
                repair_probe,
                0o755,
            )
        install_file(
            stage,
            "DEBIAN/preinst",
            repair_preinst if repair_preinst is not None else preinst,
            0o755,
        )
        checksum_lines = []
        for path in sorted(item for item in stage.rglob("*") if item.is_file()):
            relative = path.relative_to(stage).as_posix()
            if relative.startswith("DEBIAN/"):
                continue
            digest = hashlib.md5(path.read_bytes(), usedforsecurity=False).hexdigest()
            checksum_lines.append(f"{digest}  {relative}\n")
        install_file(stage, "DEBIAN/md5sums", "".join(checksum_lines).encode(), 0o644)
        normalize_tree(stage, epoch)

        temporary_deb = Path(temporary) / package_name
        run(
            [
                "/usr/bin/dpkg-deb",
                "--build",
                "--root-owner-group",
                "--uniform-compression",
                "-Zxz",
                "-z9",
                str(stage),
                str(temporary_deb),
            ],
            env={"SOURCE_DATE_EPOCH": str(epoch)},
        )
        package = output / package_name
        atomic_output(package, temporary_deb.read_bytes())
        digest = hashlib.sha256(package.read_bytes()).hexdigest()
        atomic_output(
            output / f"{package_name}.sha256", f"{digest}  {package_name}\n".encode()
        )
        atomic_output(
            output / f"{package_name}.host.sig",
            sign_package(Path(temporary), private_key, digest),
        )
        for name, raw in documents.items():
            atomic_output(
                output / f"{PACKAGE}_{version}_{debian_architecture}.{name}", raw
            )
    return package


def main() -> int:
    parser = argparse.ArgumentParser(prog="build-agent-deb")
    parser.add_argument("--version", required=True)
    parser.add_argument("--architecture", choices=sorted(ARCHITECTURES), required=True)
    parser.add_argument("--build-digest", required=True)
    parser.add_argument("--release-private-key", required=True, type=Path)
    parser.add_argument("--output-dir", required=True, type=Path)
    parser.add_argument("--binaries-dir", type=Path)
    parser.add_argument("--acceptance-baseline", action="store_true")
    parser.add_argument("--repair-authority", type=Path)
    parser.add_argument("--repair-probe-binary", type=Path)
    parser.add_argument(
        "--source-date-epoch",
        type=int,
        default=int(os.environ.get("SOURCE_DATE_EPOCH", "0")),
    )
    arguments = parser.parse_args()
    try:
        package = build(
            arguments.version,
            arguments.release_private_key.absolute(),
            arguments.output_dir,
            arguments.binaries_dir,
            arguments.source_date_epoch,
            arguments.architecture,
            arguments.build_digest,
            arguments.acceptance_baseline,
            arguments.repair_authority,
            arguments.repair_probe_binary,
        )
    except (BuildError, OSError, ValueError) as error:
        print(f"build-agent-deb: {error}", file=sys.stderr)
        return 2
    print(package)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
