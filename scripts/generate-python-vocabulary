#!/usr/bin/env python3
"""Generate the standalone Python modules that spell contract words.

The CLI ships without the contract package, and the LiteLLM supervisor loads
``route_activation.py`` with no package around it, so neither can import
``vonk_agent_protocol`` for the closed words they compare.  They import a
generated module instead of keeping a copy: a word changed in the contract
changes here, and ``tests/test_generated_contracts.py`` fails while the
committed files are stale.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

if __name__ == "__main__":
    from check_environment import run_in_control

    run_in_control(ROOT)
sys.path[:0] = [str(ROOT / "agent_protocol/src")]

CLI_WORDS = ROOT / "src/cluster_profiles/cli_states_generated.py"
HOOK_WORDS = ROOT / "scripts/hook_words_generated.py"
ROUTE_WORDS = ROOT / "agent_protocol/src/vonk_agent_protocol/route_activation_words.py"


def cli_words() -> str:
    from vonk_agent_protocol import (
        EndpointState,
        LifecycleState,
        StateAlias,
    )
    from vonk_agent_protocol.lifecycle_vocabulary import ArtifactPreparation

    words = {
        "NEEDS_OPERATOR": LifecycleState.NEEDS_OPERATOR,
        "QUEUED": LifecycleState.QUEUED,
        "RUNNING": LifecycleState.RUNNING,
        "BACKOFF": LifecycleState.BACKOFF,
        "OBSERVING": LifecycleState.OBSERVING,
        "SUCCEEDED": LifecycleState.SUCCEEDED,
        "FAILED": LifecycleState.FAILED,
        "CANCELLED": LifecycleState.CANCELLED,
        "LEGACY_NEEDS_OPERATOR": StateAlias.WAITING_FOR_OPERATOR,
        "LEGACY_CANCELLING": StateAlias.CANCELLING,
        "LEGACY_PARTIAL": StateAlias.PARTIAL,
        "EXPIRED": StateAlias.EXPIRED,
        "DRAFT": ArtifactPreparation.DRAFT,
        "READY": ArtifactPreparation.READY,
        "PUBLISHED": EndpointState.PUBLISHED,
        "ENDPOINT_INSTALLED_ONLY": EndpointState.INSTALLED_ONLY,
        "ENDPOINT_NOT_PUBLISHED_YET": EndpointState.NOT_PUBLISHED_YET,
        "ENDPOINT_EXPIRED": EndpointState.EXPIRED,
        "ENDPOINT_WITHDRAWN": EndpointState.WITHDRAWN,
        "ENDPOINT_UNAVAILABLE": EndpointState.UNAVAILABLE,
    }
    lines = [
        '"""The contract words the CLI compares, generated. Do not edit.',
        "",
        "Generated by scripts/generate-python-vocabulary from",
        "vonk_agent_protocol.lifecycle_vocabulary and state_machines; the CLI ships",
        'without the contract package, so it imports these instead of copying them."""',
        "",
        "from __future__ import annotations",
        "",
    ]
    lines += [f'{name} = "{member.value}"' for name, member in words.items()]
    return "\n".join(lines) + "\n"


def route_words() -> str:
    from vonk_agent_protocol import GatewayRouteState

    states = ", ".join(
        f'"{state.value}"'
        for state in (GatewayRouteState.MAINTENANCE, GatewayRouteState.PUBLISHED)
    )
    return (
        '"""The route activation states, generated. Do not edit.\n'
        "\n"
        "Generated by scripts/generate-python-vocabulary from\n"
        "vonk_agent_protocol.state_machines.GatewayRouteState. The LiteLLM supervisor\n"
        "loads route_activation.py with no package around it, so it carries this file\n"
        'beside it instead of a copy of the words."""\n'
        "\n"
        "from typing import Literal\n"
        "\n"
        f"ActivationState = Literal[{states}]\n"
    )


def hook_words() -> str:
    from vonk_agent_protocol import AgentFailureKind
    from vonk_agent_protocol.lifecycle_vocabulary import FailureCode

    lines = [
        '"""Generated by scripts/generate-python-vocabulary. Do not edit."""',
        "",
        "from enum import StrEnum",
        "",
        "",
        "class HookFailureCode(StrEnum):",
    ]
    lines.extend(
        f"    {member.name} = {json.dumps(member.value)}"
        for member in FailureCode
        if member.name.startswith("HOOK_VM_")
    )
    lines.extend(["", "", "class HookFailureKind(StrEnum):"])
    member = AgentFailureKind.TEMPORARY_DEPENDENCY
    lines.append(f"    {member.name} = {json.dumps(member.value)}")
    return "\n".join(lines) + "\n"


def rendered() -> dict[Path, str]:
    return {
        CLI_WORDS: cli_words(),
        ROUTE_WORDS: route_words(),
        HOOK_WORDS: hook_words(),
    }


def main() -> None:
    argparse.ArgumentParser(description=__doc__).parse_args()
    for path, content in rendered().items():
        path.write_text(content, encoding="utf-8", newline="\n")


if __name__ == "__main__":
    main()
