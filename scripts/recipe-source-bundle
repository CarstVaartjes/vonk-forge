#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from dataclasses import asdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "control/src"))

from vonk_control.source_bundles import SourceBundleError, generate_source_bundle


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Build a deterministic v1 recipe source bundle."
    )
    parser.add_argument("context", type=Path)
    parser.add_argument("--output-dir", type=Path, required=True)
    return parser.parse_args()


def _files(context: Path) -> dict[str, bytes]:
    if not context.is_dir():
        raise ValueError("context must be a directory")
    files: dict[str, bytes] = {}
    for path in sorted(context.rglob("*"), key=lambda item: item.as_posix().encode()):
        relative = path.relative_to(context).as_posix()
        if path.is_symlink():
            raise ValueError(f"symlink is forbidden in source bundles: {relative}")
        if path.is_dir():
            continue
        if not path.is_file():
            raise ValueError(f"non-regular source is forbidden: {relative}")
        if "__pycache__" in path.parts or path.suffix == ".pyc":
            raise ValueError(f"generated cache is forbidden: {relative}")
        files[relative] = path.read_bytes()
    return files


def main() -> int:
    args = _arguments()
    try:
        bundle = generate_source_bundle(_files(args.context.resolve()))
    except (OSError, SourceBundleError, ValueError) as error:
        print(f"recipe-source-bundle: {error}", file=sys.stderr)
        return 2
    manifest = json.dumps(
        {
            "schema_version": 1,
            "files": [asdict(item) for item in bundle.manifest.files],
            "total_bytes": bundle.manifest.total_bytes,
        },
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    args.output_dir.mkdir(parents=True, exist_ok=True)
    archive_path = args.output_dir / f"{bundle.sha256}.tar"
    archive_path.write_bytes(bundle.archive)
    (args.output_dir / "manifest.json").write_bytes(manifest)
    print(
        json.dumps(
            {
                "archive": archive_path.name,
                "archive_bytes": len(bundle.archive),
                "file_count": len(bundle.manifest.files),
                "source_sha256": bundle.sha256,
                "total_bytes": bundle.manifest.total_bytes,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
