#!/usr/bin/env bash
# Reconcile public convenience aliases from an authoritative immutable digest
# set. Deployments consume immutable references, never these moving aliases.
set -euo pipefail
umask 077

usage() {
  printf '%s\n' \
    'usage: promote-image-aliases API_IMAGE API_DIGEST WORKER_IMAGE WORKER_DIGEST dev|latest [HERMES_IMAGE HERMES_DIGEST] [--postcondition COMMAND [ARG...]]' \
    >&2
  exit 64
}

arguments=("$@")
boundary=${#arguments[@]}
for index in "${!arguments[@]}"; do
  if [[ "${arguments[$index]}" == --postcondition ]]; then
    boundary=$index
    break
  fi
done
base_arguments=("${arguments[@]:0:boundary}")
postcondition=("${arguments[@]:boundary + 1}")
(( "${#postcondition[@]}" > 0 || boundary == "${#arguments[@]}" )) || usage
(( boundary == 5 || boundary == 7 )) || usage
set -- "${base_arguments[@]}"
readonly api_image=$1 api_digest=$2 worker_image=$3 worker_digest=$4 alias=$5
[[ "$api_image" == ghcr.io/carstvaartjes/vonk-forge-api ]] || usage
[[ "$worker_image" == ghcr.io/carstvaartjes/vonk-forge-worker ]] || usage
[[ "$api_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || usage
[[ "$worker_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || usage
[[ "$alias" == dev || "$alias" == latest ]] || usage

roles=(api worker)
images=("$api_image" "$worker_image")
digests=("$api_digest" "$worker_digest")
if [[ "$#" -eq 7 ]]; then
  readonly hermes_image=$6 hermes_digest=$7
  [[ "$alias" == latest ]] || usage
  [[ "$hermes_image" == ghcr.io/carstvaartjes/vonk-forge-hermes ]] || usage
  [[ "$hermes_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || usage
  roles+=(hermes)
  images+=("$hermes_image")
  digests+=("$hermes_digest")
fi

readonly scratch=$(mktemp -d /tmp/vonk-image-alias-promotion.XXXXXXXXXX)
[[ "$scratch" =~ ^/tmp/vonk-image-alias-promotion\.[A-Za-z0-9]{10}$ \
  && -d "$scratch" && ! -L "$scratch" ]] || {
  printf '%s\n' 'image alias scratch path is unsafe' >&2
  exit 1
}

promotion_started=0
promotion_complete=0
rollback_complete=1
previous_digests=()

inspect_alias() {
  local role=$1 image=$2 observed
  local error_file="$scratch/$role.inspect-error"
  if observed=$(skopeo inspect --format '{{.Digest}}' \
    "docker://$image:$alias" 2>"$error_file"); then
    [[ "$observed" =~ ^sha256:[0-9a-f]{64}$ ]] || {
      printf '%s alias digest is invalid\n' "$role" >&2
      return 1
    }
    printf '%s\n' "$observed"
    return 0
  fi
  if grep -Eiq 'manifest unknown|name unknown|not found' "$error_file"; then
    return 0
  fi
  printf '%s alias lookup failed\n' "$role" >&2
  return 1
}

set_alias() {
  local role=$1 image=$2 digest=$3 attempt observed
  observed=$(inspect_alias "$role" "$image") || return 1
  [[ "$observed" == "$digest" ]] && return 0
  for attempt in 1 2 3; do
    if skopeo copy --all --preserve-digests \
      "docker://$image@$digest" "docker://$image:$alias" \
      >/dev/null 2>&1; then
      observed=$(inspect_alias "$role" "$image") || continue
      [[ "$observed" == "$digest" ]] && return 0
    fi
  done
  printf '%s %s alias did not converge\n' "$role" "$alias" >&2
  return 1
}

finish() {
  local status=$? rollback_failed=0 index previous
  trap - EXIT INT TERM
  set +e
  if [[ "$promotion_started" -eq 1 && "$promotion_complete" -eq 0 ]]; then
    for index in "${!roles[@]}"; do
      previous=${previous_digests[$index]:-}
      if [[ "$previous" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        set_alias "${roles[$index]}" "${images[$index]}" "$previous" \
          || rollback_failed=1
      fi
    done
    printf '%s\n' \
      "$alias aliases were not advanced as a set; rerun the failed publication job to reconcile the authoritative immutable set" \
      >&2
    if [[ "$rollback_failed" -ne 0 ]]; then
      printf '%s\n' \
        "one or more previous $alias aliases could not be restored" >&2
    fi
    [[ "$status" -ne 0 ]] || status=1
  fi
  rm -rf -- "$scratch"
  exit "$status"
}

trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for index in "${!roles[@]}"; do
  previous_digests+=("$(inspect_alias "${roles[$index]}" "${images[$index]}")")
done
for index in "${!roles[@]}"; do
  if [[ ! "${previous_digests[$index]}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    rollback_complete=0
  fi
done
# A missing alias cannot be removed safely with skopeo: deleting a tag resolves
# it to a manifest digest and can remove immutable tags that share that digest.
# For a first/partial publication, run the failure-prone authority check before
# any mutation. Established alias sets retain the stronger post-mutation check
# with rollback armed below.
if [[ "$rollback_complete" -eq 0 && "${#postcondition[@]}" -gt 0 ]]; then
  "${postcondition[@]}"
  postcondition=()
fi
promotion_started=1
for index in "${!roles[@]}"; do
  set_alias "${roles[$index]}" "${images[$index]}" "${digests[$index]}"
done
if (( "${#postcondition[@]}" )); then
  "${postcondition[@]}"
fi
promotion_complete=1

printf '%s aliases match the authoritative immutable set\n' "$alias"
