#!/bin/sh
# Run a command as the current user with the NAS installer's secret group.
#
# Compose gives the capability-free Tailscale containers that group, and the
# installer assigns it to their secret files. On a NAS the installer runs under
# sudo; CI installs as an ordinary user, who can assign only groups they belong
# to. This creates the group (same gid as deploy/compose/tailscale/compose.yaml),
# adds the user, and re-enters the command with that supplementary group while
# keeping the user's primary group.
set -eu

gid=64400
name=vonk-nas-secrets
user=$(id -un)

if ! getent group "$gid" >/dev/null; then
    sudo groupadd --gid "$gid" "$name"
fi
group=$(getent group "$gid" | cut -d: -f1)
sudo usermod --append --groups "$group" "$user"
exec sudo --preserve-env --user "$user" env "PATH=$PATH" "$@"
