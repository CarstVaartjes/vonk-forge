#!/usr/bin/env python3
"""Refresh a candidate artifact pin; ordinary build verification stays strict."""

from __future__ import annotations

import hashlib
import re
import sys
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True  # repository tools never leave __pycache__ behind
import os

# The sibling helper, however this file is loaded.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from check_environment import prepare
from protocol_wheel import protocol_wheel_name

ROOT = Path(__file__).resolve().parents[1]


def main() -> None:
    lock = ROOT / "control/uv.lock"
    text = lock.read_text(encoding="utf-8")
    packages = [
        package
        for package in tomllib.loads(text)["package"]
        if package["name"] == "vonk-agent-protocol"
    ]
    if len(packages) != 1:
        raise SystemExit("Expected one canonical protocol package")
    wheel = ROOT / "inventory/wheels" / protocol_wheel_name(ROOT)
    pins = [pin for pin in packages[0]["wheels"] if pin["path"] == wheel.name]
    if len(pins) != 1:
        raise SystemExit("Expected one canonical protocol wheel pin")
    prepare(
        ROOT,
        ROOT / ".state/commit-checks/control.lock",
        "protocol wheel",
        wheel.is_file,
        [
            [
                "uv",
                "build",
                "--project",
                "agent_protocol",
                "--wheel",
                "--out-dir",
                "inventory/wheels",
            ]
        ],
    )
    actual = "sha256:" + hashlib.sha256(wheel.read_bytes()).hexdigest()
    pattern = (
        rf'(?m)^    \{{ path = "{re.escape(wheel.name)}"(?:, hash = "[^"]+")? \}},$'
    )
    updated, count = re.subn(
        pattern, f'    {{ path = "{wheel.name}", hash = "{actual}" }},', text
    )
    if count != 1:
        raise SystemExit("Expected one canonical protocol wheel pin")
    lock.write_text(updated, encoding="utf-8", newline="\n")


if __name__ == "__main__":
    main()
