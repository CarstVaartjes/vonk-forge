#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

usage() {
    cat <<'USAGE'
Usage: scripts/test-local [--changed [BASE]] [--with-image-build]

Without arguments, run the complete repository and Controller suites (Linux
lanes go to the vonk-ci OrbStack VM on macOS).

--changed [BASE]    Fast inner loop: run only the test files that directly
                    exercise files changed since BASE (default: the merge base
                    with origin/main), including uncommitted and untracked
                    changes. Not a substitute for the full run before review.
--with-image-build  Build the Controller and worker images once from
                    control/Dockerfile and also run the built_image checks
                    against them (CI does this in its own job). Skipped by
                    default.
USAGE
}

changed_mode=false
changed_base=
include_image_build=false
while (($#)); do
    case "$1" in
        --changed)
            changed_mode=true
            if [[ -n "${2:-}" && "$2" != --* ]]; then
                changed_base=$2
                shift
            fi
            ;;
        --with-image-build)
            include_image_build=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# Adds the built_image deselection to a marker expression unless requested.
with_image_build_selection() {
    local expression=$1
    if [[ "$include_image_build" == true ]]; then
        printf '%s' "$expression"
    elif [[ -n "$expression" ]]; then
        printf '(%s) and not built_image' "$expression"
    else
        printf 'not built_image'
    fi
}

# Builds each image once; the built_image tests only inspect and run them.
build_test_images() {
    export VONK_TEST_CONTROLLER_IMAGE=vonk-control:test-local
    export VONK_TEST_WORKER_IMAGE=vonk-control-worker:test-local
    docker build --file control/Dockerfile --target api \
        --tag "$VONK_TEST_CONTROLLER_IMAGE" .
    docker build --file control/Dockerfile --target worker \
        --tag "$VONK_TEST_WORKER_IMAGE" .
}

scripts/build-control-wheel
if [[ "$include_image_build" == true ]]; then
    build_test_images
fi
recipe_root=${VONK_RECIPE_LIBRARY_ROOT:-/opt/vonk-forge-recipes}
linux_markers='linux_only or needs_systemd or postgres'
portable_markers='not linux_only and not needs_systemd and not needs_rust_probe and not needs_repair_probe and not postgres'

# Every suite runs in the one locked control environment, as in CI.
uv_control() {
    UV_CACHE_DIR=${UV_CACHE_DIR:-"/private/tmp/vonk-test-local-uv-cache"} \
        UV_PROJECT_ENVIRONMENT=${UV_CONTROL_PROJECT_ENVIRONMENT:-"/private/tmp/vonk-ci-infra-test-control-venv"} \
        uv run --project "$root/control" --frozen "$@"
}

use_recipe_library() {
    if [[ -d "$recipe_root/contracts" ]]; then
        export VONK_RECIPE_LIBRARY_ROOT="$recipe_root"
    elif [[ ${CI:-false} == true ]]; then
        echo "VONK_RECIPE_LIBRARY_ROOT is required in CI: $recipe_root/contracts" >&2
        return 1
    else
        echo "[SKIP-PREREQUISITE] recipe library unavailable; recipe-library tests must skip locally" >&2
        unset VONK_RECIPE_LIBRARY_ROOT || true
    fi
}

run_python_suites() {
    local marker_args=()
    if [[ -n "$1" ]]; then
        marker_args=(--markers "$1")
    fi
    use_recipe_library
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        scripts/pull-test-images postgres caddy step-ca tailscale python
    fi
    local status=0
    for suite in repository control compose; do
        scripts/test "$suite" "${marker_args[@]}" -- --durations=40 || status=1
    done
    if [[ "$include_image_build" == true ]]; then
        scripts/test images || status=1
    fi
    return "$status"
}

run_ci_wire_boundary() {
    use_recipe_library
    uv_control pytest -q control/tests/test_api_response_witness.py \
        control/tests/test_source_bundle_client_handoff.py \
        control/tests/test_artifact_job_api.py \
        control/tests/test_fleet_profile_api.py::test_profile_operator_routes_are_singular_and_unversioned \
        control/tests/test_fleet_profile_api.py::test_profile_mutation_role_is_declared_for_final_route \
        control/tests/test_production_app_recipe_image_api.py::test_production_app_recipe_download_auth_and_status \
        --api-response-witness="${TMPDIR:-/tmp}/vonk-test-local-api-response-witnesses.json"
    uv_control python scripts/tests/run_agent_wire_contracts.py -- -q -n 4 --dist loadfile
}

run_changed_tests() {
    local base=${changed_base:-$(git merge-base HEAD origin/main)}
    local selection
    selection=$(
        {
            git diff --name-only "$base"
            git ls-files --others --exclude-standard
        } | sort -u | scripts/select-changed-tests
    )
    if [[ -z "$selection" ]]; then
        echo "No test files exercise the changes since $base"
        return 0
    fi
    local repository_files=() control_files=() compose_files=()
    local suite path
    while read -r suite path; do
        case "$suite" in
            repository) repository_files+=("$path") ;;
            control) control_files+=("${path#control/}") ;;
            compose) compose_files+=("$path") ;;
        esac
    done <<< "$selection"
    if [[ -d "$recipe_root/contracts" ]]; then
        export VONK_RECIPE_LIBRARY_ROOT="$recipe_root"
    fi
    local status=0
    local marker_args=()
    local marker_expression
    marker_expression=$(with_image_build_selection "")
    if [[ -n "$marker_expression" ]]; then
        marker_args=(-m "$marker_expression")
    fi
    if ((${#repository_files[@]})); then
        echo "Repository suite: ${#repository_files[@]} changed-path test files"
        uv_control pytest -q -n auto --dist loadfile "${marker_args[@]}" "${repository_files[@]}" || status=1
    fi
    if ((${#control_files[@]})); then
        echo "Controller suite: ${#control_files[@]} changed-path test files"
        uv_control pytest -q -n auto --dist loadfile "${marker_args[@]}" \
            "${control_files[@]/#/control/}" || status=1
    fi
    if ((${#compose_files[@]})); then
        echo "Compose suite: ${#compose_files[@]} changed-path test files"
        uv_control pytest -q "${marker_args[@]}" "${compose_files[@]}" || status=1
    fi
    return "$status"
}

if [[ "$changed_mode" == true ]]; then
    run_changed_tests
    exit
fi

if [[ "$(uname -s)" != Darwin ]]; then
    run_python_suites "${VONK_TEST_LOCAL_MARKERS:-}"
    run_ci_wire_boundary
    exit
fi

echo "Running portable repository and Controller suites on macOS"
run_python_suites "$portable_markers"

if ! command -v orb >/dev/null 2>&1; then
    if [[ ${CI:-false} == true ]]; then
        echo "OrbStack is required in CI for Linux-only test markers" >&2
        exit 1
    fi
    echo "[SKIP-PREREQUISITE] OrbStack VM vonk-ci is unavailable; Linux-only tests were not run"
    exit 0
fi

if ! orb -m vonk-ci bash -lc 'test -d /' >/dev/null 2>&1; then
    if [[ ${CI:-false} == true ]]; then
        echo "OrbStack VM vonk-ci is unavailable in CI; Linux-only tests were not run" >&2
        exit 1
    fi
    echo "[SKIP-PREREQUISITE] OrbStack VM vonk-ci is not running; Linux-only tests were not run"
    exit 0
fi

echo "Running Linux-marked repository and Controller tests in OrbStack VM vonk-ci"
printf -v guest_root '%q' "$root"
orb -m vonk-ci bash -lc \
    "cd $guest_root && export CARGO_TARGET_DIR=\"\$HOME/target-vonk-ci-infra\" UV_CACHE_DIR=\"\$HOME/.cache/vonk-ci-infra-uv\" UV_CONTROL_PROJECT_ENVIRONMENT=\"\$HOME/venv-vonk-ci-infra-control\" VONK_RECIPE_LIBRARY_ROOT=$(printf %q "$recipe_root") VONK_TEST_LOCAL_MARKERS=$(printf %q "$linux_markers") && scripts/test-local"
