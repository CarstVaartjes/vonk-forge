#!/usr/bin/env python3
"""Verify that CI's selected jobs have the expected terminal results."""

from __future__ import annotations

import argparse
import json
import os
import sys

AREAS = (
    "rust",
    "repository",
    "control",
    "web",
    "generated",
    "compose",
    "nas-install",
    "agent-package",
    "lane",
)
AREA_JOBS = {
    "rust": ("rust-platform", "oci-link-fallback", "privileged-helper-oci-process"),
    "repository": ("repository",),
    "control": (
        "control",
        "client-compatibility-report",
        "installed-cli-proof",
        "model-cache-unknown-expiry",
        "profile-effect-consumer",
    ),
    "web": ("web",),
    "generated": ("generated",),
    "compose": ("compose",),
    "nas-install": ("nas-install",),
    "agent-package": ("agent-package",),
    # A change to the upgrade-carry lane's own code is merged only with a
    # green lane run on that head.
    "lane": ("lane-proof",),
}
# Every job runs only when the selector chose the full suites (`full`): a member
# pull request runs no jobs besides the selector and this gate.


# GitHub job ids whose verdict key differs from the id. Every other gated job
# is keyed by its own id.
JOB_KEYS = {
    "repository-suite": "repository",
    "control-suite": "control",
    "web-suite": "web",
    "generated-clients": "generated",
    "compose-integration": "compose",
}
# Verdict keys that `verify` applies a rule to besides AREA_JOBS.
RULED_JOBS = frozenset(
    {
        "lint",
        "member-web",
        "supply-chain",
        "rust-quality",
        "rust-tests",
        "controller-spark-wire",
        "repository-guards",
        "consumer-probe",
        "control-image-build",
    }
    | {job for jobs in AREA_JOBS.values() for job in jobs}
)


def from_needs(
    document: str,
) -> tuple[str, dict[str, str], dict[str, str], list[str]]:
    """Read `toJSON(needs)`: selector result, selections, results, unruled jobs."""
    needs = json.loads(document)
    changes = needs["changes"]
    selected = {
        key.replace("_", "-"): value
        for key, value in changes.get("outputs", {}).items()
    }
    results: dict[str, str] = {}
    errors: list[str] = []
    for job, need in needs.items():
        if job == "changes":
            continue
        key = JOB_KEYS.get(job, job)
        if key in results:
            errors.append(f"{job} shares verdict key {key} with another gated job")
        elif key in RULED_JOBS:
            results[key] = need["result"]
        else:
            errors.append(f"{job} is gated but has no rule here")
    return changes["result"], selected, results, errors


def verify(
    selector_result: str, selected: dict[str, str], results: dict[str, str]
) -> list[str]:
    errors: list[str] = []
    if selector_result != "success":
        errors.append(f"selector result is {selector_result!r}, expected 'success'")

    if selected.get("full") not in {"true", "false"}:
        errors.append(
            f"full selection is {selected.get('full')!r}, expected 'true' or 'false'"
        )
    full = selected.get("full") == "true"

    def expect(job: str, run: bool) -> None:
        expected = "success" if run else "skipped"
        if results.get(job) != expected:
            errors.append(
                f"{job} result is {results.get(job)!r}, expected {expected!r}"
            )

    for job in (
        "supply-chain",
        "repository-guards",
        "consumer-probe",
    ):
        expect(job, full)

    # The member tier: the Python check (lint) runs on every pull request, the
    # web check on a member pull request, and rust-quality on a member pull
    # request that changes Rust (or any other full run).
    rust_changed = selected.get("rust-changed")
    if rust_changed not in {"true", "false"}:
        errors.append(
            f"rust-changed selection is {rust_changed!r}, expected 'true' or 'false'"
        )
    expect("lint", True)
    expect("member-web", not full)

    def chosen(area: str) -> bool:
        return selected.get(area) == "true" and full

    for area in AREAS:
        selection = selected.get(area)
        if selection not in {"true", "false"}:
            errors.append(
                f"{area} selection is {selection!r}, expected 'true' or 'false'"
            )
        else:
            for job in AREA_JOBS[area]:
                expect(job, chosen(area))
    expect("rust-quality", chosen("rust") or (not full and rust_changed == "true"))
    expect("rust-tests", chosen("rust"))
    expect("control-image-build", chosen("control") and chosen("nas-install"))
    expect("controller-spark-wire", chosen("rust") or chosen("control"))
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--needs-env", required=True)
    args = parser.parse_args()
    selector_result, selected, results, errors = from_needs(
        os.environ.get(args.needs_env, "")
    )
    errors += verify(selector_result, selected, results)
    if errors:
        print("CI gate failed:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    print("CI gate passed: selector and selected CI jobs are healthy")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
