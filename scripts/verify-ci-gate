#!/usr/bin/env python3
"""Verify that CI's selected jobs have the expected terminal results."""

from __future__ import annotations

import argparse
import sys

AREAS = (
    "rust",
    "repository",
    "control",
    "web",
    "generated",
    "compose",
    "nas-install",
    "agent-package",
    "lane",
)
AREA_JOBS = {
    "rust": ("rust-platform",),
    "repository": ("repository",),
    "control": ("control",),
    "web": ("web",),
    "generated": ("generated",),
    "compose": ("compose",),
    "nas-install": ("nas-install",),
    "agent-package": ("agent-package",),
    # A change to the upgrade-carry lane's own code is merged only with a
    # green lane run on that head.
    "lane": ("lane-proof",),
}
# Every job runs only when the selector chose the full suites (`full`): a member
# pull request runs no jobs besides the selector and this gate.


def _pairs(values: list[str], label: str) -> dict[str, str]:
    result: dict[str, str] = {}
    for value in values:
        key, separator, item = value.partition("=")
        if not separator or not key or not item or key in result:
            raise ValueError(f"invalid {label}: {value!r}")
        result[key] = item
    return result


def verify(
    selector_result: str, selected: dict[str, str], results: dict[str, str]
) -> list[str]:
    errors: list[str] = []
    if selector_result != "success":
        errors.append(f"selector result is {selector_result!r}, expected 'success'")

    if selected.get("full") not in {"true", "false"}:
        errors.append(
            f"full selection is {selected.get('full')!r}, expected 'true' or 'false'"
        )
    full = selected.get("full") == "true"

    def expect(job: str, run: bool) -> None:
        expected = "success" if run else "skipped"
        if results.get(job) != expected:
            errors.append(
                f"{job} result is {results.get(job)!r}, expected {expected!r}"
            )

    for job in ("lint", "supply-chain", "repository-guards"):
        expect(job, full)

    def chosen(area: str) -> bool:
        return selected.get(area) == "true" and full

    for area in AREAS:
        selection = selected.get(area)
        if selection not in {"true", "false"}:
            errors.append(
                f"{area} selection is {selection!r}, expected 'true' or 'false'"
            )
        else:
            for job in AREA_JOBS[area]:
                expect(job, chosen(area))
    expect("rust-quality", chosen("rust"))
    expect("rust-tests", chosen("rust"))
    expect("control-image-build", chosen("control") and chosen("nas-install"))
    expect("controller-spark-wire", chosen("rust") or chosen("control"))
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--selector-result", required=True)
    parser.add_argument("--selected", action="append", default=[])
    parser.add_argument("--result", action="append", default=[])
    args = parser.parse_args()
    try:
        selected = _pairs(args.selected, "selection")
        results = _pairs(args.result, "result")
    except ValueError as error:
        parser.error(str(error))
    errors = verify(args.selector_result, selected, results)
    if errors:
        print("CI gate failed:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    print("CI gate passed: selector and selected CI jobs are healthy")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
