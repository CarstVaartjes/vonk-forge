#!/usr/bin/env python3
"""Export campaign schemas from the pinned canonical recipe contracts."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

if __name__ == "__main__":
    from check_environment import run_in_control

    run_in_control(ROOT)

from vonk_forge_contracts.qualification_authority import (
    campaign_authority_json_schema,
    campaign_manifest_json_schema,
)


def rendered() -> dict[Path, str]:
    """Every tracked campaign schema file and the content it must have."""

    schemas = {
        "qualification-authority-v5.schema.json": campaign_authority_json_schema(),
        "qualification-campaign-manifest-v2.schema.json": campaign_manifest_json_schema(),
    }
    return {
        ROOT / directory / name: json.dumps(schema, sort_keys=True, indent=2) + "\n"
        for name, schema in schemas.items()
        for directory in ("src/cluster_profiles/schemas", "schemas")
    }


def main() -> None:
    argparse.ArgumentParser(description=__doc__).parse_args()
    for output, content in rendered().items():
        output.write_text(content, encoding="utf-8")


if __name__ == "__main__":
    main()
