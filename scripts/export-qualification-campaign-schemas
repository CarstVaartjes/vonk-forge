#!/usr/bin/env python3
"""Export campaign schemas from the pinned canonical recipe contracts."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from vonk_forge_contracts.qualification_authority import (
    campaign_authority_json_schema,
    campaign_manifest_json_schema,
    recovery_coverage_consumption_json_schema,
    recovery_coverage_receipt_json_schema,
    recovery_coverage_use_json_schema,
)

ROOT = Path(__file__).resolve().parents[1]


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    schemas = {
        "qualification-authority-v4.schema.json": campaign_authority_json_schema(),
        "qualification-campaign-manifest-v2.schema.json": campaign_manifest_json_schema(),
        "recovery-coverage-consumption-v1.schema.json": recovery_coverage_consumption_json_schema(),
        "recovery-coverage-receipt-v1.schema.json": recovery_coverage_receipt_json_schema(),
        "recovery-coverage-use-v1.schema.json": recovery_coverage_use_json_schema(),
    }
    for name, schema in schemas.items():
        output = ROOT / "src/cluster_profiles/schemas" / name
        content = json.dumps(schema, sort_keys=True, indent=2) + "\n"
        if args.check:
            if not output.is_file() or output.read_text(encoding="utf-8") != content:
                raise SystemExit(f"Stale qualification campaign schema: {output}")
        else:
            output.write_text(content, encoding="utf-8")


if __name__ == "__main__":
    main()
