#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: $0 CONTROLLER_IMAGE DIGEST_PINNED_SOURCE ARCHITECTURE" >&2
  exit 2
fi

controller_image=$1
source_reference=$2
architecture=$3
case "$architecture" in
  linux/amd64) expected_child=sha256:0e392474a4383b733038b85eff26ade929d2ff10e8deead25a6add3ed79fb362 ;;
  linux/arm64) expected_child=sha256:807f42a95c0f05f397eb505b577b6de49048b865c4e29146d1231324c27e1e59 ;;
  *) echo "unsupported architecture: $architecture" >&2; exit 2 ;;
esac
if [[ "$source_reference" != *@sha256:* ]]; then
  echo "source must be digest pinned" >&2
  exit 2
fi
test "$source_reference" = "quay.io/skopeo/stable:v1.22.2-immutable@sha256:4a16d57b37617a04b3d643079a477a2848efe892dffcdf0ce56df4262b65f810"
# skopeo rejects a reference that carries both a tag and a digest, so resolve
# the pin by its bare repository plus index digest before invoking skopeo.
skopeo_source="quay.io/skopeo/stable@${source_reference##*@}"

labels=$(docker image inspect --format '{{index .Config.Labels "io.vonk.skopeo.index-digest"}} {{index .Config.Labels "io.vonk.skopeo.'"${architecture#linux/}"'-digest"}}' "$controller_image")
read -r index_label child_label <<<"$labels"
test "$index_label" = sha256:4a16d57b37617a04b3d643079a477a2848efe892dffcdf0ce56df4262b65f810
test "$child_label" = "$expected_child"
test "$(docker image inspect --format '{{.Architecture}}' "$controller_image")" = "${architecture#linux/}"
# inspect's Digest identifies the index even when an architecture is selected.
# Read its descriptor to verify the exact child, rather than comparing the
# index digest with a platform-manifest digest.
source_child=$(skopeo inspect --tls-verify=true --raw \
  "docker://${skopeo_source}" | python3 -c '
import json, sys
platform = sys.argv[1].split("/", 1)
matches = [entry["digest"] for entry in json.load(sys.stdin)["manifests"]
           if entry.get("platform", {}).get("os") == platform[0]
           and entry.get("platform", {}).get("architecture") == platform[1]]
if len(matches) != 1:
    raise SystemExit("source index must contain exactly one requested platform")
print(matches[0])
' "$architecture")
test "$source_child" = "$expected_child"

docker run --rm \
  --read-only \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=256m \
  --tmpfs /var/tmp:rw,nosuid,nodev,noexec,size=256m \
  --user 10001:10001 \
  --env SOURCE_REFERENCE="$skopeo_source" \
  --env EXPECTED_ARCHITECTURE="$architecture" \
  --entrypoint /bin/sh \
  "$controller_image" \
  -ec '
    test "$(id -u)" = 10001
    test -w /tmp
    test -w /var/tmp
    /usr/bin/skopeo --version
    /usr/bin/skopeo inspect --tls-verify=true \
      --override-os linux --override-arch "${EXPECTED_ARCHITECTURE#linux/}" \
      "docker://${SOURCE_REFERENCE}"
    /usr/bin/skopeo copy --tls-verify=true \
      --override-os linux --override-arch "${EXPECTED_ARCHITECTURE#linux/}" \
      "docker://${SOURCE_REFERENCE}" oci-archive:/tmp/controller-skopeo.oci
    test -s /tmp/controller-skopeo.oci
    /usr/bin/skopeo inspect --tls-verify=true \
      --override-os linux --override-arch "${EXPECTED_ARCHITECTURE#linux/}" \
      oci-archive:/tmp/controller-skopeo.oci
  '
