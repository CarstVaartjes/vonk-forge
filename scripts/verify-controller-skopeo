#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: $0 CONTROLLER_IMAGE DIGEST_PINNED_SOURCE ARCHITECTURE" >&2
  exit 2
fi

controller_image=$1
source_reference=$2
architecture=$3
case "$architecture" in
  linux/amd64) expected_child=sha256:abded792af33493f9aaa08132f564d3f9c12818193c0adc0a62f44ed84a04eda ;;
  linux/arm64) expected_child=sha256:8ec3bf7d7bc514b7178db838b2e289ea5eca7bd065ce6a67b9f04cef3c85eba9 ;;
  *) echo "unsupported architecture: $architecture" >&2; exit 2 ;;
esac
if [[ "$source_reference" != *@sha256:* ]]; then
  echo "source must be digest pinned" >&2
  exit 2
fi
test "$source_reference" = "quay.io/skopeo/stable@sha256:e5d9c4af8ec327785c7ca938d1e4f8452c6a05014850e58e2ff9456899ebd97c"

labels=$(docker image inspect --format '{{index .Config.Labels "io.vonk.skopeo.index-digest"}} {{index .Config.Labels "io.vonk.skopeo.'"${architecture#linux/}"'-digest"}}' "$controller_image")
read -r index_label child_label <<<"$labels"
test "$index_label" = sha256:e5d9c4af8ec327785c7ca938d1e4f8452c6a05014850e58e2ff9456899ebd97c
test "$child_label" = "$expected_child"
test "$(docker image inspect --format '{{.Architecture}}' "$controller_image")" = "${architecture#linux/}"
source_child=$(skopeo inspect --tls-verify=true \
  --override-os linux --override-arch "${architecture#linux/}" \
  --format '{{.Digest}}' "docker://${source_reference}")
test "$source_child" = "$expected_child"

docker run --rm \
  --read-only \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=256m \
  --tmpfs /var/tmp:rw,nosuid,nodev,noexec,size=256m \
  --user 10001:10001 \
  --env SOURCE_REFERENCE="$source_reference" \
  --env EXPECTED_ARCHITECTURE="$architecture" \
  --entrypoint /bin/sh \
  "$controller_image" \
  -ec '
    test "$(id -u)" = 10001
    test -w /tmp
    test -w /var/tmp
    /usr/bin/skopeo --version
    /usr/bin/skopeo inspect --tls-verify=true \
      --override-os linux --override-arch "${EXPECTED_ARCHITECTURE#linux/}" \
      "docker://${SOURCE_REFERENCE}"
    /usr/bin/skopeo copy --tls-verify=true \
      --override-os linux --override-arch "${EXPECTED_ARCHITECTURE#linux/}" \
      "docker://${SOURCE_REFERENCE}" oci-archive:/tmp/controller-skopeo.oci
    test -s /tmp/controller-skopeo.oci
    /usr/bin/skopeo inspect --tls-verify=true \
      --override-os linux --override-arch "${EXPECTED_ARCHITECTURE#linux/}" \
      oci-archive:/tmp/controller-skopeo.oci
  '
