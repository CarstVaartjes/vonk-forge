#!/usr/bin/env python3
"""Publish one exact platform bundle, TUF target, then discovery channel."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

repository_src = Path(__file__).resolve().parents[1] / "src"
if str(repository_src) not in sys.path:
    sys.path.insert(0, str(repository_src))

from cluster_profiles.deployment_bundle import (
    DeploymentBundleError,
    verify_deployment_bundle,
)
from cluster_profiles.platform_release import (
    OciDeploymentBundle,
    PlatformRelease,
    PlatformReleaseError,
)

_MANIFEST_MEDIA_TYPE = "application/vnd.oci.image.manifest.v1+json"
_LAYER_MEDIA_TYPE = "application/vnd.vonk-forge.control-deployment.v1.tar"
_CONFIG_MEDIA_TYPE = "application/vnd.oci.empty.v1+json"
_ARTIFACT_TYPE = "application/vnd.vonk-forge.control-deployment.v1"
_REPOSITORY = re.compile(
    r"[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?\Z"
)
_CHANNEL = re.compile(r"[a-z][a-z0-9-]{0,31}\Z")
_MAX_RELEASE_BYTES = 1024 * 1024
_MAX_BUNDLE_BYTES = 64 * 1024 * 1024
_MAX_RECEIPT_BYTES = 64 * 1024
_COMMAND_TIMEOUT_SECONDS = 15 * 60
_CONFIG_BYTES = b"{}"
_BASE_ENVIRONMENT = ("HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "SSL_CERT_DIR", "SSL_CERT_FILE")
_ORAS_ENVIRONMENT = (*_BASE_ENVIRONMENT, "DOCKER_CONFIG", "HOME", "REGISTRY_AUTH_FILE", "XDG_CONFIG_HOME")
_AUTHORITY_ENVIRONMENT = (
    *_BASE_ENVIRONMENT,
    "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
    "ACTIONS_ID_TOKEN_REQUEST_URL",
    "VONK_PLATFORM_AUTHORITY_AUDIENCE",
    "VONK_PLATFORM_AUTHORITY_URL",
)


class PublicationError(RuntimeError):
    """The exact release cannot be safely published."""


@dataclass
class _TrustedTool:
    path: Path
    descriptor: int
    identity: tuple[int, int, int, int, int]

    def close(self) -> None:
        os.close(self.descriptor)


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _sha256(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def _read_regular(path: Path, *, limit: int, label: str) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise PublicationError(f"{label} is unavailable or unsafe") from error
    try:
        details = os.fstat(descriptor)
        if (
            not stat.S_ISREG(details.st_mode)
            or details.st_nlink != 1
            or details.st_size < 1
            or details.st_size > limit
        ):
            raise PublicationError(f"{label} size or file type is invalid")
        chunks: list[bytes] = []
        remaining = details.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise PublicationError(f"{label} changed while it was read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise PublicationError(f"{label} changed while it was read")
        after = os.fstat(descriptor)
        if (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ) != (
            details.st_dev,
            details.st_ino,
            details.st_size,
            details.st_mtime_ns,
        ):
            raise PublicationError(f"{label} changed while it was read")
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def _repository(value: str) -> str:
    if _REPOSITORY.fullmatch(value) is None or "//" in value:
        raise PublicationError("OCI repository is invalid")
    return value


def _oci_manifest(bundle: bytes) -> bytes:
    document = {
        "artifactType": _ARTIFACT_TYPE,
        "config": {
            "digest": f"sha256:{_sha256(_CONFIG_BYTES)}",
            "mediaType": _CONFIG_MEDIA_TYPE,
            "size": len(_CONFIG_BYTES),
        },
        "layers": [
            {
                "digest": f"sha256:{_sha256(bundle)}",
                "mediaType": _LAYER_MEDIA_TYPE,
                "size": len(bundle),
            }
        ],
        "mediaType": _MANIFEST_MEDIA_TYPE,
        "schemaVersion": 2,
    }
    return json.dumps(document, sort_keys=True, separators=(",", ":")).encode()


def _describe_bundle(bundle: bytes, repository: str) -> dict[str, object]:
    manifest = _oci_manifest(bundle)
    manifest_digest = _sha256(manifest)
    return {
        "reference": f"{repository}@sha256:{manifest_digest}",
        "manifest_digest": f"sha256:{manifest_digest}",
        "manifest_size": len(manifest),
        "manifest_media_type": _MANIFEST_MEDIA_TYPE,
        "layer_digest": f"sha256:{_sha256(bundle)}",
        "layer_size": len(bundle),
        "layer_media_type": _LAYER_MEDIA_TYPE,
    }


def _bundle_dict(bundle: OciDeploymentBundle) -> dict[str, object]:
    return {
        "reference": bundle.reference,
        "manifest_digest": bundle.manifest_digest,
        "manifest_size": bundle.manifest_size,
        "manifest_media_type": bundle.manifest_media_type,
        "layer_digest": bundle.layer_digest,
        "layer_size": bundle.layer_size,
        "layer_media_type": bundle.layer_media_type,
    }


def _tool(variable: str) -> _TrustedTool:
    value = os.environ.get(variable)
    if value is None:
        raise PublicationError(f"{variable} is required")
    path = Path(value)
    if not path.is_absolute():
        raise PublicationError(f"{variable} must name an absolute executable file")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        details = os.fstat(descriptor)
    except OSError as error:
        raise PublicationError(f"{variable} is unavailable") from error
    if (
        not stat.S_ISREG(details.st_mode)
        or details.st_nlink != 1
        or details.st_mode & 0o022
        or not os.access(path, os.X_OK)
    ):
        os.close(descriptor)
        raise PublicationError(f"{variable} must name an absolute executable file")
    return _TrustedTool(
        path=path,
        descriptor=descriptor,
        identity=(
            details.st_dev,
            details.st_ino,
            details.st_mode,
            details.st_uid,
            details.st_mtime_ns,
        ),
    )


def _environment(names: tuple[str, ...]) -> dict[str, str]:
    result = {name: os.environ[name] for name in names if name in os.environ}
    result.update({"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/bin:/bin"})
    return result


def _terminate(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=1)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def _bounded_communicate(process: subprocess.Popen[bytes]) -> tuple[bytes, bytes]:
    streams = (process.stdout, process.stderr)
    if any(stream is None for stream in streams):
        raise PublicationError("publication command failed")
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    deadline = time.monotonic() + _COMMAND_TIMEOUT_SECONDS
    selector = selectors.DefaultSelector()
    try:
        selector.register(process.stdout, selectors.EVENT_READ, "stdout")
        selector.register(process.stderr, selectors.EVENT_READ, "stderr")
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                _terminate(process)
                raise PublicationError("publication command failed")
            events = selector.select(min(remaining, 1.0))
            if not events and process.poll() is not None:
                events = [(key, selectors.EVENT_READ) for key in selector.get_map().values()]
            for key, _ in events:
                chunk = os.read(key.fd, 8192)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                target = buffers[key.data]
                target.extend(chunk)
                if len(target) > _MAX_RECEIPT_BYTES:
                    _terminate(process)
                    raise PublicationError("publication command failed")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            _terminate(process)
            raise PublicationError("publication command failed")
        process.wait(timeout=remaining)
    except subprocess.TimeoutExpired as error:
        _terminate(process)
        raise PublicationError("publication command failed") from error
    finally:
        selector.close()
    return bytes(buffers["stdout"]), bytes(buffers["stderr"])


def _run(
    tool: _TrustedTool,
    arguments: tuple[object, ...],
    *,
    environment: tuple[str, ...],
    receipt: bool = False,
) -> dict[str, Any]:
    argv = (os.fspath(tool.path), *(os.fspath(value) for value in arguments))
    current = os.fstat(tool.descriptor)
    if (
        current.st_dev,
        current.st_ino,
        current.st_mode,
        current.st_uid,
        current.st_mtime_ns,
    ) != tool.identity:
        raise PublicationError("publication executable changed")
    try:
        process = subprocess.Popen(
            argv,
            executable=f"/proc/self/fd/{tool.descriptor}",
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            close_fds=True,
            pass_fds=(tool.descriptor,),
            start_new_session=True,
            env=_environment(environment),
        )
        stdout, stderr = _bounded_communicate(process)
    except OSError as error:
        raise PublicationError("publication command failed") from error
    if (
        process.returncode != 0
        or len(stdout) > _MAX_RECEIPT_BYTES
        or len(stderr) > _MAX_RECEIPT_BYTES
    ):
        raise PublicationError("publication command failed")
    if not receipt:
        return {}
    try:
        value = json.loads(stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise PublicationError("publication receipt is invalid") from error
    if not isinstance(value, dict):
        raise PublicationError("publication receipt is invalid")
    return value


def _publish(
    args: argparse.Namespace,
    *,
    publish_bundle: bool = True,
    publish_target: bool = True,
    publish_channel: bool = True,
) -> dict[str, object]:
    if _CHANNEL.fullmatch(args.channel) is None or args.channel == "latest":
        raise PublicationError("discovery channel is invalid")
    release_raw = _read_regular(
        args.manifest, limit=_MAX_RELEASE_BYTES, label="platform manifest"
    )
    bundle_raw = _read_regular(
        args.bundle, limit=_MAX_BUNDLE_BYTES, label="deployment bundle"
    )
    try:
        release = PlatformRelease.from_bytes(release_raw)
    except PlatformReleaseError as error:
        raise PublicationError("platform manifest is invalid") from error
    try:
        document = json.loads(release_raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise PublicationError("platform manifest is invalid") from error
    if release_raw != _canonical(document):
        raise PublicationError("platform manifest must use canonical bytes")
    target_sha256 = _sha256(release_raw)
    target_name = (
        f"platform/releases/{release.platform_version}/{target_sha256}.json"
    )
    try:
        release.validate_target_identity(target_name, target_sha256)
    except PlatformReleaseError as error:
        raise PublicationError("platform target identity is invalid") from error
    repository = _repository(release.deployment_bundle.reference.rsplit("@", 1)[0])
    expected_bundle = _describe_bundle(bundle_raw, repository)
    if expected_bundle != _bundle_dict(release.deployment_bundle):
        raise PublicationError("deployment bundle descriptor does not match manifest")
    try:
        verify_deployment_bundle(bundle_raw, release.deployment_bundle)
    except DeploymentBundleError as error:
        raise PublicationError("deployment bundle is noncanonical or invalid") from error

    tools: list[_TrustedTool] = []
    try:
        oras = None
        tuf_publisher = None
        channel_publisher = None
        if publish_bundle:
            oras = _tool("VONK_PLATFORM_ORAS_BIN")
            tools.append(oras)
        if publish_target:
            tuf_publisher = _tool("VONK_PLATFORM_TUF_PUBLISHER_BIN")
            tools.append(tuf_publisher)
        if publish_channel:
            channel_publisher = _tool("VONK_PLATFORM_CHANNEL_PUBLISHER_BIN")
            tools.append(channel_publisher)
        with tempfile.TemporaryDirectory(prefix="vonk-platform-publication-") as temporary:
            staging = Path(temporary)
            config_path = staging / "oci-empty-config.json"
            bundle_path = staging / "control-deployment.tar"
            oci_manifest_path = staging / "oci-manifest.json"
            target_path = staging / "platform-release.json"
            config_path.write_bytes(_CONFIG_BYTES)
            bundle_path.write_bytes(bundle_raw)
            oci_manifest_path.write_bytes(_oci_manifest(bundle_raw))
            target_path.write_bytes(release_raw)
            os.chmod(config_path, 0o400)
            os.chmod(bundle_path, 0o400)
            os.chmod(oci_manifest_path, 0o400)
            os.chmod(target_path, 0o400)

            if publish_bundle:
                assert oras is not None
                _run(
                    oras,
                    (
                        "blob",
                        "push",
                        "--media-type",
                        _CONFIG_MEDIA_TYPE,
                        f"{repository}@sha256:{_sha256(_CONFIG_BYTES)}",
                        config_path,
                    ),
                    environment=_ORAS_ENVIRONMENT,
                )
                _run(
                    oras,
                    (
                        "blob",
                        "push",
                        "--media-type",
                        _LAYER_MEDIA_TYPE,
                        f"{repository}@sha256:{_sha256(bundle_raw)}",
                        bundle_path,
                    ),
                    environment=_ORAS_ENVIRONMENT,
                )
                _run(
                    oras,
                    (
                        "manifest",
                        "push",
                        "--media-type",
                        _MANIFEST_MEDIA_TYPE,
                        release.deployment_bundle.reference,
                        oci_manifest_path,
                    ),
                    environment=_ORAS_ENVIRONMENT,
                )

            if publish_target:
                assert tuf_publisher is not None
                tuf_command: list[object] = [
                    "publish-target",
                    "--target-name",
                    target_name,
                    "--target-sha256",
                    target_sha256,
                    "--target-file",
                    target_path,
                ]
                retained_targets = [item.target_name for item in release.predecessors]
                for predecessor in retained_targets:
                    tuf_command.extend(("--retain-target", predecessor))
                tuf_receipt = _run(
                    tuf_publisher,
                    tuple(tuf_command),
                    environment=_AUTHORITY_ENVIRONMENT,
                    receipt=True,
                )
                expected_tuf_receipt = {
                    "target_name": target_name,
                    "target_sha256": target_sha256,
                    "retained_targets": retained_targets,
                }
                if (
                    any(
                        tuf_receipt.get(key) != value
                        for key, value in expected_tuf_receipt.items()
                    )
                    or type(tuf_receipt.get("targets_version")) is not int
                    or tuf_receipt["targets_version"] < 1
                ):
                    raise PublicationError(
                        "TUF publication receipt does not match request"
                    )
                targets_version = tuf_receipt["targets_version"]

            if publish_channel:
                assert publish_target and channel_publisher is not None
                channel_document = {
                    "channel": args.channel,
                    "discovery_only": True,
                    "schema_version": 1,
                    "target_name": target_name,
                    "target_sha256": target_sha256,
                    "tuf_targets_version": targets_version,
                }
                channel_raw = _canonical(channel_document)
                channel_sha256 = _sha256(channel_raw)
                channel_path = staging / "platform-channel.json"
                channel_path.write_bytes(channel_raw)
                os.chmod(channel_path, 0o400)
                channel_receipt = _run(
                    channel_publisher,
                    (
                        "publish-channel",
                        "--channel",
                        args.channel,
                        "--document",
                        channel_path,
                    ),
                    environment=_AUTHORITY_ENVIRONMENT,
                    receipt=True,
                )
                expected_channel_receipt = {
                    "channel": args.channel,
                    "document_sha256": channel_sha256,
                    "target_name": target_name,
                    "target_sha256": target_sha256,
                }
                if any(
                    channel_receipt.get(key) != value
                    for key, value in expected_channel_receipt.items()
                ):
                    raise PublicationError(
                        "channel publication receipt does not match request"
                    )
    finally:
        for tool in reversed(tools):
            tool.close()

    result: dict[str, object] = {
        "bundle": expected_bundle,
        "schema_version": 1,
        "target_name": target_name,
        "target_sha256": target_sha256,
    }
    if publish_target:
        result["tuf_targets_version"] = targets_version
    if publish_channel:
        result.update(
            {
                "channel": args.channel,
                "channel_document_sha256": channel_sha256,
            }
        )
    return result


def _publish_channel(args: argparse.Namespace) -> dict[str, object]:
    if _CHANNEL.fullmatch(args.channel) is None or args.channel == "latest":
        raise PublicationError("discovery channel is invalid")
    release_raw = _read_regular(
        args.manifest, limit=_MAX_RELEASE_BYTES, label="platform manifest"
    )
    receipt_raw = _read_regular(
        args.target_receipt,
        limit=_MAX_RECEIPT_BYTES,
        label="target publication receipt",
    )
    try:
        release = PlatformRelease.from_bytes(release_raw)
        release_document = json.loads(release_raw)
        receipt = json.loads(receipt_raw)
    except (PlatformReleaseError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise PublicationError("channel publication input is invalid") from error
    if (
        release_raw != _canonical(release_document)
        or not isinstance(receipt, dict)
        or receipt_raw != _canonical(receipt)
    ):
        raise PublicationError("channel publication input must use canonical bytes")
    target_sha256 = _sha256(release_raw)
    target_name = (
        f"platform/releases/{release.platform_version}/{target_sha256}.json"
    )
    try:
        release.validate_target_identity(target_name, target_sha256)
    except PlatformReleaseError as error:
        raise PublicationError("platform target identity is invalid") from error
    targets_version = receipt.get("tuf_targets_version")
    if (
        set(receipt)
        != {
            "bundle",
            "schema_version",
            "target_name",
            "target_sha256",
            "tuf_targets_version",
        }
        or receipt.get("schema_version") != 1
        or receipt.get("bundle") != _bundle_dict(release.deployment_bundle)
        or receipt.get("target_name") != target_name
        or receipt.get("target_sha256") != target_sha256
        or type(targets_version) is not int
        or targets_version < 1
    ):
        raise PublicationError("target publication receipt does not match manifest")

    channel_document = {
        "channel": args.channel,
        "discovery_only": True,
        "schema_version": 1,
        "target_name": target_name,
        "target_sha256": target_sha256,
        "tuf_targets_version": targets_version,
    }
    channel_raw = _canonical(channel_document)
    with tempfile.TemporaryDirectory(prefix="vonk-platform-channel-") as temporary:
        channel_path = Path(temporary) / "platform-channel.json"
        channel_path.write_bytes(channel_raw)
        os.chmod(channel_path, 0o400)
        publisher = _tool("VONK_PLATFORM_CHANNEL_PUBLISHER_BIN")
        try:
            channel_receipt = _run(
                publisher,
                (
                    "publish-channel",
                    "--channel",
                    args.channel,
                    "--document",
                    channel_path,
                ),
                environment=_AUTHORITY_ENVIRONMENT,
                receipt=True,
            )
        finally:
            publisher.close()
    channel_sha256 = _sha256(channel_raw)
    expected_receipt = {
        "channel": args.channel,
        "document_sha256": channel_sha256,
        "target_name": target_name,
        "target_sha256": target_sha256,
    }
    if any(channel_receipt.get(key) != value for key, value in expected_receipt.items()):
        raise PublicationError("channel publication receipt does not match request")
    return {
        "channel": args.channel,
        "channel_document_sha256": channel_sha256,
        "schema_version": 1,
        "target_name": target_name,
        "target_sha256": target_sha256,
        "tuf_targets_version": targets_version,
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="publish-platform-target")
    subcommands = parser.add_subparsers(dest="command", required=True)
    describe = subcommands.add_parser("describe-bundle")
    describe.add_argument("--bundle", required=True, type=Path)
    describe.add_argument("--repository", required=True)
    publish = subcommands.add_parser("publish")
    publish.add_argument("--manifest", required=True, type=Path)
    publish.add_argument("--bundle", required=True, type=Path)
    publish.add_argument("--channel", default="stable")
    publish_bundle = subcommands.add_parser("publish-bundle")
    publish_bundle.add_argument("--manifest", required=True, type=Path)
    publish_bundle.add_argument("--bundle", required=True, type=Path)
    publish_bundle.add_argument("--channel", default="stable")
    publish_authority = subcommands.add_parser("publish-authority")
    publish_authority.add_argument("--manifest", required=True, type=Path)
    publish_authority.add_argument("--bundle", required=True, type=Path)
    publish_authority.add_argument("--channel", default="stable")
    publish_target = subcommands.add_parser("publish-target")
    publish_target.add_argument("--manifest", required=True, type=Path)
    publish_target.add_argument("--bundle", required=True, type=Path)
    publish_target.add_argument("--channel", default="stable")
    publish_channel = subcommands.add_parser("publish-channel")
    publish_channel.add_argument("--manifest", required=True, type=Path)
    publish_channel.add_argument("--target-receipt", required=True, type=Path)
    publish_channel.add_argument("--channel", default="stable")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.command == "describe-bundle":
            bundle = _read_regular(
                args.bundle, limit=_MAX_BUNDLE_BYTES, label="deployment bundle"
            )
            result = _describe_bundle(bundle, _repository(args.repository))
        elif args.command == "publish":
            result = _publish(args)
        elif args.command == "publish-bundle":
            result = _publish(args, publish_target=False, publish_channel=False)
        elif args.command == "publish-target":
            result = _publish(args, publish_bundle=False, publish_channel=False)
        elif args.command == "publish-channel":
            result = _publish_channel(args)
        else:
            result = _publish(args, publish_bundle=False)
    except PublicationError as error:
        print(f"publish-platform-target: {error}", file=sys.stderr)
        return 2
    print(_canonical(result).decode(), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
