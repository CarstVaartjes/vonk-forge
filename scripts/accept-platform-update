SHA_A = "a" * 64
SHA_B = "b" * 64
SHA_C = "c" * 64
SHA_D = "d" * 64
SHA_E = "e" * 64


def _canonical(value: object) -> bytes:
    return (
        json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
            allow_nan=False,
        )
        + "\n"
    ).encode("ascii")


def _artifact(name: str, digest: str) -> dict[str, object]:
    return {
        "name": name,
        "provenance_sha256": SHA_D,
        "reference": f"registry.example/vonk-forge/{name}@sha256:{digest}",
        "sbom_sha256": SHA_E,
        "sha256": digest,
        "size": 1024,
    }


def _platform_release(
    version: str,
    build: str,
    predecessor: str,
    *,
    predecessor_version: str = "0.9.0",
    predecessor_target_sha256: str = SHA_E,
    predecessor_release_digest: str = "sha256:" + SHA_C,
    predecessor_bundle_digest: str = "sha256:" + SHA_D,
    agent_payload_sha256: str = SHA_B,
    agent_payload_size: int = 4096,
) -> tuple[PlatformRelease, bytes]:
    document = {
        "agents": [
            {
                "architecture": "linux-arm64",
                "artifact": _artifact("agent-linux-arm64", SHA_A),
                "payload": {
                    "name": "vonk-agent",
                    "sha256": agent_payload_sha256,
                    "size": agent_payload_size,
                },
                "protocol": {"maximum": 2, "minimum": 1},
            }
        ],
        "build_digest": f"sha256:{build}",
        "control": {
            "assets": [_artifact("web", SHA_C)],
            "config_version": 1,
            "images": {
                "api": _artifact("api", SHA_A),
                "worker": _artifact("worker", SHA_B),
            },
            "protocol": {"maximum": 2, "minimum": 1},
        },
        "database": {
            "contract_revision": None,
            "expand_revision": "0010_update_rollouts",
            "predecessor_compatible": True,
        },
        "deployment_bundle": {
            "layer_digest": f"sha256:{SHA_B}",
            "layer_media_type": "application/vnd.vonk-forge.control-deployment.v1.tar",
            "layer_size": 1048576,
            "manifest_digest": f"sha256:{SHA_A}",
            "manifest_media_type": "application/vnd.oci.image.manifest.v1+json",
            "manifest_size": 4096,
            "reference": (
                "registry.example/vonk-forge/control-deployment@sha256:" + SHA_A
            ),
        },
        "host_updater_abi": {"maximum": 2, "minimum": 1},
        "platform_version": version,
        "rollback": {
            "predecessors": [
                {
                    "build_digest": f"sha256:{predecessor}",
                    "deployment_bundle_digest": predecessor_bundle_digest,
                    "release_digest": predecessor_release_digest,
                    "target_name": (
                        f"platform/releases/{predecessor_version}/"
                        f"{predecessor_target_sha256}.json"
                    ),
                    "target_sha256": predecessor_target_sha256,
                }
            ]
        },
        "schema_version": 2,
        "supervisors": [
            {
                "architecture": "linux-arm64",
                "artifact": _artifact("supervisor-linux-arm64", SHA_B),
                "payload": {
                    "name": "vonk-agent-supervisor",
                    "sha256": SHA_C,
                    "size": 4096,
                },
            }
        ],
        "tooling": [
            {
                "architecture": "linux-arm64",
                "artifact": _artifact("tooling-linux-arm64", SHA_C),
                "payload": {
                    "name": "vonk-forge-tooling",
                    "sha256": SHA_D,
                    "size": 4096,
                },
            }
        ],
    }
    raw = _canonical(document)
    return PlatformRelease.from_bytes(raw), raw


class _ReleaseSet:
    def __init__(self, targets: dict[str, bytes]) -> None:
        self.targets = dict(targets)
        self.calls: list[str] = []

    def refresh(self, target_name: str) -> tuple[bytes, int]:
        self.calls.append(target_name)
        return self.targets[target_name], 7


class _UpgradeBoundary:
    def __init__(self, state_root: Path, identity_root: Path) -> None:
        self.events: list[str] = []
        self.crash_phase: UpgradePhase | None = None
        self._effects: set[tuple[str, UpgradePhase]] = set()
        self._store = HostGenerationStore(
            state_root, identity_root, owner_uid=os.geteuid()
        )
        self._database_revision = "0010_update_rollouts"
        self._running: dict[str, object] = {
            "control-api": {"generation_id": None, "status": "absent"},
            "control-worker": {"generation_id": None, "status": "absent"},
        }

    def database_revision(self) -> str:
        return self._database_revision

    def site_configuration_digest(self) -> str:
        return "sha256:" + SHA_E

    def running_control_identities(self) -> dict[str, object]:
        return dict(self._running)

    def available_bytes(self) -> int:
        return 64 * 1024 * 1024

    def probe_phase(
        self, phase: UpgradePhase, plan: ControlGenerationPlan
    ) -> PhaseObservation:
        key = (plan.operation_id, phase)
        if key not in self._effects:
            return PhaseObservation(ProbeDisposition.ABSENT, {})
        return PhaseObservation(
            ProbeDisposition.EXACT,
            {"generation_id": plan.generation_id, "phase": phase.value},
        )

    def perform_phase(self, phase: UpgradePhase, plan: ControlGenerationPlan) -> None:
        if phase is UpgradePhase.GENERATION_STAGED:

            def populate(destination: Path) -> None:
                destination.mkdir(mode=0o700)
                (destination / "compose.yaml").write_text("services: {}\n")

            self._store.prepare_staging(plan.generation_id, populate)
        elif phase is UpgradePhase.GENERATION_COMMITTED:
            receipt = GenerationReceipt(
                generation_id=plan.generation_id,
                platform_target_name=plan.platform_target_name,
                platform_target_sha256=plan.platform_target_sha256,
                tuf_targets_version=plan.tuf_targets_version,
                release_digest=plan.release_digest,
                build_digest=plan.build_digest,
                platform_version=plan.platform_version,
                deployment_bundle_digest=plan.deployment_bundle_digest,
                api_image=plan.api_image,
                worker_image=plan.worker_image,
                database_revision=plan.database_revision,
            )
            staged = (
                self._store.state_root
                / "generations"
                / f".{plan.generation_id}.staging"
            )
            self._store.commit_generation(staged, receipt)
        elif phase is UpgradePhase.GENERATION_SELECTED:
            generation = self._store.load_generation(plan.generation_id)
            self._store.select(
                SelectionReceipt.for_generation(
                    generation,
                    operation_id=plan.operation_id,
                    plan_digest=plan.plan_digest,
                    previous_generation=plan.previous_generation,
                )
            )
        elif phase is UpgradePhase.SERVICES_STOPPED_DATABASE_MIGRATED:
            self._database_revision = plan.database_revision
        elif phase is UpgradePhase.SERVICES_STARTED:
            self._running = {
                "control-api": {
                    "generation_id": plan.generation_id,
                    "image": plan.api_image,
                    "status": "running",
                },
                "control-worker": {
                    "generation_id": plan.generation_id,
                    "image": plan.worker_image,
                    "status": "running",
                },
            }
        self.events.append(plan.operation_id + ":" + phase.value)
        self._effects.add((plan.operation_id, phase))
        if self.crash_phase is phase:
            raise RuntimeError("injected crash after exact host phase effect")


def _host_generation_scenario(
    workspace: Path,
    *,
    crash_phase: UpgradePhase = UpgradePhase.BUNDLE_IMAGES_ACQUIRED,
) -> dict[str, object]:
    workspace.mkdir(parents=True, exist_ok=True)
    state = workspace / "control-host"
    identity = workspace / "control-identity"
    previous, previous_raw = _platform_release("1.0.0", SHA_C, SHA_D)
    previous_target_sha256 = hashlib.sha256(previous_raw).hexdigest()
    previous_target_name = (
        f"platform/releases/{previous.platform_version}/{previous_target_sha256}.json"
    )
    candidate, candidate_raw = _platform_release(
        "2.0.0",
        SHA_A,
        SHA_C,
        predecessor_version=previous.platform_version,
        predecessor_target_sha256=previous_target_sha256,
        predecessor_release_digest=previous.digest,
        predecessor_bundle_digest=previous.deployment_bundle.layer_digest,
    )
    candidate_target_sha256 = hashlib.sha256(candidate_raw).hexdigest()
    candidate_target_name = (
        f"platform/releases/{candidate.platform_version}/{candidate_target_sha256}.json"
    )
    newer, newer_raw = _platform_release(
        "3.0.0",
        SHA_B,
        SHA_A,
        predecessor_version=candidate.platform_version,
        predecessor_target_sha256=candidate_target_sha256,
        predecessor_release_digest=candidate.digest,
        predecessor_bundle_digest=candidate.deployment_bundle.layer_digest,
    )
    newer_target_sha256 = hashlib.sha256(newer_raw).hexdigest()
    newer_target_name = (
        f"platform/releases/{newer.platform_version}/{newer_target_sha256}.json"
    )
    authorized = candidate.predecessors[0]
    if (
        authorized.target_sha256 != previous_target_sha256
        or authorized.release_digest != previous.digest
        or authorized.build_digest != previous.build_digest
        or authorized.deployment_bundle_digest
        != previous.deployment_bundle.layer_digest
    ):
        raise RuntimeError("candidate predecessor authorization is invalid")
    release_source = _ReleaseSet(
        {
            previous_target_name: previous_raw,
            candidate_target_name: candidate_raw,
            newer_target_name: newer_raw,
        }
    )
    boundary = _UpgradeBoundary(state, identity)
    operation_count = 0

    def operation_id() -> str:
        nonlocal operation_count
        operation_count += 1
        return f"operation-{operation_count}"

    updater = ControlUpgrade(
        state,
        boundary,
        release_source=release_source,
        operation_id_factory=operation_id,
        start_nonce_factory=lambda: SHA_D,
        host_owner_uid=os.geteuid(),
        identity_root=identity,
    )
    try:
        updater.plan("platform/channels/stable.json")
    except UpgradeConflict:
        mutable_target_rejected = True
    else:
        mutable_target_rejected = False
    unsigned_target_name = "platform/releases/9.9.9/" + "0" * 64 + ".json"
    try:
        updater.plan(unsigned_target_name)
    except UpgradeConflict:
        unsigned_target_rejected = True
    else:
        unsigned_target_rejected = False
    release_source.targets[candidate_target_name] = candidate_raw + b" "
    try:
        updater.plan(candidate_target_name)
    except UpgradeConflict:
        tampered_target_rejected = True
    else:
        tampered_target_rejected = False
    finally:
        release_source.targets[candidate_target_name] = candidate_raw
    release_source.calls.clear()
    old = updater.apply(updater.plan(previous_target_name))
    candidate_plan = updater.plan(candidate_target_name)
    boundary.crash_phase = crash_phase
    try:
        updater.apply(candidate_plan)
    except RuntimeError as error:
        if str(error) != "injected crash after exact host phase effect":
            raise
    else:
        raise RuntimeError("injected control-host crash was accepted")
    boundary.crash_phase = None
    recovered = updater.recover()
    crash_recovered = (
        recovered.generation_id == candidate_plan.generation_id
        and HostGenerationStore(state, identity, owner_uid=os.geteuid())
        .load_active()
        .generation_id
        == candidate_plan.generation_id
    )
    if not crash_recovered:
        raise RuntimeError("control-host crash recovery did not select the candidate")
    revoked_predecessor = release_source.targets.pop(previous_target_name)
    try:
        updater.rollback_plan(old.generation_id)
    except UpgradeConflict:
        revoked_predecessor_rejected = True
    else:
        revoked_predecessor_rejected = False
    finally:
        release_source.targets[previous_target_name] = revoked_predecessor
    rollback_plan = updater.rollback_plan(old.generation_id)
    rolled_back = updater.rollback(rollback_plan)
    selected = HostGenerationStore(
        state, identity, owner_uid=os.geteuid()
    ).load_active()
    if selected is None or selected.generation_id != old.generation_id:
        raise RuntimeError("exact predecessor rollback was not selected")
    generation_asset_ids = sorted(
        path.name
        for path in (state / "generations").iterdir()
        if path.is_dir() and (path / "compose.yaml").is_file()
    )
    operation_journal_count = len(
        [path for path in (state / "operations").iterdir() if path.is_dir()]
    )
    return {
        "authorized_predecessor": True,
        "candidate_generation": candidate_plan.generation_id,
        "crash_phase": crash_phase.value,
        "crash_recovered": crash_recovered,
        "old_generation": old.generation_id,
        "generation_asset_ids": generation_asset_ids,
        "mutable_channel_resolved": any(
            not target.startswith("platform/releases/")
            for target in release_source.calls
        ),
        "mutable_target_rejected": mutable_target_rejected,
        "newer_target_name": newer_target_name,
        "operation_journal_count": operation_journal_count,
        "platform_target_name": candidate_target_name,
        "platform_target_sha256": candidate_target_sha256,
        "recovery_state": rolled_back.status,
        "release_source_calls": release_source.calls,
        "revoked_predecessor_rejected": revoked_predecessor_rejected,
        "selected_generation": selected.generation_id,
        "state_machine_events_sha256": hashlib.sha256(
            _canonical(boundary.events)
        ).hexdigest(),
        "tampered_target_rejected": tampered_target_rejected,
        "tuf_targets_version": candidate_plan.tuf_targets_version,
        "unsigned_target_rejected": unsigned_target_rejected,
    }


def _observation(
    index: int,
    *,
    online: bool = True,
    protocol: int = 1,
) -> AgentObservation:
    return AgentObservation(
        node_id=f"spk_{index:032x}",
        state="active",
        online=online,
        architecture="linux-arm64",
        platform_version="1.0.0",
        build_digest=f"sha256:{SHA_C}",
        protocol_version=protocol,
        active_slot="A",
        agent_sha256=SHA_D,
        supervisor_generation=1,
        capabilities=("agent.rollback", "agent.update"),
        last_seen_at=None,
    )


def _agent_elf() -> bytes:
    content = bytearray(4096)
    content[:7] = b"\x7fELF\x02\x01\x01"
    struct.pack_into("<HH", content, 16, 2, 183)
    return bytes(content)


@dataclass
class _AcceptanceClock:
    now: datetime = datetime(2099, 8, 6, tzinfo=UTC)

    def __call__(self) -> datetime:
        return self.now

    def advance(self, seconds: int) -> None:
        self.now += timedelta(seconds=seconds)


@dataclass(frozen=True)
class _AcceptanceFinalization:
    operation: AgentOperation
    stale: bool = False


class _AcceptanceRoutes:
    def __init__(self, clock: _AcceptanceClock) -> None:
        self._clock = clock
        self.events: list[tuple[str, tuple[str, ...]]] = []

    def withdraw(
        self, rollout_id: str, batch_index: int, targets: tuple[str, ...]
    ) -> RouteDrainReceipt:
        self.events.append(("withdraw", tuple(targets)))
        now = self._clock()
        return RouteDrainReceipt.issue(
            rollout_id=rollout_id,
            batch_index=batch_index,
            targets=targets,
            route_digest=hashlib.sha256(
                canonical_message(
                    {
                        "batch_index": batch_index,
                        "rollout_id": rollout_id,
                        "targets": list(targets),
                    }
                )
            ).hexdigest(),
            drained_at=now,
            expires_at=now + timedelta(seconds=60),
        )

    def restore(
        self, rollout_id: str, batch_index: int, targets: tuple[str, ...]
    ) -> str:
        self.events.append(("restore", tuple(targets)))
        return hashlib.sha256(
            canonical_message(
                {
                    "batch_index": batch_index,
                    "restored": True,
                    "rollout_id": rollout_id,
                    "targets": list(targets),
                }
            )
        ).hexdigest()


class _AcceptanceAgentJobs:
    def __init__(
        self,
        sessions: sessionmaker[Session],
        clock: _AcceptanceClock,
    ) -> None:
        self._sessions = sessions
        self._clock = clock
        self.enqueued: list[tuple[str, str]] = []

    def reserve_update_authorization_in_session(
        self,
        session: Session,
        *,
        rollout_id: str,
        rollout_node_id: str,
        operation: str,
        payload: dict[str, object],
        target_release_digest: str | None,
    ) -> dict[str, object]:
        node = session.get(UpdateRolloutNode, rollout_node_id)
        if node is None or node.rollout_id != rollout_id:
            raise RuntimeError("acceptance rollout node binding is unavailable")
        return {
            "node_id": node.node_id,
            "operation": operation,
            "operation_id": str(uuid.uuid4()),
            "payload": dict(payload),
            "rollout_node_id": rollout_node_id,
            "target_release_digest": target_release_digest,
        }

    @staticmethod
    def sign_update_authorization(
        reserved: object,
    ) -> dict[str, object]:
        if not isinstance(reserved, dict):
            raise TypeError("acceptance authorization reservation is invalid")
        return {"signed_payload": dict(reserved["payload"])}

    def finalize_update_authorization_in_session(
        self,
        session: Session,
        reserved: object,
        response: dict[str, object],
    ) -> _AcceptanceFinalization:
        if not isinstance(reserved, dict):
            raise TypeError("acceptance authorization reservation is invalid")
        rollout_node = session.get(
            UpdateRolloutNode, str(reserved["rollout_node_id"])
        )
        if rollout_node is None:
            raise RuntimeError("acceptance rollout node is unavailable")
        rollout = session.get(UpdateRollout, rollout_node.rollout_id)
        if rollout is None or rollout.job_id is None:
            raise RuntimeError("acceptance rollout job is unavailable")
        payload = response.get("signed_payload")
        if not isinstance(payload, dict):
            raise TypeError("acceptance signed payload is invalid")
        operation = self.enqueue_in_session(
            session,
            rollout.job_id,
            str(reserved["node_id"]),
            str(reserved["operation"]),
            rollout.authority_revision,
            payload,
            operation_id=str(reserved["operation_id"]),
            prepared_update=(
                payload if reserved["operation"] == "agent.update" else None
            ),
        )
        return _AcceptanceFinalization(operation)

    @staticmethod
    def mark_update_authorizations_stale(reserved: list[object]) -> None:
        if not reserved:
            raise RuntimeError("acceptance stale authorization set is empty")

    def enqueue_in_session(
        self,
        session: Session,
        parent_job_id: str,
        node_id: str,
        operation: str,
        authority_revision: str,
        payload: dict[str, object],
        *,
        operation_id: str,
        prepared_update: object | None = None,
    ) -> AgentOperation:
        if operation == "agent.update" and prepared_update != payload:
            raise RuntimeError("acceptance update preparation is inconsistent")
        stored = AgentOperation(
            id=operation_id,
            parent_job_id=parent_job_id,
            node_id=node_id,
            kind=operation,
            payload_digest=hashlib.sha256(canonical_message(payload)).hexdigest(),
            payload=payload,
            authority_revision=authority_revision,
            state="queued",
            current_attempt=0,
            created_at=self._clock(),
            updated_at=self._clock(),
        )
        session.add(stored)
        session.flush()
        self.enqueued.append((operation, node_id))
        return stored

    def notify_available(self) -> None:
        return None


def _acceptance_rollout(
    sessions: sessionmaker[Session], rollout_id: str
) -> UpdateRollout:
    with sessions() as session:
        rollout = session.get(UpdateRollout, rollout_id)
        if rollout is None:
            raise RuntimeError("acceptance rollout is unavailable")
        session.expunge(rollout)
        return rollout


def _acceptance_rollout_node(
    sessions: sessionmaker[Session], rollout_id: str, node_id: str
) -> UpdateRolloutNode:
    with sessions() as session:
        node = session.scalar(
            select(UpdateRolloutNode).where(
                UpdateRolloutNode.rollout_id == rollout_id,
                UpdateRolloutNode.node_id == node_id,
            )
        )
        if node is None:
            raise RuntimeError("acceptance rollout node is unavailable")
        session.expunge(node)
        return node


def _acceptance_record_contact(
    session: Session,
    node: AgentNode,
) -> None:
    serial = f"acceptance-{node.node_id}"
    certificate = session.get(AgentCertificate, serial)
    if certificate is None or node.last_seen_at is None:
        raise RuntimeError("acceptance certificate evidence is unavailable")
    runtime_identity = {
        "active_slot": node.active_slot,
        "architecture": node.architecture,
        "agent_sha256": node.agent_sha256,
        "build_digest": node.build_digest,
        "platform_version": node.platform_version,
        "self_test_passed": node.self_test_passed,
        "supervisor_generation": node.supervisor_generation,
        "supervisor_ready_generation": node.supervisor_ready_generation,
    }
    node.contact_certificate_serial = serial
    node.contact_observation_digest = hashlib.sha256(
        canonical_message(
            {
                "certificate_fingerprint": certificate.fingerprint,
                "certificate_serial": serial,
                "node_id": node.node_id,
                "observed_at": node.last_seen_at.replace(tzinfo=UTC).isoformat(),
                "runtime_identity": runtime_identity,
            }
        )
    ).hexdigest()


def _acceptance_complete_operation(
    sessions: sessionmaker[Session],
    clock: _AcceptanceClock,
    rollout_id: str,
    node_id: str,
    *,
    role: str,
    target_build: str,
    target_sha256: str,
    generation: int,
    succeeded: bool = True,
) -> None:
    with sessions.begin() as session:
        rollout_node = session.scalar(
            select(UpdateRolloutNode).where(
                UpdateRolloutNode.rollout_id == rollout_id,
                UpdateRolloutNode.node_id == node_id,
            )
        )
        if rollout_node is None:
            raise RuntimeError("acceptance rollout node is unavailable")
        operation_id = (
            rollout_node.operation_id
            if role == "update"
            else rollout_node.rollback_operation_id
        )
        operation = session.get(AgentOperation, operation_id)
        if operation is None:
            raise RuntimeError("acceptance operation is unavailable")
        operation.state = "succeeded" if succeeded else "failed"
        operation.updated_at = clock()
        node = session.get(AgentNode, node_id)
        if node is None:
            raise RuntimeError("acceptance agent node is unavailable")
        if role == "update":
            node.platform_version = "2.0.0"
            node.build_digest = target_build
            node.active_slot = "B"
            node.agent_sha256 = target_sha256
        else:
            node.platform_version = "1.0.0"
            node.build_digest = "sha256:" + SHA_C
            node.active_slot = "A"
            node.agent_sha256 = SHA_D
        node.supervisor_generation = generation
        node.supervisor_ready_generation = generation
        node.self_test_passed = True
        node.last_seen_at = clock()
        _acceptance_record_contact(session, node)


def _model_probe_scenario() -> dict[str, object]:
    requested: list[str] = []

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            requested.append(self.path)
            if self.path == "/health":
                document = {"status": "healthy"}
            elif self.path == "/v1/models":
                document = {"repository_revision": "f" * 40}
            else:
                self.send_error(404)
                return
            content = _canonical(document)
            self.send_response(200)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(content)))
            self.end_headers()
            self.wfile.write(content)

        def log_message(self, _format: str, *_arguments: object) -> None:
            return None

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        origin = f"http://127.0.0.1:{server.server_port}"
        with urllib.request.urlopen(origin + "/health", timeout=2) as response:
            health_status = response.status
            health = json.loads(response.read())
        with urllib.request.urlopen(origin + "/v1/models", timeout=2) as response:
            route_status = response.status
            models = json.loads(response.read())
    finally:
        server.shutdown()
        thread.join(timeout=2)
        server.server_close()
    if (
        health_status != 200
        or health != {"status": "healthy"}
        or route_status != 200
        or models != {"repository_revision": "f" * 40}
        or requested != ["/health", "/v1/models"]
    ):
        raise RuntimeError("simulated model HTTP probe failed")
    return {
        "health": health["status"],
        "repository_revision": models["repository_revision"],
        "request_count": len(requested),
        "requested_paths": requested,
        "route_status": route_status,
    }


def _orchestrator_scenario(
    workspace: Path,
    target: TargetPlatform,
) -> dict[str, object]:
    online_nodes = tuple(f"spk_{index:032x}" for index in range(101, 117))
    offline_node = f"spk_{117:032x}"
    clock = _AcceptanceClock()
    engine = create_engine(f"sqlite:///{workspace / 'rollout.sqlite'}")
    Base.metadata.create_all(engine)
    sessions = sessionmaker(engine, expire_on_commit=False)
    with sessions.begin() as session:
        for node_id in (*online_nodes, offline_node):
            session.add(
                AgentNode(
                    node_id=node_id,
                    state="active",
                    architecture="linux-arm64",
                    protocol_version=1,
                    platform_version="1.0.0",
                    build_digest="sha256:" + SHA_C,
                    active_slot="A",
                    agent_sha256=SHA_D,
                    supervisor_generation=1,
                    capabilities=["agent.rollback", "agent.update"],
                    last_seen_at=clock(),
                )
            )
            session.add(
                AgentCertificate(
                    serial=f"acceptance-{node_id}",
                    node_id=node_id,
                    not_before=clock() - timedelta(days=1),
                    not_after=clock() + timedelta(days=1),
                    fingerprint=f"acceptance-fingerprint-{node_id}",
                    state="active",
                    generation=1,
                )
            )
    observations = tuple(
        AgentObservation(
            node_id=node_id,
            state="active",
            online=node_id != offline_node,
            architecture="linux-arm64",
            platform_version="1.0.0",
            build_digest="sha256:" + SHA_C,
            protocol_version=1,
            active_slot="A",
            agent_sha256=SHA_D,
            supervisor_generation=1,
            capabilities=("agent.rollback", "agent.update"),
            last_seen_at=clock(),
        )
        for node_id in (*online_nodes, offline_node)
    )
    workload = DistributedWorkload(
        workload_id="accepted-model-replicas",
        members=online_nodes,
        minimum_available=15,
    )
    plan = UpdatePlanner().plan(
        target,
        observations,
        (workload,),
        RolloutPolicy(batch_size=1, soak_seconds=0),
    )
    if (
        len(plan.batches) != 16
        or plan.offline_pending != (offline_node,)
        or any(len(batch) != 1 for batch in plan.batches)
    ):
        raise RuntimeError("sixteen-node acceptance rollout plan is invalid")
    routes = _AcceptanceRoutes(clock)
    jobs = _AcceptanceAgentJobs(sessions, clock)
    orchestrator = UpdateOrchestrator(sessions, jobs, routes, clock=clock)
    rollout_id = orchestrator.create(
        plan,
        actor="acceptance-admin",
        request_id="10000000-0000-4000-8000-000000000001",
    )
    trace: list[str] = []
    canary = plan.canary_node
    if canary is None:
        raise RuntimeError("acceptance rollout canary is unavailable")

    if orchestrator.advance(rollout_id) != "withdrawing":
        raise RuntimeError("acceptance canary did not enter withdrawal")
    if orchestrator.advance(rollout_id) != "updating":
        raise RuntimeError("acceptance canary was not dispatched after drain")
    trace.append("routes-withdrawn")
    _acceptance_complete_operation(
        sessions,
        clock,
        rollout_id,
        canary,
        role="update",
        target_build=target.build_digest,
        target_sha256=target.artifacts[0].payload_sha256,
        generation=2,
        succeeded=False,
    )
    trace.append("canary-update-failed-after-slot-B")
    if orchestrator.advance(rollout_id) != "paused":
        raise RuntimeError("failed acceptance canary did not pause rollout")
    trace.append("rollout-paused")
    if orchestrator.begin_rollback(
        rollout_id,
        actor="acceptance-admin",
        request_id="20000000-0000-4000-8000-000000000002",
        admin_grant={"simulated": True},
    ) != "rolling-back":
        raise RuntimeError("acceptance canary rollback was not dispatched")
    trace.append("operator-rollback-dispatched")
    _acceptance_complete_operation(
        sessions,
        clock,
        rollout_id,
        canary,
        role="rollback",
        target_build=target.build_digest,
        target_sha256=target.artifacts[0].payload_sha256,
        generation=3,
    )
    if orchestrator.advance(rollout_id) != "rollback-publishing":
        raise RuntimeError("acceptance rollback identity was not accepted")
    trace.append("slot-A-readiness-proven")
    if orchestrator.advance(rollout_id) != "waiting-for-approval":
        raise RuntimeError("acceptance rollback routes were not restored")
    trace.append("routes-restored")
    if orchestrator.approve_resume(
        rollout_id,
        actor="acceptance-admin",
        request_id="30000000-0000-4000-8000-000000000003",
        reason="simulated canary rollback verified",
    ) != "planned":
        raise RuntimeError("acceptance rollout was not approved to resume")
    trace.append("administrator-approved-resume")

    for batch in plan.batches:
        node_id = batch[0]
        if orchestrator.advance(rollout_id) != "withdrawing":
            raise RuntimeError("acceptance batch did not enter withdrawal")
        if orchestrator.advance(rollout_id) != "updating":
            raise RuntimeError("acceptance batch was not dispatched after drain")
        current = _acceptance_rollout_node(sessions, rollout_id, node_id)
        generation = 4 if node_id == canary else 2
        if current.state != "updating":
            raise RuntimeError("acceptance batch operation is not active")
        _acceptance_complete_operation(
            sessions,
            clock,
            rollout_id,
            node_id,
            role="update",
            target_build=target.build_digest,
            target_sha256=target.artifacts[0].payload_sha256,
            generation=generation,
        )
        if orchestrator.advance(rollout_id) != "soaking":
            raise RuntimeError("acceptance batch did not enter soak")
        if orchestrator.advance(rollout_id) != "publishing":
            raise RuntimeError("acceptance batch did not pass soak")
        state = orchestrator.advance(rollout_id)
        if state not in {"planned", "partial"}:
            raise RuntimeError("acceptance batch routes were not restored")

    rollout = _acceptance_rollout(sessions, rollout_id)
    with sessions() as session:
        accepted = session.scalars(
            select(UpdateRolloutNode).where(
                UpdateRolloutNode.rollout_id == rollout_id,
                UpdateRolloutNode.state == "accepted",
            )
        ).all()
        pending = session.scalar(
            select(UpdateRolloutNode).where(
                UpdateRolloutNode.rollout_id == rollout_id,
                UpdateRolloutNode.node_id == offline_node,
            )
        )
        final_nodes = tuple(
            session.get(AgentNode, node_id) for node_id in online_nodes
        )
    if (
        rollout.state != "partial"
        or len(accepted) != 16
        or pending is None
        or pending.state != "offline-pending"
        or any(
            node is None
            or node.platform_version != target.platform_version
            or node.build_digest != target.build_digest
            for node in final_nodes
        )
    ):
        raise RuntimeError("sixteen-node acceptance rollout did not converge")
    trace.append("sixteen-nodes-accepted")
    return {
        "accepted_node_count": len(accepted),
        "batches": [list(batch) for batch in plan.batches],
        "canary_failure_trace": trace,
        "canary_node": canary,
        "offline_pending": [offline_node],
        "orchestrator_rollout_state": rollout.state,
        "route_restoration_count": sum(
            event == "restore" for event, _targets in routes.events
        ),
        "route_withdrawal_count": sum(
            event == "withdraw" for event, _targets in routes.events
        ),
        "scheduled_node_count": sum(len(batch) for batch in plan.batches),
    }


def _fleet_scenario(workspace: Path) -> dict[str, object]:
    agent_content = _agent_elf()
    agent_payload_sha256 = hashlib.sha256(agent_content).hexdigest()
    candidate_release, candidate_raw = _platform_release(
        "2.0.0",
        SHA_A,
        SHA_C,
        agent_payload_sha256=agent_payload_sha256,
        agent_payload_size=len(agent_content),
    )
    target = TargetPlatform(
        platform_version="2.0.0",
        build_digest=f"sha256:{SHA_A}",
        release_digest=candidate_release.digest,
        authority_revision="f" * 64,
        protocol_minimum=1,
        protocol_maximum=2,
        tuf_targets_version=7,
        artifacts=(
            PlatformAgentArtifact(
                architecture="linux-arm64",
                oci_manifest_digest=f"sha256:{SHA_A}",
                payload_name="vonk-agent",
                payload_sha256=agent_payload_sha256,
                payload_size=len(agent_content),
            ),
        ),
    )
    orchestration = _orchestrator_scenario(workspace, target)
    observations = (
        _observation(1),
        _observation(2),
        _observation(3, online=False),
        _observation(4, protocol=9),
    )
    analyzer = VersionSkewAnalyzer()
    before = analyzer.compare(target, observations)
    if not before.prompt_required:
        raise RuntimeError("NAS-newer skew failed to create a prompt")
    plan = UpdatePlanner().plan(
        target,
        observations,
        (),
        RolloutPolicy(batch_size=1, soak_seconds=0),
    )
    if len(plan.batches) != 2 or plan.batches[0] != (plan.canary_node,):
        raise RuntimeError("rollout plan did not isolate a canary")
    class _ReleaseSource:
        def refresh(self, target_name: str) -> tuple[bytes, int]:
            expected = (
                "platform/releases/2.0.0/"
                + hashlib.sha256(candidate_raw).hexdigest()
                + ".json"
            )
            if target_name != expected:
                raise RuntimeError("signed plan target is stale")
            return candidate_raw, 7

    authority = UpdateAuthorizationAuthority(
        ed25519.Ed25519PrivateKey.from_private_bytes(bytes.fromhex("11" * 32)),
        release_source=_ReleaseSource(),
    )
    payload = plan.payload_for(plan.canary_node)
    target_name = (
        "platform/releases/2.0.0/" + hashlib.sha256(candidate_raw).hexdigest() + ".json"
    )
    prepared = authority.refresh_and_validate(payload, target_name=target_name)
    now = datetime(2099, 8, 6, tzinfo=UTC)
    expiry = int((now + timedelta(minutes=5)).timestamp())
    signed = authority.authorize(
        payload,
        operation_id="11111111-1111-4111-8111-111111111111",
        fence="22222222-2222-4222-8222-222222222222",
        expires_at=expiry,
        previous_slot="A",
        previous_sha256=SHA_C,
        previous_generation=1,
        node_id=plan.canary_node,
        attempt=1,
        claim_deadline=expiry,
        prepared=prepared,
        now=now,
    )
    if signed["signature"]["key_id"] != authority.key_id:
        raise RuntimeError("signed update authorization identity is invalid")
    updated_observations = (
        *(
            AgentObservation(
                node_id=item.node_id,
                state=item.state,
                online=True,
                architecture=item.architecture,
                platform_version=target.platform_version,
                build_digest=target.build_digest,
                protocol_version=1,
                active_slot="B",
                agent_sha256=agent_payload_sha256,
                supervisor_generation=2,
                capabilities=item.capabilities,
                last_seen_at=None,
            )
            for item in observations[:2]
        ),
        observations[2],
        observations[3],
    )
    final_skew = analyzer.compare(target, updated_observations)
    final_statuses = {item.node_id: item.status for item in final_skew.nodes}
    final_online_current = all(
        final_statuses[observations[index].node_id] == "current" for index in (0, 1)
    )
    simulated_model_probe = _model_probe_scenario()
    final_model_verified = (
        simulated_model_probe["health"] == "healthy"
        and simulated_model_probe["route_status"] == 200
    )
    return {
        **orchestration,
        "final_model_probe": simulated_model_probe,
        "final_model_verified": final_model_verified,
        "final_online_current": final_online_current,
        "incompatible": list(plan.incompatible),
        "platform_target_name": target_name,
        "platform_target_sha256": prepared.target_sha256,
        "release_digest": target.release_digest,
        "signed_authorization_key_id": authority.key_id,
        "signed_authorization_receipt_sha256": "sha256:"
        + hashlib.sha256(_canonical(signed["receipt"])).hexdigest(),
        "signed_plan_digest": plan.plan_digest,
        "tuf_targets_version": prepared.targets_version,
    }


class _Jobs:
    def get(self, job_id: str) -> object:
        raise KeyError(job_id)

    def list(self, *, limit: int = 100) -> list[object]:
        del limit
        return []

    def list_page(self, **_arguments: object) -> tuple[list[object], None, int]:
        return [], None, 0


@dataclass
class _UpdateApiService:
    plan_digest: str
    platform_target_name: str
    calls: list[str] = field(default_factory=list)

    def _rollout(self, state: str = "planned") -> dict[str, object]:
        return {
            "can_approve_resume": state == "waiting-for-approval",
            "failure_reason": None,
            "id": "10000000-0000-4000-8000-000000000001",
            "job_id": "20000000-0000-4000-8000-000000000002",
            "nodes": [],
            "plan_digest": self.plan_digest,
            "resume_required": state == "waiting-for-approval",
            "state": state,
        }

    def skew(self) -> dict[str, object]:
        self.calls.append("skew")
        target_sha256 = self.platform_target_name.removesuffix(".json").rsplit("/", 1)[
            1
        ]
        return {
            "prompt_required": True,
            "digest": "sha256:" + SHA_D,
            "target": {
                "build_digest": "sha256:" + SHA_A,
                "platform_version": "2.0.0",
                "protocol_maximum": 2,
                "protocol_minimum": 1,
                "release": self.platform_target_name,
                "release_digest": "sha256:" + target_sha256,
                "target_sha256": target_sha256,
                "tuf_targets_version": 7,
            },
        }

    def plan(self, *, release: str) -> dict[str, object]:
        if release != self.platform_target_name:
            raise ValueError("release changed")
        self.calls.append("plan")
        return {"plan_digest": self.plan_digest}

    def apply(self, plan_digest: str, actor: str, request_id: str) -> dict[str, object]:
        if plan_digest != self.plan_digest or actor != "operator" or not request_id:
            raise ValueError("confirmation binding changed")
        self.calls.append("apply")
        return self._rollout()

    def status(self, rollout_id: str) -> dict[str, object]:
        if rollout_id != "10000000-0000-4000-8000-000000000001":
            raise KeyError(rollout_id)
        self.calls.append("status")
        return self._rollout("waiting-for-approval")

    def approve_resume(
        self,
        rollout_id: str,
        actor: str,
        request_id: str,
        reason: str,
    ) -> dict[str, object]:
        if (
            rollout_id != "10000000-0000-4000-8000-000000000001"
            or actor != "administrator"
            or not request_id
            or reason != "rollback physically verified"
        ):
            raise ValueError("resume approval binding changed")
        self.calls.append("approve-resume")
        return self._rollout("resumed")


@dataclass(frozen=True)
class _Document:
    value: dict[str, object]

    def to_dict(self) -> dict[str, object]:
        return self.value


class _CliUpdateClient:
    def __init__(self, plan_digest: str, platform_target_name: str) -> None:
        self.plan_digest = plan_digest
        self.platform_target_name = platform_target_name
        self.calls: list[str] = []

    def update_skew(self) -> _Document:
        self.calls.append("skew")
        return _Document({"prompt_required": True})

    def plan_update(self, release: str) -> _Document:
        if release != self.platform_target_name:
            raise ValueError("CLI release changed")
        self.calls.append("plan")
        return _Document({"plan_digest": self.plan_digest})

    def apply_update(self, plan_digest: str) -> _Document:
        if plan_digest != self.plan_digest:
            raise ValueError("CLI plan confirmation changed")
        self.calls.append("apply")
        return _Document({"id": "10000000-0000-4000-8000-000000000001"})

    def update_status(self, rollout_id: str) -> _Document:
        if rollout_id != "10000000-0000-4000-8000-000000000001":
            raise ValueError("CLI rollout ID changed")
        self.calls.append("status")
        return _Document({"state": "paused"})


def _admin_interface_scenario(
    plan_digest: str, platform_target_name: str
) -> dict[str, object]:
    service = _UpdateApiService(plan_digest, platform_target_name)
    codec = TokenCodec(b"acceptance-token-key" * 2)
    app = create_app(
        jobs=_Jobs(),
        tokens=codec,
        audits=MemoryAuditStore(),
        fleet=lambda: {"nodes": []},
        now=lambda: 10,
        updates=service,
    )
    client = TestClient(app)

    def headers(role: str) -> dict[str, str]:
        token = codec.issue(Actor(role, role), ttl_seconds=100, now=0)
        return {"Authorization": f"Bearer {token}"}

    skew = client.get("/api/v1/updates/skew", headers=headers("viewer"))
    if service.calls != ["skew"]:
        raise RuntimeError("reading the NAS-newer prompt mutated update state")
    skew_target = skew.json()["target"]
    planned = client.post(
        "/api/v1/updates/plan",
        headers=headers("operator"),
        json={"release": platform_target_name},
    )
    if planned.status_code != 200 or service.calls != ["skew", "plan"]:
        raise RuntimeError("update API planning failed")
    applied = client.post(
        "/api/v1/updates",
        headers=headers("operator"),
        json={"plan_digest": plan_digest},
    )
    resume = client.post(
        "/api/v1/updates/10000000-0000-4000-8000-000000000001/approve-resume",
        headers=headers("administrator"),
        json={"reason": "rollback physically verified"},
    )
    if service.calls != ["skew", "plan", "apply", "approve-resume"]:
        raise RuntimeError("update API confirmation sequence is invalid")

    cli = _CliUpdateClient(plan_digest, platform_target_name)
    commands = (
        ("admin", "updates", "skew", "--json"),
        (
            "admin",
            "updates",
            "plan",
            "--release",
            platform_target_name,
            "--json",
        ),
        (
            "admin",
            "updates",
            "apply",
            "--plan-digest",
            plan_digest,
            "--json",
        ),
        (
            "admin",
            "updates",
            "status",
            "10000000-0000-4000-8000-000000000001",
            "--json",
        ),
    )
    for command in commands:
        with redirect_stdout(StringIO()):
            if vonkctl_main(command, control_client=cli) != 0:
                raise RuntimeError("vonkctl update command failed")
    return {
        "api_apply_status": applied.status_code,
        "api_rollout_plan_digest": applied.json()["plan_digest"],
        "api_resume_status": resume.status_code,
        "api_skew_status": skew.status_code,
        "cli_commands": cli.calls,
        "confirmation_required": service.calls.index("plan")
        < service.calls.index("apply"),
        "platform_target_name": platform_target_name,
        "skew_platform_target_name": skew_target["release"],
        "skew_release_digest": skew_target["release_digest"],
        "skew_target_sha256": skew_target["target_sha256"],
        "skew_tuf_targets_version": skew_target["tuf_targets_version"],
    }


def simulate() -> dict[str, object]:
    with tempfile.TemporaryDirectory(prefix="vonk-platform-update-") as raw:
        workspace = Path(raw)
        host = _host_generation_scenario(workspace)
        fleet = _fleet_scenario(workspace)
    admin_interfaces = _admin_interface_scenario(
        str(fleet["signed_plan_digest"]), str(fleet["platform_target_name"])
    )
    scenario_evidence = {
        "canary_failure_pause": "rollout-paused" in fleet["canary_failure_trace"],
        "compatible_rolling_update": (
            len(fleet["batches"]) == 16
            and fleet["scheduled_node_count"] == 16
            and fleet["accepted_node_count"] == 16
            and fleet["orchestrator_rollout_state"] == "partial"
        ),
        "admin_confirmation_route_contract": (
            admin_interfaces["confirmation_required"] is True
            and admin_interfaces["api_apply_status"] == 202
            and admin_interfaces["api_rollout_plan_digest"]
            == fleet["signed_plan_digest"]
            and admin_interfaces["platform_target_name"]
            == fleet["platform_target_name"]
            and admin_interfaces["skew_platform_target_name"]
            == fleet["platform_target_name"]
            and admin_interfaces["skew_release_digest"] == fleet["release_digest"]
            and admin_interfaces["skew_target_sha256"]
            == fleet["platform_target_sha256"]
            and admin_interfaces["skew_tuf_targets_version"]
            == fleet["tuf_targets_version"]
            and isinstance(fleet["signed_authorization_key_id"], str)
        ),
        "control_host_old_new_rollback_recovery": (
            host["recovery_state"] == "rolled-back"
            and host["crash_recovered"] is True
            and host["selected_generation"] == host["old_generation"]
        ),
        "final_fleet_and_model_verification": (
            fleet["final_online_current"] is True
            and fleet["final_model_verified"] is True
            and fleet["final_model_probe"]["request_count"] == 2
        ),
        "incompatible_mutation_blocking": (
            len(fleet["incompatible"]) == 1
            and all(fleet["incompatible"][0] not in batch for batch in fleet["batches"])
        ),
        "nas_newer_prompt_without_mutation": admin_interfaces["api_skew_status"] == 200,
        "offline_node_pending": (
            len(fleet["offline_pending"]) == 1
            and all(
                fleet["offline_pending"][0] not in batch for batch in fleet["batches"]
            )
        ),
        "resume_after_administrator_approval": admin_interfaces["api_resume_status"]
        == 202,
    }
    if not all(scenario_evidence.values()):
        failed = sorted(
            name for name, passed in scenario_evidence.items() if not passed
        )
        raise RuntimeError("platform update scenarios failed: " + ",".join(failed))
    report: dict[str, object] = {
        "admin_interfaces": admin_interfaces,
        "evidence_kind": "simulated",
        "fleet": fleet,
        "host": host,
        "interfaces_exercised": [
            "ControlUpgrade",
            "PlatformRelease",
            "UpdateAuthorizationAuthority",
            "UpdateOrchestrator",
            "UpdatePlanner",
            "VersionSkewAnalyzer",
            "control API update route contract with simulated service",
            "vonkctl update command contract with simulated client",
        ],
        "physical_evidence": {
            "control_host_update_recovery": {
                "evidence_sha256": None,
                "exercised": False,
            },
            "signed_platform_update_manifest": {
                "evidence_sha256": None,
                "exercised": False,
            },
            "node_canary_and_rollback": {
                "evidence_sha256": None,
                "exercised": False,
            },
        },
        "remaining_release_gates": [
            "physical-control-host-update-recovery",
            "physical-node-canary-rollback",
            "signed-platform-update-manifest-evidence",
        ],
        "report_type": "vonk-forge-platform-update",
        "scenario_evidence": scenario_evidence,
        "scenarios": {name: "passed" for name in scenario_evidence},
        "schema_version": 1,
        "ssh_used_for_standard_path": False,
        "standard_path": "outbound-mtls-agent-channel",
        "status": "passed",
    }
    report["digest"] = "sha256:" + hashlib.sha256(_canonical(report)).hexdigest()
    return report


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run the deterministic simulated Vonk Forge platform update gate."
    )
    parser.add_argument("--output", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    content = _canonical(simulate())
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_bytes(content)
    if args.json or not args.output:
        sys.stdout.buffer.write(content)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
