#!/usr/bin/env python3
"""Create and verify digest-bound development image acceptance receipts."""

from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import sys
import tarfile
import tempfile
from collections.abc import Sequence
from pathlib import Path
from typing import Any

SCHEMA = "vonk-forge.dev-image-acceptance.v3"
ROLE_SCHEMA = "vonk-forge.dev-image-role-acceptance.v3"
ROLES = ("api", "worker", "hermes", "litellm")
IMAGES = {
    "api": "ghcr.io/carstvaartjes/vonk-forge-api",
    "worker": "ghcr.io/carstvaartjes/vonk-forge-worker",
    "hermes": "ghcr.io/carstvaartjes/vonk-forge-hermes",
    "litellm": "ghcr.io/carstvaartjes/vonk-forge-litellm",
}
COMPOSE_FILES = ("docker-compose.dev.yml", "docker-compose.pinned.yml")
COMMIT = re.compile(r"[0-9a-f]{40}\Z")
RUN_ID = re.compile(r"[1-9][0-9]*\Z")
DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")
SHA256 = re.compile(r"[0-9a-f]{64}\Z")
ROLE_KEYS = {"artifact", "image", "source", "manifest_digest"}


class ReceiptError(ValueError):
    """The receipt or one of the files it binds is invalid."""


def _require_keys(value: Any, expected: set[str], context: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != expected:
        raise ReceiptError(f"{context} has an invalid shape")
    return value


def _regular_file(path: Path) -> None:
    try:
        metadata = path.lstat()
    except FileNotFoundError as error:
        raise ReceiptError(f"required file is missing: {path.name}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise ReceiptError(f"required file is not a regular file: {path.name}")


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _validate_identity(commit: str, run_id: str, run_attempt: str) -> None:
    if (
        COMMIT.fullmatch(commit) is None
        or RUN_ID.fullmatch(run_id) is None
        or RUN_ID.fullmatch(run_attempt) is None
    ):
        raise ReceiptError("acceptance identity is invalid")


def _artifact(role: str, commit: str, run_id: str, run_attempt: str) -> str:
    return f"development-role-receipt-{role}-{commit}-{run_id}-{run_attempt}"


def _validate_role_entry(
    value: object,
    commit: str,
    run_id: str,
    run_attempt: str,
    role: str,
    context: str,
) -> dict[str, Any]:
    entry = _require_keys(value, ROLE_KEYS, context)
    image = IMAGES[role]
    digest = entry["manifest_digest"]
    if (
        entry["artifact"] != _artifact(role, commit, run_id, run_attempt)
        or entry["image"] != image
        or not isinstance(digest, str)
        or DIGEST.fullmatch(digest) is None
        or entry["source"] != f"{image}@{digest}"
    ):
        raise ReceiptError(f"{context} is invalid")
    return entry


def _load_json(path: Path, context: str) -> Any:
    _regular_file(path)

    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ReceiptError("acceptance receipt has duplicate keys")
            result[key] = value
        return result

    try:
        return json.loads(path.read_text(), object_pairs_hook=reject_duplicates)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ReceiptError(f"{context} is not valid JSON") from error


def _load_role_receipt(
    path: Path, commit: str, run_id: str, run_attempt: str, role: str
) -> dict[str, Any]:
    document = _load_json(path, f"{role} acceptance receipt")
    root = _require_keys(
        document,
        {
            "schema",
            "commit",
            "run_id",
            "run_attempt",
            "role",
            *ROLE_KEYS,
        },
        f"{role} acceptance receipt",
    )
    if (
        root["schema"] != ROLE_SCHEMA
        or root["commit"] != commit
        or root["run_id"] != run_id
        or root["run_attempt"] != run_attempt
        or root["role"] != role
    ):
        raise ReceiptError(
            f"{role} acceptance receipt identity does not match this run"
        )
    entry = {key: root[key] for key in ROLE_KEYS}
    return _validate_role_entry(
        entry, commit, run_id, run_attempt, role, f"{role} acceptance receipt"
    )


def _load_receipt(
    path: Path, commit: str, run_id: str, run_attempt: str
) -> dict[str, Any]:
    document = _load_json(path, "acceptance receipt")
    root = _require_keys(
        document,
        {"schema", "commit", "run_id", "run_attempt", "roles", "compose"},
        "receipt",
    )
    if (
        root["schema"] != SCHEMA
        or root["commit"] != commit
        or root["run_id"] != run_id
        or root["run_attempt"] != run_attempt
    ):
        raise ReceiptError("acceptance receipt identity does not match this run")
    roles = _require_keys(root["roles"], set(ROLES), "receipt roles")
    for role in ROLES:
        _validate_role_entry(
            roles[role], commit, run_id, run_attempt, role, f"receipt role {role}"
        )
    compose = _require_keys(root["compose"], set(COMPOSE_FILES), "receipt compose")
    for name in COMPOSE_FILES:
        entry = _require_keys(compose[name], {"sha256", "size"}, f"receipt {name}")
        if (
            not isinstance(entry["size"], int)
            or isinstance(entry["size"], bool)
            or entry["size"] <= 0
            or not isinstance(entry["sha256"], str)
            or SHA256.fullmatch(entry["sha256"]) is None
        ):
            raise ReceiptError(f"receipt {name} has invalid evidence")
    return root


def _file_evidence(path: Path) -> dict[str, Any]:
    _regular_file(path)
    return {"sha256": _sha256(path), "size": path.stat().st_size}


def validate_archive_members(archive: Path) -> None:
    _regular_file(archive)
    seen: set[str] = set()
    required = {"index.json", "oci-layout"}
    allowed_directories = {"blobs", "blobs/sha256"}
    try:
        with tarfile.open(archive, mode="r:*") as stream:
            for member in stream.getmembers():
                name = member.name.removeprefix("./").rstrip("/")
                if not name or name in seen:
                    raise ReceiptError("OCI archive has an invalid or duplicate member")
                seen.add(name)
                if name in allowed_directories:
                    if not member.isdir():
                        raise ReceiptError("OCI archive directory member is invalid")
                elif name in required:
                    if not member.isfile() or member.size <= 0:
                        raise ReceiptError("OCI archive metadata member is invalid")
                elif name.startswith("blobs/sha256/"):
                    digest = name.removeprefix("blobs/sha256/")
                    if SHA256.fullmatch(digest) is None or not member.isfile():
                        raise ReceiptError("OCI archive blob member is invalid")
                else:
                    raise ReceiptError(f"unsafe OCI archive member: {member.name}")
    except tarfile.TarError as error:
        raise ReceiptError("OCI archive cannot be read") from error
    if not required.issubset(seen):
        raise ReceiptError("OCI archive metadata is incomplete")


def _write_json(output: Path, document: dict[str, Any]) -> None:
    if not output.parent.is_dir() or output.is_symlink():
        raise ReceiptError("receipt output path is invalid")
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{output.name}.", dir=output.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(document, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, output)
    finally:
        temporary.unlink(missing_ok=True)


def create_role(
    output: Path,
    commit: str,
    run_id: str,
    run_attempt: str,
    role: str,
    image: str,
    digest: str,
) -> None:
    _validate_identity(commit, run_id, run_attempt)
    if role not in ROLES or image != IMAGES[role] or DIGEST.fullmatch(digest) is None:
        raise ReceiptError("role acceptance identity is invalid")
    _write_json(
        output,
        {
            "schema": ROLE_SCHEMA,
            "commit": commit,
            "run_id": run_id,
            "run_attempt": run_attempt,
            "role": role,
            "artifact": _artifact(role, commit, run_id, run_attempt),
            "image": image,
            "source": f"{image}@{digest}",
            "manifest_digest": digest,
        },
    )


def _load_role_receipts(
    root: Path, commit: str, run_id: str, run_attempt: str
) -> dict[str, dict[str, Any]]:
    if not root.is_dir() or root.is_symlink():
        raise ReceiptError("role receipt root is invalid")
    return {
        role: _load_role_receipt(
            root / f"{role}.role-receipt.json", commit, run_id, run_attempt, role
        )
        for role in ROLES
    }


def collect(role_root: Path, commit: str, run_id: str, run_attempt: str) -> None:
    _validate_identity(commit, run_id, run_attempt)
    roles = _load_role_receipts(role_root, commit, run_id, run_attempt)
    for role in ROLES:
        print(f"{role}_digest={roles[role]['manifest_digest']}")


def aggregate(
    output: Path,
    commit: str,
    run_id: str,
    run_attempt: str,
    role_root: Path,
    compose_root: Path,
) -> None:
    _validate_identity(commit, run_id, run_attempt)
    roles = _load_role_receipts(role_root, commit, run_id, run_attempt)
    if not compose_root.is_dir() or compose_root.is_symlink():
        raise ReceiptError("Compose receipt root is invalid")
    compose = {name: _file_evidence(compose_root / name) for name in COMPOSE_FILES}
    _write_json(
        output,
        {
            "schema": SCHEMA,
            "commit": commit,
            "run_id": run_id,
            "run_attempt": run_attempt,
            "roles": {
                role: {key: roles[role][key] for key in ROLE_KEYS} for role in ROLES
            },
            "compose": compose,
        },
    )


def verify(
    receipt_path: Path,
    commit: str,
    run_id: str,
    run_attempt: str,
    publication_root: Path,
) -> None:
    _validate_identity(commit, run_id, run_attempt)
    if not publication_root.is_dir() or publication_root.is_symlink():
        raise ReceiptError("publication root is invalid")
    receipt = _load_receipt(receipt_path, commit, run_id, run_attempt)
    for name in COMPOSE_FILES:
        if _file_evidence(publication_root / name) != receipt["compose"][name]:
            raise ReceiptError(f"accepted {name} does not match its receipt")


def main(argv: Sequence[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    try:
        if len(arguments) == 2 and arguments[0] == "validate-archive":
            validate_archive_members(Path(arguments[1]))
        elif len(arguments) == 8 and arguments[0] == "create-role":
            create_role(
                Path(arguments[1]),
                arguments[2],
                arguments[3],
                arguments[4],
                arguments[5],
                arguments[6],
                arguments[7],
            )
        elif len(arguments) == 5 and arguments[0] == "collect":
            collect(Path(arguments[1]), arguments[2], arguments[3], arguments[4])
        elif len(arguments) == 7 and arguments[0] == "aggregate":
            aggregate(
                Path(arguments[1]),
                arguments[2],
                arguments[3],
                arguments[4],
                Path(arguments[5]),
                Path(arguments[6]),
            )
        elif len(arguments) == 6 and arguments[0] == "verify":
            verify(
                Path(arguments[1]),
                arguments[2],
                arguments[3],
                arguments[4],
                Path(arguments[5]),
            )
        else:
            raise ReceiptError(
                "usage: dev-image-acceptance-receipt "
                "validate-archive ARCHIVE | "
                "create-role RECEIPT COMMIT RUN_ID RUN_ATTEMPT ROLE IMAGE DIGEST | "
                "collect ROLE_ROOT COMMIT RUN_ID RUN_ATTEMPT | "
                "aggregate RECEIPT COMMIT RUN_ID RUN_ATTEMPT ROLE_ROOT COMPOSE_ROOT | "
                "verify RECEIPT COMMIT RUN_ID RUN_ATTEMPT PUBLICATION_ROOT"
            )
    except (OSError, ReceiptError) as error:
        print(f"dev-image-acceptance-receipt: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
