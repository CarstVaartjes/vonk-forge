#!/usr/bin/env python3
"""Create and destroy the API-only tailnet used by NAS acceptance.

`cleanup` is the sanctioned removal for a stale disposable child whose creating
run died before its runner-local state file could be used.  It cannot run on a
developer machine: the factory credential that reaches the API-only children is
an environment secret on the `installer-canary-dev` GitHub environment, so the
`workflow_dispatch` path in `.github/workflows/installer-publication.yml` is the
primary interface rather than a convenience.  Running it locally fails on the
missing credential, which is expected and not a broken script.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any, Callable

API_BASE = "https://api.tailscale.com/api/v2"
ISOLATED_TAILNET_KIND = "isolated-disposable-test"
SAFE_DNS_NAME = re.compile(r"tail[a-z0-9-]+\.ts\.net\Z")
SAFE_ID = re.compile(r"[A-Za-z0-9_-]{3,128}\Z")
SAFE_DISPLAY_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9 '\-]{2,62}\Z")
SERVICES = (
    ("svc:vonk-forge", "Vonk Forge"),
    ("svc:hermes-api", "Hermes API"),
    ("svc:hermes-dashboard", "Hermes dashboard"),
)
STALE_CHILD_AGE = timedelta(minutes=60)
# Every disposable CI child is named `Vonk Forge CI <run> attempt <n>`.  Only
# this exact prefix is eligible for stale cleanup; `Vonk Forge CI` alone is a
# production-name candidate, so the trailing space is part of the boundary.
CI_CHILD_DISPLAY_PREFIX = "Vonk Forge CI "
# One page is both the request bound and the consideration bound: cleanup never
# paginates, so it can only ever act on what a single listing showed it.
ORGANIZATION_TAILNET_LIST_LIMIT = 100
# A run that dies leaves at most one child, so a healthy backlog is a handful of
# dead runs.  Refuse a listing that would delete more than this rather than
# emptying an organization in one manual dispatch.
MAX_CLEANUP_CHILDREN = 20


class LifecycleError(RuntimeError):
    """A fail-closed disposable-tailnet lifecycle error."""


class ApiRequestError(LifecycleError):
    """A sanitized API failure carrying only retry-control metadata."""

    def __init__(
        self,
        message: str,
        *,
        method: str,
        path: str,
        status_code: int | None,
    ) -> None:
        super().__init__(message)
        self.method = method
        self.path = path
        self.status_code = status_code


@dataclass(frozen=True)
class ApiResponse:
    document: dict[str, Any]
    etag: str | None


@dataclass(frozen=True)
class ProtectedState:
    document: dict[str, str]
    device: int
    inode: int


def _required_environment(name: str) -> str:
    value = os.environ.get(name, "")
    if not value or any(character in value for character in "\0\r\n"):
        raise LifecycleError(f"required secret {name} is missing or invalid")
    return value


def _transport_cause(error: BaseException) -> str:
    """Name the underlying transport failure for a "was unavailable" line.

    `urllib` wraps most failures in `URLError` and keeps the reason; a bare
    `TimeoutError` from a read has none. Without this the message cannot tell a
    DNS failure from a refused connection from the 30-second read timeout, which
    is exactly the distinction the disposable-tailnet flake needs.

    Only the reason's type and text are reported. The request URL, headers and
    body can carry the OAuth client secret, and `ApiRequestError` stays
    sanitized, so the reason is flattened to one bounded line.
    """
    reason = error.reason if isinstance(error, urllib.error.URLError) else error
    detail = " ".join(str(reason).split())
    if len(detail) > 120:
        detail = f"{detail[:117]}..."
    return f"{type(reason).__name__}: {detail}" if detail else type(reason).__name__


def _request(
    method: str,
    path: str,
    *,
    access_token: str | None = None,
    json_body: object | None = None,
    form_body: dict[str, str] | None = None,
    headers: dict[str, str] | None = None,
) -> ApiResponse:
    if json_body is not None and form_body is not None:
        raise LifecycleError("an API request cannot contain JSON and form bodies")
    request_headers = {"Accept": "application/json"}
    data: bytes | None = None
    if access_token is not None:
        request_headers["Authorization"] = f"Bearer {access_token}"
    if json_body is not None:
        request_headers["Content-Type"] = "application/json"
        data = json.dumps(json_body, separators=(",", ":"), sort_keys=True).encode()
    elif form_body is not None:
        request_headers["Content-Type"] = "application/x-www-form-urlencoded"
        data = urllib.parse.urlencode(form_body).encode()
    if headers:
        request_headers.update(headers)
    request = urllib.request.Request(
        f"{API_BASE}{path}", data=data, headers=request_headers, method=method
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
            etag = response.headers.get("ETag")
    except urllib.error.HTTPError as error:
        raise ApiRequestError(
            f"Tailscale API {method} {path} failed with HTTP {error.code}",
            method=method,
            path=path,
            status_code=error.code,
        ) from error
    except (TimeoutError, urllib.error.URLError) as error:
        raise ApiRequestError(
            f"Tailscale API {method} {path} was unavailable "
            f"({_transport_cause(error)})",
            method=method,
            path=path,
            status_code=None,
        ) from error
    if not raw:
        return ApiResponse(document={}, etag=etag)
    try:
        document = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise LifecycleError(
            f"Tailscale API {method} {path} returned invalid JSON"
        ) from error
    # The Tailscale delete endpoint may acknowledge a successful deletion with
    # JSON `null` or a scalar message instead of an object.  DELETE callers do
    # not consume a response document, so normalize those acknowledgements to
    # the same empty response used for a 204.  Keep object validation strict
    # for every other method (and for unexpected DELETE arrays/numbers/bools).
    if method == "DELETE" and (document is None or isinstance(document, str)):
        return ApiResponse(document={}, etag=etag)
    if not isinstance(document, dict):
        raise LifecycleError(
            f"Tailscale API {method} {path} returned an invalid document"
        )
    return ApiResponse(document=document, etag=etag)


def _oauth_token(
    client_id: str,
    client_secret: str,
    *,
    scope: str,
    tailnet: str | None = None,
) -> str:
    """Exchange an OAuth client for an access token.

    `tailnet` selects an API-only child tailnet to act against.  That is the
    documented recovery path when the child's own returned OAuth credential died
    with its runner: an OAuth client owned by the creating tailnet names the
    target in the token request.  It requires the `all` scope, so only the
    cleanup path passes it.
    """
    form_body = {
        "client_id": client_id,
        "client_secret": client_secret,
        "scope": scope,
    }
    if tailnet is not None:
        if SAFE_ID.fullmatch(tailnet) is None:
            raise LifecycleError("disposable tailnet ID is invalid")
        form_body["tailnet"] = tailnet
    response = _request(
        "POST",
        "/oauth/token",
        form_body=form_body,
    )
    token = response.document.get("access_token")
    if not isinstance(token, str) or not token or any(c in token for c in "\0\r\n"):
        raise LifecycleError("Tailscale OAuth returned an invalid access token")
    print(f"::add-mask::{token}")
    return token


def _write_state(path: Path, document: dict[str, str]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    payload = (
        json.dumps(document, separators=(",", ":"), sort_keys=True) + "\n"
    ).encode()
    try:
        descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except OSError as error:
        raise LifecycleError("cannot create disposable tailnet state") from error
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def _read_state(path: Path) -> ProtectedState | None:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise LifecycleError("disposable tailnet state is unsafe") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_mode & 0o077
            or metadata.st_size > 8192
        ):
            raise LifecycleError("disposable tailnet state is unsafe")
        with os.fdopen(descriptor, "rb") as stream:
            descriptor = -1
            raw = stream.read(8193)
        if len(raw) > 8192:
            raise LifecycleError("disposable tailnet state is unsafe")
        document = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise LifecycleError("disposable tailnet state is invalid") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if not isinstance(document, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in document.items()
    ):
        raise LifecycleError("disposable tailnet state is invalid")
    return ProtectedState(
        document=document,
        device=metadata.st_dev,
        inode=metadata.st_ino,
    )


def _child_token_factory(
    client_id: str,
    client_secret: str,
    *,
    tailnet_id: str | None = None,
) -> Callable[[], str]:
    """Mint `all`-scoped access tokens for one child tailnet.

    Without `tailnet_id` the tokens come from the child's own OAuth credential,
    which exists only on the runner that created it.  With `tailnet_id` they
    come from the creating OAuth client naming the target child, which is the
    documented recovery for a stale child whose runner is gone: the creating
    client must carry the `all` scope.  A `tailnets`-only creating credential
    cannot mint this token, which is a clean refusal and never a mutation.
    """

    def token() -> str:
        return _oauth_token(
            client_id, client_secret, scope="all", tailnet=tailnet_id
        )

    return token


def _delete_tailnet(
    tailnet_id: str, access_token_factory: Callable[[], str]
) -> None:
    """Delete exactly one tailnet, with one owner for the DELETE request.

    The token is minted per attempt so a retry cannot present an expired
    credential; `delete(state=...)` supplies the child's own lifecycle token and
    `cleanup` supplies a factory-minted token for the child.
    """
    if SAFE_ID.fullmatch(tailnet_id) is None:
        raise LifecycleError("disposable tailnet ID is invalid")
    path = f"/tailnet/{urllib.parse.quote(tailnet_id, safe='')}"
    transient_statuses = {408, 409, 425, 429, *range(500, 600)}
    for attempt in range(4):
        try:
            _request("DELETE", path, access_token=access_token_factory())
            return
        except ApiRequestError as error:
            if (
                error.method == "DELETE"
                and error.path == path
                and error.status_code == 404
            ):
                return
            retryable = (
                error.status_code is None or error.status_code in transient_statuses
            )
            if not retryable or attempt == 3:
                raise
            time.sleep(min(2**attempt, 4))
    raise AssertionError("unreachable")


def _list_organization_tailnets(access_token: str) -> list[dict[str, Any]]:
    """Read the organization tailnet list. One owner for this request shape.

    Preflight and cleanup share this, so they cannot drift into disagreeing
    about which children exist or how the list is validated.
    """
    response = _request(
        "GET",
        f"/organizations/-/tailnets?limit={ORGANIZATION_TAILNET_LIST_LIMIT}",
        access_token=access_token,
    )
    tailnets = response.document.get("tailnets")
    if not isinstance(tailnets, list) or not all(
        isinstance(tailnet, dict) for tailnet in tailnets
    ):
        raise LifecycleError("Tailscale returned an invalid organization tailnet list")
    return tailnets


def _assert_no_stale_children(access_token: str) -> None:
    """Fail closed while a live run still owns its child tailnet.

    Selection -- not this function -- decides staleness.  Creation never
    deletes: the child's own state file is the only child-authorized cleanup
    path, and `create` does not have it.  `cleanup` is the sanctioned
    child-authorized path for a child whose state file died with its runner.
    """
    stale = _select_stale_ci_children(_list_organization_tailnets(access_token))
    if stale:
        children = ", ".join(f"{tailnet_id} ({name})" for tailnet_id, name in stale)
        raise LifecycleError(
            "stale disposable CI tailnets require explicit child-authorized cleanup: "
            f"{children}"
        )


def _stale_ci_child(now: datetime, tailnet: dict[str, Any]) -> tuple[str, str] | None:
    """Classify one organization tailnet; refuse anything unproven.

    Returns the identity of a stale CI child, `None` for a tailnet this
    lifecycle does not own (a production tailnet, or a live run's young child),
    and raises for a CI-named tailnet whose identity cannot be validated.  An
    unreadable name, id or timestamp is never skipped: skipping would silently
    leave a wedge in place, and reading it as stale could delete a live run's
    network mid-acceptance.
    """
    display_name = tailnet.get("displayName")
    if not isinstance(display_name, str) or not display_name.startswith(
        CI_CHILD_DISPLAY_PREFIX
    ):
        return None
    tailnet_id = tailnet.get("id")
    created_at = tailnet.get("createdAt")
    if (
        SAFE_DISPLAY_NAME.fullmatch(display_name) is None
        or not isinstance(tailnet_id, str)
        or SAFE_ID.fullmatch(tailnet_id) is None
        or not isinstance(created_at, str)
    ):
        raise LifecycleError("Tailscale returned an unsafe CI child identity")
    try:
        created = datetime.fromisoformat(created_at)
    except ValueError as error:
        raise LifecycleError(
            "Tailscale returned an invalid CI child timestamp"
        ) from error
    if created.tzinfo is None:
        raise LifecycleError("Tailscale returned an invalid CI child timestamp")
    if now - created.astimezone(UTC) < STALE_CHILD_AGE:
        return None
    return tailnet_id, display_name


def _select_stale_ci_children(
    tailnets: list[dict[str, Any]], *, child_id: str | None = None
) -> list[tuple[str, str]]:
    """Select the stale CI children a caller may delete, and nothing else.

    Without `child_id` this is every stale CI child in reading order.  With an
    explicit id it is exactly that child, still only after the same name,
    identity, timestamp and age checks; an id this listing cannot prove is
    refused by name rather than skipped.  The returned order is the deletion
    order, so a caller can report each id and display name as it acts.
    """
    now = datetime.now(UTC)
    selected: list[tuple[str, str]] = []
    for tailnet in tailnets:
        child = _stale_ci_child(now, tailnet)
        if child is None:
            continue
        if child_id is not None:
            if child[0] == child_id:
                # The listing repeated this id; deleting it twice is pointless
                # and a duplicated identity is itself not worth acting on twice.
                return [child]
            continue
        selected.append(child)
    if child_id is not None:
        raise LifecycleError(
            "no stale disposable CI tailnet matches the requested id "
            f"{child_id}: it is absent from the organization listing, is not a "
            f"{CI_CHILD_DISPLAY_PREFIX.strip()} child, or is younger than "
            f"{_describe_age(STALE_CHILD_AGE)}"
        )
    return selected


def _describe_age(age: timedelta) -> str:
    minutes = int(age.total_seconds() // 60)
    return f"{minutes} minutes"


def _factory_credentials() -> tuple[str, str]:
    """Read the repository-secret factory credential pair, or fail closed."""
    return (
        _required_environment("VONK_ACCEPTANCE_TAILNET_FACTORY_OAUTH_CLIENT_ID"),
        _required_environment("VONK_ACCEPTANCE_TAILNET_FACTORY_OAUTH_CLIENT_SECRET"),
    )


def cleanup(*, child_id: str | None = None) -> None:
    """Delete stale disposable CI children the factory credential authorizes.

    Bounded and idempotent: it considers one organization listing, deletes at
    most `MAX_CLEANUP_CHILDREN` proven-stale CI children, and reports each
    deletion by id and display name.  A second run finds nothing and succeeds.
    """
    if child_id is not None and SAFE_ID.fullmatch(child_id) is None:
        raise LifecycleError("disposable tailnet ID is invalid")
    factory_id, factory_secret = _factory_credentials()
    stale = _select_stale_ci_children(
        _list_organization_tailnets(
            _oauth_token(factory_id, factory_secret, scope="tailnets")
        ),
        child_id=child_id,
    )
    if len(stale) > MAX_CLEANUP_CHILDREN:
        raise LifecycleError(
            f"{len(stale)} stale disposable CI tailnets exceed the bounded "
            f"cleanup limit of {MAX_CLEANUP_CHILDREN}"
        )
    deleted = 0
    try:
        for tailnet_id, display_name in stale:
            _delete_tailnet(
                tailnet_id,
                _child_token_factory(
                    factory_id, factory_secret, tailnet_id=tailnet_id
                ),
            )
            deleted += 1
            print(f"Deleted stale disposable CI tailnet {tailnet_id} ({display_name})")
    finally:
        print(
            f"Stale disposable CI tailnet cleanup: deleted {deleted} of "
            f"{len(stale)} selected (bounded at {MAX_CLEANUP_CHILDREN})"
        )


def _configure_tailnet(
    tailnet_id: str, client_id: str, client_secret: str
) -> tuple[str, str]:
    token = _oauth_token(client_id, client_secret, scope="all")
    quoted_tailnet = urllib.parse.quote(tailnet_id, safe="")
    for service, display_name in SERVICES:
        response = _request(
            "PUT",
            f"/tailnet/{quoted_tailnet}/services/"
            f"{urllib.parse.quote(service, safe='')}",
            access_token=token,
            json_body={
                "comment": "Ephemeral Vonk Forge installer acceptance",
                "displayName": display_name,
                "name": service,
                "ports": ["tcp:443"],
            },
        )
        if response.document.get("name") != service or response.document.get(
            "ports"
        ) != ["tcp:443"]:
            raise LifecycleError(f"Tailscale did not create exact Service {service}")
    listed_services = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/services",
        access_token=token,
    ).document.get("vipServices")
    expected_services = {service: ["tcp:443"] for service, _ in SERVICES}
    exact_services = (
        isinstance(listed_services, list)
        and len(listed_services) == len(expected_services)
        and all(isinstance(service, dict) for service in listed_services)
        and all(isinstance(service.get("name"), str) for service in listed_services)
        and len({service.get("name") for service in listed_services})
        == len(expected_services)
        and {service.get("name"): service.get("ports") for service in listed_services}
        == expected_services
    )
    if not exact_services:
        raise LifecycleError("Tailscale Service readback was not exact")
    service_names = [service for service, _ in SERVICES]
    child_policy = {
        "acls": [],
        "autoApprovers": {
            "services": {service: ["tag:vonk-gateway"] for service in service_names}
        },
        "grants": [
            {
                "dst": service_names,
                "ip": ["tcp:443"],
                "src": ["tag:vonk-gateway"],
            }
        ],
        "tagOwners": {"tag:vonk-gateway": ["autogroup:admin"]},
    }
    policy = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/acl",
        access_token=token,
    )
    if (
        not isinstance(policy.etag, str)
        or not policy.etag
        or len(policy.etag) > 256
        or any(character in policy.etag for character in "\0\r\n")
    ):
        raise LifecycleError("Tailscale did not return the child policy ETag")
    _request(
        "POST",
        f"/tailnet/{quoted_tailnet}/acl",
        access_token=token,
        headers={"If-Match": policy.etag},
        json_body=child_policy,
    )
    readback_policy = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/acl",
        access_token=token,
    )
    if readback_policy.document != child_policy:
        raise LifecycleError("Tailscale child policy readback was not exact")
    gateway_client = _request(
        "POST",
        f"/tailnet/{quoted_tailnet}/keys",
        access_token=token,
        json_body={
            "description": "Vonk Forge CI gateway acceptance",
            "keyType": "client",
            "scopes": ["auth_keys"],
            "tags": ["tag:vonk-gateway"],
        },
    ).document
    gateway_id = gateway_client.get("id")
    gateway_secret = gateway_client.get("key")
    if (
        not isinstance(gateway_id, str)
        or SAFE_ID.fullmatch(gateway_id) is None
        or not isinstance(gateway_secret, str)
        or not gateway_secret
        or any(character in gateway_secret for character in "\0\r\n")
        or gateway_client.get("keyType") != "client"
        or gateway_client.get("scopes") != ["auth_keys"]
        or gateway_client.get("tags") != ["tag:vonk-gateway"]
    ):
        raise LifecycleError("Tailscale returned an invalid gateway client")
    print(f"::add-mask::{gateway_secret}")
    metadata = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/keys/{urllib.parse.quote(gateway_id, safe='')}",
        access_token=token,
    ).document
    if (
        metadata.get("id") != gateway_id
        or metadata.get("keyType") != "client"
        or metadata.get("scopes") != ["auth_keys"]
        or metadata.get("tags") != ["tag:vonk-gateway"]
    ):
        raise LifecycleError("Tailscale gateway client readback was not exact")
    return gateway_id, gateway_secret


def _append_github_environment(path: Path, values: dict[str, str]) -> None:
    if not path.is_absolute():
        raise LifecycleError("GitHub environment path must be absolute")
    for name, value in values.items():
        if (
            re.fullmatch(r"[A-Z0-9_]+", name) is None
            or not value
            or any(character in value for character in "\0\r\n")
        ):
            raise LifecycleError("generated GitHub environment is invalid")
    try:
        with path.open("a", encoding="utf-8") as stream:
            for name, value in values.items():
                stream.write(f"{name}={value}\n")
    except OSError as error:
        raise LifecycleError("cannot write GitHub environment") from error


def create(*, display_name: str, github_env: Path, state: Path) -> None:
    if SAFE_DISPLAY_NAME.fullmatch(display_name) is None:
        raise LifecycleError("disposable tailnet display name is invalid")
    if state.exists() or state.is_symlink():
        raise LifecycleError("disposable tailnet state already exists")
    factory_id = _required_environment(
        "VONK_ACCEPTANCE_TAILNET_FACTORY_OAUTH_CLIENT_ID"
    )
    factory_secret = _required_environment(
        "VONK_ACCEPTANCE_TAILNET_FACTORY_OAUTH_CLIENT_SECRET"
    )
    token = _oauth_token(factory_id, factory_secret, scope="tailnets")
    _assert_no_stale_children(token)
    response = _request(
        "POST",
        "/organizations/-/tailnets",
        access_token=token,
        json_body={"displayName": display_name},
    )
    document = response.document
    tailnet_id = document.get("id")
    dns_name = document.get("dnsName")
    oauth_client = document.get("oauthClient")
    if (
        not isinstance(tailnet_id, str)
        or SAFE_ID.fullmatch(tailnet_id) is None
        or not isinstance(oauth_client, dict)
        or not isinstance(oauth_client.get("id"), str)
        or SAFE_ID.fullmatch(oauth_client["id"]) is None
        or not isinstance(oauth_client.get("secret"), str)
        or not oauth_client["secret"]
        or any(c in oauth_client["secret"] for c in "\0\r\n")
    ):
        raise LifecycleError(
            "Tailscale returned invalid new-tailnet deletion credentials"
        )
    client_id = oauth_client["id"]
    client_secret = oauth_client["secret"]
    print(f"::add-mask::{client_secret}")
    try:
        _write_state(
            state,
            {
                "client_id": client_id,
                "client_secret": client_secret,
                "tailnet_id": tailnet_id,
            },
        )
    except BaseException:
        _delete_tailnet(tailnet_id, _child_token_factory(client_id, client_secret))
        raise
    try:
        if (
            not isinstance(dns_name, str)
            or SAFE_DNS_NAME.fullmatch(dns_name) is None
            or document.get("alreadyExists", False) is not False
        ):
            raise LifecycleError("Tailscale returned an invalid new-tailnet identity")
        gateway_client_id, gateway_client_secret = _configure_tailnet(
            tailnet_id, client_id, client_secret
        )
        _append_github_environment(
            github_env,
            {
                "VONK_ACCEPTANCE_TAILNET_DNS_SUFFIX": dns_name,
                "VONK_ACCEPTANCE_TAILNET_KIND": ISOLATED_TAILNET_KIND,
                "VONK_ACCEPTANCE_TAILSCALE_OAUTH_CLIENT_ID": gateway_client_id,
                "VONK_ACCEPTANCE_TAILSCALE_OAUTH_CLIENT_SECRET": gateway_client_secret,
            },
        )
    except BaseException:
        _delete_tailnet(tailnet_id, _child_token_factory(client_id, client_secret))
        state.unlink()
        raise


def delete(*, state: Path) -> None:
    protected_state = _read_state(state)
    if protected_state is None:
        return
    document = protected_state.document
    if set(document) != {"client_id", "client_secret", "tailnet_id"}:
        raise LifecycleError("disposable tailnet state is incomplete")
    print(f"::add-mask::{document['client_secret']}")
    _delete_tailnet(
        document["tailnet_id"],
        _child_token_factory(document["client_id"], document["client_secret"]),
    )
    try:
        current = state.lstat()
    except FileNotFoundError as error:
        raise LifecycleError(
            "disposable tailnet state changed during cleanup"
        ) from error
    if (current.st_dev, current.st_ino) != (
        protected_state.device,
        protected_state.inode,
    ):
        raise LifecycleError("disposable tailnet state changed during cleanup")
    state.unlink()


def main() -> None:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    create_parser = subparsers.add_parser("create")
    create_parser.add_argument("--display-name", required=True)
    create_parser.add_argument("--github-env", type=Path, required=True)
    create_parser.add_argument("--state", type=Path, required=True)
    delete_parser = subparsers.add_parser("delete")
    delete_parser.add_argument("--state", type=Path, required=True)
    cleanup_parser = subparsers.add_parser("cleanup")
    cleanup_parser.add_argument(
        "--id",
        default=None,
        help=(
            "Clean exactly this stale CI child instead of every stale CI child "
            "in the organization listing. The same name, identity and age "
            "checks still apply."
        ),
    )
    arguments = parser.parse_args()
    if arguments.command == "create":
        create(
            display_name=arguments.display_name,
            github_env=arguments.github_env,
            state=arguments.state,
        )
    elif arguments.command == "delete":
        delete(state=arguments.state)
    else:
        cleanup(child_id=arguments.id)


if __name__ == "__main__":
    try:
        main()
    except (LifecycleError, OSError) as error:
        raise SystemExit(f"Tailscale acceptance tailnet: {error}") from error
