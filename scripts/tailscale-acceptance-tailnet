#!/usr/bin/env python3
"""Create and destroy the API-only tailnet used by NAS acceptance."""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any

API_BASE = "https://api.tailscale.com/api/v2"
ISOLATED_TAILNET_KIND = "isolated-disposable-test"
SAFE_DNS_NAME = re.compile(r"tail[a-z0-9-]+\.ts\.net\Z")
SAFE_ID = re.compile(r"[A-Za-z0-9_-]{3,128}\Z")
SAFE_DISPLAY_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9 '\-]{2,62}\Z")
SERVICES = (
    ("svc:vonk-forge", "Vonk Forge"),
    ("svc:hermes-api", "Hermes API"),
    ("svc:hermes-dashboard", "Hermes dashboard"),
)
STALE_CHILD_AGE = timedelta(minutes=60)


class LifecycleError(RuntimeError):
    """A fail-closed disposable-tailnet lifecycle error."""


class ApiRequestError(LifecycleError):
    """A sanitized API failure carrying only retry-control metadata."""

    def __init__(
        self,
        message: str,
        *,
        method: str,
        path: str,
        status_code: int | None,
    ) -> None:
        super().__init__(message)
        self.method = method
        self.path = path
        self.status_code = status_code


@dataclass(frozen=True)
class ApiResponse:
    document: dict[str, Any]
    etag: str | None


@dataclass(frozen=True)
class ProtectedState:
    document: dict[str, str]
    device: int
    inode: int


def _required_environment(name: str) -> str:
    value = os.environ.get(name, "")
    if not value or any(character in value for character in "\0\r\n"):
        raise LifecycleError(f"required secret {name} is missing or invalid")
    return value


def _request(
    method: str,
    path: str,
    *,
    access_token: str | None = None,
    json_body: object | None = None,
    form_body: dict[str, str] | None = None,
    headers: dict[str, str] | None = None,
) -> ApiResponse:
    if json_body is not None and form_body is not None:
        raise LifecycleError("an API request cannot contain JSON and form bodies")
    request_headers = {"Accept": "application/json"}
    data: bytes | None = None
    if access_token is not None:
        request_headers["Authorization"] = f"Bearer {access_token}"
    if json_body is not None:
        request_headers["Content-Type"] = "application/json"
        data = json.dumps(json_body, separators=(",", ":"), sort_keys=True).encode()
    elif form_body is not None:
        request_headers["Content-Type"] = "application/x-www-form-urlencoded"
        data = urllib.parse.urlencode(form_body).encode()
    if headers:
        request_headers.update(headers)
    request = urllib.request.Request(
        f"{API_BASE}{path}", data=data, headers=request_headers, method=method
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
            etag = response.headers.get("ETag")
    except urllib.error.HTTPError as error:
        raise ApiRequestError(
            f"Tailscale API {method} {path} failed with HTTP {error.code}",
            method=method,
            path=path,
            status_code=error.code,
        ) from error
    except (TimeoutError, urllib.error.URLError) as error:
        raise ApiRequestError(
            f"Tailscale API {method} {path} was unavailable",
            method=method,
            path=path,
            status_code=None,
        ) from error
    if not raw:
        return ApiResponse(document={}, etag=etag)
    try:
        document = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise LifecycleError(
            f"Tailscale API {method} {path} returned invalid JSON"
        ) from error
    if not isinstance(document, dict):
        raise LifecycleError(
            f"Tailscale API {method} {path} returned an invalid document"
        )
    return ApiResponse(document=document, etag=etag)


def _oauth_token(client_id: str, client_secret: str, *, scope: str) -> str:
    response = _request(
        "POST",
        "/oauth/token",
        form_body={
            "client_id": client_id,
            "client_secret": client_secret,
            "scope": scope,
        },
    )
    token = response.document.get("access_token")
    if not isinstance(token, str) or not token or any(c in token for c in "\0\r\n"):
        raise LifecycleError("Tailscale OAuth returned an invalid access token")
    print(f"::add-mask::{token}")
    return token


def _write_state(path: Path, document: dict[str, str]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    payload = (
        json.dumps(document, separators=(",", ":"), sort_keys=True) + "\n"
    ).encode()
    try:
        descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except OSError as error:
        raise LifecycleError("cannot create disposable tailnet state") from error
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def _read_state(path: Path) -> ProtectedState | None:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise LifecycleError("disposable tailnet state is unsafe") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_mode & 0o077
            or metadata.st_size > 8192
        ):
            raise LifecycleError("disposable tailnet state is unsafe")
        with os.fdopen(descriptor, "rb") as stream:
            descriptor = -1
            raw = stream.read(8193)
        if len(raw) > 8192:
            raise LifecycleError("disposable tailnet state is unsafe")
        document = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise LifecycleError("disposable tailnet state is invalid") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if not isinstance(document, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in document.items()
    ):
        raise LifecycleError("disposable tailnet state is invalid")
    return ProtectedState(
        document=document,
        device=metadata.st_dev,
        inode=metadata.st_ino,
    )


def _delete_tailnet(tailnet_id: str, client_id: str, client_secret: str) -> None:
    if SAFE_ID.fullmatch(tailnet_id) is None:
        raise LifecycleError("disposable tailnet ID is invalid")
    path = f"/tailnet/{urllib.parse.quote(tailnet_id, safe='')}"
    transient_statuses = {408, 409, 425, 429, *range(500, 600)}
    for attempt in range(4):
        try:
            token = _oauth_token(client_id, client_secret, scope="all")
            _request("DELETE", path, access_token=token)
            return
        except ApiRequestError as error:
            if (
                error.method == "DELETE"
                and error.path == path
                and error.status_code == 404
            ):
                return
            retryable = (
                error.status_code is None or error.status_code in transient_statuses
            )
            if not retryable or attempt == 3:
                raise
            time.sleep(min(2**attempt, 4))
    raise AssertionError("unreachable")


def _assert_no_stale_children(access_token: str) -> None:
    response = _request(
        "GET",
        "/organizations/-/tailnets?limit=100",
        access_token=access_token,
    )
    tailnets = response.document.get("tailnets")
    if not isinstance(tailnets, list):
        raise LifecycleError("Tailscale returned an invalid organization tailnet list")
    now = datetime.now(UTC)
    stale: list[tuple[str, str]] = []
    for tailnet in tailnets:
        if not isinstance(tailnet, dict):
            raise LifecycleError(
                "Tailscale returned an invalid organization tailnet list"
            )
        display_name = tailnet.get("displayName")
        if not isinstance(display_name, str) or not display_name.startswith(
            "Vonk Forge CI "
        ):
            continue
        tailnet_id = tailnet.get("id")
        created_at = tailnet.get("createdAt")
        if (
            SAFE_DISPLAY_NAME.fullmatch(display_name) is None
            or not isinstance(tailnet_id, str)
            or SAFE_ID.fullmatch(tailnet_id) is None
            or not isinstance(created_at, str)
        ):
            raise LifecycleError("Tailscale returned an unsafe CI child identity")
        try:
            created = datetime.fromisoformat(created_at)
        except ValueError as error:
            raise LifecycleError(
                "Tailscale returned an invalid CI child timestamp"
            ) from error
        if created.tzinfo is None:
            raise LifecycleError("Tailscale returned an invalid CI child timestamp")
        if now - created.astimezone(UTC) >= STALE_CHILD_AGE:
            stale.append((tailnet_id, display_name))
    if stale:
        children = ", ".join(f"{tailnet_id} ({name})" for tailnet_id, name in stale)
        raise LifecycleError(
            "stale disposable CI tailnets require explicit child-authorized cleanup: "
            f"{children}"
        )


def _configure_tailnet(
    tailnet_id: str, client_id: str, client_secret: str
) -> tuple[str, str]:
    token = _oauth_token(client_id, client_secret, scope="all")
    quoted_tailnet = urllib.parse.quote(tailnet_id, safe="")
    for service, display_name in SERVICES:
        response = _request(
            "PUT",
            f"/tailnet/{quoted_tailnet}/services/"
            f"{urllib.parse.quote(service, safe='')}",
            access_token=token,
            json_body={
                "comment": "Ephemeral Vonk Forge installer acceptance",
                "displayName": display_name,
                "name": service,
                "ports": ["tcp:443"],
            },
        )
        if response.document.get("name") != service or response.document.get(
            "ports"
        ) != ["tcp:443"]:
            raise LifecycleError(f"Tailscale did not create exact Service {service}")
    listed_services = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/services",
        access_token=token,
    ).document.get("vipServices")
    expected_services = {service: ["tcp:443"] for service, _ in SERVICES}
    exact_services = (
        isinstance(listed_services, list)
        and len(listed_services) == len(expected_services)
        and all(isinstance(service, dict) for service in listed_services)
        and all(isinstance(service.get("name"), str) for service in listed_services)
        and len({service.get("name") for service in listed_services})
        == len(expected_services)
        and {service.get("name"): service.get("ports") for service in listed_services}
        == expected_services
    )
    if not exact_services:
        raise LifecycleError("Tailscale Service readback was not exact")
    service_names = [service for service, _ in SERVICES]
    child_policy = {
        "acls": [],
        "autoApprovers": {
            "services": {service: ["tag:vonk-gateway"] for service in service_names}
        },
        "grants": [
            {
                "dst": service_names,
                "ip": ["tcp:443"],
                "src": ["tag:vonk-gateway"],
            }
        ],
        "tagOwners": {"tag:vonk-gateway": ["autogroup:admin"]},
    }
    policy = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/acl",
        access_token=token,
    )
    if (
        not isinstance(policy.etag, str)
        or not policy.etag
        or len(policy.etag) > 256
        or any(character in policy.etag for character in "\0\r\n")
    ):
        raise LifecycleError("Tailscale did not return the child policy ETag")
    _request(
        "POST",
        f"/tailnet/{quoted_tailnet}/acl",
        access_token=token,
        headers={"If-Match": policy.etag},
        json_body=child_policy,
    )
    readback_policy = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/acl",
        access_token=token,
    )
    if readback_policy.document != child_policy:
        raise LifecycleError("Tailscale child policy readback was not exact")
    gateway_client = _request(
        "POST",
        f"/tailnet/{quoted_tailnet}/keys",
        access_token=token,
        json_body={
            "description": "Vonk Forge CI gateway acceptance",
            "keyType": "client",
            "scopes": ["auth_keys"],
            "tags": ["tag:vonk-gateway"],
        },
    ).document
    gateway_id = gateway_client.get("id")
    gateway_secret = gateway_client.get("key")
    if (
        not isinstance(gateway_id, str)
        or SAFE_ID.fullmatch(gateway_id) is None
        or not isinstance(gateway_secret, str)
        or not gateway_secret
        or any(character in gateway_secret for character in "\0\r\n")
        or gateway_client.get("keyType") != "client"
        or gateway_client.get("scopes") != ["auth_keys"]
        or gateway_client.get("tags") != ["tag:vonk-gateway"]
    ):
        raise LifecycleError("Tailscale returned an invalid gateway client")
    print(f"::add-mask::{gateway_secret}")
    metadata = _request(
        "GET",
        f"/tailnet/{quoted_tailnet}/keys/{urllib.parse.quote(gateway_id, safe='')}",
        access_token=token,
    ).document
    if (
        metadata.get("id") != gateway_id
        or metadata.get("keyType") != "client"
        or metadata.get("scopes") != ["auth_keys"]
        or metadata.get("tags") != ["tag:vonk-gateway"]
    ):
        raise LifecycleError("Tailscale gateway client readback was not exact")
    return gateway_id, gateway_secret


def _append_github_environment(path: Path, values: dict[str, str]) -> None:
    if not path.is_absolute():
        raise LifecycleError("GitHub environment path must be absolute")
    for name, value in values.items():
        if (
            re.fullmatch(r"[A-Z0-9_]+", name) is None
            or not value
            or any(character in value for character in "\0\r\n")
        ):
            raise LifecycleError("generated GitHub environment is invalid")
    try:
        with path.open("a", encoding="utf-8") as stream:
            for name, value in values.items():
                stream.write(f"{name}={value}\n")
    except OSError as error:
        raise LifecycleError("cannot write GitHub environment") from error


def create(*, display_name: str, github_env: Path, state: Path) -> None:
    if SAFE_DISPLAY_NAME.fullmatch(display_name) is None:
        raise LifecycleError("disposable tailnet display name is invalid")
    if state.exists() or state.is_symlink():
        raise LifecycleError("disposable tailnet state already exists")
    factory_id = _required_environment(
        "VONK_ACCEPTANCE_TAILNET_FACTORY_OAUTH_CLIENT_ID"
    )
    factory_secret = _required_environment(
        "VONK_ACCEPTANCE_TAILNET_FACTORY_OAUTH_CLIENT_SECRET"
    )
    token = _oauth_token(factory_id, factory_secret, scope="tailnets")
    _assert_no_stale_children(token)
    response = _request(
        "POST",
        "/organizations/-/tailnets",
        access_token=token,
        json_body={"displayName": display_name},
    )
    document = response.document
    tailnet_id = document.get("id")
    dns_name = document.get("dnsName")
    oauth_client = document.get("oauthClient")
    if (
        not isinstance(tailnet_id, str)
        or SAFE_ID.fullmatch(tailnet_id) is None
        or not isinstance(oauth_client, dict)
        or not isinstance(oauth_client.get("id"), str)
        or SAFE_ID.fullmatch(oauth_client["id"]) is None
        or not isinstance(oauth_client.get("secret"), str)
        or not oauth_client["secret"]
        or any(c in oauth_client["secret"] for c in "\0\r\n")
    ):
        raise LifecycleError(
            "Tailscale returned invalid new-tailnet deletion credentials"
        )
    client_id = oauth_client["id"]
    client_secret = oauth_client["secret"]
    print(f"::add-mask::{client_secret}")
    try:
        _write_state(
            state,
            {
                "client_id": client_id,
                "client_secret": client_secret,
                "tailnet_id": tailnet_id,
            },
        )
    except BaseException:
        _delete_tailnet(tailnet_id, client_id, client_secret)
        raise
    try:
        if (
            not isinstance(dns_name, str)
            or SAFE_DNS_NAME.fullmatch(dns_name) is None
            or document.get("alreadyExists", False) is not False
        ):
            raise LifecycleError("Tailscale returned an invalid new-tailnet identity")
        gateway_client_id, gateway_client_secret = _configure_tailnet(
            tailnet_id, client_id, client_secret
        )
        _append_github_environment(
            github_env,
            {
                "VONK_ACCEPTANCE_TAILNET_DNS_SUFFIX": dns_name,
                "VONK_ACCEPTANCE_TAILNET_KIND": ISOLATED_TAILNET_KIND,
                "VONK_ACCEPTANCE_TAILSCALE_OAUTH_CLIENT_ID": gateway_client_id,
                "VONK_ACCEPTANCE_TAILSCALE_OAUTH_CLIENT_SECRET": gateway_client_secret,
            },
        )
    except BaseException:
        _delete_tailnet(tailnet_id, client_id, client_secret)
        state.unlink()
        raise


def delete(*, state: Path) -> None:
    protected_state = _read_state(state)
    if protected_state is None:
        return
    document = protected_state.document
    if set(document) != {"client_id", "client_secret", "tailnet_id"}:
        raise LifecycleError("disposable tailnet state is incomplete")
    print(f"::add-mask::{document['client_secret']}")
    _delete_tailnet(
        document["tailnet_id"], document["client_id"], document["client_secret"]
    )
    try:
        current = state.lstat()
    except FileNotFoundError as error:
        raise LifecycleError(
            "disposable tailnet state changed during cleanup"
        ) from error
    if (current.st_dev, current.st_ino) != (
        protected_state.device,
        protected_state.inode,
    ):
        raise LifecycleError("disposable tailnet state changed during cleanup")
    state.unlink()


def main() -> None:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    create_parser = subparsers.add_parser("create")
    create_parser.add_argument("--display-name", required=True)
    create_parser.add_argument("--github-env", type=Path, required=True)
    create_parser.add_argument("--state", type=Path, required=True)
    delete_parser = subparsers.add_parser("delete")
    delete_parser.add_argument("--state", type=Path, required=True)
    arguments = parser.parse_args()
    if arguments.command == "create":
        create(
            display_name=arguments.display_name,
            github_env=arguments.github_env,
            state=arguments.state,
        )
    else:
        delete(state=arguments.state)


if __name__ == "__main__":
    try:
        main()
    except (LifecycleError, OSError) as error:
        raise SystemExit(f"Tailscale acceptance tailnet: {error}") from error
