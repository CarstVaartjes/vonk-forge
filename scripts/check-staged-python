#!/usr/bin/env python3
"""Run local commit checks, preparing locked dependencies when needed."""

from __future__ import annotations

import fnmatch
import importlib.metadata
import os
import subprocess
import sys
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True  # repository tools never leave __pycache__ behind
# The sibling helper, however this file is loaded.
sys.path.insert(0, str(Path(__file__).absolute().parent))
from check_environment import (  # noqa: E402 -- imports follow this entry point's sys.path or environment setup
    ensure_control,
)

ROOT = Path(__file__).resolve().parents[1]
TYPE_INPUTS = {
    "pyproject.toml",
    "control/pyproject.toml",
    "uv.lock",
    "pyrightconfig.json",
    "scripts/check-python-types",
    "scripts/check-staged-python",
    "scripts/check-staged-code",
    "scripts/check_environment.py",
}


def python_files(paths: list[str], python: Path) -> list[str]:
    """The staged paths Ruff treats as Python, extensionless scripts included.

    A ``.py`` path is Python (Ruff's ``--force-exclude`` still drops excluded
    ones). Whether an extensionless file is a Python script is decided by Ruff's
    ``extend-include``/``extend-exclude`` in pyproject.toml, the one owner of
    that list; CI runs Ruff on the whole tree."""
    bare = [path for path in paths if not Path(path).suffix]
    selected: set[Path] = set()
    if bare:
        # Ruff's selection of the whole tree, never the staged paths by name:
        # a path named on the command line is linted whatever its type.
        shown = subprocess.run(
            [str(python), "-m", "ruff", "check", "--show-files", "."],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            text=True,
            check=True,
            timeout=60,
        ).stdout.splitlines()
        selected = {Path(line).resolve() for line in shown if line}
    return [
        path
        for path in paths
        if path.endswith(".py") or (ROOT / path).resolve() in selected
    ]


def type_checked(files: list[str]) -> list[str]:
    """The staged files inside pyright's configured scope.

    The full check (CI) reports ``include`` minus ``exclude`` from pyproject.toml
    plus the extensionless Python scripts; handing pyright a file outside that
    reports errors CI never sees. pyproject.toml is the one owner of the scope."""
    try:
        config = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))
    except FileNotFoundError:
        config = {}
    pyright = config.get("tool", {}).get("pyright", {})
    # Like pyright, no ``include`` means the whole root.
    include = [entry.rstrip("/") for entry in pyright.get("include", ["."])]
    exclude = [pattern.replace("**", "*") for pattern in pyright.get("exclude", [])]
    return [
        path
        for path in files
        if not Path(path).suffix
        or (
            any(
                entry in (".", path) or path.startswith(entry + "/")
                for entry in include
            )
            and not any(fnmatch.fnmatch(path, pattern) for pattern in exclude)
        )
    ]


def main() -> int:
    staged = subprocess.check_output(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMRD", "-z"],
        cwd=ROOT,
        timeout=30,
    )
    paths = [os.fsdecode(path) for path in staged.split(b"\0") if path]
    candidates = [
        path
        for path in paths
        if (ROOT / path).is_file() and (path.endswith(".py") or not Path(path).suffix)
    ]
    full_types = bool(TYPE_INPUTS.intersection(paths))
    if not candidates and not full_types:
        return 0
    environment = Path(os.environ.get("UV_PROJECT_ENVIRONMENT", ".venv"))
    if not environment.is_absolute():
        environment = ROOT / environment
    python = environment / "bin/python"
    ensure_control(ROOT, environment)
    if Path(sys.prefix).resolve() != environment.resolve():
        return subprocess.run(
            [str(python), str(Path(__file__).resolve())],
            cwd=ROOT,
            check=False,
            timeout=600,
        ).returncode
    files = python_files(candidates, python)
    if not files and not full_types:
        return 0
    check_env = {
        **os.environ,
        "PYRIGHT_PYTHON_FORCE_VERSION": importlib.metadata.version("pyright"),
        "PYRIGHT_PYTHON_NODEJS_WHEEL": "1",
        "PYRIGHT_PYTHON_GLOBAL_NODE": "0",
    }
    commands = []
    if files:
        commands.extend(
            [
                [
                    sys.executable,
                    "-m",
                    "ruff",
                    "check",
                    "--force-exclude",
                    "--",
                    *files,
                ],
                [
                    sys.executable,
                    "-m",
                    "ruff",
                    "format",
                    "--check",
                    "--force-exclude",
                    "--",
                    *files,
                ],
            ]
        )
    checked = files if full_types else type_checked(files)
    if full_types or checked:
        commands.append(
            [
                sys.executable,
                "scripts/check-python-types",
                *([] if full_types else checked),
            ]
        )
    for command in commands:
        result = subprocess.run(
            command, cwd=ROOT, env=check_env, check=False, timeout=600
        )
        if result.returncode:
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
