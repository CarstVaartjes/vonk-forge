#!/usr/bin/python3
"""Materialize pinned third-party executables used by the agent package."""

from __future__ import annotations

import argparse
import hashlib
import io
import os
import stat
import sys
import tarfile
import urllib.error
import urllib.request
from pathlib import Path

ORAS_VERSION = "1.3.2"
MAXIMUM_ARCHIVE_BYTES = 64 * 1024 * 1024
ARCHITECTURES = {
    "arm64": {
        "archive_sha256": "8db4a223bd6034deff198e791ea7cb3af0840df25b7e9f370e2f1f3fd20d389b",
        "binary_sha256": "1b694cbaabcd31c8807176b36eed45ae6ba8cdde0694b7fbff5edc55db2fa4f6",
        "target": "aarch64-unknown-linux-gnu",
    },
    "amd64": {
        "archive_sha256": "9229ccc6d17bb282039ad4a69abb16dcb887a5bce567c075d731d9b3c7ad8eaf",
        "binary_sha256": "22dc6b05994a786f36bc57de47c48562543f3fa0cc62366a9a9574b422a13ab2",
        "target": "x86_64-unknown-linux-gnu",
    },
}


class MaterializationError(RuntimeError):
    pass


def download(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "vonk-forge-release"})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            if response.status != 200:
                raise MaterializationError("tool download returned an unexpected status")
            chunks: list[bytes] = []
            total = 0
            while chunk := response.read(1024 * 1024):
                total += len(chunk)
                if total > MAXIMUM_ARCHIVE_BYTES:
                    raise MaterializationError("tool archive exceeds its size limit")
                chunks.append(chunk)
    except (OSError, urllib.error.URLError) as error:
        raise MaterializationError("tool download failed") from error
    return b"".join(chunks)


def archive_members(raw: bytes) -> dict[str, bytes]:
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
            members = archive.getmembers()
            if [member.name for member in members] != ["LICENSE", "oras"]:
                raise MaterializationError("tool archive members are not canonical")
            if any(not member.isfile() or member.issparse() for member in members):
                raise MaterializationError("tool archive contains an invalid member")
            extracted: dict[str, bytes] = {}
            for member in members:
                source = archive.extractfile(member)
                if source is None:
                    raise MaterializationError("tool archive member is unreadable")
                extracted[member.name] = source.read(MAXIMUM_ARCHIVE_BYTES + 1)
    except (tarfile.TarError, OSError) as error:
        raise MaterializationError("tool archive is invalid") from error
    if any(len(value) > MAXIMUM_ARCHIVE_BYTES for value in extracted.values()):
        raise MaterializationError("tool archive member exceeds its size limit")
    return extracted


def atomic_install(path: Path, raw: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.new")
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC,
        mode,
    )
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
    path.chmod(mode)


def materialize(output_root: Path) -> None:
    licenses: set[bytes] = set()
    releases: list[Path] = []
    for architecture, specification in ARCHITECTURES.items():
        url = (
            "https://github.com/oras-project/oras/releases/download/"
            f"v{ORAS_VERSION}/oras_{ORAS_VERSION}_linux_{architecture}.tar.gz"
        )
        archive = download(url)
        if hashlib.sha256(archive).hexdigest() != specification["archive_sha256"]:
            raise MaterializationError("tool archive digest does not match its pin")
        members = archive_members(archive)
        binary = members["oras"]
        if hashlib.sha256(binary).hexdigest() != specification["binary_sha256"]:
            raise MaterializationError("tool binary digest does not match its pin")
        if binary[:7] != b"\x7fELF\x02\x01\x01":
            raise MaterializationError("tool binary is not a 64-bit little-endian ELF")
        licenses.add(members["LICENSE"])
        release = output_root / str(specification["target"]) / "release"
        releases.append(release)
        executable_mode = (
            stat.S_IRUSR
            | stat.S_IXUSR
            | stat.S_IRGRP
            | stat.S_IXGRP
            | stat.S_IROTH
            | stat.S_IXOTH
        )
        atomic_install(release / "oras", binary, executable_mode)
    if len(licenses) != 1:
        raise MaterializationError("tool license differs across architectures")
    license_text = licenses.pop()
    for release in releases:
        atomic_install(release / "oras.LICENSE", license_text, 0o444)


def main() -> int:
    parser = argparse.ArgumentParser(prog="materialize-agent-tools")
    parser.add_argument("--output-root", required=True, type=Path)
    arguments = parser.parse_args()
    try:
        materialize(arguments.output_root.resolve())
    except MaterializationError as error:
        print(f"materialize-agent-tools: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
