#!/usr/bin/env python3
"""Render the canonical production Compose graph for the development channel."""

from __future__ import annotations

import argparse
import hashlib
import os
import posixpath
import re
import tempfile
from pathlib import Path

import yaml

IMAGE = re.compile(
    r"^ghcr\.io/carstvaartjes/vonk-forge-(api|worker|hermes):"
    r"dev-sha-[0-9a-f]{40}@sha256:[0-9a-f]{64}$"
)
PINNED_IMAGE = re.compile(r"^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$")
DEFAULT_IMAGE = re.compile(r"^\$\{[A-Z0-9_]+:-([^}]+)\}$")
TOKENS = {
    "api": "${CONTROL_API_IMAGE:?set a digest-pinned control-api image}",
    "worker": "${CONTROL_WORKER_IMAGE:?set a digest-pinned control-worker image}",
    "hermes": "${HERMES_AGENT_IMAGE:?set a digest-pinned Hermes image}",
}


def _validate(role: str, image: str, channel: str) -> None:
    if channel == "pinned" and PINNED_IMAGE.fullmatch(image) is not None:
        return
    if channel == "dev" and IMAGE.fullmatch(image) is not None:
        return
    if channel not in {"dev", "pinned"} or IMAGE.fullmatch(image) is None:
        raise ValueError(
            f"{role} image must be an immutable published development image"
        )


def _rebase_relative_paths(value: object, prefix: str) -> object:
    if isinstance(value, str) and value.startswith("./"):
        return f"./{prefix}/{value[2:]}"
    if isinstance(value, dict):
        return {
            key: _rebase_relative_paths(item, prefix) for key, item in value.items()
        }
    if isinstance(value, list):
        return [_rebase_relative_paths(item, prefix) for item in value]
    return value


def _merge_values(base: object, incoming: object) -> object:
    if isinstance(base, list) and isinstance(incoming, list):
        merged = list(base)
        for item in incoming:
            if item not in merged:
                merged.append(item)
        return merged
    if isinstance(base, dict) and isinstance(incoming, dict):
        merged = dict(base)
        for key, value in incoming.items():
            merged[key] = _merge_values(merged[key], value) if key in merged else value
        return merged
    return incoming


def _compose_document(path: Path, seen: set[Path] | None = None) -> dict[str, object]:
    seen = set() if seen is None else seen
    path = path.resolve()
    if path in seen:
        raise ValueError(f"Compose include cycle: {path}")
    seen.add(path)
    document = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict):
        raise TypeError(f"Compose document is not a mapping: {path}")

    merged: dict[str, object] = {}
    includes = document.pop("include", [])
    if not isinstance(includes, list):
        raise TypeError(f"Compose include list is invalid: {path}")
    for included in includes:
        included_path = included if isinstance(included, str) else included.get("path")
        if not isinstance(included_path, str):
            raise TypeError(f"Compose include path is invalid: {path}")
        child = _compose_document(path.parent / included_path, seen)
        prefix = str(Path(included_path).parent)
        if prefix != ".":
            child = _rebase_relative_paths(child, prefix)  # type: ignore[assignment]
        merged = _merge_values(merged, child)  # type: ignore[assignment]
    for key, value in document.items():
        merged = _merge_values(merged, {key: value})  # type: ignore[assignment]
    return merged


def _replace_image_tokens(value: object, replacements: dict[str, str]) -> object:
    if isinstance(value, str):
        return replacements.get(value, value)
    if isinstance(value, dict):
        return {
            key: _replace_image_tokens(item, replacements)
            for key, item in value.items()
        }
    if isinstance(value, list):
        return [_replace_image_tokens(item, replacements) for item in value]
    return value


def _runtime_config_name(source: Path) -> str:
    digest = hashlib.sha256(source.as_posix().encode("utf-8")).hexdigest()[:16]
    return f"vonk_runtime_{digest}"


def _config_content(source: Path) -> str:
    try:
        content = source.read_text(encoding="utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(f"runtime asset must be UTF-8 text: {source}") from error
    # Compose interpolates config content too. Escape every dollar so the
    # mounted file retains its exact source bytes after Compose evaluates it.
    return content.replace("$", "$$")


def _config_mode(source: Path) -> str:
    # Shell programs are executable in the rendered artifact even when the
    # source graph currently invokes them through /bin/sh. Preserve execute
    # bits for other program types, but never project writable permissions.
    executable = source.suffix == ".sh" or bool(source.stat().st_mode & 0o111)
    return "0555" if executable else "0444"


def _config_mounts(
    source_root: Path, source: str, target: str
) -> tuple[dict[str, dict[str, str]], list[dict[str, str]]]:
    if not source.startswith("./"):
        return {}, []
    asset = (source_root / source[2:]).resolve()
    try:
        asset.relative_to(source_root.resolve())
    except ValueError as error:
        raise ValueError(
            f"runtime asset escapes Compose source root: {source}"
        ) from error
    if not asset.exists():
        raise ValueError(f"runtime asset is missing: {source}")

    files = (
        [asset]
        if asset.is_file()
        else sorted(path for path in asset.rglob("*") if path.is_file())
    )
    if not files:
        raise ValueError(f"runtime asset directory is empty: {source}")
    configs: dict[str, dict[str, str]] = {}
    mounts: list[dict[str, str]] = []
    for file in files:
        relative = file.relative_to(asset).as_posix() if asset.is_dir() else ""
        destination = target if not relative else posixpath.join(target, relative)
        name = _runtime_config_name(file.relative_to(source_root))
        configs[name] = {"content": _config_content(file)}
        mounts.append(
            {"source": name, "target": destination, "mode": _config_mode(file)}
        )
    return configs, mounts


def _embed_runtime_assets(document: dict[str, object], source_root: Path) -> None:
    services = document.get("services")
    if not isinstance(services, dict):
        raise TypeError("Compose services are invalid")
    configs = document.setdefault("configs", {})
    if not isinstance(configs, dict):
        raise TypeError("Compose configs are invalid")
    for name, service in services.items():
        if not isinstance(service, dict):
            raise TypeError(f"Compose service is invalid: {name}")
        volumes = service.get("volumes", [])
        if not isinstance(volumes, list):
            raise TypeError(f"Compose volumes are invalid: {name}")
        remaining_volumes: list[object] = []
        embedded_mounts: list[dict[str, str]] = []
        for volume in volumes:
            if not isinstance(volume, str):
                remaining_volumes.append(volume)
                continue
            fields = volume.split(":", 2)
            if len(fields) < 2 or not fields[0].startswith("./"):
                remaining_volumes.append(volume)
                continue
            embedded, mounts = _config_mounts(source_root, fields[0], fields[1])
            configs.update(embedded)
            embedded_mounts.extend(mounts)
        if embedded_mounts:
            service["volumes"] = remaining_volumes
            current_configs = service.get("configs", [])
            if not isinstance(current_configs, list):
                raise TypeError(f"Compose service configs are invalid: {name}")
            service["configs"] = [*current_configs, *embedded_mounts]


def _resolve_runtime_images(document: dict[str, object]) -> None:
    services = document.get("services")
    if not isinstance(services, dict):
        raise TypeError("Compose services are invalid")
    for name, service in services.items():
        if not isinstance(service, dict):
            raise TypeError(f"Compose service is invalid: {name}")
        image = service.get("image")
        if not isinstance(image, str):
            raise TypeError(f"Compose service image is invalid: {name}")
        default = DEFAULT_IMAGE.fullmatch(image)
        if default is not None:
            image = default.group(1)
            service["image"] = image
        if PINNED_IMAGE.fullmatch(image) is None:
            raise ValueError(f"runtime service image is not digest pinned: {name}")


def _count_template_token(
    path: Path, needle: str, seen: set[Path] | None = None
) -> int:
    seen = set() if seen is None else seen
    path = path.resolve()
    if path in seen:
        return 0
    seen.add(path)
    document = yaml.safe_load(path.read_text(encoding="utf-8"))
    includes = document.get("include", []) if isinstance(document, dict) else []
    count = path.read_text(encoding="utf-8").count(needle)
    for included in includes:
        included_path = included if isinstance(included, str) else included.get("path")
        if isinstance(included_path, str):
            count += _count_template_token(path.parent / included_path, needle, seen)
    return count


def render(
    template: Path,
    output: Path,
    api_image: str,
    worker_image: str,
    hermes_image: str,
    *,
    channel: str,
) -> None:
    if channel not in {"dev", "pinned"}:
        raise ValueError("channel must be dev or pinned")
    _validate("API", api_image, channel)
    _validate("worker", worker_image, channel)
    _validate("Hermes", hermes_image, channel)
    if not template.is_file() or template.is_symlink():
        raise ValueError("template must be an existing regular file")
    if not output.parent.is_dir():
        raise ValueError("output parent must exist")
    document = _compose_document(template)
    if (
        _count_template_token(template, TOKENS["api"]) != 2
        or _count_template_token(template, TOKENS["worker"]) != 2
    ):
        raise ValueError("template control image inputs changed")
    document = _replace_image_tokens(
        document,
        {
            TOKENS["api"]: api_image,
            TOKENS["worker"]: worker_image,
            TOKENS["hermes"]: hermes_image,
        },
    )
    _resolve_runtime_images(document)
    _embed_runtime_assets(document, template.parent)
    rendered = yaml.safe_dump(document, sort_keys=False, default_flow_style=False)
    if "VONK_DEPLOYMENT_MODE: production" not in rendered:
        raise ValueError("development channel must render the production graph")
    descriptor, staged_name = tempfile.mkstemp(
        prefix=".render-dev-compose-", dir=output.parent
    )
    staged = Path(staged_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(rendered)
            stream.flush()
            os.fsync(stream.fileno())
        staged.chmod(0o644)
        os.replace(staged, output)
    except BaseException:
        staged.unlink(missing_ok=True)
        raise


def main() -> None:
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--template", type=Path, default=root / "deploy/compose/compose.yaml"
    )
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--api-image", required=True)
    parser.add_argument("--worker-image", required=True)
    parser.add_argument("--hermes-image", required=True)
    parser.add_argument("--channel", choices=("dev", "pinned"), default="pinned")
    parser.add_argument("--commit")
    arguments = parser.parse_args()
    render(
        arguments.template,
        arguments.output,
        arguments.api_image,
        arguments.worker_image,
        arguments.hermes_image,
        channel=arguments.channel,
    )


if __name__ == "__main__":
    main()
