#!/usr/bin/env python3

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
from pathlib import Path

SCHEMAS = {
    "schemas/container-runtime-policy/v1.json": "schemas/global/container-runtime-policy-v1.json",
    "schemas/problem/v1.schema.json": "schemas/global/problem-v1.schema.json",
}
FIXTURES: tuple[str, ...] = ()


def git(repo: Path, *arguments: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(repo), *arguments],
        check=True,
        capture_output=True,
    ).stdout


def canonical_hash(payload: bytes) -> str:
    document = json.loads(
        payload, parse_float=lambda _: (_ for _ in ()).throw(ValueError("float"))
    )
    canonical = json.dumps(
        document,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(canonical).hexdigest()


def atomic_write(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_bytes(payload)
    temporary.replace(path)


def main() -> None:
    root = Path(__file__).resolve().parents[1]
    lock = json.loads((root / "schemas/global/contract.lock.json").read_text())
    repository_root = (
        Path(git(root, "rev-parse", "--git-common-dir").decode().strip())
        .resolve()
        .parent
    )
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--repo", type=Path, default=repository_root.parent / "vonk-forge-web"
    )
    parser.add_argument("--commit", default=lock["source_commit"])
    arguments = parser.parse_args()
    if re.fullmatch(r"[0-9a-f]{40}", arguments.commit) is None:
        raise SystemExit("--commit must be a full lowercase Git commit")
    if git(arguments.repo, "status", "--porcelain"):
        raise SystemExit("global contract source tree must be clean")
    git(arguments.repo, "cat-file", "-e", f"{arguments.commit}^{{commit}}")
    files: dict[str, dict[str, str]] = {}
    for source, destination in SCHEMAS.items():
        payload = git(arguments.repo, "show", f"{arguments.commit}:{source}")
        atomic_write(root / destination, payload)
        files[destination] = {
            "source_path": source,
            "sha256": hashlib.sha256(payload).hexdigest(),
        }
    fixtures: dict[str, dict[str, str]] = {}
    for name in FIXTURES:
        source = f"schemas/fixtures/{name}"
        payload = git(arguments.repo, "show", f"{arguments.commit}:{source}")
        atomic_write(root / f"control/tests/fixtures/global/{name}", payload)
        fixtures[name] = {
            "content_sha256": canonical_hash(payload),
            "file_sha256": hashlib.sha256(payload).hexdigest(),
        }
    remote = git(arguments.repo, "remote", "get-url", "origin").decode().strip()
    lock = {
        "contract_version": "1.0.0",
        "source_repository": remote,
        "source_commit": arguments.commit,
        "files": files,
        "fixtures": fixtures,
    }
    atomic_write(
        root / "schemas/global/contract.lock.json",
        json.dumps(
            lock, ensure_ascii=False, sort_keys=True, separators=(",", ":")
        ).encode()
        + b"\n",
    )


if __name__ == "__main__":
    main()
