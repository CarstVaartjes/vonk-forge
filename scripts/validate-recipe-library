#!/usr/bin/env python3
"""Validate a standalone Vonk Forge v2 recipe-library snapshot."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import re
import sys
import tarfile
from collections.abc import Mapping
from pathlib import Path, PurePosixPath
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
_SECRET_MARKERS = (
    b"BEGIN PRIVATE KEY",
    b"BEGIN OPENSSH PRIVATE KEY",
    b"ghp_",
    b"github_pat_",
    b"-----BEGIN RSA PRIVATE KEY-----",
)
_ARCHIVE_PAYLOAD_PREFIXES = (
    "image/",
    "oci/",
    "weights/",
    "runtime-distributions/",
    "patch-bundles/",
    "execution-harnesses/",
)
_ARCHIVE_PAYLOAD_SUFFIXES = (
    ".safetensors",
    ".bin",
    ".pt",
    ".pth",
    ".ckpt",
    ".onnx",
)
_SHA256 = re.compile(r"^[a-f0-9]{64}$")


class LibraryValidationError(ValueError):
    pass


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--library-root", type=Path, required=True)
    parser.add_argument("--platform-root", type=Path, default=ROOT)
    parser.add_argument("--json", action="store_true", dest="as_json")
    return parser.parse_args()


def _scan_secrets(root: Path, platform_root: Path) -> None:
    excluded_root: Path | None = None
    try:
        platform_root.relative_to(root)
    except ValueError:
        pass
    else:
        # The producer workflow checks out this repository below the recipe
        # checkout. Its contents are platform-owned and are validated by the
        # platform checkout itself, so they are outside the recipe authority
        # being scanned here. Keep the root itself in scope when both roots
        # are the same (as in local validation).
        if platform_root != root:
            excluded_root = platform_root
    for path in root.rglob("*"):
        if (
            not path.is_file()
            or ".git" in path.parts
            or "__pycache__" in path.parts
        ):
            continue
        if excluded_root is not None:
            try:
                path.relative_to(excluded_root)
            except ValueError:
                pass
            else:
                continue
        if path.suffix.lower() in {
            ".gz",
            ".tar",
            ".png",
            ".jpg",
            ".jpeg",
            ".bin",
            ".safetensors",
        }:
            continue
        try:
            payload = path.read_bytes()
        except OSError as error:
            raise LibraryValidationError(f"{path}: cannot read for secret scan") from error
        if any(marker in payload for marker in _SECRET_MARKERS):
            raise LibraryValidationError(f"{path}: possible private credential in recipe library")
    package_root = root / "packages"
    if not package_root.is_dir():
        return
    for archive_path in sorted(package_root.glob("*.tar.gz")):
        try:
            archive = tarfile.open(archive_path, mode="r:gz")  # noqa: SIM115 - closed below
        except (OSError, tarfile.TarError) as error:
            raise LibraryValidationError(f"{archive_path}: package archive is unreadable") from error
        try:
            with archive:
                for member in archive.getmembers():
                    if not member.isreg() or member.name.endswith(_ARCHIVE_PAYLOAD_SUFFIXES):
                        continue
                    content_file = archive.extractfile(member)
                    payload = content_file.read() if content_file is not None else b""
                    if any(marker in payload for marker in _SECRET_MARKERS):
                        raise LibraryValidationError(
                            f"{archive_path}:{member.name}: possible private credential in recipe package"
                        )
        except tarfile.TarError as error:
            raise LibraryValidationError(f"{archive_path}: package archive is unreadable") from error


def _validate_target_recipe_coverage(
    root: Path,
    recipe_slugs: set[str],
) -> None:
    # The standalone public library owns the complete target ledger.  The
    # platform checkout may contain a deliberately smaller imported snapshot;
    # its config/model-targets files are not the publication authority.
    target_root = root / "model-targets"
    if not target_root.is_dir():
        return
    for path in sorted(target_root.glob("*.json")):
        try:
            document = json.loads(path.read_bytes())
        except (OSError, json.JSONDecodeError) as error:
            raise LibraryValidationError(f"{path}: target ledger is invalid") from error
        targets = document.get("targets") if isinstance(document, Mapping) else None
        if not isinstance(targets, list):
            raise LibraryValidationError(f"{path}: target ledger targets are required")
        for index, target in enumerate(targets):
            if not isinstance(target, Mapping):
                raise LibraryValidationError(f"{path}: target {index} is invalid")
            status = target.get("status")
            slugs = target.get("recipe_slugs", [])
            if not isinstance(slugs, list) or any(
                not isinstance(slug, str) or not slug for slug in slugs
            ):
                raise LibraryValidationError(
                    f"{path}: target {index} recipe_slugs are invalid"
                )
            if status == "blocked":
                if slugs:
                    raise LibraryValidationError(
                        f"{path}: blocked target {index} must not advertise a recipe"
                    )
                continue
            if not slugs:
                raise LibraryValidationError(
                    f"{path}: non-blocked target has no recipe (index {index})"
                )
            missing = sorted(set(slugs) - recipe_slugs)
            if missing:
                raise LibraryValidationError(
                    f"{path}: target {index} references missing recipes: {', '.join(missing)}"
                )


def _dockerfile_build_inputs(payload: bytes, label: str) -> list[dict[str, str]]:
    """Extract the pinned OCI inputs used by a build Dockerfile."""
    inputs: list[dict[str, str]] = []
    seen: set[tuple[str, str]] = set()
    for raw_line in payload.decode("utf-8", errors="strict").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        match = re.match(r"^FROM(?:\s+--platform=(\S+))?\s+(\S+)", line, re.IGNORECASE)
        if match is None:
            continue
        platform = match.group(1) or "linux/arm64"
        reference = match.group(2)
        if "@sha256:" not in reference:
            raise LibraryValidationError(f"{label}: every Dockerfile FROM must pin a digest")
        key = (reference, platform)
        if key not in seen:
            inputs.append({"kind": "oci-image", "reference": reference, "platform": platform})
            seen.add(key)
    if not inputs:
        raise LibraryValidationError(f"{label}: Dockerfile has no FROM image")
    return inputs


def _validate_v2_package(
    package_bytes: bytes,
    recipe: Any,
    models: Mapping[tuple[str, str], Any],
    package_label: str,
) -> None:
    """Validate one self-contained v2 package without hydrating remote files."""
    from vonk_forge_contracts import ModelDefinition, RecipeDefinition, content_sha256

    expected_recipe = RecipeDefinition.model_validate(recipe)
    expected_recipe_dump = expected_recipe.model_dump(
        mode="json", exclude_unset=False, exclude_none=False
    )
    try:
        archive = tarfile.open(  # noqa: SIM115 - the archive is closed by the context below
            fileobj=io.BytesIO(package_bytes), mode="r:gz"
        )
    except (OSError, tarfile.TarError) as error:
        raise LibraryValidationError(f"{package_label}: invalid gzip archive") from error
    with archive:
        members = archive.getmembers()
        names = [member.name for member in members]
        if len(names) != len(set(names)):
            raise LibraryValidationError(f"{package_label}: archive contains duplicate paths")
        for name, member in zip(names, members, strict=True):
            path = PurePosixPath(name)
            if (
                not member.isreg()
                or path.is_absolute()
                or any(part in {"", ".", ".."} for part in path.parts)
            ):
                raise LibraryValidationError(f"{package_label}: archive contains unsafe member {name}")
            if name.startswith(_ARCHIVE_PAYLOAD_PREFIXES) or name.endswith(_ARCHIVE_PAYLOAD_SUFFIXES):
                raise LibraryValidationError(f"{package_label}: archive contains model or OCI payload {name}")
        if [name for name in names if PurePosixPath(name).name == "recipe.json"] != ["recipe.json"]:
            raise LibraryValidationError(
                f"{package_label}: archive must contain exactly one recipe.json entrypoint"
            )
        try:
            manifest_member = archive.extractfile("manifest.json")
        except KeyError:
            manifest_member = None
        if manifest_member is None:
            raise LibraryValidationError(f"{package_label}: archive manifest is missing")
        try:
            manifest = json.load(manifest_member)
        except (TypeError, UnicodeError, json.JSONDecodeError) as error:
            raise LibraryValidationError(f"{package_label}: archive manifest is invalid") from error
        if (
            not isinstance(manifest, Mapping)
            or manifest.get("schema_version") != 2
            or manifest.get("kind") != "recipe-package"
            or manifest.get("package_type") != "recipe"
        ):
            raise LibraryValidationError(f"{package_label}: archive manifest kind is invalid")
        entries = manifest.get("files")
        if not isinstance(entries, list):
            raise LibraryValidationError(f"{package_label}: archive manifest files are invalid")
        declared: dict[str, Mapping[str, object]] = {}
        for entry in entries:
            if not isinstance(entry, Mapping):
                raise LibraryValidationError(f"{package_label}: archive manifest entry is invalid")
            name = entry.get("path")
            size = entry.get("size")
            digest = entry.get("sha256")
            if (
                not isinstance(name, str)
                or name in declared
                or not isinstance(size, int)
                or isinstance(size, bool)
                or size < 0
                or not isinstance(digest, str)
                or _SHA256.fullmatch(digest) is None
            ):
                raise LibraryValidationError(f"{package_label}: archive manifest entry is invalid")
            declared[name] = entry
        payload_names = set(names) - {"manifest.json"}
        if set(declared) != payload_names:
            raise LibraryValidationError(f"{package_label}: archive manifest closure is incomplete")
        for name, entry in declared.items():
            member = archive.extractfile(name)
            content = member.read() if member is not None else None
            if (
                content is None
                or len(content) != entry["size"]
                or hashlib.sha256(content).hexdigest() != entry["sha256"]
            ):
                raise LibraryValidationError(f"{package_label}: archive file identity is stale: {name}")
        recipe_member = archive.extractfile("recipe.json")
        if recipe_member is None:
            raise LibraryValidationError(f"{package_label}: recipe entrypoint is missing")
        try:
            actual_recipe = RecipeDefinition.model_validate(json.load(recipe_member))
        except (TypeError, UnicodeError, json.JSONDecodeError, ValueError) as error:
            raise LibraryValidationError(f"{package_label}: recipe entrypoint is invalid") from error
        recipe_digest = content_sha256(actual_recipe)
        if actual_recipe.model_dump(mode="json", exclude_unset=False, exclude_none=False) != expected_recipe_dump:
            raise LibraryValidationError(f"{package_label}: recipe entrypoint does not match the index")
        if manifest.get("recipe_content_sha256") != recipe_digest:
            raise LibraryValidationError(f"{package_label}: recipe digest is stale")

        pending = [selection.model for selection in expected_recipe.models]
        seen_models: set[tuple[str, str]] = set()
        while pending:
            reference = pending.pop(0)
            model_key = (reference.publisher, reference.slug)
            if model_key in seen_models:
                continue
            seen_models.add(model_key)
            model_path = f"models/{reference.slug}.json"
            try:
                model_member = archive.extractfile(model_path)
            except KeyError:
                model_member = None
            if model_member is None:
                raise LibraryValidationError(f"{package_label}: exact Model snapshot is missing: {model_path}")
            try:
                model = ModelDefinition.model_validate(json.load(model_member))
            except (TypeError, UnicodeError, json.JSONDecodeError, ValueError) as error:
                raise LibraryValidationError(f"{package_label}: Model snapshot is invalid: {model_path}") from error
            if content_sha256(model) != reference.content_sha256:
                raise LibraryValidationError(f"{package_label}: Model snapshot digest is stale: {model_path}")
            catalog_model = models.get(model_key)
            if catalog_model is None or content_sha256(catalog_model) != reference.content_sha256:
                raise LibraryValidationError(f"{package_label}: Model snapshot is not the catalog Model")
            pending.extend(model.dependencies)
            if model.supersedes is not None:
                pending.append(model.supersedes)
        package_models = {
            name for name in names if name.startswith("models/") and name.endswith(".json")
        }
        expected_models = {f"models/{slug}.json" for _publisher, slug in seen_models}
        if package_models != expected_models:
            raise LibraryValidationError(f"{package_label}: Model snapshot closure is incomplete")

        execution = expected_recipe.execution
        if execution.mode == "build":
            build = execution.build
            context = build.context.path
            if any(
                path != context and not path.startswith(context + "/")
                for path in (build.dockerfile, *(patch.path for patch in build.patches))
            ):
                raise LibraryValidationError(f"{package_label}: build input escapes its context")
            if not any(name.startswith(context + "/") for name in payload_names):
                raise LibraryValidationError(f"{package_label}: build context is missing: {context}")
            required = {build.dockerfile, *(patch.path for patch in build.patches)}
            missing = sorted(required - payload_names)
            if missing:
                raise LibraryValidationError(
                    f"{package_label}: source closure is missing: {', '.join(missing)}"
                )
            dockerfile_member = archive.extractfile(build.dockerfile)
            if dockerfile_member is None:
                raise LibraryValidationError(f"{package_label}: Dockerfile is missing")
            inputs = _dockerfile_build_inputs(dockerfile_member.read(), f"{package_label}/{build.dockerfile}")
            if manifest.get("build_inputs") != inputs:
                raise LibraryValidationError(f"{package_label}: build inputs are stale")
            if not any(
                item["reference"].split("@sha256:", 1)[0].split(":", 1)[0] == build.base_image.repository
                and item["reference"].endswith("@sha256:" + build.base_image.digest)
                and item["platform"] == build.base_image.platform
                for item in inputs
            ):
                raise LibraryValidationError(f"{package_label}: base image is absent from build inputs")
        for check in expected_recipe.validation.serving.checks:
            request = check.request
            if getattr(request, "transport", None) == "job":
                required = {request.fixture, *request.input_slots.values()}
                if missing := sorted(required - payload_names):
                    raise LibraryValidationError(
                        f"{package_label}: serving closure is missing: {', '.join(missing)}"
                    )


def _validate_v2(library_root: Path, platform_root: Path) -> dict[str, Any]:
    """Validate the central Model/Recipe producer and immutable packages."""
    contract_root = library_root / "contracts" / "src"
    if not (contract_root / "vonk_forge_contracts").is_dir():
        raise LibraryValidationError("central contracts package is missing")
    sys.path.insert(0, str(contract_root))
    from vonk_forge_contracts import ModelDefinition, RecipeDefinition, content_sha256
    from vonk_forge_contracts.resolver import (
        ContractResolutionError,
        validate_model_references,
        validate_recipe_models,
        validate_recipe_package_paths,
    )

    model_root, recipe_root, package_root = (library_root / name for name in ("models", "recipes", "packages"))
    if not model_root.is_dir() or not recipe_root.is_dir() or not package_root.is_dir():
        raise LibraryValidationError("schema-2 library requires models, recipes, and packages")
    models: dict[tuple[str, str], ModelDefinition] = {}
    for path in sorted(model_root.glob("*.json")):
        try:
            model = ModelDefinition.model_validate(json.loads(path.read_bytes()))
        except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
            raise LibraryValidationError(f"{path}: ModelDefinition is invalid") from error
        key = (model.identity.publisher, model.identity.slug)
        if key in models:
            raise LibraryValidationError(f"{path}: duplicate exact Model identity")
        models[key] = model
    if not models:
        raise LibraryValidationError("schema-2 library contains no Models")
    try:
        validate_model_references(models.values())
    except ContractResolutionError as error:
        raise LibraryValidationError(f"model reference graph is invalid: {error}") from error
    harness_root = platform_root / "config" / "execution-harnesses"
    harnesses: dict[str, Mapping[str, object]] = {}
    if harness_root.is_dir():
        for harness_path in sorted(harness_root.glob("*.json")):
            try:
                harness = json.loads(harness_path.read_bytes())
            except (OSError, UnicodeError, json.JSONDecodeError) as error:
                raise LibraryValidationError(f"{harness_path}: execution harness is invalid") from error
            if (
                not isinstance(harness, Mapping)
                or harness.get("kind") != "execution-harness"
                or harness.get("schema_version") != 1
                or not isinstance(harness.get("identity"), Mapping)
                or harness["identity"].get("slug") != harness_path.stem
                or not isinstance(harness.get("runtime_interface"), str)
                or not harness.get("runtime_interface")
                or not isinstance(harness.get("topology_modes"), list)
                or not harness.get("topology_modes")
            ):
                raise LibraryValidationError(f"{harness_path}: execution harness compatibility declaration is invalid")
            harnesses[harness_path.stem] = harness
    if not harnesses:
        raise LibraryValidationError("platform execution-harnesses directory is missing or empty")
    recipe_keys: set[tuple[str, str]] = set()
    digests: list[str] = []
    try:
        index = json.loads((library_root / "catalog-index.json").read_bytes())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise LibraryValidationError("schema-2 catalog-index.json is unreadable") from error
    if not isinstance(index, Mapping) or index.get("schema_version") != 2 or index.get("kind") != "recipe-library-index":
        raise LibraryValidationError("catalog index must be a schema-2 recipe-library index")
    entity_rows = index.get("catalog_entities")
    if not isinstance(entity_rows, list):
        raise LibraryValidationError("catalog index catalog entities are invalid")
    indexed_models: dict[tuple[str, str], Any] = {}
    for row in entity_rows:
        if not isinstance(row, Mapping) or not isinstance(row.get("document"), Mapping):
            raise LibraryValidationError("catalog index Model row is invalid")
        try:
            indexed_model = ModelDefinition.model_validate(row["document"])
        except ValueError as error:
            raise LibraryValidationError("catalog index Model document is invalid") from error
        key = (indexed_model.identity.publisher, indexed_model.identity.slug)
        if key in indexed_models or row.get("content_sha256") != content_sha256(indexed_model):
            raise LibraryValidationError("catalog index Model identity is stale or duplicated")
        if row.get("source_path") != f"models/{indexed_model.identity.slug}.json":
            raise LibraryValidationError("catalog index Model source path is invalid")
        indexed_models[key] = indexed_model
    if set(indexed_models) != set(models):
        raise LibraryValidationError("catalog index and Model directory identities differ")
    rows = index.get("recipes")
    if not isinstance(rows, list):
        raise LibraryValidationError("catalog index recipes are invalid")
    indexed: dict[tuple[str, str], Mapping[str, object]] = {}
    for row in rows:
        if not isinstance(row, Mapping) or not isinstance(row.get("document"), Mapping):
            raise LibraryValidationError("catalog index recipe row is invalid")
        identity = row["document"].get("identity")
        if not isinstance(identity, Mapping):
            raise LibraryValidationError("catalog index recipe identity is missing")
        key = (str(identity.get("publisher")), str(identity.get("slug")))
        if key in indexed:
            raise LibraryValidationError(f"catalog index duplicates recipe {key[0]}/{key[1]}")
        indexed[key] = row
    for path in sorted(recipe_root.glob("*.json")):
        try:
            recipe = RecipeDefinition.model_validate(json.loads(path.read_bytes()))
        except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
            raise LibraryValidationError(f"{path}: RecipeDefinition is invalid") from error
        key = (recipe.identity.publisher, recipe.identity.slug)
        if path.name != f"{recipe.identity.slug}.json" or key in recipe_keys:
            raise LibraryValidationError(f"{path}: Recipe identity or filename is duplicated/invalid")
        recipe_keys.add(key)
        try:
            validate_recipe_models(recipe, models.values())
            # The package, rather than a sibling checkout, is the source of
            # truth for closure membership.  Validate the declared path
            # grammar here; _validate_v2_package verifies the archive bytes.
            closure: set[str] = set()
            if recipe.execution.mode == "build":
                build = recipe.execution.build
                closure.update((build.context.path, build.dockerfile))
                closure.update(patch.path for patch in build.patches)
            for check in recipe.validation.serving.checks:
                request = check.request
                if getattr(request, "transport", None) == "job":
                    closure.update((request.fixture, *request.input_slots.values()))
            validate_recipe_package_paths(recipe, closure)
        except (ContractResolutionError, ValueError) as error:
            raise LibraryValidationError(f"{path}: Recipe model/closure resolution failed: {error}") from error
        if recipe.runtime.engine not in harnesses:
            raise LibraryValidationError(f"{path}: runtime engine is not an available platform harness: {recipe.runtime.engine}")
        harness = harnesses[recipe.runtime.engine]
        implementation = (
            platform_root
            / "control"
            / "src"
            / "vonk_control"
            / "harnesses"
            / f"{recipe.runtime.engine.replace('-', '_')}.py"
        )
        try:
            compile(implementation.read_bytes(), str(implementation), "exec")
        except (OSError, SyntaxError) as error:
            raise LibraryValidationError(
                f"{path}: platform harness implementation is not structurally valid"
            ) from error
        if recipe.validation.serving.interface not in harness["adapters"]:
            raise LibraryValidationError(
                f"{path}: serving interface is not implemented by platform harness: "
                f"{recipe.validation.serving.interface}"
            )
        row = indexed.get(key)
        digest = content_sha256(recipe)
        if row is None or row.get("content_sha256") != digest:
            raise LibraryValidationError(f"{path}: catalog index digest does not match RecipeDefinition")
        package = row.get("package")
        package_path = package.get("path") if isinstance(package, Mapping) else None
        if not isinstance(package, Mapping) or package.get("recipe_content_sha256") != digest or not isinstance(package_path, str) or not package_path.startswith("packages/"):
            raise LibraryValidationError(f"{path}: package metadata does not bind the Recipe digest")
        package_posix = PurePosixPath(package_path)
        if (
            package_posix.is_absolute()
            or any(part in {"", ".", ".."} for part in package_posix.parts)
            or package_posix.parts[0:1] != ("packages",)
            or package_posix.name != f"{recipe.identity.slug}.tar.gz"
        ):
            raise LibraryValidationError(f"{path}: package path escapes the package root")
        if (
            package.get("media_type") != "application/vnd.vonk-forge.recipe-package.v2+tar+gzip"
            or package.get("minimum_consumer_schema") != 2
        ):
            raise LibraryValidationError(f"{path}: package metadata contract is invalid")
        package_file = library_root.joinpath(*package_posix.parts)
        try:
            if package_file.is_symlink() or not package_file.is_file():
                raise OSError("package file is not a regular file")
            package_bytes = package_file.read_bytes()
        except OSError as error:
            raise LibraryValidationError(f"{path}: immutable recipe package is missing") from error
        if package.get("sha256") != hashlib.sha256(package_bytes).hexdigest() or package.get("expected_bytes") != len(package_bytes):
            raise LibraryValidationError(f"{path}: immutable recipe package identity is stale")
        _validate_v2_package(package_bytes, recipe, models, package_path)
        digests.append(digest)
    if set(indexed) != recipe_keys:
        raise LibraryValidationError("catalog index and recipe directory identities differ")
    _validate_target_recipe_coverage(library_root, {slug for _publisher, slug in recipe_keys})
    return {"schema_version": 2, "catalog_entity_count": len(models), "recipe_count": len(digests), "recipe_content_sha256": digests, "secret_scan": "passed", "package_check": "identity-verified", "contract_source": "contracts/"}


def validate(library_root: Path, platform_root: Path) -> dict[str, Any]:
    library_root = library_root.resolve()
    platform_root = platform_root.resolve()
    if not library_root.is_dir():
        raise LibraryValidationError(
            f"recipe-library root is unavailable: {library_root}"
        )
    _scan_secrets(library_root, platform_root)
    if not (library_root / "models").is_dir() or not (library_root / "contracts").is_dir():
        raise LibraryValidationError(
            "schema-2 library requires models and contracts directories"
        )
    return _validate_v2(library_root, platform_root)


def main() -> int:
    args = _arguments()
    try:
        report = validate(args.library_root, args.platform_root)
    except (LibraryValidationError, OSError) as error:
        print(f"validate-recipe-library: {error}", file=sys.stderr)
        return 2
    if args.as_json:
        print(json.dumps(report, sort_keys=True, separators=(",", ":")))
    else:
        print(
            f"validated {report['recipe_count']} recipes and {report['catalog_entity_count']} catalog entities"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
