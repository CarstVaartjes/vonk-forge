#!/usr/bin/env python3
"""Preflight and accept one exact checked-in recipe on an exact Spark set."""

from __future__ import annotations

import argparse
import hashlib
import ipaddress
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path
from typing import Any

from fleet_snapshot_contract import active_agents, is_ready_node

ROOT = Path(__file__).resolve().parents[1]
RUNNER = ROOT / "scripts/run-development-slices"
QUALIFIER = ROOT / "scripts/qualify-recipe"
KIND_ROOTS = {
    "model-group": "model-groups",
    "model": "models",
    "model-version": "model-versions",
    "execution-harness": "execution-harnesses",
    "runtime-distribution": "runtime-distributions",
    "patch-bundle": "patch-bundles",
}
PHASES = (
    "authored",
    "structurally-verified",
    "container-verified",
    "spark-canary",
    "spark-accepted",
)
MODEL_SINGLE_STATES = (
    "inventory-ready",
    "recipe-resolved",
    "source-verified",
    "image-built",
    "image-distributed",
    "installed",
    "running",
    "route-published",
    "inference-ok",
    "restart-persistence-observed",
    "stopped",
    "route-withdrawn",
    "uninstalled",
)
MODEL_MULTINODE_STATES = (
    *MODEL_SINGLE_STATES[:9],
    "rank-failure-observed",
    "route-withdrawn-after-failure",
    "rank-recovered",
    "route-republished",
    "inference-recovered",
    "restart-persistence-observed",
    *MODEL_SINGLE_STATES[10:],
)
NODE_ID = re.compile(r"spk_[0-9a-f]{32}\Z")
SELECTOR = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:@-]{0,254}\Z")
SLUG = re.compile(r"[a-z0-9][a-z0-9-]{0,62}\Z")
SHA256 = re.compile(r"[0-9a-f]{64}\Z")
IMAGE_DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")
MAXIMUM_PRIVATE_BYTES = 4 * 1024 * 1024
MAXIMUM_TOKEN_BYTES = 16 * 1024
MAXIMUM_HTTP_BYTES = 4 * 1024 * 1024
MAXIMUM_SSH_BYTES = 4 * 1024 * 1024
DEFAULT_FABRIC_VALIDATOR = ROOT / "scripts/validate_fabric.py"
DEFAULT_FABRIC_INVENTORY = ROOT / "inventory/cluster.toml"


class AcceptanceError(RuntimeError):
    """Acceptance cannot safely advance."""


class AcceptanceCheckpoint(RuntimeError):
    """A proven checkpoint requires an external operator action."""


def _canonical(value: object) -> bytes:
    return (
        json.dumps(
            value,
            ensure_ascii=False,
            allow_nan=False,
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    ).encode()


def _content_sha256(value: object) -> str:
    encoded = json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(encoded).hexdigest()


def _canonical_uuid(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        return str(uuid.UUID(value)) == value
    except ValueError:
        return False


def _safe_read(
    path: Path, *, maximum: int = MAXIMUM_PRIVATE_BYTES, private: bool
) -> bytes:
    descriptor = -1
    try:
        listed = path.stat(follow_symlinks=False)
        if not stat.S_ISREG(listed.st_mode):
            raise AcceptanceError("acceptance input file is unsafe")
        descriptor = os.open(
            path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
        )
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or (listed.st_dev, listed.st_ino) != (before.st_dev, before.st_ino)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or not 0 < before.st_size <= maximum
            or (private and stat.S_IMODE(before.st_mode) & 0o077)
        ):
            raise AcceptanceError("acceptance input file is unsafe")
        content = bytearray()
        while len(content) <= maximum:
            chunk = os.read(descriptor, min(64 * 1024, maximum + 1 - len(content)))
            if not chunk:
                break
            content.extend(chunk)
        after = os.fstat(descriptor)
        if len(content) != before.st_size or (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            raise AcceptanceError("acceptance input file changed while read")
        return bytes(content)
    except AcceptanceError:
        raise
    except OSError as error:
        raise AcceptanceError("acceptance input file is unavailable") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _private_token(path: Path, label: str) -> str:
    try:
        value = _safe_read(path, maximum=MAXIMUM_TOKEN_BYTES, private=True).decode(
            "ascii"
        )
    except UnicodeDecodeError as error:
        raise AcceptanceError(f"{label} token file is invalid") from error
    token = value.rstrip("\r\n")
    if (
        not token
        or token != token.strip()
        or "\n" in token
        or "\r" in token
        or any(not 0x21 <= ord(character) <= 0x7E for character in token)
    ):
        raise AcceptanceError(f"{label} token file is invalid")
    return token


def _atomic_write_bytes(path: Path, content: bytes) -> None:
    if not path.is_absolute() or not content or len(content) > MAXIMUM_PRIVATE_BYTES:
        raise AcceptanceError("acceptance evidence destination is invalid")
    parent = path.parent
    try:
        parent_status = parent.stat(follow_symlinks=False)
    except OSError as error:
        raise AcceptanceError("acceptance evidence directory is unavailable") from error
    if not stat.S_ISDIR(parent_status.st_mode):
        raise AcceptanceError("acceptance evidence directory is unsafe")
    if path.exists() or path.is_symlink():
        status = path.lstat()
        if (
            not stat.S_ISREG(status.st_mode)
            or status.st_uid != os.geteuid()
            or status.st_nlink != 1
            or stat.S_IMODE(status.st_mode) & 0o077
        ):
            raise AcceptanceError("acceptance evidence file is unsafe")
    descriptor, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=parent)
    temporary = Path(name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            descriptor = -1
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def _atomic_write(path: Path, value: object) -> None:
    _atomic_write_bytes(path, _canonical(value))


def _json_file(path: Path, *, private: bool) -> tuple[dict[str, Any], bytes]:
    raw = _safe_read(path, private=private)
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise AcceptanceError("acceptance JSON input is invalid") from error
    if not isinstance(value, dict):
        raise AcceptanceError("acceptance JSON input is invalid")
    return value, raw


def _base_url(value: str, label: str) -> str:
    parsed = urllib.parse.urlsplit(value)
    if (
        parsed.scheme not in {"http", "https"}
        or not parsed.hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
    ):
        raise AcceptanceError(f"{label} URL is invalid")
    if parsed.scheme == "http":
        try:
            address = ipaddress.ip_address(parsed.hostname)
        except ValueError as error:
            raise AcceptanceError(
                f"{label} plain HTTP requires an explicit loopback address"
            ) from error
        if not address.is_loopback:
            raise AcceptanceError(
                f"{label} plain HTTP requires an explicit loopback address"
            )
    return value.rstrip("/")


class Client:
    def __init__(self, base: str, token: str, timeout: float) -> None:
        self.base = base
        self._token = token
        self.timeout = timeout

    def get(self, path: str) -> dict[str, Any]:
        if not path.startswith("/") or "?" in path or "#" in path:
            raise AcceptanceError("control API request path is invalid")
        request = urllib.request.Request(
            self.base + path,
            method="GET",
            headers={
                "Authorization": f"Bearer {self._token}",
                "Accept": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                status = response.status
                body = response.read(MAXIMUM_HTTP_BYTES + 1)
        except urllib.error.HTTPError as error:
            status = error.code
            body = error.read(MAXIMUM_HTTP_BYTES + 1)
        except (OSError, urllib.error.URLError) as error:
            raise AcceptanceError(f"control API request failed: GET {path}") from error
        if status != 200:
            raise AcceptanceError(
                f"control API request failed: GET {path} returned HTTP {status}"
            )
        if len(body) > MAXIMUM_HTTP_BYTES:
            raise AcceptanceError("control API response is too large")
        try:
            value = json.loads(body)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise AcceptanceError("control API response is invalid") from error
        if not isinstance(value, dict):
            raise AcceptanceError("control API response is invalid")
        return value


def _selectors(value: str) -> list[str]:
    selectors = value.split(",")
    if (
        not selectors
        or any(SELECTOR.fullmatch(selector) is None for selector in selectors)
        or len(set(selectors)) != len(selectors)
    ):
        raise AcceptanceError("node selectors are invalid")
    return selectors


def _recipe(path: Path, selectors: list[str]) -> dict[str, Any]:
    value, _raw = _json_file(path, private=False)
    identity = value.get("identity")
    topology = value.get("topology")
    count = topology.get("node_count") if isinstance(topology, dict) else None
    if (
        value.get("schema_version") != 1
        or not isinstance(identity, dict)
        or SLUG.fullmatch(str(identity.get("publisher", ""))) is None
        or SLUG.fullmatch(str(identity.get("slug", ""))) is None
        or not isinstance(count, int)
        or isinstance(count, bool)
        or count < 1
    ):
        raise AcceptanceError("recipe acceptance input is invalid")
    if len(selectors) != count:
        raise AcceptanceError(f"recipe requires exactly {count} nodes")
    roles = topology.get("roles")
    if (
        not isinstance(roles, list)
        or sum(role.get("count", 0) if isinstance(role, dict) else 0 for role in roles)
        != count
    ):
        raise AcceptanceError("recipe topology is invalid")
    return value


def _content_root(root: Path) -> Path:
    config = root / "config"
    return config if (config / "model-groups").is_dir() else root


def _catalog_document(
    reference: object, *, library_root: Path, platform_root: Path
) -> dict[str, Any]:
    if not isinstance(reference, dict):
        raise AcceptanceError("recipe catalog reference is invalid")
    kind = reference.get("kind")
    publisher = reference.get("publisher")
    slug = reference.get("slug")
    digest = reference.get("content_sha256")
    if (
        kind not in KIND_ROOTS
        or SLUG.fullmatch(str(publisher)) is None
        or SLUG.fullmatch(str(slug)) is None
        or SHA256.fullmatch(str(digest)) is None
    ):
        raise AcceptanceError("recipe catalog reference is invalid")
    content_roots = (_content_root(library_root), _content_root(platform_root))
    seen: set[Path] = set()
    for content_root in content_roots:
        directory = content_root / KIND_ROOTS[str(kind)]
        path = directory / f"{slug}.json"
        if path in seen or not path.is_file():
            continue
        seen.add(path)
        document, _raw = _json_file(path, private=False)
        identity = document.get("identity")
        if (
            document.get("kind") != kind
            or not isinstance(identity, dict)
            or identity.get("publisher") != publisher
            or identity.get("slug") != slug
            or _content_sha256(document) != digest
        ):
            raise AcceptanceError("recipe catalog reference digest mismatch")
        return document
    raise AcceptanceError("recipe catalog reference is unavailable")


def _inputs(
    recipe: dict[str, Any],
    selectors: list[str],
    *,
    library_root: Path,
    platform_root: Path,
) -> tuple[
    dict[str, Any],
    dict[str, Any],
    list[dict[str, Any]],
    tuple[dict[str, Any], ...],
]:
    try:
        model_reference = recipe["model"]
        execution = recipe["execution"]
        runtime = recipe["runtime"]
        harness_reference = execution["harness"]
        distribution_reference = runtime["distribution"]
        patch_reference = execution.get("patch_bundle")
    except (KeyError, TypeError) as error:
        raise AcceptanceError("recipe catalog references are invalid") from error
    model_version = _catalog_document(
        model_reference, library_root=library_root, platform_root=platform_root
    )
    model_reference_from_version = model_version.get("model")
    model = _catalog_document(
        model_reference_from_version,
        library_root=library_root,
        platform_root=platform_root,
    )
    model_group_reference = model.get("model_group")
    model_group = _catalog_document(
        model_group_reference, library_root=library_root, platform_root=platform_root
    )
    harness = _catalog_document(
        harness_reference, library_root=library_root, platform_root=platform_root
    )
    distribution = _catalog_document(
        distribution_reference,
        library_root=library_root,
        platform_root=platform_root,
    )
    if distribution.get("implements_harness") != harness_reference:
        raise AcceptanceError(
            "runtime distribution does not implement the recipe harness"
        )
    references = [
        model_group_reference,
        model_reference_from_version,
        model_reference,
        harness_reference,
        distribution_reference,
    ]
    if patch_reference is not None:
        patch = _catalog_document(
            patch_reference, library_root=library_root, platform_root=platform_root
        )
        references.append(patch_reference)
    else:
        patch = None
    normalized = [
        {
            "kind": reference["kind"],
            "publisher": reference["publisher"],
            "slug": reference["slug"],
            "content_sha256": reference["content_sha256"],
        }
        for reference in references
    ]
    normalized.sort(
        key=lambda item: (str(item["kind"]), str(item["publisher"]), str(item["slug"]))
    )
    if len(selectors) > 1:
        distributed = distribution.get("capabilities", {}).get("distributed_vllm")
        topology = recipe.get("topology", {})
        if (
            not isinstance(distributed, dict)
            or distributed.get("verified") is not True
            or distributed.get("node_count") != len(selectors)
            or distributed.get("topology_mode") != topology.get("mode")
            or distributed.get("world_size")
            != topology.get("parallelism", {}).get("world_size")
        ):
            raise AcceptanceError(
                "runtime distribution does not prove the distributed topology"
            )
    catalog_documents = tuple(
        document
        for document in (model_group, model, model_version, harness, distribution, patch)
        if document is not None
    )
    return model_version, distribution, normalized, catalog_documents


def _artifact_inputs(model_version: dict[str, Any]) -> list[dict[str, Any]]:
    artifacts = model_version.get("artifacts")
    if not isinstance(artifacts, list) or not artifacts:
        raise AcceptanceError("model version artifact inventory is invalid")
    result: list[dict[str, Any]] = []
    for artifact in artifacts:
        if not isinstance(artifact, dict):
            raise AcceptanceError("model version artifact inventory is invalid")
        selected = {
            "id": artifact.get("id"),
            "repository": artifact.get("repository"),
            "revision": artifact.get("revision"),
            "path": artifact.get("path"),
            "sha256": artifact.get("sha256"),
            "accessible": True,
        }
        if (
            not all(
                isinstance(selected[key], str) and bool(selected[key])
                for key in ("id", "repository", "revision", "path")
            )
            or SHA256.fullmatch(str(selected["sha256"])) is None
        ):
            raise AcceptanceError("model version artifact inventory is invalid")
        result.append(selected)
    return result


def _qualification_path(evidence: Path) -> Path:
    return evidence.with_name(f"{evidence.stem}.qualification.json")


def _runner_path(evidence: Path) -> Path:
    return evidence.with_name(f"{evidence.stem}.runner.json")


def _qualification(
    recipe_path: Path,
    destination: Path,
    timeout: float,
    *,
    library_root: Path,
    platform_root: Path,
) -> tuple[dict[str, Any], str]:
    expected_recipes = {recipe_path.name}
    try:
        result = subprocess.run(
            [
                sys.executable,
                str(QUALIFIER),
                "--recipe",
                str(recipe_path),
                "--library-root",
                str(library_root),
                "--platform-root",
                str(platform_root),
                "--level",
                "structural",
            ],
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise AcceptanceError("structural recipe qualification failed") from error
    if result.returncode != 0 or len(result.stdout) > MAXIMUM_PRIVATE_BYTES:
        raise AcceptanceError("structural recipe qualification failed")
    try:
        document = json.loads(result.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise AcceptanceError("structural recipe qualification is invalid") from error
    if not isinstance(document, dict) or result.stdout != _canonical(document):
        raise AcceptanceError("structural recipe qualification is invalid")
    raw = result.stdout
    _atomic_write_bytes(destination, raw)
    if (
        document.get("passed") is not True
        or document.get("status") != "passed"
        or document.get("recipe") not in expected_recipes
    ):
        raise AcceptanceError("structural recipe qualification did not pass")
    return document, hashlib.sha256(raw).hexdigest()


REMOTE_PREFLIGHT = r"""import json
import platform
import subprocess
import sys
import urllib.parse
import urllib.request

request = json.load(sys.stdin)

def run(command):
    return subprocess.run(command, check=True, capture_output=True, text=True, timeout=60).stdout.strip()

machine = platform.machine().lower()
architecture = "linux-arm64" if machine in {"aarch64", "arm64"} else f"linux-{machine}"
drivers = {line.strip() for line in run(["nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader"]).splitlines() if line.strip()}
if len(drivers) != 1:
    raise RuntimeError("NVIDIA driver identity is ambiguous")
docker_version = run(["sudo", "-n", "docker", "--version"])
info = json.loads(run(["sudo", "-n", "docker", "info", "--format", "{{json .}}"])); runtimes = info.get("Runtimes", {})
images = []
for reference in request["images"]:
    accessible = subprocess.run(["sudo", "-n", "docker", "manifest", "inspect", reference], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60).returncode == 0
    images.append({"reference": reference, "accessible": accessible})
artifacts = []
for item in request["artifacts"]:
    url = item["repository"].rstrip("/") + "/resolve/" + urllib.parse.quote(item["revision"], safe="") + "/" + urllib.parse.quote(item["path"], safe="/")
    accessible = False
    try:
        with urllib.request.urlopen(urllib.request.Request(url, method="HEAD"), timeout=30) as response:
            accessible = 200 <= response.status < 400
    except Exception:
        accessible = False
    artifacts.append({key: item[key] for key in ("id", "repository", "revision", "path", "sha256")} | {"accessible": accessible})
result = {"schema_version": 1, "architecture": architecture, "nvidia_driver_version": next(iter(drivers)), "container_runtime_version": docker_version, "nvidia_container_runtime": "nvidia" in runtimes, "image_access": images, "artifact_access": artifacts}
print(json.dumps(result, allow_nan=False, sort_keys=True, separators=(",", ":")))
"""


def _host_preflight(
    args: argparse.Namespace,
    ssh_target: str,
    image: str,
    artifacts: list[dict[str, Any]],
) -> dict[str, Any]:
    if SELECTOR.fullmatch(ssh_target) is None or ssh_target.startswith("-"):
        raise AcceptanceError("SSH target is invalid")
    request = {"images": [image], "artifacts": artifacts}
    remote_command = f"python3 -c {shlex.quote(REMOTE_PREFLIGHT)}"
    command = [
        args.ssh_command,
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "ForwardAgent=no",
        "-o",
        "StrictHostKeyChecking=yes",
        ssh_target,
        remote_command,
    ]
    try:
        result = subprocess.run(
            command,
            input=_canonical(request),
            capture_output=True,
            check=False,
            timeout=args.timeout_seconds,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise AcceptanceError(f"host preflight failed for {ssh_target}") from error
    if (
        result.returncode != 0
        or not result.stdout
        or len(result.stdout) > MAXIMUM_SSH_BYTES
    ):
        raise AcceptanceError(f"host preflight failed for {ssh_target}")
    try:
        evidence = json.loads(result.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise AcceptanceError(f"host preflight is invalid for {ssh_target}") from error
    if not isinstance(evidence, dict) or result.stdout != _canonical(evidence):
        raise AcceptanceError(f"host preflight is not canonical for {ssh_target}")
    return evidence


def _fleet(client: Client) -> tuple[dict[str, Any], dict[str, dict[str, Any]], str]:
    fleet = client.get("/api/v1/fleet")
    nodes = fleet.get("nodes")
    cursor = fleet.get("event_cursor")
    if (
        fleet.get("schema_version") != 1
        or not isinstance(cursor, int)
        or isinstance(cursor, bool)
        or cursor < 0
        or not isinstance(fleet.get("generated_at"), str)
        or re.fullmatch(r"[0-9a-f]{40}", str(fleet.get("repository_commit"))) is None
        or not isinstance(nodes, list)
    ):
        raise AcceptanceError("fleet response is invalid")
    by_id: dict[str, dict[str, Any]] = {}
    for node in nodes:
        node_id = node.get("id") if isinstance(node, dict) else None
        if (
            not isinstance(node, dict)
            or NODE_ID.fullmatch(str(node_id)) is None
            or node_id in by_id
        ):
            raise AcceptanceError("fleet response is invalid")
        by_id[str(node_id)] = node
    return fleet, by_id, hashlib.sha256(_canonical(fleet)).hexdigest()


def _agents(client: Client) -> dict[str, dict[str, Any]]:
    try:
        return active_agents(client.get("/api/v1/agents"))
    except (TypeError, ValueError) as error:
        raise AcceptanceError("agent response is invalid") from error


def _ssh_target_mapping(
    values: list[str] | None, selectors: list[str]
) -> dict[str, str]:
    mapping: dict[str, str] = {}
    for value in values or []:
        selector, separator, target = value.partition("=")
        if (
            separator != "="
            or not selector
            or SELECTOR.fullmatch(selector) is None
            or SELECTOR.fullmatch(target) is None
            or selector.startswith("-")
            or target.startswith("-")
            or selector in mapping
            or target in mapping.values()
        ):
            raise AcceptanceError("SSH target mapping is invalid")
        mapping[selector] = target
    if list(mapping) != selectors:
        raise AcceptanceError("SSH target mapping must exactly cover Fleet selectors")
    return mapping


def _resolve_nodes(
    selectors: list[str],
    nodes: dict[str, dict[str, Any]],
    agents: dict[str, dict[str, Any]],
) -> list[tuple[str, dict[str, Any], dict[str, Any]]]:
    result: list[tuple[str, dict[str, Any], dict[str, Any]]] = []
    selected: set[str] = set()
    for selector in selectors:
        matches = [
            node
            for node in nodes.values()
            if selector
            in {node.get("id"), node.get("display_name"), node.get("hostname")}
        ]
        if len(matches) != 1:
            raise AcceptanceError(
                f"node selector {selector} is not an exact fleet identity"
            )
        node = matches[0]
        node_id = str(node["id"])
        if node_id in selected or node_id not in agents:
            raise AcceptanceError("requested node identities are not unique and active")
        selected.add(node_id)
        result.append((selector, node, agents[node_id]))
    return result


def _role_requirements(recipe: dict[str, Any]) -> list[dict[str, Any]]:
    topology = recipe["topology"]
    result: list[dict[str, Any]] = []
    for role in topology["roles"]:
        if not isinstance(role, dict) or not isinstance(role.get("count"), int):
            raise AcceptanceError("recipe topology role is invalid")
        result.extend([role] * role["count"])
    return result


def _positive_integer(value: object) -> int | None:
    return (
        value
        if isinstance(value, int) and not isinstance(value, bool) and value >= 0
        else None
    )


def _resource_preflight(
    recipe: dict[str, Any],
    selected: list[tuple[str, dict[str, Any], dict[str, Any]]],
) -> dict[str, dict[str, int]]:
    roles = _role_requirements(recipe)
    requirements: dict[str, dict[str, int]] = {}
    fabric_addresses: set[str] = set()
    minimum_bandwidth = int(recipe["topology"]["fabric"]["minimum_bandwidth_mbps"])
    connected = recipe["topology"]["fabric"]["connectivity"] == "connected"
    for role, (_selector, node, agent) in zip(roles, selected, strict=True):
        node_id = str(node["id"])
        connection = node.get("connection")
        inventory = node.get("inventory")
        reservations = node.get("reservations")
        if (
            not is_ready_node(
                node,
                required_capabilities=(
                    "build.rootless-podman.v1",
                    "recipe.operations.v1",
                    "runtime.spark-docker-nvidia.v1",
                ),
            )
            or not isinstance(connection, dict)
            or not isinstance(inventory, dict)
            or inventory.get("artifact_store_read_only") is not False
            or not isinstance(reservations, dict)
            or agent.get("state") != "active"
            or agent.get("stale") is not False
        ):
            raise AcceptanceError(f"node {node_id} is not acceptance-ready")
        capabilities = set(inventory.get("capabilities", [])) & set(
            agent.get("capabilities", [])
        )
        required_capabilities = {
            "build.rootless-podman.v1",
            "recipe.operations.v1",
            "runtime.spark-docker-nvidia.v1",
        }
        if not required_capabilities <= capabilities:
            raise AcceptanceError(f"node {node_id} lacks required runtime capabilities")
        if not inventory.get("nvidia_driver_version") or not inventory.get(
            "container_runtime_version"
        ):
            raise AcceptanceError(f"node {node_id} lacks exact runtime identity")
        disk = role.get("resources", {}).get("disk", {})
        memory = role.get("resources", {}).get("memory", {})
        if not isinstance(disk, dict) or not isinstance(memory, dict):
            raise AcceptanceError("recipe resource contract is invalid")
        disk_required_values = [
            _positive_integer(disk.get(key))
            for key in (
                "image_bytes",
                "artifact_bytes",
                "staging_bytes",
                "cache_bytes",
                "rollback_bytes",
                "safety_margin_bytes",
            )
        ]
        memory_required_values = [
            _positive_integer(memory.get(key))
            for key in (
                "startup_peak_bytes",
                "steady_state_bytes",
                "runtime_growth_bytes",
                "system_reserve_bytes",
            )
        ]
        disk_free = _positive_integer(inventory.get("disk_free_bytes"))
        host_free = _positive_integer(inventory.get("host_memory_free_bytes"))
        gpu_free = _positive_integer(inventory.get("gpu_memory_free_bytes"))
        disk_reserved = _positive_integer(reservations.get("disk_bytes"))
        unified_reserved = _positive_integer(reservations.get("unified_memory_bytes"))
        host_reserved = _positive_integer(reservations.get("host_memory_bytes"))
        gpu_reserved = _positive_integer(reservations.get("gpu_memory_bytes"))
        if any(
            value is None
            for value in (
                *disk_required_values,
                *memory_required_values,
                disk_free,
                host_free,
                gpu_free,
                disk_reserved,
                unified_reserved,
                host_reserved,
                gpu_reserved,
            )
        ):
            raise AcceptanceError(f"node {node_id} resource evidence is invalid")
        disk_required = sum(int(value) for value in disk_required_values)
        startup_peak, steady_state, runtime_growth, system_reserve = (
            int(value) for value in memory_required_values
        )
        memory_required = (
            max(startup_peak, steady_state + runtime_growth) + system_reserve
        )
        assert None not in {
            disk_free,
            host_free,
            gpu_free,
            disk_reserved,
            unified_reserved,
            host_reserved,
            gpu_reserved,
        }
        disk_available = int(disk_free) - int(disk_reserved)
        memory_available = min(
            int(host_free) - int(host_reserved) - int(unified_reserved),
            int(gpu_free) - int(gpu_reserved) - int(unified_reserved),
        )
        if disk_available < disk_required:
            raise AcceptanceError(f"node {node_id} lacks required disk capacity")
        if memory_available < memory_required:
            raise AcceptanceError(f"node {node_id} lacks required unified memory")
        if connected:
            address = inventory.get("fabric_address")
            bandwidth = inventory.get("fabric_bandwidth_mbps")
            if (
                not isinstance(address, str)
                or not address
                or address in fabric_addresses
                or not isinstance(bandwidth, int)
                or isinstance(bandwidth, bool)
                or bandwidth < minimum_bandwidth
            ):
                raise AcceptanceError(f"node {node_id} lacks exact fabric evidence")
            fabric_addresses.add(address)
        requirements[node_id] = {
            "disk_required_bytes": disk_required,
            "disk_available_bytes": disk_available,
            "memory_required_bytes": memory_required,
            "memory_available_bytes": memory_available,
        }
    return requirements


def _node_record(
    selector: str,
    ssh_target: str,
    node: dict[str, Any],
    agent: dict[str, Any],
) -> dict[str, Any]:
    build_digest = agent.get("build_digest")
    agent_sha256 = agent.get("agent_sha256")
    generation = agent.get("supervisor_generation")
    if (
        IMAGE_DIGEST.fullmatch(str(build_digest)) is None
        or SHA256.fullmatch(str(agent_sha256)) is None
        or not isinstance(generation, int)
        or isinstance(generation, bool)
        or generation < 1
        or not isinstance(node.get("display_name"), str)
        or not node["display_name"]
        or not isinstance(node.get("hostname"), str)
        or not node["hostname"]
        or not isinstance(agent.get("certificate_expires_at"), str)
        or not agent["certificate_expires_at"]
    ):
        raise AcceptanceError("agent exact identity is incomplete")
    return {
        "selector": selector,
        "ssh_target": ssh_target,
        "node_id": node["id"],
        "display_name": node["display_name"],
        "hostname": node["hostname"],
        "agent_build_digest": build_digest,
        "agent_sha256": agent_sha256,
        "supervisor_generation": generation,
        "certificate_expires_at": agent["certificate_expires_at"],
    }


def _same_node_binding(initial: dict[str, Any], current: dict[str, Any]) -> bool:
    stable = {
        "selector",
        "ssh_target",
        "node_id",
        "display_name",
        "hostname",
        "agent_build_digest",
        "agent_sha256",
        "certificate_expires_at",
    }
    return (
        all(initial.get(key) == current.get(key) for key in stable)
        and isinstance(initial.get("supervisor_generation"), int)
        and current["supervisor_generation"] >= initial["supervisor_generation"]
    )


def _host_evidence(
    host: dict[str, Any],
    *,
    node: dict[str, Any],
    image: str,
    artifacts: list[dict[str, Any]],
) -> None:
    inventory = node["inventory"]
    if host.get("architecture") != "linux-arm64":
        raise AcceptanceError("recipe requires linux-arm64")
    if (
        host.get("schema_version") != 1
        or host.get("nvidia_driver_version") != inventory.get("nvidia_driver_version")
        or host.get("container_runtime_version")
        != inventory.get("container_runtime_version")
        or host.get("nvidia_container_runtime") is not True
        or host.get("image_access") != [{"reference": image, "accessible": True}]
        or host.get("artifact_access") != artifacts
    ):
        raise AcceptanceError(f"host evidence does not match node {node['id']}")


def _load_acceptance(
    path: Path,
    *,
    recipe_identity: dict[str, Any],
    selectors: list[str],
    entity_references: list[dict[str, Any]],
    ssh_targets: dict[str, str],
) -> dict[str, Any]:
    expected = {
        "recipe": recipe_identity,
        "requested_nodes": selectors,
        "entity_references": entity_references,
        "ssh_targets": ssh_targets,
    }
    if not path.exists() and not path.is_symlink():
        evidence: dict[str, Any] = {
            "schema_version": 1,
            "acceptance_id": str(uuid.uuid4()),
            **expected,
            "nodes": [],
            "completed_phases": ["authored"],
            "status": "authored",
        }
        _atomic_write(path, evidence)
        return evidence
    evidence, raw = _json_file(path, private=True)
    completed = evidence.get("completed_phases")
    status = evidence.get("status")
    minimum_phase_count = {
        "failed": 0,
        "authored": 1,
        "structurally-verified": 2,
        "preflight-passed": 2,
        "checkpoint-required": 3,
        "spark-accepted": len(PHASES),
    }
    if (
        raw != _canonical(evidence)
        or evidence.get("schema_version") != 1
        or not _canonical_uuid(evidence.get("acceptance_id"))
        or any(evidence.get(key) != value for key, value in expected.items())
        or not isinstance(completed, list)
        or completed != list(PHASES[: len(completed)])
        or not isinstance(evidence.get("nodes"), list)
    ):
        if any(evidence.get(key) != value for key, value in expected.items()):
            raise AcceptanceError("evidence inputs do not match this invocation")
        raise AcceptanceError("acceptance evidence is invalid")
    if (
        not isinstance(status, str)
        or status not in minimum_phase_count
        or len(completed) < minimum_phase_count[status]
    ):
        raise AcceptanceError(
            "acceptance evidence status overstates completed phases"
        )
    return evidence


def _complete_phase(evidence: dict[str, Any], phase: str) -> None:
    completed = evidence["completed_phases"]
    if phase in completed:
        return
    if phase != PHASES[len(completed)]:
        raise AcceptanceError("acceptance phase transition is invalid")
    completed.append(phase)


def _runner_identity(
    document: dict[str, Any],
    *,
    args: argparse.Namespace,
    recipe: dict[str, Any],
    node_ids: list[str],
    qualification_sha256: str,
) -> tuple[str, tuple[str, ...], dict[str, Any]]:
    phase = "model-single" if len(node_ids) == 1 else "model-multinode"
    states = MODEL_SINGLE_STATES if phase == "model-single" else MODEL_MULTINODE_STATES
    topology = recipe["topology"]
    expected: dict[str, Any] = {
        "schema_version": 1,
        "phase": phase,
        "api_base": _base_url(args.api_base, "control API"),
        "inference_base": _base_url(args.inference_base, "inference API"),
        "builder_node": node_ids[0],
        "target_nodes": node_ids,
        "recipe_slug": recipe["identity"]["slug"],
        "topology_name": topology["name"],
        "qualification_sha256": qualification_sha256,
    }
    if phase == "model-multinode":
        expected["failure_node"] = node_ids[1]
    if any(document.get(key) != value for key, value in expected.items()):
        raise AcceptanceError("runner evidence inputs do not match acceptance")
    completed = document.get("completed_states")
    outputs = document.get("outputs")
    if (
        not _canonical_uuid(document.get("acceptance_id"))
        or not isinstance(completed, list)
        or completed != list(states[: len(completed)])
        or not isinstance(outputs, dict)
    ):
        raise AcceptanceError("runner evidence is invalid")
    return phase, states, outputs


def _require_sha(outputs: dict[str, Any], *keys: str) -> None:
    if any(SHA256.fullmatch(str(outputs.get(key))) is None for key in keys):
        raise AcceptanceError("runner evidence is incomplete")


def _require_uuid(outputs: dict[str, Any], *keys: str) -> None:
    if any(not _canonical_uuid(outputs.get(key)) for key in keys):
        raise AcceptanceError("runner evidence is incomplete")


def _rank_checkpoint_action(
    *,
    run_id: str,
    runtime_request_sha256: str | None,
    ssh_target: str,
    start: bool,
) -> dict[str, Any]:
    if not _canonical_uuid(run_id) or SELECTOR.fullmatch(ssh_target) is None:
        raise AcceptanceError("rank checkpoint identity is invalid")
    if runtime_request_sha256 is not None and SHA256.fullmatch(
        runtime_request_sha256
    ) is None:
        raise AcceptanceError("rank checkpoint identity is invalid")
    container_name = f"vonk-{run_id}"
    request_label = runtime_request_sha256 or "<64-lowercase-hex>"
    return {
        "agent_action": "keep-running",
        "ssh_target": ssh_target,
        "container_name": container_name,
        "expected_labels": {
            "ai.vonkforge.managed": "true",
            "ai.vonkforge.run-id": run_id,
            "ai.vonkforge.runtime-request-sha256": request_label,
        },
        "inspect_argv": [
            "sudo",
            "docker",
            "container",
            "inspect",
            "--format",
            (
                '{{index .Config.Labels "ai.vonkforge.managed"}} '
                '{{index .Config.Labels "ai.vonkforge.run-id"}} '
                '{{index .Config.Labels "ai.vonkforge.runtime-request-sha256"}}'
            ),
            container_name,
        ],
        "operation": "start" if start else "stop",
        "operation_argv": [
            "sudo",
            "docker",
            "start" if start else "stop",
            container_name,
        ],
    }


def _validate_runner_outputs(
    document: dict[str, Any],
    *,
    states: tuple[str, ...],
    outputs: dict[str, Any],
    recipe_digest: str,
    node_ids: list[str],
) -> None:
    completed = document["completed_states"]
    reached = set(completed)
    if "inventory-ready" in reached:
        _require_sha(outputs, "fleet_evidence_digest")
        initial = outputs.get("initial_agent_last_seen")
        if (
            not isinstance(initial, dict)
            or set(initial) != set(node_ids)
            or any(
                not isinstance(value, str) or not value for value in initial.values()
            )
        ):
            raise AcceptanceError("runner evidence is incomplete")
    if "recipe-resolved" in reached:
        _require_uuid(outputs, "recipe_id", "recipe_revision_id")
        if outputs.get("recipe_content_sha256") != recipe_digest or not isinstance(
            outputs.get("recipe_revision"), int
        ):
            raise AcceptanceError("runner evidence is incomplete")
    if "source-verified" in reached:
        _require_sha(outputs, "source_bundle_sha256")
    if "image-built" in reached:
        _require_sha(outputs, "build_input_sha256", "oci_layout_sha256")
        _require_uuid(outputs, "recipe_build_id", "build_operation_id")
        if (
            IMAGE_DIGEST.fullmatch(str(outputs.get("image_digest"))) is None
            or not isinstance(outputs.get("image_bytes"), int)
            or isinstance(outputs.get("image_bytes"), bool)
            or outputs["image_bytes"] <= 0
        ):
            raise AcceptanceError("runner evidence is incomplete")
    if "image-distributed" in reached:
        _require_sha(outputs, "distribution_evidence_sha256")
        _require_uuid(outputs, "mapping_id", "distribution_operation_id")
        if outputs.get("distribution_nodes") != node_ids or not isinstance(
            outputs.get("mapping_generation"), int
        ):
            raise AcceptanceError("runner evidence is incomplete")
    if "installed" in reached:
        _require_uuid(outputs, "installation_id", "installation_operation_id")
    if "running" in reached:
        _require_uuid(outputs, "run_id", "run_operation_id")
        _require_sha(
            outputs,
            "artifact_set_digest",
            "run_evidence_sha256",
        )
        node_evidence = outputs.get("run_node_evidence_digests")
        if (
            not isinstance(node_evidence, dict)
            or set(node_evidence) != set(node_ids)
            or any(
                SHA256.fullmatch(str(value)) is None for value in node_evidence.values()
            )
        ):
            raise AcceptanceError("runner evidence is incomplete")
    if "inference-ok" in reached:
        _require_sha(outputs, "inference_response_sha256")
    if "inference-recovered" in reached:
        _require_sha(outputs, "recovered_inference_response_sha256")
    if "restart-persistence-observed" in reached:
        _require_sha(
            outputs,
            "restart_fleet_evidence_digest",
            "restart_inference_response_sha256",
            "restart_binding_sha256",
        )
        restarted = outputs.get("restart_agent_last_seen")
        checkpoint = outputs.get("restart_checkpoint")
        identities = outputs.get("restart_identity")
        if (
            not isinstance(restarted, dict)
            or set(restarted) != set(node_ids)
            or not isinstance(checkpoint, dict)
            or set(checkpoint) != set(node_ids)
            or not isinstance(identities, dict)
            or set(identities) != set(node_ids)
        ):
            raise AcceptanceError("runner evidence is incomplete")
        for node_id in node_ids:
            before = checkpoint[node_id]
            after = identities[node_id]
            if (
                not isinstance(before, dict)
                or not isinstance(after, dict)
                or not _canonical_uuid(before.get("boot_id"))
                or not _canonical_uuid(after.get("boot_id"))
                or before["boot_id"] == after["boot_id"]
                or not isinstance(before.get("supervisor_generation"), int)
                or isinstance(before.get("supervisor_generation"), bool)
                or not isinstance(after.get("supervisor_generation"), int)
                or isinstance(after.get("supervisor_generation"), bool)
                or after["supervisor_generation"]
                <= before["supervisor_generation"]
            ):
                raise AcceptanceError("runner evidence is incomplete")
        binding = {
            "fleet_evidence_digest": outputs["restart_fleet_evidence_digest"],
            "inference_response_sha256": outputs[
                "restart_inference_response_sha256"
            ],
            "restart_identity": identities,
        }
        if outputs["restart_binding_sha256"] != hashlib.sha256(
            _canonical(binding)
        ).hexdigest():
            raise AcceptanceError("runner evidence is incomplete")
    if "stopped" in reached:
        _require_uuid(outputs, "stop_operation_id")
    if "uninstalled" in reached:
        _require_uuid(outputs, "uninstall_operation_id")
    if completed == list(states) and set(states) - reached:
        raise AcceptanceError("runner evidence is incomplete")


class Acceptance:
    def __init__(
        self,
        args: argparse.Namespace,
        selectors: list[str],
        ssh_targets: dict[str, str],
        recipe: dict[str, Any],
    ) -> None:
        self.args = args
        self.selectors = selectors
        self.ssh_targets = ssh_targets
        self.recipe = recipe
        self.recipe_digest = _content_sha256(recipe)
        (
            self.model_version,
            self.distribution,
            references,
            self.catalog_documents,
        ) = _inputs(
            recipe,
            selectors,
            library_root=args.library_root,
            platform_root=ROOT,
        )
        identity = recipe["identity"]
        self.recipe_identity = {
            "publisher": identity["publisher"],
            "slug": identity["slug"],
            "content_sha256": self.recipe_digest,
        }
        self.evidence = _load_acceptance(
            args.evidence_file,
            recipe_identity=self.recipe_identity,
            selectors=selectors,
            entity_references=references,
            ssh_targets=ssh_targets,
        )

    def _write(self) -> None:
        _atomic_write(self.args.evidence_file, self.evidence)

    def _structural(self) -> str:
        _document, digest = _qualification(
            self.args.recipe,
            _qualification_path(self.args.evidence_file),
            self.args.timeout_seconds,
            library_root=self.args.library_root,
            platform_root=ROOT,
        )
        _complete_phase(self.evidence, "structurally-verified")
        self.evidence["qualification_sha256"] = digest
        self.evidence["status"] = "structurally-verified"
        self._write()
        return digest

    def _preflight(self, client: Client) -> tuple[list[str], dict[str, dict[str, Any]]]:
        fleet, fleet_nodes, fleet_digest = _fleet(client)
        agents = _agents(client)
        selected = _resolve_nodes(self.selectors, fleet_nodes, agents)
        current_records = [
            _node_record(selector, self.ssh_targets[selector], node, agent)
            for selector, node, agent in selected
        ]
        initial_records = self.evidence.get("nodes")
        if initial_records:
            if len(initial_records) != len(current_records) or any(
                not isinstance(initial, dict)
                or not _same_node_binding(initial, current)
                for initial, current in zip(
                    initial_records, current_records, strict=True
                )
            ):
                raise AcceptanceError(
                    "evidence node identities do not match this fleet"
                )
        else:
            self.evidence["nodes"] = current_records
        resources = _resource_preflight(self.recipe, selected)
        image = self.distribution.get("image")
        if not isinstance(image, str) or "@sha256:" not in image:
            raise AcceptanceError("runtime distribution image identity is invalid")
        artifacts = _artifact_inputs(self.model_version)
        hosts: dict[str, dict[str, Any]] = {}
        for selector, node, _agent in selected:
            host = _host_preflight(
                self.args, self.ssh_targets[selector], image, artifacts
            )
            _host_evidence(
                host,
                node=node,
                image=image,
                artifacts=artifacts,
            )
            hosts[str(node["id"])] = host
        fabric = self._fabric_preflight(selected)
        self.evidence["preflight"] = {
            "fleet_evidence_sha256": fleet_digest,
            "fleet_event_cursor": fleet["event_cursor"],
            "repository_commit": fleet["repository_commit"],
            "resources": resources,
            "hosts": hosts,
        }
        if fabric is not None:
            self.evidence["preflight"]["fabric"] = fabric
        self.evidence["status"] = "preflight-passed"
        self._write()
        return [str(node[1]["id"]) for node in selected], agents

    def _fabric_preflight(
        self,
        selected: list[tuple[str, dict[str, Any], dict[str, Any]]],
    ) -> dict[str, Any] | None:
        if len(selected) == 1:
            return None
        try:
            descriptor, output_name = tempfile.mkstemp(
                prefix=f".{self.args.evidence_file.stem}.fabric-",
                suffix=".json",
                dir=self.args.evidence_file.parent,
            )
            os.fchmod(descriptor, 0o600)
            os.close(descriptor)
            output = Path(output_name)
        except OSError as error:
            raise AcceptanceError("fabric preflight output is unavailable") from error
        expected = [
            f"{node['id']}={self.ssh_targets[selector]}"
            for selector, node, _agent in selected
        ]
        command = [
            str(self.args.fabric_validator),
            "--inventory",
            str(self.args.fabric_inventory),
            "--output",
            str(output),
            "--preflight-only",
        ]
        for binding in expected:
            command.extend(("--expected-node", binding))
        try:
            result = subprocess.run(
                command,
                capture_output=True,
                check=False,
                timeout=self.args.timeout_seconds,
            )
            if result.returncode != 0:
                raise AcceptanceError("fabric preflight failed")
            document, raw = _json_file(output, private=True)
            if (
                document.get("schema_version") != 2
                or document.get("status") != "preflight_passed"
                or document.get("evidence_scope") != "live_read_only_preflight"
                or document.get("selected_nodes") != expected
            ):
                raise AcceptanceError("fabric preflight evidence is invalid")
            inventory = _safe_read(self.args.fabric_inventory, private=False)
            return {
                "selected_nodes": expected,
                "inventory_sha256": hashlib.sha256(inventory).hexdigest(),
                "evidence_sha256": hashlib.sha256(raw).hexdigest(),
            }
        except (OSError, subprocess.SubprocessError) as error:
            raise AcceptanceError("fabric preflight failed") from error
        finally:
            try:
                output.unlink()
            except FileNotFoundError:
                pass

    def _runner_command(
        self,
        node_ids: list[str],
        qualification_sha256: str,
        *,
        catalog_path: Path,
        source_context: Path,
    ) -> list[str]:
        phase = "model-single" if len(node_ids) == 1 else "model-multinode"
        command = [
            str(RUNNER),
            "--api-base",
            self.args.api_base,
            "--inference-base",
            self.args.inference_base,
            "--admin-token-file",
            str(self.args.admin_token_file),
            "--inference-token-file",
            str(self.args.inference_token_file),
            "--phase",
            phase,
            "--builder-node",
            node_ids[0],
            "--evidence-file",
            str(_runner_path(self.args.evidence_file)),
            "--recipe",
            str(self.args.recipe),
            "--catalog",
            str(catalog_path),
            "--source-context",
            str(source_context),
            "--qualification-file",
            str(_qualification_path(self.args.evidence_file)),
            "--timeout-seconds",
            str(self.args.timeout_seconds),
            "--poll-seconds",
            str(self.args.poll_seconds),
        ]
        for node_id in node_ids:
            command.extend(("--target-node", node_id))
        if phase == "model-multinode":
            command.extend(("--failure-node", node_ids[1]))
        existing = self._runner_evidence(
            node_ids=node_ids,
            qualification_sha256=qualification_sha256,
            required=False,
        )
        completed = existing[0].get("completed_states", []) if existing else []
        if "inference-ok" not in completed:
            command.extend(("--stop-after", "inference-ok"))
        elif (
            phase == "model-multinode"
            and "route-withdrawn-after-failure" not in completed
        ):
            command.extend(("--stop-after", "route-withdrawn-after-failure"))
        elif phase == "model-multinode" and "inference-recovered" not in completed:
            command.extend(("--stop-after", "inference-recovered"))
        return command

    def _runner_evidence(
        self,
        *,
        node_ids: list[str],
        qualification_sha256: str,
        required: bool,
    ) -> tuple[dict[str, Any], bytes, str, tuple[str, ...], dict[str, Any]] | None:
        path = _runner_path(self.args.evidence_file)
        if not path.exists() and not path.is_symlink():
            if required:
                raise AcceptanceError("runner evidence is missing")
            return None
        document, raw = _json_file(path, private=True)
        if raw != _canonical(document):
            raise AcceptanceError("runner evidence is not canonical")
        phase, states, outputs = _runner_identity(
            document,
            args=self.args,
            recipe=self.recipe,
            node_ids=node_ids,
            qualification_sha256=qualification_sha256,
        )
        _validate_runner_outputs(
            document,
            states=states,
            outputs=outputs,
            recipe_digest=self.recipe_digest,
            node_ids=node_ids,
        )
        return document, raw, phase, states, outputs

    def _spark(
        self,
        client: Client,
        node_ids: list[str],
        qualification_sha256: str,
    ) -> None:
        # Reading the inference token here keeps preflight independent of it.
        _private_token(self.args.inference_token_file, "inference")
        try:
            with tempfile.TemporaryDirectory(prefix="vonk-accept-catalog-") as temp:
                catalog_path = Path(temp)
                for index, document in enumerate(self.catalog_documents):
                    (catalog_path / f"{index:02d}.json").write_bytes(
                        _canonical(document)
                    )
                context = self.recipe.get("build", {}).get("context", {})
                context_path = context.get("path") if isinstance(context, dict) else None
                if not isinstance(context_path, str):
                    raise AcceptanceError("recipe source context is invalid")
                source_context = (self.args.library_root / context_path).resolve()
                try:
                    source_context.relative_to(self.args.library_root.resolve())
                except ValueError as error:
                    raise AcceptanceError("recipe source context escapes library root") from error
                if not source_context.is_dir():
                    source_context = (ROOT / context_path).resolve()
                if not source_context.is_dir():
                    raise AcceptanceError("recipe source context is unavailable")
                command = self._runner_command(
                    node_ids,
                    qualification_sha256,
                    catalog_path=catalog_path,
                    source_context=source_context,
                )
                result = subprocess.run(
                    command,
                    capture_output=True,
                    check=False,
                    timeout=min(self.args.timeout_seconds * 20, 21_600),
                )
        except (OSError, subprocess.SubprocessError) as error:
            raise AcceptanceError("acceptance runner failed") from error
        if result.returncode != 0:
            detail = result.stderr.decode("utf-8", errors="replace").strip()
            raise AcceptanceError(
                "acceptance runner failed" + (f": {detail[:1000]}" if detail else "")
            )
        loaded = self._runner_evidence(
            node_ids=node_ids,
            qualification_sha256=qualification_sha256,
            required=True,
        )
        assert loaded is not None
        document, raw, phase, states, outputs = loaded
        completed = document["completed_states"]
        if "running" in completed:
            _complete_phase(self.evidence, "container-verified")
        if "inference-ok" in completed:
            _complete_phase(self.evidence, "spark-canary")
        if completed != list(states):
            self.evidence["runner_evidence_sha256"] = hashlib.sha256(raw).hexdigest()
            self.evidence["status"] = "checkpoint-required"
            self.evidence.pop("checkpoint_action", None)
            if phase == "model-single":
                action = "restart the accepted Spark offline, then rerun this command"
            elif "route-withdrawn-after-failure" not in completed:
                failure_node = node_ids[1]
                ssh_target = next(
                    node["ssh_target"]
                    for node in self.evidence["nodes"]
                    if node["node_id"] == failure_node
                )
                self.evidence["checkpoint_action"] = _rank_checkpoint_action(
                    run_id=outputs["run_id"],
                    runtime_request_sha256=None,
                    ssh_target=ssh_target,
                    start=False,
                )
                action = (
                    "keep the agent running; verify the emitted exact container "
                    "labels, stop only that rank container, then rerun this command"
                )
            elif "inference-recovered" not in completed:
                failure_node = node_ids[1]
                ssh_target = next(
                    node["ssh_target"]
                    for node in self.evidence["nodes"]
                    if node["node_id"] == failure_node
                )
                self.evidence["checkpoint_action"] = _rank_checkpoint_action(
                    run_id=outputs["run_id"],
                    runtime_request_sha256=None,
                    ssh_target=ssh_target,
                    start=True,
                )
                action = (
                    "keep the agent running; verify the emitted exact container "
                    "labels, start only that rank container, then rerun this command"
                )
            else:
                action = "restart both accepted Sparks offline, then rerun this command"
            self._write()
            raise AcceptanceCheckpoint(action)
        current_agents = _agents(client)
        for initial in self.evidence["nodes"]:
            current = current_agents.get(initial["node_id"])
            if (
                not isinstance(current, dict)
                or current.get("build_digest") != initial["agent_build_digest"]
                or not isinstance(current.get("supervisor_generation"), int)
                or current["supervisor_generation"] <= initial["supervisor_generation"]
            ):
                raise AcceptanceError(
                    "spark acceptance requires an advanced supervisor generation"
                )
        _complete_phase(self.evidence, "spark-accepted")
        self.evidence["runner_evidence_sha256"] = hashlib.sha256(raw).hexdigest()
        self.evidence["accepted_evidence"] = {
            key: outputs[key]
            for key in (
                "recipe_id",
                "recipe_revision_id",
                "recipe_content_sha256",
                "source_bundle_sha256",
                "build_input_sha256",
                "image_digest",
                "oci_layout_sha256",
                "artifact_set_digest",
                "run_evidence_sha256",
                "restart_fleet_evidence_digest",
                "restart_inference_response_sha256",
                "restart_identity",
                "restart_binding_sha256",
            )
        }
        self.evidence["status"] = "spark-accepted"
        self._write()

    def run(self) -> None:
        try:
            qualification_sha256 = self._structural()
            admin_token = _private_token(self.args.admin_token_file, "administrator")
            client = Client(
                _base_url(self.args.api_base, "control API"),
                admin_token,
                self.args.timeout_seconds,
            )
            del admin_token
            node_ids, _agent_snapshot = self._preflight(client)
            if self.args.preflight_only:
                return
            self._spark(client, node_ids, qualification_sha256)
        except AcceptanceCheckpoint:
            raise
        except AcceptanceError:
            self.evidence["status"] = "failed"
            self._write()
            raise


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--recipe", required=True, type=Path)
    parser.add_argument(
        "--library-root",
        type=Path,
        default=ROOT,
        help="recipe-library checkout containing model entities and build contexts",
    )
    parser.add_argument("--nodes", required=True)
    parser.add_argument("--preflight-only", action="store_true")
    parser.add_argument("--level", choices=("spark",), default="spark")
    parser.add_argument(
        "--api-base",
        default=os.environ.get("VONK_DEVELOPMENT_API_BASE", "http://127.0.0.1:8080"),
    )
    parser.add_argument(
        "--inference-base",
        default=os.environ.get(
            "VONK_DEVELOPMENT_INFERENCE_BASE", "http://127.0.0.1:4000"
        ),
    )
    parser.add_argument(
        "--admin-token-file",
        type=Path,
        default=Path(
            os.environ.get(
                "VONK_DEVELOPMENT_ADMIN_TOKEN_FILE",
                ".state/recipe-acceptance/admin-token",
            )
        ),
    )
    parser.add_argument(
        "--inference-token-file",
        type=Path,
        default=Path(
            os.environ.get(
                "VONK_DEVELOPMENT_INFERENCE_TOKEN_FILE",
                ".state/recipe-acceptance/inference-token",
            )
        ),
    )
    parser.add_argument("--evidence-file", type=Path)
    parser.add_argument("--ssh-command", default="ssh")
    parser.add_argument(
        "--ssh-target",
        action="append",
        help="exact Fleet selector=SSH alias mapping; repeat in --nodes order",
    )
    parser.add_argument(
        "--fabric-validator", type=Path, default=DEFAULT_FABRIC_VALIDATOR
    )
    parser.add_argument(
        "--fabric-inventory", type=Path, default=DEFAULT_FABRIC_INVENTORY
    )
    parser.add_argument("--timeout-seconds", type=float, default=900.0)
    parser.add_argument("--poll-seconds", type=float, default=1.0)
    args = parser.parse_args()
    if not 0 < args.timeout_seconds <= 3600 or not 0 < args.poll_seconds <= 30:
        parser.error("timeouts are outside the bounded acceptance contract")
    args.recipe = Path(os.path.abspath(args.recipe))
    args.library_root = Path(os.path.abspath(args.library_root))
    args.admin_token_file = Path(os.path.abspath(args.admin_token_file))
    args.inference_token_file = Path(os.path.abspath(args.inference_token_file))
    args.fabric_validator = Path(os.path.abspath(args.fabric_validator))
    args.fabric_inventory = Path(os.path.abspath(args.fabric_inventory))
    return args


def main() -> int:
    args = _arguments()
    try:
        selectors = _selectors(args.nodes)
        recipe = _recipe(args.recipe, selectors)
        ssh_targets = _ssh_target_mapping(args.ssh_target, selectors)
        if args.evidence_file is None:
            identity = recipe["identity"]
            node_digest = hashlib.sha256(",".join(selectors).encode()).hexdigest()[:16]
            args.evidence_file = (
                ROOT
                / ".state/recipe-acceptance"
                / f"{identity['slug']}-{node_digest}.json"
            )
            args.evidence_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        args.evidence_file = Path(os.path.abspath(args.evidence_file))
        Acceptance(args, selectors, ssh_targets, recipe).run()
    except AcceptanceCheckpoint as checkpoint:
        print(f"acceptance checkpoint: {checkpoint}", file=sys.stderr)
        return 4
    except AcceptanceError as error:
        print(f"recipe acceptance failed: {error}", file=sys.stderr)
        return 1
    print("recipe preflight passed" if args.preflight_only else "recipe spark-accepted")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
