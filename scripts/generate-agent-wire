#!/usr/bin/env python3
"""Generate the Rust wire declarations from the current Pydantic graph.

tests/test_generated_contracts.py fails when the committed JSON schemas are
stale, and the vonk-wire-codegen crate's own test fails when generated.rs does
not match the committed wire schema.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> None:
    argparse.ArgumentParser(description=__doc__).parse_args()
    schema = ROOT / "rust/crates/vonk-agent-protocol/schema/wire.json"
    output = ROOT / "rust/crates/vonk-agent-protocol/src/generated.rs"
    subprocess.run(
        [
            sys.executable,
            str(ROOT / "scripts/export-agent-wire-schema"),
            "--output",
            str(schema),
        ],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [sys.executable, str(ROOT / "scripts/export-installer-release-schema")],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [
            "cargo",
            "run",
            "--locked",
            "--quiet",
            "-p",
            "vonk-wire-codegen",
            "--",
            str(schema),
            str(output),
        ],
        cwd=ROOT,
        check=True,
    )


if __name__ == "__main__":
    main()
