#!/usr/bin/env python3
"""Generate the Rust wire declarations from the current Pydantic graph.

Cargo also invokes this same renderer in build.rs; generated outputs are
local build inputs. scripts/check-generated-determinism --wire checks bytes
from two independent runs.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

if __name__ == "__main__":
    from check_environment import run_in_control

    run_in_control(ROOT)


def main() -> None:
    argparse.ArgumentParser(description=__doc__).parse_args()
    schema = ROOT / "rust/crates/vonk-agent-protocol/schema/wire.json"
    output = ROOT / "rust/crates/vonk-agent-protocol/src/generated.rs"
    subprocess.run(
        [
            sys.executable,
            str(ROOT / "scripts/export-agent-wire-schema"),
            "--output",
            str(schema),
        ],
        cwd=ROOT,
        check=True,
        timeout=1200,
    )
    subprocess.run(
        [sys.executable, str(ROOT / "scripts/export-installer-release-schema")],
        cwd=ROOT,
        check=True,
        timeout=1200,
    )
    subprocess.run(
        [
            "cargo",
            "run",
            "--locked",
            "--quiet",
            "-p",
            "vonk-wire-codegen",
            "--",
            str(schema),
            str(output),
        ],
        cwd=ROOT,
        check=True,
        timeout=1200,
    )


if __name__ == "__main__":
    main()
