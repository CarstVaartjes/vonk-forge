#!/usr/bin/env python3
"""Qualify one canonical ModelDefinition/RecipeDefinition package.

Structural qualification is a deterministic, repository and package scoped
gate. It proves exact Model snapshots, package closure, compiler projection,
and serving/security coherence. It does not download model files, build an
image, or imply a native Spark result. Container execution is a separate
arm64/environment-dependent gate.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import re
import subprocess
import sys
import tarfile
import time
from collections.abc import Mapping
from dataclasses import dataclass
from importlib.machinery import SourceFileLoader
from pathlib import Path, PurePosixPath
from types import ModuleType

sys.dont_write_bytecode = True  # repository tools never leave __pycache__ behind
import os
# The sibling helper, however this file is loaded.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from check_environment import ensure_catalog

ROOT = Path(__file__).resolve().parents[1]
_SHA256 = re.compile(r"^[a-f0-9]{64}$")
_ARCHIVE_PAYLOAD_PREFIXES = ("image/", "oci/", "weights/")
SUPPORTED_CHECKS = frozenset({
    "endpoint.healthy", "chat.nonempty", "chat.output-cap", "completion.nonempty",
    "completion.output-cap", "embedding.nonempty", "tools.called", "inference.completed",
    "artifact.output",
})


class QualificationError(RuntimeError):
    pass


class EnvironmentLimited(QualificationError):
    """A requested environment gate is not available on this checkout."""


@dataclass(frozen=True, slots=True)
class PackageSnapshot:
    path: Path
    manifest: dict[str, object]
    files: dict[str, bytes]

    @property
    def paths(self) -> tuple[str, ...]:
        return tuple(sorted(self.files))


@dataclass(frozen=True, slots=True)
class QualificationInputs:
    recipe: object
    models: dict[str, object]
    package: PackageSnapshot
    compiled: tuple[dict[str, object], ...]
    source_digest: str
    independent_validator: dict[str, object]


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--recipe", required=True, type=Path)
    parser.add_argument("--library-root", type=Path, required=True,
                        help="canonical checkout containing contracts/, models/, recipes/, and packages/")
    parser.add_argument("--platform-root", type=Path, default=ROOT,
                        help="vonk-forge checkout containing the compiler and harnesses")
    parser.add_argument("--level", choices=("structural", "container"), required=True)
    parser.add_argument("--engine", default="docker")
    parser.add_argument("--timeout-seconds", type=float, default=300.0)
    parser.add_argument("--serving-url", help="base URL for executing declared HTTP serving checks")
    args = parser.parse_args()
    if not 0 < args.timeout_seconds <= 3600:
        parser.error("--timeout-seconds must be between 0 and 3600")
    return args


def _load_json(path: Path) -> object:
    try:
        return json.loads(path.read_bytes())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise QualificationError(f"invalid JSON: {path}") from error


def _install_contract_path(library_root: Path) -> None:
    contract_root = (library_root / "contracts" / "src").resolve()
    if not (contract_root / "vonk_forge_contracts").is_dir():
        raise QualificationError("canonical contracts package is missing")
    if str(contract_root) not in sys.path:
        sys.path.insert(0, str(contract_root))


def _contracts(library_root: Path) -> ModuleType:
    _install_contract_path(library_root)
    try:
        import vonk_forge_contracts
        import vonk_forge_contracts.resolver
    except ImportError as error:
        raise QualificationError("canonical contracts package cannot be imported") from error
    return vonk_forge_contracts


def _safe_member(name: str) -> None:
    path = PurePosixPath(name)
    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts) or name.startswith(_ARCHIVE_PAYLOAD_PREFIXES):
        raise QualificationError(f"recipe package contains an unsafe member: {name}")


def _read_package(path: Path, document: Mapping[str, object], contracts: ModuleType) -> PackageSnapshot:
    files: dict[str, bytes] = {}
    try:
        with tarfile.open(path, mode="r:gz") as archive:
            for member in archive.getmembers():
                _safe_member(member.name)
                if not member.isreg() or member.name in files:
                    raise QualificationError(f"recipe package member is not a unique regular file: {member.name}")
                stream = archive.extractfile(member)
                if stream is None:
                    raise QualificationError(f"recipe package member is unreadable: {member.name}")
                files[member.name] = stream.read()
    except (OSError, tarfile.TarError) as error:
        raise QualificationError(f"recipe package is unreadable or malformed: {path}") from error
    manifest_bytes = files.pop("manifest.json", None)
    if manifest_bytes is None:
        raise QualificationError("recipe package manifest is missing")
    try:
        manifest = json.loads(manifest_bytes)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise QualificationError("recipe package manifest is invalid") from error
    if (not isinstance(manifest, Mapping) or manifest.get("schema_version") != 2
            or manifest.get("kind") != "recipe-package" or manifest.get("package_type") != "recipe"):
        raise QualificationError("recipe package manifest kind is invalid")
    entries = manifest.get("files")
    if not isinstance(entries, list):
        raise QualificationError("recipe package manifest files are invalid")
    declared: dict[str, Mapping[str, object]] = {}
    for entry in entries:
        if not isinstance(entry, Mapping):
            raise QualificationError("recipe package manifest entry is invalid")
        name, size, digest = entry.get("path"), entry.get("size"), entry.get("sha256")
        if (not isinstance(name, str) or name in declared or type(size) is not int or size < 0
                or not isinstance(digest, str) or _SHA256.fullmatch(digest) is None):
            raise QualificationError("recipe package manifest entry is invalid")
        _safe_member(name)
        declared[name] = entry
    if set(declared) != set(files):
        raise QualificationError("recipe package manifest closure is incomplete")
    for name, entry in declared.items():
        payload = files[name]
        if len(payload) != entry["size"] or hashlib.sha256(payload).hexdigest() != entry["sha256"]:
            raise QualificationError(f"recipe package member digest is stale: {name}")
    try:
        package_document = json.loads(files["recipe.json"])
    except (KeyError, UnicodeError, json.JSONDecodeError) as error:
        raise QualificationError("recipe package recipe.json is invalid") from error
    expected_digest = contracts.document_sha256(document)
    if not isinstance(package_document, Mapping) or contracts.document_sha256(package_document) != expected_digest:
        raise QualificationError("recipe package recipe.json does not match the selected recipe")
    if manifest.get("recipe_content_sha256") != expected_digest:
        raise QualificationError("recipe package recipe digest is stale")
    return PackageSnapshot(path, dict(manifest), files)


def _catalog_package(library_root: Path, recipe: object, document: Mapping[str, object], contracts: ModuleType) -> Path:
    ensure_catalog(ROOT, library_root)
    index = _load_json(library_root / "catalog-index.json")
    rows = index.get("recipes") if isinstance(index, Mapping) else None
    if not isinstance(rows, list):
        raise QualificationError("canonical catalog recipe rows are invalid")
    identity = recipe.identity
    expected_digest = contracts.document_sha256(document)
    for row in rows:
        if not isinstance(row, Mapping) or not isinstance(row.get("document"), Mapping):
            raise QualificationError("canonical catalog recipe row is invalid")
        row_identity = row["document"].get("identity")
        if not isinstance(row_identity, Mapping) or (row_identity.get("publisher"), row_identity.get("slug")) != (identity.publisher, identity.slug):
            continue
        if row.get("content_sha256") != expected_digest:
            raise QualificationError("catalog recipe digest does not match the recipe document")
        package = row.get("package")
        package_path = package.get("path") if isinstance(package, Mapping) else None
        if not isinstance(package_path, str) or not package_path.startswith("packages/"):
            raise QualificationError("catalog recipe package path is invalid")
        path = (library_root / package_path).resolve()
        try:
            path.relative_to(library_root.resolve())
        except ValueError as error:
            raise QualificationError("catalog recipe package path escapes the library") from error
        if path.is_symlink() or not path.is_file():
            raise QualificationError("catalog recipe package is unavailable")
        payload = path.read_bytes()
        if (not isinstance(package, Mapping) or package.get("expected_bytes") != len(payload)
                or package.get("sha256") != hashlib.sha256(payload).hexdigest()):
            raise QualificationError("catalog recipe package identity is stale")
        return path
    raise QualificationError("recipe is not present in the canonical catalog index")


def _resolve_models(library_root: Path, recipe: object, package: PackageSnapshot,
                    contracts: ModuleType) -> dict[str, object]:
    resolver = contracts.resolver
    models: dict[tuple[str, str], object] = {}
    digests: dict[str, object] = {}
    pending = [selection.model for selection in recipe.models]
    while pending:
        reference = pending.pop(0)
        key = (reference.publisher, reference.slug)
        if key in models:
            continue
        name = f"models/{reference.slug}.json"
        payload = package.files.get(name)
        if payload is None:
            raise QualificationError(f"exact Model snapshot is missing from package: {name}")
        try:
            document = json.loads(payload)
            catalog = _load_json(library_root / "models" / f"{reference.slug}.json")
            model = contracts.read_model(document)
        except (OSError, UnicodeError, json.JSONDecodeError, ValueError, TypeError) as error:
            raise QualificationError(f"Model snapshot is invalid: {name}") from error
        if ((model.identity.publisher, model.identity.slug) != key
                or contracts.document_sha256(document) != reference.content_sha256
                or not isinstance(catalog, Mapping)
                or contracts.document_sha256(catalog) != reference.content_sha256):
            raise QualificationError(f"Model snapshot identity or digest is stale: {name}")
        models[key] = model
        digests[reference.content_sha256] = model
        pending.extend(model.dependencies)
    try:
        resolver.validate_model_references(digests)
        resolver.validate_recipe_models(recipe, digests)
        # The resolver expresses a directory requirement as the context path;
        # archives carry the directory's regular members, never a directory
        # TarInfo. Add that logical path while retaining every real member for
        # the manifest and compiler checks below.
        closure_paths = set(package.paths)
        closure_paths.add(recipe.execution.build.context.path)
        for check in recipe.validation.serving.checks:
            if getattr(check.request, "transport", None) == "job":
                closure_paths.add(check.request.fixture)
                closure_paths.update(check.request.input_slots.values())
        resolver.validate_recipe_package_paths(recipe, closure_paths)
    except Exception as error:
        raise QualificationError(f"canonical model or package closure resolution failed: {error}") from error
    expected_models = {f"models/{slug}.json" for _publisher, slug in models}
    actual_models = {name for name in package.files if name.startswith("models/") and name.endswith(".json")}
    if actual_models != expected_models:
        raise QualificationError("Model snapshot closure contains unexpected files")
    selected_model_files = {
        (PurePosixPath(file.path).as_posix(), file.sha256, file.size_bytes)
        for model in models.values()
        for file in model.files
    }
    source_context = PurePosixPath(recipe.execution.build.context.path)
    fixture_paths = {
        request.fixture
        for check in recipe.validation.serving.checks
        if (request := check.request).transport == "job"
    }
    fixture_paths.update(
        input_path
        for check in recipe.validation.serving.checks
        if (request := check.request).transport == "job"
        for input_path in request.input_slots.values()
    )

    def is_source_member(name: str) -> bool:
        try:
            PurePosixPath(name).relative_to(source_context)
        except ValueError:
            return False
        return True

    for name, content in package.files.items():
        if name == "recipe.json" or name in expected_models:
            continue
        if (PurePosixPath(name).as_posix(), hashlib.sha256(content).hexdigest(), len(content)) in selected_model_files:
            raise QualificationError(f"selected Model payload is embedded in recipe package: {name}")
        if is_source_member(name) or name in fixture_paths:
            continue
        raise QualificationError(f"recipe package member is outside declared namespaces: {name}")
    return digests


def _build_inputs(payload: bytes) -> list[dict[str, str]]:
    result: list[dict[str, str]] = []
    seen: set[tuple[str, str]] = set()
    for raw in payload.decode("utf-8", errors="strict").splitlines():
        match = re.match(r"^\s*FROM(?:\s+--platform=(\S+))?\s+(\S+)", raw, re.IGNORECASE)
        if match is None or match.group(2) == "scratch":
            continue
        platform, reference = match.group(1) or "linux/arm64", match.group(2)
        digest = reference.rsplit("@sha256:", 1)[-1]
        if "@sha256:" not in reference or _SHA256.fullmatch(digest) is None:
            raise QualificationError("every Dockerfile FROM must pin a digest")
        if (reference, platform) not in seen:
            result.append({"kind": "oci-image", "reference": reference, "platform": platform})
            seen.add((reference, platform))
    if not result:
        raise QualificationError("source-build Dockerfile has no pinned FROM image")
    return result


def _source_digest(recipe: object, package: PackageSnapshot) -> str:
    build = recipe.execution.build
    context = build.context.path
    context_files = {name.removeprefix(context + "/"): payload for name, payload in package.files.items() if name.startswith(context + "/")}
    if not context_files or build.dockerfile.removeprefix(context + "/") not in context_files:
        raise QualificationError("source-build package context is incomplete")
    dockerfile = package.files.get(build.dockerfile)
    if dockerfile is None:
        raise QualificationError("source-build Dockerfile is missing from package")
    actual_inputs = _build_inputs(dockerfile)
    if package.manifest.get("build_inputs") != actual_inputs:
        raise QualificationError("source-build manifest build inputs are stale")
    base = build.base_image
    if not any(item["platform"] == "linux/arm64" and item["reference"].split("@sha256:", 1)[0].split(":", 1)[0] == base.repository and item["reference"].endswith("@sha256:" + base.digest) for item in actual_inputs):
        raise QualificationError("source-build base image is absent from package build inputs")
    digest = hashlib.sha256()
    for name in sorted(context_files):
        encoded = name.encode("utf-8")
        digest.update(len(encoded).to_bytes(8, "big"))
        digest.update(encoded)
        digest.update(len(context_files[name]).to_bytes(8, "big"))
        digest.update(context_files[name])
    return digest.hexdigest()


def _compile(recipe: object, recipe_digest: str, models: dict[str, object], package: PackageSnapshot, source_digest: str, platform_root: Path) -> tuple[dict[str, object], ...]:
    control_src = platform_root / "control" / "src"
    if not control_src.is_dir():
        raise QualificationError("platform compiler source is unavailable")
    if str(control_src) not in sys.path:
        sys.path.insert(0, str(control_src))
    try:
        from vonk_control.recipe_runtime_specs import compile_runtime_spec
    except ImportError as error:
        raise QualificationError("canonical runtime compiler is unavailable") from error
    package_paths = set(package.paths)
    package_paths.add(recipe.execution.build.context.path)
    package_handle: dict[str, object] = {"paths": tuple(sorted(package_paths))}
    package_handle.update({"image_digest": source_digest, "image_reference": f"localhost/vonk/structural-build@sha256:{source_digest}", "platform": "linux/arm64", "build_input_sha256": source_digest})
    roles: list[str] = []
    for declaration in recipe.topology.roles:
        roles.extend([declaration.name] * declaration.count)
    compiled: list[dict[str, object]] = []
    for rank, role in enumerate(roles):
        try:
            spec = compile_runtime_spec(recipe, models=models, package_handle=package_handle, role=role, rank=rank, recipe_digest=recipe_digest)
        except Exception as error:
            raise QualificationError(f"canonical runtime compiler rejected {role}[{rank}]: {error}") from error
        # The compiler returns the typed RuntimeSpec; qualification reads its wire document.
        spec = spec.model_dump(mode="json", by_alias=True) if hasattr(spec, "model_dump") else spec
        security = spec.get("security")
        # Privileges, capabilities and the read-only root are platform constants;
        # only the per-workload choices remain to be checked.
        user = security.get("user") if isinstance(security, Mapping) else None
        if not isinstance(user, str) or user.split(":")[0] in {"", "0", "root"}:
            raise QualificationError("compiled runtime security projection is unsafe")
        compiled.append(spec)
    checks = {
        assertion
        for check in recipe.validation.serving.checks
        for assertion in check.assertions
    }
    if not checks or not checks <= SUPPORTED_CHECKS:
        raise QualificationError("recipe declares an unsupported serving assertion")
    return tuple(compiled)


def _independent_validator(library_root: Path, platform_root: Path) -> dict[str, object]:
    required = ("contracts", "models", "recipes", "packages", "catalog-index.json")
    if not all((library_root / item).exists() for item in required):
        return {"status": "skipped", "reason": "incomplete canonical library snapshot"}
    path = platform_root / "scripts" / "validate-recipe-library"
    if not path.is_file():
        raise QualificationError("independent recipe-library validator is unavailable")
    loader = SourceFileLoader("vonk_independent_recipe_validator", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise QualificationError("independent recipe-library validator cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    try:
        report = module.validate(library_root, platform_root)
    except Exception as error:
        raise QualificationError(f"independent recipe-library validator rejected the snapshot: {error}") from error
    # The validator returns every recipe digest for publication auditing. The
    # qualifier reports the dynamic counts and contract/closure result while
    # keeping stdout compact enough for CI evidence and phone-readable handoff.
    return {
        "catalog_entity_count": report.get("catalog_entity_count"),
        "contract_source": report.get("contract_source"),
        "package_check": report.get("package_check"),
        "recipe_count": report.get("recipe_count"),
        "secret_scan": report.get("secret_scan"),
        "status": "passed",
    }


def _structural(path: Path, *, library_root: Path, platform_root: Path) -> QualificationInputs:
    contracts = _contracts(library_root)
    document = _load_json(path)
    try:
        recipe = contracts.read_recipe(document)
    except (TypeError, ValueError) as error:
        raise QualificationError(f"recipe does not satisfy contract {contracts.CONTRACT_VERSION}") from error
    package_path = _catalog_package(library_root, recipe, document, contracts)
    package = _read_package(package_path, document, contracts)
    models = _resolve_models(library_root, recipe, package, contracts)
    source_digest = _source_digest(recipe, package)
    compiled = _compile(recipe, contracts.document_sha256(document), models, package, source_digest, platform_root)
    independent = _independent_validator(library_root, platform_root)
    return QualificationInputs(recipe, models, package, compiled, source_digest, independent)


def _run(command: list[str], *, timeout: float, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=check, capture_output=True, text=True, timeout=timeout)


def _architecture(engine: str, timeout: float) -> str:
    return _run([engine, "info", "--format", "{{.Architecture}}"], timeout=timeout).stdout.strip()


def _container(inputs: QualificationInputs, args: argparse.Namespace, architecture: str) -> dict[str, object]:
    del inputs, args, architecture
    raise EnvironmentLimited(
        "production CompiledExecutionPlan launch adapter/materializer is unavailable; "
        "container qualification refuses to launch a handwritten runtime"
    )


def _serving_check_documents(recipe: object) -> tuple[dict[str, object], ...]:
    return tuple(
        check.model_dump(mode="json", exclude_none=True)
        for check in recipe.validation.serving.checks
    )


def _run_declared_serving_checks(inputs: QualificationInputs, args: argparse.Namespace) -> dict[str, object] | None:
    """Run declared HTTP checks when a real endpoint is supplied.

    Job checks are evaluated by the Controller artifact-job lifecycle and are
    therefore reported as an honest environment limitation by this local
    qualifier until that production adapter is available.
    """
    if not args.serving_url:
        return None
    profile_src = args.platform_root / "src"
    if str(profile_src) not in sys.path:
        sys.path.insert(0, str(profile_src))
    from cluster_profiles.serving_execution import (
        ServingExecutionError,
        execute_http_check,
    )
    checks = _serving_check_documents(inputs.recipe)
    alias_values = tuple(inputs.recipe.interfaces[0].model_aliases) if inputs.recipe.interfaces[0].adapter == "openai" else ()
    alias = alias_values[0] if alias_values else None
    results: list[dict[str, object]] = []
    for check in checks:
        step = f"serving.{check['name']}"
        if check["request"]["transport"] != "http":
            raise EnvironmentLimited("job serving requires the Controller artifact-job adapter")
        started = time.monotonic()
        try:
            result = execute_http_check(args.serving_url, check, timeout_seconds=args.timeout_seconds, model_alias=alias)
        except ServingExecutionError as error:
            raise QualificationError(f"{step}: {error}") from error
        results.append({"check": check["name"], "elapsed_seconds": round(time.monotonic() - started, 6), **result})
    return {"scope": "local-http", "status": "passed", "checks": results}


def _print(value: Mapping[str, object]) -> None:
    print(json.dumps(value, allow_nan=False, sort_keys=True, separators=(",", ":")))


def main() -> int:
    args = _arguments()
    try:
        inputs = _structural(args.recipe.resolve(), library_root=args.library_root.resolve(), platform_root=args.platform_root.resolve())
    except (OSError, ValueError, QualificationError, subprocess.SubprocessError) as error:
        _print({"error": str(error), "passed": False, "status": "failed"})
        return 1
    if args.level == "structural":
        recipe = inputs.recipe
        try:
            serving = _run_declared_serving_checks(inputs, args)
        except EnvironmentLimited as error:
            _print({"compiled_roles": len(inputs.compiled), "detail": str(error), "independent_validator": inputs.independent_validator, "model_count": len(inputs.models), "passed": False, "physical_claim": False, "recipe": recipe.identity.slug, "status": "environment-limited"})
            return 3
        except (OSError, QualificationError) as error:
            _print({"compiled_roles": len(inputs.compiled), "error": str(error), "independent_validator": inputs.independent_validator, "model_count": len(inputs.models), "passed": False, "physical_claim": False, "recipe": recipe.identity.slug, "status": "failed"})
            return 1
        result = {"compiled_roles": len(inputs.compiled), "independent_validator": inputs.independent_validator, "model_count": len(inputs.models), "package": {"members": len(inputs.package.files), "path": str(inputs.package.path), "schema_version": inputs.package.manifest["schema_version"]}, "passed": True, "physical_claim": False, "recipe": recipe.identity.slug, "status": "passed"}
        if serving is not None:
            result["serving"] = serving
        _print(result)
        return 0
    try:
        architecture = _architecture(args.engine, min(args.timeout_seconds, 30.0))
    except (OSError, subprocess.SubprocessError) as error:
        _print({"detected_architecture": None, "detail": f"container engine unavailable: {error}", "passed": False, "required_architecture": "arm64", "status": "environment-limited"})
        return 3
    if architecture not in {"arm64", "aarch64"}:
        _print({"detected_architecture": architecture, "detail": "container qualification requires a native linux/arm64 host", "passed": False, "physical_claim": False, "required_architecture": "arm64", "status": "environment-limited"})
        return 3
    try:
        _print(_container(inputs, args, architecture))
        return 0
    except EnvironmentLimited as error:
        _print({"detected_architecture": architecture, "detail": str(error), "passed": False,
                "physical_claim": False, "recipe": inputs.recipe.identity.slug, "status": "environment-limited"})
        return 3
    except (OSError, QualificationError, subprocess.SubprocessError) as error:
        _print({"detected_architecture": architecture, "error": str(error), "passed": False, "physical_claim": False, "recipe": inputs.recipe.identity.slug, "status": "failed"})
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
