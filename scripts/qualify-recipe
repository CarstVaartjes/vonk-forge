#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "control/src"))

from vonk_control.catalog_contract import (
    catalog_content_sha256,
    validate_catalog_document,
)
from vonk_control.recipe_contract import validate_recipe
from vonk_control.source_bundles import generate_source_bundle
from vonk_control.source_policy import enforce_build_source_policy

KIND_ROOT = {
    "model-group": "model-groups",
    "model": "models",
    "model-version": "model-versions",
    "execution-harness": "execution-harnesses",
    "runtime-distribution": "runtime-distributions",
    "patch-bundle": "patch-bundles",
}
CONTEXTS = {
    "deepseek-v4-flash-0731-ds4-single": ROOT / "adapters/deepseek/ds4",
    "deepseek-v4-flash-0731-mia-dual": ROOT / "adapters/deepseek/mia-vllm",
}


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Qualify one exact v1 recipe.")
    parser.add_argument("--recipe", required=True, type=Path)
    parser.add_argument("--level", choices=("structural", "container"), required=True)
    parser.add_argument("--engine", default="docker")
    return parser.parse_args()


def _load(path: Path) -> dict[str, object]:
    return json.loads(path.read_text(encoding="utf-8"))


def _resolve(reference: dict[str, object]) -> dict[str, object]:
    document = _load(
        ROOT
        / "config"
        / KIND_ROOT[str(reference["kind"])]
        / f"{reference['slug']}.json"
    )
    validate_catalog_document(document)
    if catalog_content_sha256(document) != reference["content_sha256"]:
        raise ValueError("catalog reference digest mismatch")
    return document


def _structural(path: Path) -> dict[str, object]:
    recipe = _load(path)
    validate_recipe(recipe)
    version = _resolve(recipe["model"])
    model = _resolve(version["model"])
    _resolve(model["model_group"])
    _resolve(recipe["execution"]["harness"])
    _resolve(recipe["runtime"]["distribution"])
    patch = recipe["execution"]["patch_bundle"]
    if patch is not None:
        _resolve(patch)
    slug = str(recipe["identity"]["slug"])
    context = CONTEXTS.get(slug)
    if context is None:
        raise ValueError("recipe has no curated qualification context")
    bundle = generate_source_bundle(
        {
            source.relative_to(context).as_posix(): source.read_bytes()
            for source in sorted(context.rglob("*"))
            if source.is_file()
        }
    )
    enforce_build_source_policy(recipe, bundle)
    return recipe


def _architecture(engine: str) -> str:
    result = subprocess.run(
        [engine, "info", "--format", "{{.Architecture}}"],
        check=True,
        capture_output=True,
        text=True,
        timeout=30,
    )
    return result.stdout.strip()


def main() -> int:
    args = _arguments()
    try:
        _structural(args.recipe.resolve())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(json.dumps({"passed": False, "status": "failed", "error": str(error)}))
        return 1
    if args.level == "structural":
        print(
            json.dumps(
                {
                    "passed": True,
                    "recipe": args.recipe.name,
                    "status": "passed",
                },
                sort_keys=True,
            )
        )
        return 0
    try:
        architecture = _architecture(args.engine)
    except (OSError, subprocess.SubprocessError) as error:
        print(
            json.dumps(
                {
                    "detected_architecture": None,
                    "detail": f"container engine unavailable: {error}",
                    "passed": False,
                    "required_architecture": "arm64",
                    "status": "environment-limited",
                },
                sort_keys=True,
            )
        )
        return 3
    if architecture not in {"arm64", "aarch64"}:
        print(
            json.dumps(
                {
                    "detected_architecture": architecture,
                    "detail": "container qualification requires a native linux/arm64 host",
                    "passed": False,
                    "required_architecture": "arm64",
                    "status": "environment-limited",
                },
                sort_keys=True,
            )
        )
        return 3
    print(
        json.dumps(
            {
                "detected_architecture": architecture,
                "detail": (
                    "native ARM64 is available, but this host still requires DGX Spark GPUs, "
                    "the exact installed model inventory, and two-node fabric for full qualification"
                ),
                "passed": False,
                "required_architecture": "arm64",
                "status": "environment-limited",
            },
            sort_keys=True,
        )
    )
    return 3


if __name__ == "__main__":
    raise SystemExit(main())
