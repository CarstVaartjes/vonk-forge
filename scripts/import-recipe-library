#!/usr/bin/env python3
"""Validate and import the standard vonk-forge-recipes checkout."""

from __future__ import annotations

import argparse
import hashlib
import http.cookiejar
import json
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Mapping
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "control/src"))

from vonk_control.catalog_contract import (
    CatalogContractError,
    CatalogKind,
    CatalogReference,
    catalog_content_sha256,
    parse_catalog_reference,
)
from vonk_control.recipe_contract import RecipeContractError, recipe_references
from vonk_control.source_bundles import generate_source_bundle

ENTITY_DIRECTORIES = (
    "model-groups",
    "models",
    "model-versions",
    "runtime-distributions",
    "patch-bundles",
)
ENTITY_KINDS = {
    "model-groups": "model-group",
    "models": "model",
    "model-versions": "model-version",
    "runtime-distributions": "runtime-distribution",
    "patch-bundles": "patch-bundle",
}
ENTITY_ORDER = {
    CatalogKind.MODEL_GROUP: 0,
    CatalogKind.MODEL: 1,
    CatalogKind.MODEL_VERSION: 2,
    CatalogKind.RUNTIME_DISTRIBUTION: 3,
    CatalogKind.PATCH_BUNDLE: 4,
}
MAX_RESPONSE_BYTES = 512 * 1024
MUTATING_METHODS = frozenset({"DELETE", "PATCH", "POST", "PUT"})
OPAQUE_BROWSER_TOKEN = re.compile(r"[A-Za-z0-9_-]{43}\Z")
DEFAULT_UPLOAD_TIMEOUT_SECONDS = 300
MIN_UPLOAD_TIMEOUT_SECONDS = 30
MAX_UPLOAD_TIMEOUT_SECONDS = 1_800


class ImportError(RuntimeError):
    pass


def _upload_timeout(value: str) -> int:
    try:
        seconds = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("upload timeout must be an integer") from error
    if not MIN_UPLOAD_TIMEOUT_SECONDS <= seconds <= MAX_UPLOAD_TIMEOUT_SECONDS:
        raise argparse.ArgumentTypeError(
            f"upload timeout must be between {MIN_UPLOAD_TIMEOUT_SECONDS} and "
            f"{MAX_UPLOAD_TIMEOUT_SECONDS} seconds"
        )
    return seconds


def _args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--library-root", type=Path, default=ROOT.parent / "vonk-forge-recipes"
    )
    parser.add_argument("--platform-root", type=Path, default=ROOT)
    parser.add_argument(
        "--control-url", help="local control-plane URL; required with --apply"
    )
    auth = parser.add_mutually_exclusive_group()
    auth.add_argument("--token-file", type=Path, help="administrator bearer token file")
    auth.add_argument(
        "--cookie-file",
        type=Path,
        help="Netscape-format browser cookie file for an administrator session",
    )
    parser.add_argument(
        "--apply", action="store_true", help="perform the import after validation"
    )
    parser.add_argument(
        "--upload-timeout-seconds",
        type=_upload_timeout,
        default=DEFAULT_UPLOAD_TIMEOUT_SECONDS,
        metavar="SECONDS",
        help=(
            "source-bundle PUT timeout; bounded to "
            f"{MIN_UPLOAD_TIMEOUT_SECONDS}-{MAX_UPLOAD_TIMEOUT_SECONDS} seconds "
            f"(default: {DEFAULT_UPLOAD_TIMEOUT_SECONDS})"
        ),
    )
    parser.add_argument(
        "--include-candidates",
        action="store_true",
        help="also import recipes not marked accepted",
    )
    parser.add_argument(
        "--recipe",
        action="append",
        dest="recipes",
        help="recipe slug to import; may be repeated",
    )
    return parser.parse_args()


def _json(path: Path) -> dict[str, object]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ImportError(f"cannot read JSON document: {path}") from error
    if not isinstance(value, dict):
        raise ImportError(f"JSON document must be an object: {path}")
    return value


def _commit(root: Path) -> str:
    try:
        value = subprocess.check_output(
            ["git", "-C", str(root), "rev-parse", "HEAD"], text=True
        ).strip()
    except (OSError, subprocess.CalledProcessError) as error:
        raise ImportError("recipe library must be a Git checkout") from error
    if len(value) != 40 or any(
        character not in "0123456789abcdef" for character in value
    ):
        raise ImportError("recipe library HEAD is not a full immutable commit")
    return value


def _validate(root: Path, platform: Path) -> None:
    command = [
        sys.executable,
        str(platform / "scripts/validate-recipe-library"),
        "--library-root",
        str(root),
        "--platform-root",
        str(platform),
        "--json",
    ]
    try:
        subprocess.run(command, check=True, stdout=subprocess.PIPE, text=True)
    except (OSError, subprocess.CalledProcessError) as error:
        raise ImportError("recipe library validation failed") from error


def _accepted_slugs(root: Path) -> set[str]:
    accepted: set[str] = set()
    for path in sorted((root / "model-targets").glob("*.json")):
        document = _json(path)
        targets = document.get("targets")
        if not isinstance(targets, list):
            continue
        for target in targets:
            if not isinstance(target, dict) or target.get("status") != "accepted":
                continue
            slugs = target.get("recipe_slugs")
            if isinstance(slugs, list):
                accepted.update(value for value in slugs if isinstance(value, str))
    return accepted


def _files(context: Path) -> dict[str, bytes]:
    if not context.is_dir():
        raise ImportError(f"recipe build context does not exist: {context}")
    result: dict[str, bytes] = {}
    for path in sorted(context.rglob("*"), key=lambda item: item.as_posix().encode()):
        relative = path.relative_to(context).as_posix()
        if path.is_symlink():
            raise ImportError(f"unsafe recipe build-context entry: {relative}")
        if path.is_dir():
            continue
        if not path.is_file() or "__pycache__" in path.parts or path.suffix == ".pyc":
            raise ImportError(f"unsafe recipe build-context entry: {relative}")
        result[relative] = path.read_bytes()
    return result


def _bundle(root: Path, recipe: dict[str, object]) -> tuple[str, bytes]:
    build = recipe.get("build")
    context = build.get("context") if isinstance(build, dict) else None
    if not isinstance(context, dict):
        raise ImportError("recipe build context is invalid")
    relative = context.get("path")
    expected = context.get("sha256")
    if not isinstance(relative, str) or not isinstance(expected, str):
        raise ImportError("recipe build context identity is invalid")
    generated = generate_source_bundle(_files(root / relative))
    if generated.sha256 != expected:
        raise ImportError(f"source bundle digest mismatch for {relative}")
    return expected, generated.archive


class ControlClient:
    def __init__(
        self,
        base_url: str,
        token: str | None = None,
        cookie_file: Path | None = None,
    ):
        if (token is None) == (cookie_file is None):
            raise ImportError(
                "exactly one control-plane authentication method is required"
            )
        self.base_url = base_url.rstrip("/")
        self._token = token
        self._cookies: http.cookiejar.MozillaCookieJar | None = None
        self._secrets = {token} if token is not None else set()
        if cookie_file is not None:
            cookies = http.cookiejar.MozillaCookieJar(str(cookie_file))
            try:
                cookies.load(ignore_discard=True, ignore_expires=False)
            except FileNotFoundError as error:
                raise ImportError("browser cookie file is unavailable") from error
            except (OSError, http.cookiejar.LoadError) as error:
                raise ImportError("browser cookie file is invalid") from error
            self._cookies = cookies

    def _auth_headers(self, method: str, url: str) -> dict[str, str]:
        if self._token is not None:
            return {"Authorization": f"Bearer {self._token}"}
        assert self._cookies is not None
        cookie_request = urllib.request.Request(url)
        self._cookies.add_cookie_header(cookie_request)
        cookie_header = cookie_request.get_header("Cookie")
        if not cookie_header:
            raise ImportError("browser cookie file has no cookies matching control URL")
        pairs = [part.strip().split("=", 1) for part in cookie_header.split(";")]
        values = [
            value
            for pair in pairs
            if len(pair) == 2
            for name, value in [pair]
            if name == "vonk_csrf"
        ]
        self._secrets.update(pair[1] for pair in pairs if len(pair) == 2 and pair[1])
        headers = {"Cookie": cookie_header}
        if method.upper() in MUTATING_METHODS:
            if len(values) != 1 or OPAQUE_BROWSER_TOKEN.fullmatch(values[0]) is None:
                raise ImportError(
                    "browser cookie file has no unique valid CSRF cookie for control URL"
                )
            headers["X-CSRF-Token"] = values[0]
        return headers

    def redact(self, value: object) -> str:
        text = (
            value.decode("utf-8", errors="replace")
            if isinstance(value, bytes)
            else str(value)
        )
        for secret in sorted(self._secrets, key=len, reverse=True):
            if secret:
                text = text.replace(secret, "[REDACTED]")
        return text

    def _send(
        self,
        method: str,
        path: str,
        payload: bytes | None,
        content_type: str | None,
        timeout: int = 30,
    ) -> tuple[int, bytes]:
        url = self.base_url + path
        headers = {
            **self._auth_headers(method, url),
            "Accept": "application/json",
            **({"Content-Type": content_type} if content_type is not None else {}),
        }
        request = urllib.request.Request(
            url,
            data=payload,
            method=method,
            headers=headers,
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                content = response.read(MAX_RESPONSE_BYTES + 1)
                if len(content) > MAX_RESPONSE_BYTES:
                    raise ImportError("control-plane response is too large")
                return response.status, content
        except urllib.error.HTTPError as error:
            content = error.read(MAX_RESPONSE_BYTES + 1)
            if len(content) > MAX_RESPONSE_BYTES:
                raise ImportError("control-plane response is too large") from error
            return error.code, content
        except urllib.error.URLError as error:
            if isinstance(error.reason, TimeoutError):
                raise ImportError(
                    f"control-plane request timed out after {timeout} seconds: "
                    f"{method} {path}"
                ) from error
            raise ImportError(
                f"control-plane request failed: {method} {path}"
            ) from error
        except TimeoutError as error:
            raise ImportError(
                f"control-plane request timed out after {timeout} seconds: "
                f"{method} {path}"
            ) from error
        except OSError as error:
            raise ImportError(
                f"control-plane request failed: {method} {path}"
            ) from error

    def request(
        self, method: str, path: str, body: object | None = None
    ) -> tuple[int, dict[str, Any] | bytes]:
        payload = (
            None if body is None else json.dumps(body, separators=(",", ":")).encode()
        )
        status, content = self._send(
            method,
            path,
            payload,
            "application/json" if payload is not None else None,
        )
        try:
            return status, json.loads(content)
        except json.JSONDecodeError:
            return status, content

    def upload(
        self,
        path: str,
        body: bytes,
        content_type: str,
        timeout: int = DEFAULT_UPLOAD_TIMEOUT_SECONDS,
    ) -> tuple[int, bytes]:
        return self._send("PUT", path, body, content_type, timeout=timeout)


def _load_entities(root: Path) -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    for directory in ENTITY_DIRECTORIES:
        for path in sorted((root / directory).glob("*.json")):
            document = _json(path)
            if document.get("kind") != ENTITY_KINDS[directory]:
                raise ImportError(f"entity kind does not match directory: {path}")
            result.append({"path": f"{directory}/{path.name}", "document": document})
    return result


def _entity_reference(document: Mapping[str, object], path: str) -> CatalogReference:
    identity = document.get("identity")
    try:
        if not isinstance(identity, Mapping):
            raise TypeError("identity is missing")
        kind = CatalogKind(document["kind"])
        publisher = identity["publisher"]
        slug = identity["slug"]
        if not isinstance(publisher, str) or not isinstance(slug, str):
            raise TypeError("identity is invalid")
        return CatalogReference(
            kind=kind,
            publisher=publisher,
            slug=slug,
            content_sha256=catalog_content_sha256(document),
        )
    except (CatalogContractError, KeyError, TypeError, ValueError) as error:
        raise ImportError(f"catalog entity identity is invalid: {path}") from error


def _entity_references(
    document: Mapping[str, object], path: str
) -> tuple[CatalogReference, ...]:
    """Return the dependency edges enforced by recipe-library validation."""

    kind = document.get("kind")
    references: list[CatalogReference] = []
    try:
        if kind == CatalogKind.MODEL.value:
            references.append(
                parse_catalog_reference(
                    document["model_group"], expected_kind=CatalogKind.MODEL_GROUP
                )
            )
        elif kind == CatalogKind.MODEL_VERSION.value:
            references.append(
                parse_catalog_reference(
                    document["model"], expected_kind=CatalogKind.MODEL
                )
            )
            lineage = document["lineage"]
            if not isinstance(lineage, Mapping):
                raise TypeError("lineage is invalid")
            references.append(
                parse_catalog_reference(
                    lineage["source_model"], expected_kind=CatalogKind.MODEL
                )
            )
        elif kind == CatalogKind.RUNTIME_DISTRIBUTION.value:
            references.append(
                parse_catalog_reference(
                    document["implements_harness"],
                    expected_kind=CatalogKind.EXECUTION_HARNESS,
                )
            )
        elif kind == CatalogKind.PATCH_BUNDLE.value:
            references.append(
                parse_catalog_reference(
                    document["applies_to"],
                    expected_kind=CatalogKind.RUNTIME_DISTRIBUTION,
                )
            )
            compatible: object = []
            if "compatible_model_versions" in document:
                compatible = document["compatible_model_versions"]
            if not isinstance(compatible, list):
                raise TypeError("compatible model versions are invalid")
            references.extend(
                parse_catalog_reference(value, expected_kind=CatalogKind.MODEL_VERSION)
                for value in compatible
            )
    except (CatalogContractError, KeyError, TypeError, ValueError) as error:
        raise ImportError(f"catalog entity dependency is invalid: {path}") from error
    return tuple(references)


def _platform_harnesses(platform: Path) -> list[dict[str, object]]:
    content = platform / "config"
    root = content if (content / "execution-harnesses").is_dir() else platform
    harness_root = root / "execution-harnesses"
    if not harness_root.is_dir():
        raise ImportError("platform execution harnesses are unavailable")
    result: list[dict[str, object]] = []
    for path in sorted(harness_root.glob("*.json")):
        document = _json(path)
        if document.get("kind") != CatalogKind.EXECUTION_HARNESS.value:
            raise ImportError(f"platform execution harness kind is invalid: {path}")
        result.append({"path": str(path), "document": document})
    if not result:
        raise ImportError("platform execution harnesses are unavailable")
    return result


def _entity_closure(
    entities: list[dict[str, object]],
    recipes: list[dict[str, object]],
    platform: Path,
) -> list[dict[str, object]]:
    importable: dict[CatalogReference, list[dict[str, object]]] = {}
    available: dict[CatalogReference, list[dict[str, object]]] = {}
    for item in entities:
        document = item["document"]
        path = str(item["path"])
        if not isinstance(document, Mapping):
            raise ImportError(f"catalog entity document is invalid: {path}")
        reference = _entity_reference(document, path)
        importable.setdefault(reference, []).append(item)
        available.setdefault(reference, []).append(item)
    for item in _platform_harnesses(platform):
        document = item["document"]
        path = str(item["path"])
        if not isinstance(document, Mapping):
            raise ImportError(f"catalog entity document is invalid: {path}")
        reference = _entity_reference(document, path)
        available.setdefault(reference, []).append(item)

    pending: list[CatalogReference] = []
    try:
        for item in recipes:
            document = item["document"]
            if not isinstance(document, Mapping):
                raise TypeError("recipe document is invalid")
            pending.extend(recipe_references(document))
    except (RecipeContractError, TypeError, ValueError) as error:
        raise ImportError("selected recipe dependency is invalid") from error

    selected: set[CatalogReference] = set()
    visited: set[CatalogReference] = set()
    while pending:
        reference = pending.pop()
        if reference in visited:
            continue
        matches = available.get(reference, [])
        identity = "/".join(reference.portable_identity[:3])
        if not matches:
            raise ImportError(f"selected recipe dependency is missing: {identity}")
        if len(matches) != 1:
            raise ImportError(f"selected recipe dependency is ambiguous: {identity}")
        visited.add(reference)
        item = matches[0]
        if reference in importable:
            selected.add(reference)
        document = item["document"]
        assert isinstance(document, Mapping)
        pending.extend(_entity_references(document, str(item["path"])))

    chosen = [
        items[0] for reference, items in importable.items() if reference in selected
    ]
    return sorted(
        chosen,
        key=lambda item: (
            ENTITY_ORDER[_entity_reference(item["document"], str(item["path"])).kind],
            _entity_reference(item["document"], str(item["path"])).publisher,
            _entity_reference(item["document"], str(item["path"])).slug,
            str(item["path"]),
        ),
    )


def _scoped_entities(
    entities: list[dict[str, object]],
    recipes: list[dict[str, object]],
    selected: set[str] | None,
    platform: Path,
) -> list[dict[str, object]]:
    if selected is None:
        return entities
    return _entity_closure(entities, recipes, platform)


def _load_recipes(
    root: Path, selected: set[str] | None, include_candidates: bool
) -> list[dict[str, object]]:
    accepted = _accepted_slugs(root)
    result: list[dict[str, object]] = []
    for path in sorted((root / "recipes").glob("*.json")):
        slug = path.stem
        if selected is not None and slug not in selected:
            continue
        if selected is None and not include_candidates and slug not in accepted:
            continue
        result.append({"path": f"recipes/{path.name}", "document": _json(path)})
    if selected and len(result) != len(selected):
        missing = sorted(selected - {str(item["path"])[8:-5] for item in result})
        raise ImportError(f"requested recipe does not exist: {', '.join(missing)}")
    return result


def _token(path: Path) -> str:
    try:
        value = path.read_text(encoding="ascii").strip()
    except OSError as error:
        raise ImportError("administrator token file is unavailable") from error
    if not value or any(character.isspace() for character in value):
        raise ImportError("administrator token file is invalid")
    return value


def _apply_entity(client: ControlClient, document: dict[str, object]) -> None:
    identity = document["identity"]
    assert isinstance(identity, dict)
    kind = str(document["kind"])
    publisher = str(identity["publisher"])
    slug = str(identity["slug"])
    query = urllib.parse.urlencode({"kind": kind, "publisher": publisher, "limit": 100})
    status, payload = client.request("GET", f"/api/v1/catalog/entities?{query}")
    if status != 200 or not isinstance(payload, dict):
        raise ImportError(f"cannot list catalog entities for {kind}/{publisher}")
    matches = [
        item
        for item in payload.get("entities", [])
        if isinstance(item, dict) and item.get("slug") == slug
    ]
    digest = hashlib.sha256(
        json.dumps(
            document, ensure_ascii=False, sort_keys=True, separators=(",", ":")
        ).encode()
    ).hexdigest()
    current = matches[0] if matches else None
    if current is None:
        status, current = client.request(
            "POST", "/api/v1/catalog/entities", {"document": document}
        )
        if status == 409:
            status, payload = client.request("GET", f"/api/v1/catalog/entities?{query}")
            matches = (
                [
                    item
                    for item in payload.get("entities", [])
                    if isinstance(item, dict) and item.get("slug") == slug
                ]
                if isinstance(payload, dict)
                else []
            )
            current = matches[0] if matches else None
        if status not in (200, 201) or not isinstance(current, dict):
            raise ImportError(f"cannot create catalog entity {kind}/{publisher}/{slug}")
    if (
        current.get("content_sha256") == digest
        and current.get("lifecycle") == "resolved"
    ):
        return
    entity_id = str(current["entity_id"])
    revision = int(current["revision_number"])
    status, current = client.request(
        "PUT",
        f"/api/v1/catalog/entities/{entity_id}/draft",
        {"expected_revision": revision, "document": document},
    )
    if status not in (200, 201) or not isinstance(current, dict):
        raise ImportError(f"cannot revise catalog entity {kind}/{publisher}/{slug}")
    status, _ = client.request(
        "POST",
        f"/api/v1/catalog/entities/{entity_id}/resolve",
        {"expected_revision": int(current["revision_number"])},
    )
    if status not in (200, 201):
        raise ImportError(f"cannot resolve catalog entity {kind}/{publisher}/{slug}")


def main() -> int:
    args = _args()
    try:
        library = args.library_root.resolve()
        platform = args.platform_root.resolve()
        commit = _commit(library)
        _validate(library, platform)
        entities = _load_entities(library)
        selected = set(args.recipes) if args.recipes else None
        recipes = _load_recipes(library, selected, args.include_candidates)
        entities = _scoped_entities(entities, recipes, selected, platform)
        print(
            json.dumps(
                {
                    "library_commit": commit,
                    "entities": len(entities),
                    "recipes": [item["path"] for item in recipes],
                },
                sort_keys=True,
            )
        )
        if not args.apply:
            return 0
        if not args.control_url or (
            args.token_file is None and args.cookie_file is None
        ):
            raise ImportError(
                "--apply requires --control-url and one of --token-file or --cookie-file"
            )
        client = ControlClient(
            args.control_url,
            token=_token(args.token_file) if args.token_file is not None else None,
            cookie_file=args.cookie_file,
        )
        for item in entities:
            _apply_entity(client, item["document"])
        for item in recipes:
            recipe = item["document"]
            source_sha256, archive = _bundle(library, recipe)
            status, payload = client.upload(
                f"/api/v1/catalog/source-bundles/{source_sha256}",
                archive,
                "application/vnd.vonk-forge.source-bundle.v1+tar",
                timeout=args.upload_timeout_seconds,
            )
            if status not in (200, 201, 204):
                raise ImportError(
                    f"cannot upload source bundle for {item['path']}: "
                    f"{client.redact(payload)}"
                )
            digest = hashlib.sha256(
                json.dumps(
                    recipe, ensure_ascii=False, sort_keys=True, separators=(",", ":")
                ).encode()
            ).hexdigest()
            status, payload = client.request(
                "POST",
                "/api/v1/catalog/imports/recipe-library",
                {
                    "library_commit": commit,
                    "source_path": item["path"],
                    "expected_content_sha256": digest,
                    "document": recipe,
                },
            )
            if status not in (200, 201):
                raise ImportError(
                    f"cannot import {item['path']}: {client.redact(payload)}"
                )
        return 0
    except ImportError as error:
        print(f"import-recipe-library: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
