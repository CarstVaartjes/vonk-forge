#!/usr/bin/env python3
"""Create canonical evidence binding a signed agent package to its release."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path
from typing import Any

_SEMVER = re.compile(
    r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?\Z"
)
_ARCHITECTURES = {"linux-amd64": "amd64", "linux-arm64": "arm64"}
_MAX_PACKAGE_BYTES = 1 << 30
_MAX_ATTESTATION_BYTES = 16 << 20


class EvidenceError(RuntimeError):
    """Package evidence is incomplete or does not match the release."""


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read_regular(path: Path, label: str, maximum: int) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise EvidenceError(f"{label} is unavailable or unsafe") from error
    try:
        details = os.fstat(descriptor)
        if (
            not stat.S_ISREG(details.st_mode)
            or details.st_nlink != 1
            or not 0 < details.st_size <= maximum
        ):
            raise EvidenceError(f"{label} is unavailable or unsafe")
        content = bytearray()
        while len(content) < details.st_size:
            chunk = os.read(descriptor, details.st_size - len(content))
            if not chunk:
                raise EvidenceError(f"{label} changed while read")
            content.extend(chunk)
        return bytes(content)
    finally:
        os.close(descriptor)


def _write_new(path: Path, content: bytes) -> None:
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o644,
        )
    except OSError as error:
        raise EvidenceError("output already exists or is unsafe") from error
    try:
        offset = 0
        while offset < len(content):
            offset += os.write(descriptor, content[offset:])
        os.fchmod(descriptor, 0o644)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="build-agent-package-evidence")
    parser.add_argument("--package", required=True, type=Path)
    parser.add_argument("--sbom", required=True, type=Path)
    parser.add_argument("--provenance", required=True, type=Path)
    parser.add_argument("--sigstore-bundle", required=True, type=Path)
    parser.add_argument("--version", required=True)
    parser.add_argument("--architecture", required=True, choices=sorted(_ARCHITECTURES))
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args(argv)
    try:
        if _SEMVER.fullmatch(args.version) is None:
            raise EvidenceError("version is invalid")
        deb_architecture = _ARCHITECTURES[args.architecture]
        expected_prefix = f"vonk-forge-agent_{args.version}_"
        if not args.package.name.startswith(
            expected_prefix
        ) or not args.package.name.endswith(f"_{deb_architecture}.deb"):
            raise EvidenceError(
                "package filename does not match version or architecture"
            )
        package = _read_regular(args.package, "package", _MAX_PACKAGE_BYTES)
        sbom = _read_regular(args.sbom, "SBOM", _MAX_ATTESTATION_BYTES)
        provenance = _read_regular(
            args.provenance, "provenance", _MAX_ATTESTATION_BYTES
        )
        sigstore = _read_regular(
            args.sigstore_bundle, "Sigstore bundle", _MAX_ATTESTATION_BYTES
        )
        evidence: dict[str, Any] = {
            "locator": f"agent_packages.{args.architecture}",
            "package": {
                "architecture": args.architecture,
                "filename": args.package.name,
                "name": "vonk-forge-agent",
                "provenance_sha256": _digest(provenance),
                "sbom_sha256": _digest(sbom),
                "sha256": _digest(package),
                "sigstore_bundle_sha256": _digest(sigstore),
                "size": len(package),
                "version": args.version,
            },
            "schema_version": 1,
        }
        _write_new(args.output, _canonical(evidence))
    except EvidenceError as error:
        print(f"build-agent-package-evidence: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
