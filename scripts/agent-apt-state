#!/usr/bin/env python3
"""Crash-safe private state and exact public-tree transactions for agent apt."""

from __future__ import annotations

import argparse
import concurrent.futures
import gzip
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import tempfile
from dataclasses import dataclass
from functools import cmp_to_key
from pathlib import Path
from typing import Any, Protocol

RECEIPT_KEYS = {
    "channel",
    "distribution",
    "packages",
    "snapshot",
    "source_sha",
    "version",
}
CHANNELS = {
    "dev": ("dev", "vonk-forge-dev-archive-keyring.gpg"),
    "stable": ("stable", "vonk-forge-archive-keyring.gpg"),
}
# The arm64 contract starts a clean state epoch. Historical objects under the
# former top-level ``versions/`` prefix remain immutable and are not read.
STATE_PREFIX = "arm64"
COMMIT_RE = re.compile(rf"^{STATE_PREFIX}/versions/([^/]+)/commit\.json$")
LATEST_COMMIT_RE = re.compile(
    rf"^(?:{STATE_PREFIX}/)?versions/([^/]+)/commit\.json$"
)
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
SEMVER_RE = re.compile(r"^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$")
DEVELOPMENT_VERSION_RE = re.compile(
    r"^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"
    r"~dev\.(?:0|[1-9][0-9]*)\+g[0-9a-f]{12}$"
)
BY_HASH_DIGEST_LENGTHS = {"MD5Sum": 32, "SHA1": 40, "SHA256": 64, "SHA512": 128}
MAX_BUNDLE_BYTES = 1024 * 1024 * 1024
MAX_MEMBER_BYTES = 512 * 1024 * 1024
APTLY_PACKAGE_FORMAT = (
    "{{.Package}}\t{{.Version}}\t{{.Architecture}}\t{{.SHA256}}"
)
REPOSITORIES = {"dev": "vonk-forge-dev", "stable": "vonk-forge"}
RETAINED_PREDECESSORS = {"dev": 0, "stable": 2}
RCLONE_SECRET_ENVIRONMENT = (
    "RCLONE_CONFIG_R2_ACCESS_KEY_ID",
    "RCLONE_CONFIG_R2_SECRET_ACCESS_KEY",
    "RCLONE_CONFIG_R2_ENDPOINT",
)
MAX_OBJECT_STORE_WORKERS = 8


class StateError(RuntimeError):
    pass


class ObjectStore(Protocol):
    def list(self, prefix: str) -> list[str]: ...

    def read(self, key: str) -> bytes: ...

    def write(self, key: str, data: bytes) -> None: ...


@dataclass(frozen=True)
class ValidatedBundle:
    receipt: dict[str, Any]
    files: dict[str, bytes]
    directories: frozenset[str]


@dataclass(frozen=True)
class Preparation:
    mode: str
    state_bundle: bytes | None
    public_bundle: bytes | None
    has_state: bool
    has_public: bool
    high_water_version: str | None


def sha256(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def parse_canonical_json(raw: bytes) -> Any:
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError("JSON object is invalid") from error
    if canonical_json(value) != raw:
        raise StateError("JSON object is not canonical")
    return value


def _validate_receipt(value: object) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != RECEIPT_KEYS:
        raise StateError("publication receipt is invalid")
    string_keys = RECEIPT_KEYS - {"packages"}
    if not all(isinstance(value[key], str) for key in string_keys):
        raise StateError("publication receipt is invalid")
    receipt = {key: value[key] for key in RECEIPT_KEYS}
    packages = receipt["packages"]
    if not isinstance(packages, dict) or set(packages) != {"arm64"}:
        raise StateError("publication receipt is invalid")
    for architecture, package in packages.items():
        if (
            not isinstance(package, dict)
            or set(package) != {"filename", "sha256"}
            or not isinstance(package["filename"], str)
            or not isinstance(package["sha256"], str)
            or package["filename"]
            != f"vonk-forge-agent_{receipt['version']}_{architecture}.deb"
            or SHA256_RE.fullmatch(package["sha256"]) is None
        ):
            raise StateError("publication receipt is invalid")
    authority = CHANNELS.get(receipt["channel"])
    if (
        authority is None
        or receipt["distribution"] != authority[0]
        or SHA_RE.fullmatch(receipt["source_sha"]) is None
        or receipt["snapshot"] != f"{receipt['channel']}-{receipt['version']}"
    ):
        raise StateError("publication receipt is invalid")
    metadata = subprocess.run(
        [
            Path(__file__).with_name("agent-apt-metadata"),
            receipt["channel"],
            receipt["version"],
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if metadata.returncode != 0:
        raise StateError("publication receipt is invalid")
    return receipt


def _member_name(member: tarfile.TarInfo) -> str:
    name = member.name
    if (
        not name
        or name.startswith("/")
        or "\\" in name
        or any(ord(character) < 32 or ord(character) == 127 for character in name)
    ):
        raise StateError("unsafe archive member")
    parts = name.split("/")
    if any(part in {"", ".", ".."} for part in parts):
        raise StateError("unsafe archive member")
    canonical = "/".join(parts)
    if canonical != name:
        raise StateError("unsafe archive member")
    if not (member.isdir() or member.isreg()):
        raise StateError("unsafe archive member")
    if member.size < 0 or member.size > MAX_MEMBER_BYTES:
        raise StateError("unsafe archive member")
    return canonical


def validate_bundle(
    raw: bytes, kind: str, expected_receipt: dict[str, Any] | None = None
) -> ValidatedBundle:
    if kind not in {"state", "public"}:
        raise StateError("bundle is invalid")
    if not raw:
        raise StateError(f"{kind} bundle is empty")
    if len(raw) > MAX_BUNDLE_BYTES:
        raise StateError(
            f"{kind} bundle exceeds {MAX_BUNDLE_BYTES} byte limit: {len(raw)} bytes"
        )
    root = "aptly" if kind == "state" else "public"
    files: dict[str, bytes] = {}
    directories: set[str] = set()
    destinations: set[str] = set()
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
            for member in archive.getmembers():
                name = _member_name(member)
                if name in destinations:
                    raise StateError("unsafe archive member")
                destinations.add(name)
                if name != "publication-receipt.json" and not (
                    name == root or name.startswith(f"{root}/")
                ):
                    raise StateError("unsafe archive member")
                if member.isdir():
                    directories.add(name)
                    continue
                stream = archive.extractfile(member)
                if stream is None:
                    raise StateError("unsafe archive member")
                files[name] = stream.read(MAX_MEMBER_BYTES + 1)
                if len(files[name]) != member.size:
                    raise StateError("unsafe archive member")
    except (tarfile.TarError, OSError, EOFError) as error:
        raise StateError("bundle is invalid") from error
    if root not in directories or "publication-receipt.json" not in files:
        raise StateError("bundle is incomplete")
    receipt = _validate_receipt(
        parse_canonical_json(files["publication-receipt.json"])
    )
    if expected_receipt is not None and receipt != _validate_receipt(expected_receipt):
        raise StateError("publication receipt does not match request")
    if kind == "public":
        distribution, keyring = CHANNELS[receipt["channel"]]
        required = {
            f"public/dists/{distribution}/InRelease",
            f"public/dists/{distribution}/Release",
            f"public/dists/{distribution}/Release.gpg",
            f"public/{keyring}",
        }
        if not required.issubset(files):
            raise StateError("public bundle is incomplete")
        for package in receipt["packages"].values():
            package_files = [
                content
                for name, content in files.items()
                if Path(name).name == package["filename"]
            ]
            if len(package_files) != 1 or sha256(package_files[0]) != package["sha256"]:
                raise StateError("public package hash does not match receipt")
        for name in files:
            if name == "publication-receipt.json":
                continue
            relative = name.removeprefix("public/")
            if relative != keyring and not relative.startswith(
                (f"dists/{distribution}/", "pool/")
            ):
                raise StateError("unsafe archive member")
    return ValidatedBundle(
        receipt=receipt,
        files=files,
        directories=frozenset(directories),
    )


def _tar_info(name: str, *, directory: bool, size: int = 0) -> tarfile.TarInfo:
    member = tarfile.TarInfo(name)
    member.uid = 0
    member.gid = 0
    member.uname = ""
    member.gname = ""
    member.mtime = 0
    member.mode = 0o755 if directory else 0o644
    member.type = tarfile.DIRTYPE if directory else tarfile.REGTYPE
    member.size = 0 if directory else size
    return member


def _is_aptly_by_hash_alias(
    path: Path, root: Path, receipt: dict[str, Any]
) -> bool:
    try:
        relative = path.relative_to(root)
    except ValueError:
        return False
    parts = relative.parts
    if len(parts) < 5 or parts[:2] != ("dists", receipt["distribution"]):
        return False
    try:
        by_hash_index = parts.index("by-hash", 2)
    except ValueError:
        return False
    if by_hash_index != len(parts) - 3:
        return False
    algorithm, alias = parts[-2:]
    digest_length = BY_HASH_DIGEST_LENGTHS.get(algorithm)
    if (
        digest_length is None
        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", alias) is None
        or re.fullmatch(rf"[0-9a-f]{{{digest_length}}}", alias) is not None
    ):
        return False
    try:
        parent = path.parent.resolve(strict=True)
        target = path.resolve(strict=True)
    except (OSError, RuntimeError):
        return False
    return (
        target.parent == parent
        and target.is_file()
        and not target.is_symlink()
        and re.fullmatch(rf"[0-9a-f]{{{digest_length}}}", target.name) is not None
    )


def build_bundle(root: Path, kind: str, publication: dict[str, Any]) -> bytes:
    receipt = _validate_receipt(publication)
    expected_name = "aptly" if kind == "state" else "public"
    if kind not in {"state", "public"} or root.name != expected_name:
        raise StateError("bundle root is invalid")
    if not root.is_dir() or root.is_symlink():
        raise StateError("bundle root is invalid")
    entries = [root, *sorted(root.rglob("*"), key=lambda path: path.as_posix())]
    output = io.BytesIO()
    with (
        gzip.GzipFile(fileobj=output, mode="wb", filename="", mtime=0) as compressed,
        tarfile.open(fileobj=compressed, mode="w") as archive,
    ):
        for path in entries:
            if path.is_symlink():
                if kind == "public" and _is_aptly_by_hash_alias(path, root, receipt):
                    continue
                raise StateError("bundle source is unsafe")
            if not (path.is_dir() or path.is_file()):
                raise StateError("bundle source is unsafe")
            name = expected_name
            if path != root:
                name = f"{expected_name}/{path.relative_to(root).as_posix()}"
            if path.is_dir():
                archive.addfile(_tar_info(name, directory=True))
            else:
                raw = path.read_bytes()
                archive.addfile(
                    _tar_info(name, directory=False, size=len(raw)),
                    io.BytesIO(raw),
                )
        receipt_raw = canonical_json(receipt)
        archive.addfile(
            _tar_info(
                "publication-receipt.json",
                directory=False,
                size=len(receipt_raw),
            ),
            io.BytesIO(receipt_raw),
        )
    raw = output.getvalue()
    validate_bundle(raw, kind, receipt)
    return raw


def _prefix(receipt: dict[str, Any]) -> str:
    return f"{STATE_PREFIX}/versions/{receipt['version']}"


def _validate_latest_pointer(raw: bytes, channel: str) -> dict[str, Any]:
    value = parse_canonical_json(raw)
    commit_match = (
        value.get("commit")
        if isinstance(value, dict) and isinstance(value.get("commit"), str)
        else None
    )
    commit_path = LATEST_COMMIT_RE.fullmatch(commit_match or "")
    if (
        not isinstance(value, dict)
        or set(value) != {"channel", "commit", "commit_sha256", "version"}
        or value["channel"] != channel
        or commit_path is None
        or not isinstance(value["commit_sha256"], str)
        or SHA256_RE.fullmatch(value["commit_sha256"]) is None
        or not isinstance(value["version"], str)
        or _version_pattern(channel).fullmatch(value["version"]) is None
        or commit_path.group(1) != value["version"]
    ):
        raise StateError("latest publication pointer is invalid")
    return value


def _latest_version(store: ObjectStore, channel: str) -> str | None:
    keys = store.list("latest.json")
    if not keys:
        return None
    if keys != ["latest.json"]:
        raise StateError("latest publication pointer path is invalid")
    return _validate_latest_pointer(store.read("latest.json"), channel)["version"]


def _object_record(key: str, raw: bytes) -> dict[str, object]:
    return {"key": key, "sha256": sha256(raw), "size": len(raw)}


def _manifest(
    receipt: dict[str, Any], state_bundle: bytes, public_bundle: bytes
) -> bytes:
    prefix = _prefix(receipt)
    return canonical_json(
        {
            "objects": {
                "aptly_state": _object_record(
                    f"{prefix}/aptly-state.tar.gz", state_bundle
                ),
                "public_tree": _object_record(
                    f"{prefix}/public-tree.tar.gz", public_bundle
                ),
            },
            "publication": receipt,
            "schema_version": 1,
        }
    )


def _validate_manifest(raw: bytes, key: str) -> dict[str, Any]:
    value = parse_canonical_json(raw)
    if (
        not isinstance(value, dict)
        or set(value) != {"objects", "publication", "schema_version"}
        or value["schema_version"] != 1
        or not isinstance(value["objects"], dict)
        or set(value["objects"]) != {"aptly_state", "public_tree"}
    ):
        raise StateError("commit manifest is invalid")
    receipt = _validate_receipt(value["publication"])
    if key != f"{_prefix(receipt)}/commit.json":
        raise StateError("commit manifest path is invalid")
    expected_names = {
        "aptly_state": f"{_prefix(receipt)}/aptly-state.tar.gz",
        "public_tree": f"{_prefix(receipt)}/public-tree.tar.gz",
    }
    for name, expected_key in expected_names.items():
        record = value["objects"][name]
        if (
            not isinstance(record, dict)
            or set(record) != {"key", "sha256", "size"}
            or record["key"] != expected_key
            or not isinstance(record["size"], int)
            or not 1 <= record["size"] <= MAX_BUNDLE_BYTES
            or not isinstance(record["sha256"], str)
            or SHA256_RE.fullmatch(record["sha256"]) is None
        ):
            raise StateError("commit manifest is invalid")
    return value


def _write_immutable(store: ObjectStore, key: str, raw: bytes) -> None:
    existing = store.list(key)
    if key in existing:
        if store.read(key) != raw:
            raise StateError(f"immutable object conflict: {key}")
        return
    if existing:
        raise StateError(f"immutable object path conflict: {key}")
    store.write(key, raw)
    if store.read(key) != raw:
        raise StateError(f"persisted object hash mismatch: {key}")


def _bounded_object_operations(
    objects: dict[str, bytes], operation: Any
) -> dict[str, Any]:
    """Run one object-store phase concurrently without crossing its boundary."""
    if not objects:
        return {}
    ordered = sorted(objects)
    workers = min(MAX_OBJECT_STORE_WORKERS, len(ordered))
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        futures = {
            key: executor.submit(operation, key, objects[key]) for key in ordered
        }
        concurrent.futures.wait(futures.values())
        return {key: futures[key].result() for key in ordered}


def _read_objects(store: ObjectStore, keys: list[str]) -> dict[str, bytes]:
    """Read an authenticated object set concurrently within one phase."""
    if len(keys) != len(set(keys)):
        raise StateError("object read set is invalid")
    return _bounded_object_operations(
        {key: b"" for key in keys},
        lambda key, _raw: store.read(key),
    )


def _write_objects(store: ObjectStore, objects: dict[str, bytes]) -> None:
    _bounded_object_operations(
        objects, lambda key, raw: store.write(key, raw)
    )


def _write_immutable_objects(
    store: ObjectStore,
    objects: dict[str, bytes],
    *,
    description: str = "immutable object",
) -> None:
    """Preflight, persist, and verify an immutable object phase."""
    existing = _bounded_object_operations(
        objects, lambda key, _raw: store.list(key)
    )
    present: set[str] = set()
    for key in sorted(objects):
        keys = existing[key]
        if key in keys:
            if keys != [key]:
                raise StateError(f"{description} path conflict: {key}")
            present.add(key)
        elif keys:
            raise StateError(f"{description} path conflict: {key}")

    existing_bytes = _bounded_object_operations(
        {key: objects[key] for key in present},
        lambda key, _raw: store.read(key),
    )
    for key in sorted(present):
        if existing_bytes[key] != objects[key]:
            raise StateError(f"{description} conflict: {key}")

    missing = {key: raw for key, raw in objects.items() if key not in present}
    _write_objects(store, missing)
    persisted = _bounded_object_operations(
        missing, lambda key, _raw: store.read(key)
    )
    for key in sorted(missing):
        if persisted[key] != missing[key]:
            raise StateError(f"persisted object hash mismatch: {key}")


def commit_candidate(
    store: ObjectStore,
    publication: dict[str, Any],
    state_bundle: bytes,
    public_bundle: bytes,
) -> bytes:
    receipt = _validate_receipt(publication)
    validate_bundle(state_bundle, "state", receipt)
    validate_bundle(public_bundle, "public", receipt)
    prefix = _prefix(receipt)
    manifest = _manifest(receipt, state_bundle, public_bundle)
    _write_immutable_objects(
        store,
        {
            f"{prefix}/aptly-state.tar.gz": state_bundle,
            f"{prefix}/public-tree.tar.gz": public_bundle,
        },
    )
    _write_immutable(store, f"{prefix}/commit.json", manifest)
    return manifest


def _read_committed_objects(
    store: ObjectStore,
    key: str,
    names: frozenset[str],
    raw: bytes | None = None,
) -> tuple[dict[str, Any], dict[str, bytes]]:
    if not names or not names.issubset({"aptly_state", "public_tree"}):
        raise StateError("committed object selection is invalid")
    manifest_raw = store.read(key) if raw is None else raw
    manifest = _validate_manifest(manifest_raw, key)
    records = {name: manifest["objects"][name] for name in sorted(names)}
    raw_bundles = _read_objects(
        store,
        [record["key"] for record in records.values()],
    )
    bundles: dict[str, bytes] = {}
    for name, record in records.items():
        bundle = raw_bundles[record["key"]]
        if len(bundle) != record["size"] or sha256(bundle) != record["sha256"]:
            raise StateError("committed object hash mismatch")
        bundles[name] = bundle
    receipt = manifest["publication"]
    if "aptly_state" in bundles:
        validate_bundle(bundles["aptly_state"], "state", receipt)
    if "public_tree" in bundles:
        validate_bundle(bundles["public_tree"], "public", receipt)
    return manifest, bundles


def _read_committed(
    store: ObjectStore, key: str, raw: bytes | None = None
) -> tuple[dict[str, Any], bytes, bytes]:
    manifest, bundles = _read_committed_objects(
        store, key, frozenset({"aptly_state", "public_tree"}), raw
    )
    return manifest, bundles["aptly_state"], bundles["public_tree"]


def _compare_versions(left: str, right: str) -> int:
    for relation, result in (("lt", -1), ("gt", 1)):
        compared = subprocess.run(
            ["/usr/bin/dpkg", "--compare-versions", left, relation, right],
            check=False,
        )
        if compared.returncode == 0:
            return result
    return 0


def prepare_candidate(
    store: ObjectStore, publication: dict[str, Any]
) -> Preparation:
    requested = _validate_receipt(publication)
    committed: list[tuple[dict[str, Any], str, bytes]] = []
    commit_keys: list[str] = []
    for key in store.list(f"{STATE_PREFIX}/versions/"):
        if not key.endswith("/commit.json"):
            continue
        match = COMMIT_RE.fullmatch(key)
        if match is None:
            raise StateError("commit manifest path is invalid")
        commit_keys.append(key)
    commit_manifests = _read_objects(store, commit_keys)
    for key in sorted(commit_keys):
        raw = commit_manifests[key]
        manifest = _validate_manifest(raw, key)
        if manifest["publication"]["channel"] != requested["channel"]:
            raise StateError("commit manifest channel is invalid")
        committed.append((manifest, key, raw))
    committed.sort(
        key=cmp_to_key(
            lambda left, right: _compare_versions(
                left[0]["publication"]["version"],
                right[0]["publication"]["version"],
            )
        )
    )
    high = committed[-1] if committed else None
    high_version = high[0]["publication"]["version"] if high else None
    published_version = _latest_version(store, requested["channel"])
    if published_version is not None:
        published_comparison = _compare_versions(
            requested["version"], published_version
        )
        if published_comparison < 0:
            raise StateError("refusing to roll back publication epoch")
        if (
            published_comparison == 0
            and (high is None or high_version != requested["version"])
        ):
            raise StateError("publication epoch conflicts with latest pointer")
    if high_version is not None:
        comparison = _compare_versions(requested["version"], high_version)
        if comparison < 0:
            raise StateError("refusing to roll back apt channel")
        if comparison == 0:
            if high[0]["publication"] != requested:
                raise StateError("committed publication conflicts with request")
            _, state_bundle, public_bundle = _read_committed(
                store, high[1], high[2]
            )
            return Preparation(
                mode="committed",
                state_bundle=state_bundle,
                public_bundle=public_bundle,
                has_state=True,
                has_public=True,
                high_water_version=high_version,
            )

    prefix = _prefix(requested)
    keys = store.list(f"{prefix}/")
    allowed = {
        f"{prefix}/aptly-state.tar.gz",
        f"{prefix}/public-tree.tar.gz",
    }
    if not set(keys).issubset(allowed):
        raise StateError("uncommitted immutable prefix is invalid")
    state_key = f"{prefix}/aptly-state.tar.gz"
    public_key = f"{prefix}/public-tree.tar.gz"
    requested_objects = _read_objects(
        store,
        [key for key in (state_key, public_key) if key in keys],
    )
    requested_state = requested_objects.get(state_key)
    requested_public = requested_objects.get(public_key)
    if requested_state is not None:
        validate_bundle(requested_state, "state", requested)
    if requested_public is not None:
        validate_bundle(requested_public, "public", requested)
    base_state = requested_state
    if base_state is None and high is not None:
        _, bundles = _read_committed_objects(
            store, high[1], frozenset({"aptly_state"}), high[2]
        )
        base_state = bundles["aptly_state"]
    return Preparation(
        mode="pending",
        state_bundle=base_state,
        public_bundle=requested_public,
        has_state=requested_state is not None,
        has_public=requested_public is not None,
        high_water_version=high_version,
    )


def publish_committed(
    state_store: ObjectStore,
    public_store: ObjectStore,
    publication: dict[str, Any],
) -> bytes:
    receipt = _validate_receipt(publication)
    commit_key = f"{_prefix(receipt)}/commit.json"
    manifest_raw = state_store.read(commit_key)
    manifest, bundles = _read_committed_objects(
        state_store, commit_key, frozenset({"public_tree"}), manifest_raw
    )
    public_bundle = bundles["public_tree"]
    if manifest["publication"] != receipt:
        raise StateError("committed publication conflicts with request")
    validated = validate_bundle(public_bundle, "public", receipt)
    public_files = {
        name.removeprefix("public/"): content
        for name, content in validated.files.items()
        if name.startswith("public/")
    }
    release = f"dists/{receipt['distribution']}/Release"
    release_gpg = f"dists/{receipt['distribution']}/Release.gpg"
    inrelease = f"dists/{receipt['distribution']}/InRelease"
    commit_objects = {release, release_gpg, inrelease}
    immutable_objects = {
        name
        for name in public_files
        if name.startswith("pool/")
        or name.startswith(f"dists/{receipt['distribution']}/")
        and "/by-hash/" in name
    }
    _write_immutable_objects(
        public_store,
        {name: public_files[name] for name in immutable_objects},
        description="immutable public object",
    )
    ordinary = set(public_files) - commit_objects - immutable_objects
    _write_objects(
        public_store, {name: public_files[name] for name in ordinary}
    )
    _write_objects(
        public_store,
        {
            name: public_files[name]
            for name in (release, release_gpg)
            if name in public_files
        },
    )
    public_store.write(inrelease, public_files[inrelease])
    pointer = canonical_json(
        {
            "channel": receipt["channel"],
            "commit": commit_key,
            "commit_sha256": sha256(manifest_raw),
            "version": receipt["version"],
        }
    )
    state_store.write("latest.json", pointer)
    return pointer


class RcloneStore:
    def __init__(self, bucket: str) -> None:
        if re.fullmatch(r"[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]", bucket) is None:
            raise StateError("object store bucket is invalid")
        self.remote = f"r2:{bucket}"

    def _run(
        self,
        operation: str,
        arguments: list[str],
        *,
        input_raw: bytes | None = None,
    ) -> bytes:
        completed = subprocess.run(
            ["rclone", *arguments],
            input=input_raw,
            check=False,
            capture_output=True,
        )
        if completed.returncode != 0:
            message = (
                f"object store {operation} failed with exit code "
                f"{completed.returncode}"
            )
            detail = _sanitize_rclone_error(completed.stderr)
            if detail:
                message = f"{message}: {detail}"
            raise StateError(message)
        return completed.stdout

    def list(self, prefix: str) -> list[str]:
        clean = prefix.rstrip("/")
        if prefix.endswith("/"):
            parent = clean
        else:
            parent = clean.rsplit("/", 1)[0] if "/" in clean else ""
        remote = self.remote if not parent else f"{self.remote}/{parent}"
        output = self._run(
            "list",
            ["lsf", remote, "--recursive", "--files-only", "--order-by", "name"]
        )
        names = output.decode("utf-8").splitlines()
        keys = [f"{parent}/{name}" if parent else name for name in names]
        return sorted(key for key in keys if key.startswith(prefix))

    def read(self, key: str) -> bytes:
        return self._run("read", ["cat", f"{self.remote}/{key}"])

    def write(self, key: str, data: bytes) -> None:
        with tempfile.NamedTemporaryFile(prefix="agent-apt-object-") as temporary:
            temporary.write(data)
            temporary.flush()
            self._run("write", ["copyto", temporary.name, f"{self.remote}/{key}"])


def _sanitize_rclone_error(raw: bytes) -> str:
    message = raw.decode("utf-8", errors="replace")
    for name in RCLONE_SECRET_ENVIRONMENT:
        secret = os.environ.get(name, "")
        if secret:
            message = message.replace(secret, "[redacted]")
    message = re.sub(
        r"(?i)\b(https?://)[^\s/@]+@",
        r"\1[redacted]@",
        message,
    )
    message = re.sub(
        r"(?i)(https?://[^\s?#]+)[?#][^\s]*",
        r"\1?[redacted]",
        message,
    )
    lines = [line.strip() for line in message.splitlines() if line.strip()]
    return lines[-1][:512] if lines else ""


def _receipt_from_environment() -> dict[str, Any]:
    names = {
        "channel": "CHANNEL",
        "distribution": "DISTRIBUTION",
        "snapshot": "SNAPSHOT",
        "source_sha": "SOURCE_SHA",
        "version": "VERSION",
    }
    try:
        packages_raw = os.environ.get("PACKAGES_JSON", "")
        packages = parse_canonical_json((packages_raw + "\n").encode())
    except StateError as error:
        raise StateError("publication receipt is invalid") from error
    return _validate_receipt(
        {
            **{name: os.environ.get(variable, "") for name, variable in names.items()},
            "packages": packages,
        }
    )


def _work_directory(value: str) -> Path:
    runner = Path(os.environ.get("RUNNER_TEMP", "")).resolve()
    work = Path(value).resolve()
    if not runner.is_dir() or not work.is_relative_to(runner) or work == runner:
        raise StateError("work directory is invalid")
    work.mkdir(mode=0o700, parents=True, exist_ok=True)
    return work


def _write_private(path: Path, raw: bytes) -> None:
    path.write_bytes(raw)
    path.chmod(0o600)


def _validated_regular_file(path: Path, description: str) -> Path:
    if path.is_symlink():
        raise StateError(f"{description} is invalid")
    resolved = path.resolve()
    if not resolved.is_file():
        raise StateError(f"{description} is invalid")
    return resolved


def _run_aptly(
    config: Path, *arguments: str, allow_no_results: bool = False
) -> str:
    completed = subprocess.run(
        ["aptly", f"-config={config}", *arguments],
        check=False,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        if (
            allow_no_results
            and completed.returncode == 1
            and not completed.stdout
            and completed.stderr.strip() == "ERROR: no results"
        ):
            return ""
        operation = " ".join(arguments[:2])
        details = [
            line.strip()
            for line in completed.stderr.splitlines()
            if line.strip()
        ]
        detail = f": {details[-1][:512]}" if details else ""
        raise StateError(
            f"aptly {operation} failed with exit code {completed.returncode}{detail}"
        )
    return completed.stdout


def _parse_aptly_package_records(
    output: str,
) -> set[tuple[str, str, str, str]]:
    records: set[tuple[str, str, str, str]] = set()
    for line in output.splitlines():
        fields = tuple(line.split("\t"))
        if (
            len(fields) != 4
            or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.+-]*", fields[0]) is None
            or not fields[1]
            or any(character.isspace() for character in fields[1])
            or fields[2] != "arm64"
            or SHA256_RE.fullmatch(fields[3]) is None
            or fields in records
        ):
            raise StateError("aptly package set is invalid")
        records.add(fields)
    return records


def _aptly_package_records(
    config: Path,
    scope: str,
    name: str,
    query: str | None = "Name (= vonk-forge-agent)",
) -> set[tuple[str, str, str, str]]:
    arguments = [
        scope,
        "search",
        f"-format={APTLY_PACKAGE_FORMAT}",
        name,
    ]
    if query is not None:
        arguments.append(query)
    return _parse_aptly_package_records(
        _run_aptly(config, *arguments, allow_no_results=True)
    )


def _repository_records(config: Path, repository: str) -> set[tuple[str, str, str, str]]:
    records = _aptly_package_records(config, "repo", repository)
    if records != _aptly_package_records(config, "repo", repository, None):
        raise StateError("aptly repository contains unexpected packages")
    return records


def _version_pattern(channel: str) -> re.Pattern[str]:
    return DEVELOPMENT_VERSION_RE if channel == "dev" else SEMVER_RE


def _group_complete_versions(
    records: set[tuple[str, str, str, str]], channel: str
) -> dict[str, set[tuple[str, str, str, str]]]:
    versions: dict[str, set[tuple[str, str, str, str]]] = {}
    pattern = _version_pattern(channel)
    for record in records:
        package, version, _architecture, _digest = record
        if package != "vonk-forge-agent" or pattern.fullmatch(version) is None:
            raise StateError("aptly repository package identity is invalid")
        versions.setdefault(version, set()).add(record)
    for version_records in versions.values():
        if len(version_records) != 1 or {
            record[2] for record in version_records
        } != {"arm64"}:
            raise StateError("aptly repository has an incomplete package version")
    return versions


def _sorted_versions(versions: set[str]) -> list[str]:
    return sorted(versions, key=cmp_to_key(_compare_versions))


def _expected_current_records(
    publication: dict[str, Any]
) -> set[tuple[str, str, str, str]]:
    return {
        (
            "vonk-forge-agent",
            publication["version"],
            architecture,
            publication["packages"][architecture]["sha256"],
        )
        for architecture in ("arm64",)
    }


def _validate_bounded_records(
    records: set[tuple[str, str, str, str]], publication: dict[str, Any]
) -> None:
    versions = _group_complete_versions(records, publication["channel"])
    current = publication["version"]
    if versions.get(current) != _expected_current_records(publication):
        raise StateError("current aptly package set does not match publication receipt")
    ordered = _sorted_versions(set(versions))
    if ordered[-1] != current:
        raise StateError("current aptly version is not the repository high water")
    if len(ordered) > RETAINED_PREDECESSORS[publication["channel"]] + 1:
        raise StateError("aptly repository retention is unbounded")


def _debian_control_paragraphs(raw: bytes) -> list[dict[str, str]]:
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StateError("aptly Packages index is invalid") from error
    paragraphs: list[dict[str, str]] = []
    for raw_paragraph in text.strip().split("\n\n"):
        if not raw_paragraph:
            continue
        fields: dict[str, str] = {}
        current: str | None = None
        for line in raw_paragraph.splitlines():
            if line.startswith((" ", "\t")):
                if current is None:
                    raise StateError("aptly Packages index is invalid")
                fields[current] += f"\n{line}"
                continue
            name, separator, value = line.partition(":")
            if (
                not separator
                or not name
                or name in fields
                or re.fullmatch(r"[A-Za-z0-9-]+", name) is None
            ):
                raise StateError("aptly Packages index is invalid")
            fields[name] = value.lstrip()
            current = name
        paragraphs.append(fields)
    return paragraphs


def _public_package_records(
    publication: dict[str, Any], public_directory: Path
) -> set[tuple[str, str, str, str]]:
    if public_directory.is_symlink():
        raise StateError("aptly public directory is invalid")
    root = public_directory.resolve()
    if not root.is_dir():
        raise StateError("aptly public directory is invalid")
    records: set[tuple[str, str, str, str]] = set()
    required = {"Package", "Version", "Architecture", "Filename", "SHA256"}
    for architecture in ("arm64",):
        index = _validated_regular_file(
            root
            / "dists"
            / publication["distribution"]
            / "main"
            / f"binary-{architecture}"
            / "Packages",
            "aptly Packages index",
        )
        if not index.is_relative_to(root):
            raise StateError("aptly Packages index is invalid")
        for fields in _debian_control_paragraphs(index.read_bytes()):
            if not required.issubset(fields):
                raise StateError("aptly Packages index is incomplete")
            if (
                fields["Package"] != "vonk-forge-agent"
                or fields["Architecture"] != architecture
                or SHA256_RE.fullmatch(fields["SHA256"]) is None
            ):
                raise StateError("aptly Packages index package is invalid")
            filename = Path(fields["Filename"])
            if (
                filename.is_absolute()
                or filename.as_posix() != fields["Filename"]
                or any(part in {"", ".", ".."} for part in filename.parts)
                or filename.name
                != f"vonk-forge-agent_{fields['Version']}_{architecture}.deb"
            ):
                raise StateError("aptly Packages index filename is invalid")
            package_path = _validated_regular_file(
                root / filename, "aptly published package"
            )
            if (
                not package_path.is_relative_to(root)
                or sha256(package_path.read_bytes()) != fields["SHA256"]
            ):
                raise StateError("aptly published package hash is invalid")
            record = (
                fields["Package"],
                fields["Version"],
                architecture,
                fields["SHA256"],
            )
            if record in records:
                raise StateError("aptly Packages index has a duplicate package")
            records.add(record)
    return records


def compact_aptly_state(
    receipt: dict[str, Any],
    config: Path,
    repository: str,
    package_directory: Path,
    public_directory: Path,
    phase: str,
) -> None:
    publication = _validate_receipt(receipt)
    channel = publication["channel"]
    if repository != REPOSITORIES[channel]:
        raise StateError("aptly repository does not match channel")
    if phase not in {"prepare", "finalize"}:
        raise StateError("aptly state compaction phase is invalid")
    config = _validated_regular_file(config, "aptly config")
    if package_directory.is_symlink():
        raise StateError("package directory is invalid")
    package_directory = package_directory.resolve()
    if not package_directory.is_dir():
        raise StateError("package directory is invalid")

    package_paths: dict[str, Path] = {}
    expected_current = _expected_current_records(publication)
    for architecture in ("arm64",):
        package = publication["packages"][architecture]
        path = _validated_regular_file(
            package_directory / package["filename"], "agent package"
        )
        if (
            path.parent != package_directory
            or sha256(path.read_bytes()) != package["sha256"]
        ):
            raise StateError("agent package does not match publication receipt")
        package_paths[architecture] = path

    if phase == "prepare":
        before = _repository_records(config, repository)
        versions = _group_complete_versions(before, channel)
        current = publication["version"]
        if current in versions and versions[current] != expected_current:
            raise StateError("current aptly package set conflicts with publication receipt")
        historical = _sorted_versions(set(versions) - {current})
        if historical and _compare_versions(current, historical[-1]) <= 0:
            raise StateError("refusing to roll back aptly repository")
        retained_versions = set(historical[-RETAINED_PREDECESSORS[channel] :])
        if RETAINED_PREDECESSORS[channel] == 0:
            retained_versions = set()
        for version in historical:
            if version not in retained_versions:
                _run_aptly(
                    config,
                    "repo",
                    "remove",
                    repository,
                    f"Name (= vonk-forge-agent), $Version (= '{version}')",
                )
        remaining = _repository_records(config, repository)
        expected = set().union(
            *(versions[version] for version in retained_versions)
        )
        if current in versions:
            expected |= expected_current
        if remaining != expected:
            raise StateError("aptly repository pruning did not match retention policy")
        if current not in versions:
            for architecture in ("arm64",):
                _run_aptly(
                    config,
                    "repo",
                    "add",
                    repository,
                    str(package_paths[architecture]),
                )
        compacted = _repository_records(config, repository)
        if compacted != expected | expected_current:
            raise StateError("compacted aptly repository is invalid")
        _validate_bounded_records(compacted, publication)
        return

    snapshots = _run_aptly(config, "snapshot", "list", "-raw").splitlines()
    if (
        publication["snapshot"] not in snapshots
        or len(snapshots) != len(set(snapshots))
        or any(
            not name or any(character.isspace() for character in name)
            for name in snapshots
        )
    ):
        raise StateError("aptly snapshot set is invalid")
    current_records = _repository_records(config, repository)
    _validate_bounded_records(current_records, publication)
    snapshot_records = _aptly_package_records(
        config, "snapshot", publication["snapshot"], None
    )
    if snapshot_records != current_records:
        raise StateError("current aptly snapshot does not match compacted repository")
    if _public_package_records(publication, public_directory) != current_records:
        raise StateError("published aptly package matrix does not match snapshot")
    for snapshot in sorted(set(snapshots) - {publication["snapshot"]}):
        _run_aptly(config, "snapshot", "drop", snapshot)

    _run_aptly(config, "db", "cleanup")
    remaining = _run_aptly(config, "snapshot", "list", "-raw").splitlines()
    if remaining != [publication["snapshot"]]:
        raise StateError("cleaned aptly snapshot set is invalid")
    cleaned = _repository_records(config, repository)
    _validate_bounded_records(cleaned, publication)
    if (
        _aptly_package_records(
            config, "snapshot", publication["snapshot"], None
        )
        != cleaned
    ):
        raise StateError("cleaned aptly snapshot does not match compacted repository")


def extract_bundle(
    raw: bytes,
    kind: str,
    destination: Path,
    expected_receipt: dict[str, Any],
) -> None:
    validated = validate_bundle(raw, kind, expected_receipt)
    root = "aptly" if kind == "state" else "public"
    target_root = destination / root
    if target_root.exists():
        raise StateError("bundle extraction target already exists")
    for name in sorted(validated.directories, key=lambda item: (item.count("/"), item)):
        if name == root or name.startswith(f"{root}/"):
            target = destination / name
            target.mkdir(mode=0o700 if kind == "state" else 0o755, exist_ok=False)
    for name, content in sorted(validated.files.items()):
        if not name.startswith(f"{root}/"):
            continue
        target = destination / name
        target.parent.mkdir(
            mode=0o700 if kind == "state" else 0o755,
            parents=True,
            exist_ok=True,
        )
        target.write_bytes(content)
        target.chmod(0o600 if kind == "state" else 0o644)


def _state_store() -> RcloneStore:
    return RcloneStore(os.environ.get("R2_APT_STATE_BUCKET", ""))


def _prepare(work: Path, receipt: dict[str, Any]) -> None:
    prepared = prepare_candidate(_state_store(), receipt)
    if prepared.state_bundle is not None:
        if prepared.has_state:
            _write_private(work / "aptly-state.tar.gz", prepared.state_bundle)
        else:
            _write_private(work / "base-aptly-state.tar.gz", prepared.state_bundle)
        extract_bundle(prepared.state_bundle, "state", work, _validate_receipt(
            validate_bundle(prepared.state_bundle, "state").receipt
        ))
    if prepared.public_bundle is not None:
        _write_private(work / "public-tree.tar.gz", prepared.public_bundle)
    needs_generation = not (prepared.has_state and prepared.has_public)
    print(f"mode={prepared.mode}")
    print(f"has_state={str(prepared.has_state).lower()}")
    print(f"has_public={str(prepared.has_public).lower()}")
    print(f"restored={str(prepared.state_bundle is not None).lower()}")
    print(f"needs_generation={str(needs_generation).lower()}")


def _bundle(work: Path, receipt: dict[str, Any]) -> None:
    state_path = work / "aptly-state.tar.gz"
    if state_path.exists():
        validate_bundle(state_path.read_bytes(), "state", receipt)
    else:
        _write_private(state_path, build_bundle(work / "aptly", "state", receipt))
    public_path = work / "public-tree.tar.gz"
    if public_path.exists():
        validate_bundle(public_path.read_bytes(), "public", receipt)
    else:
        _write_private(public_path, build_bundle(work / "public", "public", receipt))


def _commit(work: Path, receipt: dict[str, Any]) -> None:
    manifest = commit_candidate(
        _state_store(),
        receipt,
        (work / "aptly-state.tar.gz").read_bytes(),
        (work / "public-tree.tar.gz").read_bytes(),
    )
    _write_private(work / "commit.json", manifest)


def _publish(receipt: dict[str, Any]) -> None:
    publish_committed(
        _state_store(),
        RcloneStore(os.environ.get("R2_APT_PUBLIC_BUCKET", "")),
        receipt,
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command", choices=("prepare", "compact", "bundle", "commit", "publish")
    )
    parser.add_argument("--work-dir")
    parser.add_argument("--aptly-config", type=Path)
    parser.add_argument("--repository")
    parser.add_argument("--package-dir", type=Path)
    parser.add_argument("--public-dir", type=Path)
    parser.add_argument("--phase", choices=("prepare", "finalize"))
    arguments = parser.parse_args(argv)
    try:
        receipt = _receipt_from_environment()
        if arguments.command in {"prepare", "bundle", "commit"}:
            if arguments.work_dir is None:
                raise StateError("work directory is required")
            work = _work_directory(arguments.work_dir)
        if arguments.command == "prepare":
            _prepare(work, receipt)
        elif arguments.command == "compact":
            if (
                arguments.aptly_config is None
                or arguments.repository is None
                or arguments.package_dir is None
                or arguments.public_dir is None
                or arguments.phase is None
            ):
                raise StateError("aptly compaction arguments are required")
            compact_aptly_state(
                receipt,
                arguments.aptly_config,
                arguments.repository,
                arguments.package_dir,
                arguments.public_dir,
                arguments.phase,
            )
        elif arguments.command == "bundle":
            _bundle(work, receipt)
        elif arguments.command == "commit":
            _commit(work, receipt)
        else:
            _publish(receipt)
    except (OSError, StateError, KeyError) as error:
        print(f"agent apt state failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
