#!/usr/bin/env python3
"""Publish only a development Compose file and validated runtime secrets."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import importlib.util
import ipaddress
import json
import os
import re
import secrets
import shutil
import stat
import sys
import tempfile
from pathlib import Path
from types import ModuleType

_DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
_READ_FLAGS = os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC
_WRITE_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
_MAX_FILE_BYTES = 2 * 1024 * 1024
_PUBLICATION_JOURNAL = ".vonk-forge-publish"
_PUBLICATION_TOMBSTONE = ".vonk-forge-publish.cleanup"
_LOCAL_STAGING_FILESYSTEMS = frozenset(
    {
        "btrfs",
        "ext2",
        "ext3",
        "ext4",
        "f2fs",
        "overlay",
        "ramfs",
        "tmpfs",
        "xfs",
        "zfs",
    }
)
_HOST_LABEL = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?")
_PUBLISHED_SECRET_NAMES = frozenset(
    {
        "agent-ca-certificate",
        "agent-ca-key",
        "agent-proxy-auth",
        "controller-ca",
        "controller-server-certificate",
        "controller-server-key",
        "database-url",
        "git-signing-key",
        "host-runtime-grant-private-key",
        "litellm-master-key",
        "litellm-upstream-key",
        "management-cidrs",
        "postgres-password",
        "token-signing-key",
    }
)


class ProjectPublicationError(RuntimeError):
    """The requested project publication is unsafe or invalid."""


def _runtime_module() -> ModuleType:
    path = Path(__file__).with_name("dev-runtime-secrets.py")
    specification = importlib.util.spec_from_file_location(
        "vonk_dev_runtime_secrets", path
    )
    if specification is None or specification.loader is None:
        raise ProjectPublicationError("runtime secret validator cannot be loaded")
    module = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(module)
    return module


def _filesystem_type(path: Path) -> str:
    return str(_runtime_module()._filesystem_type(path))


def _validate_hostname(value: str) -> str:
    hostname = value.rstrip(".").lower()
    if (
        not hostname
        or len(hostname) > 253
        or hostname != value.lower()
        or any(_HOST_LABEL.fullmatch(label) is None for label in hostname.split("."))
    ):
        raise ProjectPublicationError("development hostname is invalid")
    return hostname


def _validate_cidrs(value: str, *, kind: str = "management") -> tuple[str, ...]:
    values = [part.strip() for part in value.split(",")]
    if not values or any(not part for part in values):
        raise ProjectPublicationError(f"development {kind} CIDRs are invalid")
    try:
        networks = tuple(ipaddress.ip_network(part, strict=True) for part in values)
    except ValueError as error:
        raise ProjectPublicationError(
            f"development {kind} CIDRs are invalid"
        ) from error
    normalized = tuple(str(network) for network in networks)
    if len(set(normalized)) != len(normalized):
        raise ProjectPublicationError(f"development {kind} CIDRs are duplicated")
    return normalized


def _validate_direct_fabric_cidrs(
    value: str, *, management_cidrs: tuple[str, ...]
) -> tuple[str, ...]:
    if value == "none":
        return ()
    direct = _validate_cidrs(value, kind="direct-fabric")
    management_networks = tuple(
        ipaddress.ip_network(cidr, strict=True) for cidr in management_cidrs
    )
    direct_networks = tuple(ipaddress.ip_network(cidr, strict=True) for cidr in direct)
    if any(
        management.version == fabric.version and management.overlaps(fabric)
        for management in management_networks
        for fabric in direct_networks
    ):
        raise ProjectPublicationError(
            "development direct-fabric CIDRs overlap management CIDRs"
        )
    return direct


def _open_parent_without_symlinks(path: Path) -> int:
    if not path.is_absolute() or "\\" in str(path):
        raise ProjectPublicationError("source path must be absolute and local")
    descriptor = -1
    try:
        descriptor = os.open("/", _DIRECTORY_FLAGS)
        for component in path.parent.parts[1:]:
            listed = os.stat(component, dir_fd=descriptor, follow_symlinks=False)
            child = os.open(component, _DIRECTORY_FLAGS, dir_fd=descriptor)
            opened = os.fstat(child)
            if (listed.st_dev, listed.st_ino) != (
                opened.st_dev,
                opened.st_ino,
            ) or not stat.S_ISDIR(opened.st_mode):
                os.close(child)
                raise ProjectPublicationError("source path changed while opening")
            os.close(descriptor)
            descriptor = child
        return descriptor
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise ProjectPublicationError("source path cannot be opened safely") from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        raise


def _read_regular(
    path: Path, *, private: bool, maximum: int = _MAX_FILE_BYTES
) -> bytes:
    parent = _open_parent_without_symlinks(path)
    try:
        listed = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        descriptor = os.open(path.name, _READ_FLAGS, dir_fd=parent)
    except OSError as error:
        os.close(parent)
        raise ProjectPublicationError(f"source file {path.name} is unsafe") from error
    try:
        before = os.fstat(descriptor)
        allowed_modes = {0o600} if private else {0o600, 0o644}
        if (
            (listed.st_dev, listed.st_ino) != (before.st_dev, before.st_ino)
            or not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) not in allowed_modes
            or not 0 < before.st_size <= maximum
        ):
            raise ProjectPublicationError(f"source file {path.name} is unsafe")
        content = bytearray()
        while len(content) <= maximum:
            chunk = os.read(descriptor, min(65536, maximum + 1 - len(content)))
            if not chunk:
                break
            content.extend(chunk)
        after = os.fstat(descriptor)
        identity = (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_nlink,
            before.st_mtime_ns,
            before.st_ctime_ns,
        )
        updated = (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_nlink,
            after.st_mtime_ns,
            after.st_ctime_ns,
        )
        if len(content) != before.st_size or identity != updated:
            raise ProjectPublicationError(
                f"source file {path.name} changed while reading"
            )
        return bytes(content)
    finally:
        os.close(descriptor)
        os.close(parent)


def _validate_source_directory(path: Path) -> None:
    parent = _open_parent_without_symlinks(path)
    try:
        listed = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        descriptor = os.open(path.name, _DIRECTORY_FLAGS, dir_fd=parent)
    except OSError as error:
        os.close(parent)
        raise ProjectPublicationError("source secrets directory is unsafe") from error
    try:
        opened = os.fstat(descriptor)
        if (
            (listed.st_dev, listed.st_ino) != (opened.st_dev, opened.st_ino)
            or not stat.S_ISDIR(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o700
        ):
            raise ProjectPublicationError("source secrets directory is unsafe")
    finally:
        os.close(descriptor)
        os.close(parent)


def _render_compose(
    source: bytes, *, enroll: str, agent: str, direct_fabric_cidrs: tuple[str, ...]
) -> bytes:
    try:
        text = source.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ProjectPublicationError("source Compose file is not UTF-8") from error
    old_enroll = "VONK_AGENT_ENROLL_HOSTNAME: enroll.vonk-forge.lan"
    old_agent = "VONK_AGENT_HOSTNAME: agents.vonk-forge.lan"
    old_fabric = 'VONK_DIRECT_FABRIC_CIDRS: ""'
    old_project = "name: vonk-forge-dev\n\n"
    if (
        text.count(old_project) != 1
        or not text.startswith(old_project)
        or text.count(old_enroll) != 1
        or text.count(old_agent) != 1
        or text.count(old_fabric) != 2
    ):
        raise ProjectPublicationError("source Compose hostname contract is unexpected")
    rendered = text.removeprefix(old_project)
    rendered = rendered.replace(old_enroll, f"VONK_AGENT_ENROLL_HOSTNAME: {enroll}")
    rendered = rendered.replace(old_agent, f"VONK_AGENT_HOSTNAME: {agent}")
    rendered = rendered.replace(
        old_fabric,
        f'VONK_DIRECT_FABRIC_CIDRS: "{",".join(direct_fabric_cidrs)}"',
    )
    return rendered.encode("utf-8")


def _write_verified(path: Path, content: bytes, mode: int) -> None:
    descriptor = -1
    try:
        descriptor = os.open(path, _WRITE_FLAGS, mode)
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise OSError("short write")
            view = view[written:]
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    except OSError as error:
        raise ProjectPublicationError("project staging write failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    copied = _read_regular(path, private=mode == 0o600)
    if (
        len(copied) != len(content)
        or hashlib.sha256(copied).digest() != hashlib.sha256(content).digest()
    ):
        raise ProjectPublicationError("project staging verification failed")


def _validate_destination(destination: Path) -> tuple[Path, bool]:
    if os.name != "posix" or not destination.is_absolute() or "\\" in str(destination):
        raise ProjectPublicationError(
            "project destination must be an absolute mounted path"
        )
    parent = destination.parent
    try:
        parent_metadata = parent.lstat()
    except OSError as error:
        raise ProjectPublicationError(
            "project destination parent does not exist"
        ) from error
    if not stat.S_ISDIR(parent_metadata.st_mode):
        raise ProjectPublicationError("project destination parent is unsafe")
    created = False
    try:
        destination_metadata = destination.lstat()
    except FileNotFoundError:
        try:
            destination.mkdir(mode=0o700)
            created = True
            destination_metadata = destination.lstat()
        except OSError as error:
            raise ProjectPublicationError(
                "project destination cannot be created"
            ) from error
    if not stat.S_ISDIR(destination_metadata.st_mode):
        raise ProjectPublicationError("project destination is unsafe")
    allowed = {
        "docker-compose.yml",
        "secrets",
        _PUBLICATION_JOURNAL,
        _PUBLICATION_TOMBSTONE,
    }
    entries = {entry.name for entry in destination.iterdir()}
    if not entries <= allowed:
        raise ProjectPublicationError("project destination contains unexpected entries")
    compose = destination / "docker-compose.yml"
    if compose.exists() or compose.is_symlink():
        metadata = compose.lstat()
        if not stat.S_ISREG(metadata.st_mode):
            raise ProjectPublicationError("existing project Compose file is unsafe")
    secret_destination = destination / "secrets"
    if secret_destination.exists() or secret_destination.is_symlink():
        metadata = secret_destination.lstat()
        if not stat.S_ISDIR(metadata.st_mode):
            raise ProjectPublicationError(
                "existing project secrets directory is unsafe"
            )
        names = {entry.name for entry in secret_destination.iterdir()}
        if not names <= _PUBLISHED_SECRET_NAMES:
            raise ProjectPublicationError(
                "project secrets directory contains unexpected entries"
            )
        for entry in secret_destination.iterdir():
            if not stat.S_ISREG(entry.lstat().st_mode):
                raise ProjectPublicationError("existing project secret is unsafe")
    else:
        secret_destination.mkdir(mode=0o700)
    return secret_destination, created


def _publication_lock_path(destination: Path) -> Path:
    digest = hashlib.sha256(os.fsencode(destination.name)).hexdigest()[:24]
    return destination.parent / f".vonk-forge-publish-{digest}.lock"


def _acquire_publication_lock(destination: Path) -> int:
    descriptor = -1
    path = _publication_lock_path(destination)
    try:
        descriptor = os.open(
            path,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
        os.fchmod(descriptor, 0o600)
        opened = os.fstat(descriptor)
        listed = path.lstat()
        if (
            (opened.st_dev, opened.st_ino) != (listed.st_dev, listed.st_ino)
            or not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or opened.st_nlink != 1
        ):
            raise ProjectPublicationError("publication lock is unsafe")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ProjectPublicationError(
                "another project publisher is active"
            ) from error
        return descriptor
    except ProjectPublicationError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise ProjectPublicationError(
            "exclusive publication locking is unavailable"
        ) from error


def _release_publication_lock(descriptor: int) -> None:
    try:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
    finally:
        os.close(descriptor)


def _generation_paths() -> tuple[str, ...]:
    return ("docker-compose.yml",) + tuple(
        f"secrets/{name}" for name in sorted(_PUBLISHED_SECRET_NAMES)
    )


def _digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def _read_generation(destination: Path) -> dict[str, bytes]:
    generation: dict[str, bytes] = {}
    for relative in _generation_paths():
        path = destination / relative
        if path.exists() or path.is_symlink():
            generation[relative] = _read_regular(path, private=True)
    return generation


def _write_journal_generation(root: Path, generation: dict[str, bytes]) -> None:
    root.mkdir(mode=0o700)
    (root / "secrets").mkdir(mode=0o700)
    for relative, content in generation.items():
        _write_verified(root / relative, content, 0o600)


def _journal_manifest(
    old_generation: dict[str, bytes], new_generation: dict[str, bytes]
) -> bytes:
    manifest = {
        "schema_version": 1,
        "old": {name: _digest(content) for name, content in old_generation.items()},
        "new": {name: _digest(content) for name, content in new_generation.items()},
    }
    return (json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )


def _load_recovery_generation(journal: Path) -> dict[str, bytes] | None:
    manifest_path = journal / "manifest.json"
    if not manifest_path.exists():
        return None
    try:
        manifest = json.loads(
            _read_regular(manifest_path, private=True, maximum=64 * 1024)
        )
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise ProjectPublicationError("publication journal is invalid") from error
    if (
        not isinstance(manifest, dict)
        or manifest.get("schema_version") != 1
        or not isinstance(manifest.get("old"), dict)
        or not isinstance(manifest.get("new"), dict)
    ):
        raise ProjectPublicationError("publication journal is invalid")
    allowed = set(_generation_paths())
    old_hashes = manifest["old"]
    new_hashes = manifest["new"]
    if (
        not set(old_hashes) <= allowed
        or set(new_hashes) != allowed
        or any(
            not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None
            for value in (*old_hashes.values(), *new_hashes.values())
        )
    ):
        raise ProjectPublicationError("publication journal is invalid")
    expected_entries = {
        "manifest.json",
        "old",
        "new",
        "scratch",
    }
    if {entry.name for entry in journal.iterdir()} != expected_entries:
        raise ProjectPublicationError("publication journal is invalid")
    for generation_name, expected_names in (("old", old_hashes), ("new", new_hashes)):
        root = journal / generation_name
        if not root.is_dir() or root.is_symlink():
            raise ProjectPublicationError("publication journal is invalid")
        actual_entries = {
            str(path.relative_to(root)) for path in root.rglob("*")
        }
        if actual_entries != set(expected_names) | {"secrets"}:
            raise ProjectPublicationError("publication journal is invalid")
        expected_files = set(expected_names)
        actual_files = {
            str(path.relative_to(root))
            for path in root.rglob("*")
            if path.is_file() and not path.is_symlink()
        }
        actual_directories = {
            str(path.relative_to(root))
            for path in root.rglob("*")
            if path.is_dir() and not path.is_symlink()
        }
        if actual_files != expected_files or actual_directories != {"secrets"}:
            raise ProjectPublicationError("publication journal is invalid")
    scratch = journal / "scratch"
    if not scratch.is_dir() or scratch.is_symlink():
        raise ProjectPublicationError("publication journal is invalid")
    for child in scratch.iterdir():
        if not child.is_file() or child.is_symlink():
            raise ProjectPublicationError("publication journal is invalid")
        child.unlink()
    old_generation: dict[str, bytes] = {}
    for relative, expected_digest in old_hashes.items():
        content = _read_regular(journal / "old" / relative, private=True)
        if _digest(content) != expected_digest:
            raise ProjectPublicationError("publication journal failed verification")
        old_generation[relative] = content
    return old_generation


def _replace_visible(path: Path, content: bytes, scratch: Path) -> None:
    temporary = scratch / secrets.token_hex(16)
    try:
        _write_verified(temporary, content, 0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _restore_generation(
    destination: Path, generation: dict[str, bytes], scratch: Path
) -> None:
    secret_destination = destination / "secrets"
    secret_destination.mkdir(mode=0o700, exist_ok=True)
    for relative in _generation_paths():
        path = destination / relative
        if relative in generation:
            _replace_visible(path, generation[relative], scratch)
        else:
            path.unlink(missing_ok=True)
    restored = _read_generation(destination)
    if {
        name: _digest(content) for name, content in restored.items()
    } != {name: _digest(content) for name, content in generation.items()}:
        raise ProjectPublicationError("previous project generation cannot be restored")


def _recover_publication(destination: Path) -> None:
    journal = destination / _PUBLICATION_JOURNAL
    if not journal.exists() and not journal.is_symlink():
        return
    if not journal.is_dir() or journal.is_symlink():
        raise ProjectPublicationError("publication journal is unsafe")
    old_generation = _load_recovery_generation(journal)
    if old_generation is None:
        _retire_publication_journal(destination, journal)
        return
    _restore_generation(destination, old_generation, journal / "scratch")
    _retire_publication_journal(destination, journal)


def _remove_publication_tombstone(destination: Path) -> None:
    tombstone = destination / _PUBLICATION_TOMBSTONE
    if not tombstone.exists() and not tombstone.is_symlink():
        return
    if not tombstone.is_dir() or tombstone.is_symlink():
        raise ProjectPublicationError("publication cleanup tombstone is unsafe")
    try:
        shutil.rmtree(tombstone)
    except OSError as error:
        raise ProjectPublicationError(
            "completed publication cleanup was interrupted; rerun to continue"
        ) from error


def _retire_publication_journal(destination: Path, journal: Path) -> None:
    tombstone = destination / _PUBLICATION_TOMBSTONE
    try:
        os.replace(journal, tombstone)
        shutil.rmtree(tombstone)
    except OSError as error:
        raise ProjectPublicationError(
            "completed publication cleanup was interrupted; rerun to continue"
        ) from error


def _prepare_publication_journal(
    destination: Path,
    old_generation: dict[str, bytes],
    new_generation: dict[str, bytes],
) -> Path:
    journal = destination / _PUBLICATION_JOURNAL
    try:
        journal.mkdir(mode=0o700)
        _write_journal_generation(journal / "old", old_generation)
        _write_journal_generation(journal / "new", new_generation)
        (journal / "scratch").mkdir(mode=0o700)
        pending_manifest = journal / "manifest.pending"
        _write_verified(
            pending_manifest,
            _journal_manifest(old_generation, new_generation),
            0o600,
        )
        os.replace(pending_manifest, journal / "manifest.json")
    except BaseException:
        if not (journal / "manifest.json").exists():
            shutil.rmtree(journal, ignore_errors=True)
        raise
    return journal


def _filesystem_type_at(descriptor: int) -> str:
    return _filesystem_type(Path(f"/proc/self/fd/{descriptor}"))


def _open_local_staging_parent(path: Path) -> int:
    descriptor = -1
    try:
        listed = path.lstat()
        descriptor = os.open(path, _DIRECTORY_FLAGS)
        opened = os.fstat(descriptor)
        if (
            (listed.st_dev, listed.st_ino) != (opened.st_dev, opened.st_ino)
            or not stat.S_ISDIR(opened.st_mode)
            or _filesystem_type_at(descriptor) not in _LOCAL_STAGING_FILESYSTEMS
        ):
            raise ProjectPublicationError("project staging root must be local storage")
        return descriptor
    except OSError as error:
        raise ProjectPublicationError(
            "local staging root cannot be opened safely"
        ) from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        raise


def _create_local_staging_directory(parent: int) -> tuple[str, int, tuple[int, int]]:
    name = f".vonk-forge-project-{secrets.token_hex(16)}"
    descriptor = -1
    try:
        os.mkdir(name, 0o700, dir_fd=parent)
        listed = os.stat(name, dir_fd=parent, follow_symlinks=False)
        descriptor = os.open(name, _DIRECTORY_FLAGS, dir_fd=parent)
        opened = os.fstat(descriptor)
        identity = (opened.st_dev, opened.st_ino)
        if (
            (listed.st_dev, listed.st_ino) != identity
            or not stat.S_ISDIR(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o700
            or _filesystem_type_at(descriptor) not in _LOCAL_STAGING_FILESYSTEMS
        ):
            raise ProjectPublicationError("project staging directory is unsafe")
        return name, descriptor, identity
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.rmdir(name, dir_fd=parent)
        except OSError:
            pass
        raise ProjectPublicationError(
            "project staging directory cannot be created safely"
        ) from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.rmdir(name, dir_fd=parent)
        except OSError:
            pass
        raise


def _open_private_staging_child(parent: int, name: str) -> int:
    descriptor = -1
    created = False
    try:
        os.mkdir(name, 0o700, dir_fd=parent)
        created = True
        listed = os.stat(name, dir_fd=parent, follow_symlinks=False)
        descriptor = os.open(name, _DIRECTORY_FLAGS, dir_fd=parent)
        opened = os.fstat(descriptor)
        if (
            (listed.st_dev, listed.st_ino) != (opened.st_dev, opened.st_ino)
            or not stat.S_ISDIR(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o700
        ):
            raise ProjectPublicationError("project staging child is unsafe")
        return descriptor
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        if created:
            try:
                os.rmdir(name, dir_fd=parent)
            except OSError:
                pass
        raise ProjectPublicationError(
            "project staging child cannot be created"
        ) from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        if created:
            try:
                os.rmdir(name, dir_fd=parent)
            except OSError:
                pass
        raise


def _read_regular_at(
    directory: int, name: str, *, maximum: int = _MAX_FILE_BYTES
) -> bytes:
    descriptor = -1
    try:
        listed = os.stat(name, dir_fd=directory, follow_symlinks=False)
        descriptor = os.open(name, _READ_FLAGS, dir_fd=directory)
        before = os.fstat(descriptor)
        if (
            (listed.st_dev, listed.st_ino) != (before.st_dev, before.st_ino)
            or not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o600
            or not 0 < before.st_size <= maximum
        ):
            raise ProjectPublicationError(f"staged file {name} is unsafe")
        content = bytearray()
        while len(content) <= maximum:
            chunk = os.read(descriptor, min(65536, maximum + 1 - len(content)))
            if not chunk:
                break
            content.extend(chunk)
        after = os.fstat(descriptor)
        identity = (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_nlink,
            before.st_mtime_ns,
            before.st_ctime_ns,
        )
        updated = (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_nlink,
            after.st_mtime_ns,
            after.st_ctime_ns,
        )
        if len(content) != before.st_size or identity != updated:
            raise ProjectPublicationError(f"staged file {name} changed while reading")
        return bytes(content)
    except OSError as error:
        raise ProjectPublicationError(f"staged file {name} is unsafe") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _write_verified_at(directory: int, name: str, content: bytes) -> bytes:
    descriptor = -1
    try:
        descriptor = os.open(name, _WRITE_FLAGS, 0o600, dir_fd=directory)
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise OSError("short write")
            view = view[written:]
        os.fchmod(descriptor, 0o600)
        os.fsync(descriptor)
    except OSError as error:
        raise ProjectPublicationError(
            f"staged file {name} cannot be written"
        ) from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    copied = _read_regular_at(directory, name)
    if (
        len(copied) != len(content)
        or hashlib.sha256(copied).digest() != hashlib.sha256(content).digest()
    ):
        raise ProjectPublicationError(f"staged file {name} failed verification")
    return copied


def _remove_local_staging(
    parent: int,
    name: str,
    directory: int,
    identity: tuple[int, int],
    secrets_directory: int,
) -> None:
    if secrets_directory >= 0:
        for child in os.listdir(secrets_directory):
            os.unlink(child, dir_fd=secrets_directory)
        os.close(secrets_directory)
        os.rmdir("secrets", dir_fd=directory)
    try:
        os.unlink("docker-compose.yml", dir_fd=directory)
    except FileNotFoundError:
        pass
    os.close(directory)
    try:
        current = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if (current.st_dev, current.st_ino) == identity:
            os.rmdir(name, dir_fd=parent)
    except FileNotFoundError:
        pass


def publish_project(
    *,
    source_compose: Path,
    secrets_dir: Path,
    destination: Path,
    nas_address: str,
    management_cidrs: str,
    direct_fabric_cidrs: str,
    enroll_hostname: str,
    agent_hostname: str,
    registry_hostname: str,
) -> Path:
    try:
        ipaddress.ip_address(nas_address)
    except ValueError as error:
        raise ProjectPublicationError("NAS address must be an IP address") from error
    enroll = _validate_hostname(enroll_hostname)
    agent = _validate_hostname(agent_hostname)
    registry = _validate_hostname(registry_hostname)
    cidrs = _validate_cidrs(management_cidrs)
    fabric_cidrs = _validate_direct_fabric_cidrs(
        direct_fabric_cidrs, management_cidrs=cidrs
    )
    _validate_source_directory(secrets_dir)
    runtime = _runtime_module()
    source_bundle = {
        name: _read_regular(secrets_dir / name, private=True, maximum=64 * 1024)
        for name in runtime.RUNTIME_SECRET_NAMES
    }
    try:
        runtime._validate_bundle(
            source_bundle,
            management_cidrs=cidrs,
            enroll_hostname=enroll,
            agent_hostname=agent,
            registry_hostname=registry,
        )
    except runtime.RuntimeSecretError as error:
        raise ProjectPublicationError(
            "source secret bundle does not match project inputs"
        ) from error
    compose_source = _read_regular(source_compose, private=False)
    compose = _render_compose(
        compose_source,
        enroll=enroll,
        agent=agent,
        direct_fabric_cidrs=fabric_cidrs,
    )

    staging_parent = _open_local_staging_parent(Path(tempfile.gettempdir()))
    staging_name = ""
    staging_directory = -1
    staging_identity = (-1, -1)
    staging_secrets = -1
    publication_lock = -1
    try:
        staging_name, staging_directory, staging_identity = (
            _create_local_staging_directory(staging_parent)
        )
        staging_secrets = _open_private_staging_child(staging_directory, "secrets")
        staged_compose = _write_verified_at(
            staging_directory, "docker-compose.yml", compose
        )
        staged_secrets: dict[str, bytes] = {}
        for name in sorted(_PUBLISHED_SECRET_NAMES):
            staged_secrets[name] = _write_verified_at(
                staging_secrets, name, source_bundle[name]
            )
        if (
            os.fstat(staging_directory).st_dev,
            os.fstat(staging_directory).st_ino,
        ) != staging_identity or _filesystem_type_at(
            staging_directory
        ) not in _LOCAL_STAGING_FILESYSTEMS:
            raise ProjectPublicationError("project staging directory changed")

        secret_destination, _created = _validate_destination(destination)
        publication_lock = _acquire_publication_lock(destination)
        _remove_publication_tombstone(destination)
        _recover_publication(destination)
        old_generation = _read_generation(destination)
        new_generation = {"docker-compose.yml": staged_compose}
        new_generation.update(
            {
                f"secrets/{name}": staged_secrets[name]
                for name in sorted(_PUBLISHED_SECRET_NAMES)
            }
        )
        journal = _prepare_publication_journal(
            destination, old_generation, new_generation
        )
        try:
            for relative in _generation_paths():
                _replace_visible(
                    destination / relative,
                    new_generation[relative],
                    journal / "scratch",
                )
            if {entry.name for entry in destination.iterdir()} != {
                "docker-compose.yml",
                "secrets",
                _PUBLICATION_JOURNAL,
            }:
                raise ProjectPublicationError("published project layout is invalid")
            if {
                entry.name for entry in secret_destination.iterdir()
            } != _PUBLISHED_SECRET_NAMES:
                raise ProjectPublicationError(
                    "published project secret layout is invalid"
                )
            published = _read_generation(destination)
            if {
                name: _digest(content) for name, content in published.items()
            } != {name: _digest(content) for name, content in new_generation.items()}:
                raise ProjectPublicationError("published project failed verification")
        except (OSError, ProjectPublicationError) as error:
            try:
                _recover_publication(destination)
            except ProjectPublicationError as recovery_error:
                raise ProjectPublicationError(
                    "project publication was interrupted; rerun to recover"
                ) from recovery_error
            raise ProjectPublicationError("project publication was interrupted") from error
        _retire_publication_journal(destination, journal)
    finally:
        if publication_lock >= 0:
            _release_publication_lock(publication_lock)
        if staging_directory >= 0:
            _remove_local_staging(
                staging_parent,
                staging_name,
                staging_directory,
                staging_identity,
                staging_secrets,
            )
        os.close(staging_parent)
    return destination


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source-compose", type=Path, required=True)
    parser.add_argument("--secrets-dir", type=Path, required=True)
    parser.add_argument("--destination", type=Path, required=True)
    parser.add_argument("--nas-address", required=True)
    parser.add_argument("--management-cidrs", required=True)
    parser.add_argument("--direct-fabric-cidrs", required=True)
    parser.add_argument("--enroll-hostname", required=True)
    parser.add_argument("--agent-hostname", required=True)
    parser.add_argument("--registry-hostname", required=True)
    return parser.parse_args()


def main() -> int:
    arguments = _arguments()
    os.umask(0o077)
    try:
        destination = publish_project(
            source_compose=arguments.source_compose,
            secrets_dir=arguments.secrets_dir,
            destination=arguments.destination,
            nas_address=arguments.nas_address,
            management_cidrs=arguments.management_cidrs,
            direct_fabric_cidrs=arguments.direct_fabric_cidrs,
            enroll_hostname=arguments.enroll_hostname,
            agent_hostname=arguments.agent_hostname,
            registry_hostname=arguments.registry_hostname,
        )
        print(destination)
        return 0
    except ProjectPublicationError as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
