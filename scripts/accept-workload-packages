#!/usr/bin/env python3
"""Run the decisive unknown-workload acceptance and write release evidence.

This command deliberately delegates execution to the checked-in hermetic E2E
harness.  It does not manufacture a passing report from fixture metadata: a
non-zero test result, an xfail, or an xpass blocks evidence publication.
Physical GPU node acceptance is a separate operator gate and is never inferred
from this simulated run.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_OUTPUT = ROOT / "inventory/reports/workload-package-acceptance.json"


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _run_acceptance() -> tuple[bool, str, str]:
    if shutil.which("uv"):
        command = [
            "uv",
            "run",
            "--no-managed-python",
            "--python",
            sys.executable,
            "--project",
            "agent",
            "--frozen",
            "pytest",
            "-q",
            "tests/e2e/test_unknown_workload_package.py",
        ]
    else:
        command = [
            sys.executable,
            "-m",
            "pytest",
            "-q",
            "tests/e2e/test_unknown_workload_package.py",
        ]
    completed = subprocess.run(
        command,
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    output = (completed.stdout + completed.stderr).strip()
    # Pytest can return zero for xfail; release evidence must not treat an
    # intentionally skipped production composition as acceptance.
    lowered = output.lower()
    passed = (
        completed.returncode == 0
        and "xfailed" not in lowered
        and "xpassed" not in lowered
    )
    return passed, " ".join(command), output


def build_report(*, mode: str) -> dict[str, object]:
    if mode != "simulated":
        raise ValueError("only --mode simulated is available; physical evidence needs approved hardware")
    passed, command, output = _run_acceptance()
    output_digest = hashlib.sha256(output.encode()).hexdigest()
    report: dict[str, object] = {
        "schema_version": 1,
        "report_type": "vonk-forge-workload-package-acceptance",
        "status": "passed" if passed else "blocked",
        "evidence_kind": "simulated",
        "physical_nodes_exercised": False,
        "unknown_family_without_agent_update": passed,
        "agent_digest_unchanged": passed,
        "release_two_activated": passed,
        "offline_release_one_rollback": passed,
        "unsigned_release_rejected": passed,
        "unapproved_release_rejected": passed,
        "ssh_calls": 0,
        "agent_update_calls": 0,
        "test_command": command,
        "test_output_sha256": output_digest,
    }
    report["digest"] = "sha256:" + hashlib.sha256(_canonical(report)).hexdigest()
    return report


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", choices=("simulated",), required=True)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        report = build_report(mode=args.mode)
    except (OSError, ValueError) as error:
        print(f"accept-workload-packages: {error}", file=sys.stderr)
        return 2
    content = _canonical(report)
    target = args.output if args.output is not None else DEFAULT_OUTPUT
    if not target.is_absolute():
        target = ROOT / target
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(content)
    if args.json or args.output is None:
        sys.stdout.buffer.write(content)
    return 0 if report["status"] == "passed" else 2


if __name__ == "__main__":
    raise SystemExit(main())
