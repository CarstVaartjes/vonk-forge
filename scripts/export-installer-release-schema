#!/usr/bin/env python3
"""Export the complete current installer manifest from its canonical models."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

if __name__ == "__main__":
    from check_environment import run_in_control

    run_in_control(ROOT)
sys.path.insert(0, str(ROOT / "agent_protocol/src"))

from vonk_agent_protocol.installer_release import (
    CliReleaseProjection,
    InstallerReleaseManifest,
)

OUTPUT = ROOT / "schemas/install-release-manifest.schema.json"


def rendered() -> str:
    schema = InstallerReleaseManifest.model_json_schema()
    schema["$schema"] = "https://json-schema.org/draft/2020-12/schema"
    schema["$id"] = "https://vonkforge.ai/schemas/install-release-manifest.schema.json"
    return json.dumps(schema, sort_keys=True, indent=2) + "\n"


CLI_OUTPUT = ROOT / "src/cluster_profiles/schemas/cli-release-projection.schema.json"


def rendered_cli_projection() -> str:
    schema = CliReleaseProjection.model_json_schema()
    schema["$schema"] = "https://json-schema.org/draft/2020-12/schema"
    return json.dumps(schema, sort_keys=True, indent=2) + "\n"


def main() -> None:
    argparse.ArgumentParser(description=__doc__).parse_args()
    OUTPUT.write_text(rendered())
    CLI_OUTPUT.write_text(rendered_cli_projection())


if __name__ == "__main__":
    main()
