#!/usr/bin/env python3
"""Run native-v1 DS4 or Mia development qualification through one evidence path."""

from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
QUALIFIER = ROOT / "scripts/qualify-development-model"
NATIVE_INPUTS = {
    "model-single": {
        "recipe": "config/recipes/deepseek-v4-flash-0731-ds4-single.json",
        "context": "adapters/deepseek/ds4",
    },
    "model-multinode": {
        "recipe": "config/recipes/deepseek-v4-flash-0731-mia-dual.json",
        "context": "adapters/deepseek/mia-vllm",
    },
}


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--print-native-inputs", action="store_true")
    parser.add_argument("--phase", choices=tuple(NATIVE_INPUTS))
    parser.add_argument("--level", choices=("structural", "container"), default="container")
    parser.add_argument("--engine", default="docker")
    parser.add_argument("--endpoint-host", default="127.0.0.1")
    parser.add_argument("--artifact-root", type=Path, default=Path("/var/lib/vonk/models"))
    parser.add_argument("--timeout-seconds", type=float, default=300.0)
    parser.add_argument("--evidence-file", type=Path)
    args = parser.parse_args()
    if args.print_native_inputs:
        if any((args.phase, args.evidence_file)):
            parser.error("--print-native-inputs cannot be combined with a run")
        return args
    if args.phase is None or args.evidence_file is None:
        parser.error("--phase and --evidence-file are required")
    return args


def main() -> int:
    args = _arguments()
    if args.print_native_inputs:
        print(json.dumps(NATIVE_INPUTS, sort_keys=True, separators=(",", ":")))
        return 0
    selected = NATIVE_INPUTS[args.phase]
    result = subprocess.run(
        [
            str(QUALIFIER),
            "--recipe",
            str(ROOT / selected["recipe"]),
            "--level",
            args.level,
            "--engine",
            args.engine,
            "--endpoint-host",
            args.endpoint_host,
            "--artifact-root",
            str(args.artifact_root),
            "--timeout-seconds",
            str(args.timeout_seconds),
            "--output",
            str(args.evidence_file),
        ],
        cwd=ROOT,
        check=False,
    )
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
