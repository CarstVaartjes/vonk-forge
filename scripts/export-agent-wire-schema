#!/usr/bin/env python3
"""Export the current Pydantic wire graph without a second field registry."""

from __future__ import annotations

import argparse
import importlib
import json
import pkgutil
import sys
from pathlib import Path
from typing import get_args

ROOT = Path(__file__).resolve().parents[1]

if __name__ == "__main__":
    from check_environment import run_in_control

    run_in_control(ROOT)
sys.path[:0] = [str(ROOT / "agent_protocol/src"), str(ROOT / "control/src")]

import vonk_agent_protocol
from pydantic import BaseModel, TypeAdapter
from pydantic.json_schema import models_json_schema


def export_schema() -> dict[str, object]:
    models: set[type[BaseModel]] = set()
    for entry in pkgutil.iter_modules(vonk_agent_protocol.__path__):
        module = importlib.import_module(f"vonk_agent_protocol.{entry.name}")
        for value in vars(module).values():
            if (
                isinstance(value, type)
                and issubclass(value, BaseModel)
                and value.__module__ == module.__name__
                and not value.__name__.startswith("_")
            ):
                models.add(value)
    # A fieldless model is a wire message (an empty success) unless it is a
    # shared base class of other models.
    models = {
        model
        for model in models
        if model.model_fields
        or not any(other is not model and issubclass(other, model) for other in models)
    }

    from vonk_control.contract_graph import discover_contracts, schema_application

    # The browser-auth application adds routes to the plain one, so its
    # contracts are the complete set.
    _operations, api_models = discover_contracts(schema_application(browser_auth=True))
    models.update(api_models)
    ordered = sorted(models, key=lambda model: (model.__module__, model.__name__))
    if len({model.__name__ for model in ordered}) != len(ordered):
        raise ValueError("Wire model names collide across canonical modules")
    references, schema = models_json_schema(
        [(model, "validation") for model in ordered],
        title="Vonk Agent Wire",
    )
    from vonk_agent_protocol.lifecycle_vocabulary import RETIRED_RESULT_STATE_SPELLINGS

    schema["$defs"]["AgentResultState"]["x-vonk-read-aliases"] = {
        old: current.value for old, current in RETIRED_RESULT_STATE_SPELLINGS.items()
    }
    # Discriminator constructors also consume the canonical operation vocabulary.
    # Export its enum directly rather than spelling discriminator words in Rust.
    from vonk_agent_protocol.host_helper import HostOperationKind

    schema["$defs"]["HostOperationKind"] = TypeAdapter(HostOperationKind).json_schema()
    # A validation format on a string does not authorize normalizing its bytes
    # into a timestamp type: these values may be inside digest-bound payloads.
    for model in ordered:
        definition = schema["$defs"][
            references[model, "validation"]["$ref"].rsplit("/", 1)[-1]
        ]
        if model.model_config.get("extra") == "ignore":
            # A retained record must stay readable after an upgrade that adds or
            # drops a field: the generated reader discards unknown keys for it.
            definition["x-vonk-ignore-unknown"] = True
        for name, field in model.model_fields.items():
            property_schema = definition.get("properties", {}).get(name, {})
            if field.default_factory is list:
                property_schema["default"] = []
            elif field.default_factory is not None:
                raise ValueError(
                    f"Unsupported dynamic wire default: {model.__name__}.{name}"
                )
            if (
                field.annotation is str or str in get_args(field.annotation)
            ) and property_schema.get("format") == "date-time":
                property_schema["x-vonk-source-type"] = "string"
    schema["$schema"] = "https://json-schema.org/draft/2020-12/schema"
    schema["x-vonk-models"] = {
        model.__name__: references[model, "validation"]["$ref"] for model in ordered
    }
    schema["x-vonk-model-sources"] = {
        model.__name__: f"{model.__module__}.{model.__name__}" for model in ordered
    }
    schema["x-vonk-model-bases"] = {
        model.__name__: [base.__name__ for base in model.__mro__[1:] if base in models]
        for model in ordered
        if any(base in models for base in model.__mro__[1:])
    }
    return schema


def rendered() -> str:
    return json.dumps(export_schema(), indent=2, sort_keys=True) + "\n"


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(rendered())


if __name__ == "__main__":
    main()
