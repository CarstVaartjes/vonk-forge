#!/usr/bin/env bash
# Measure Controller-to-Spark object transfer from a Spark, layer by layer.
#
#   sudo scripts/measure-transfer PLAN_DIGEST OBJECT_SHA256 [IPERF_HOST]
#
# PLAN_DIGEST and OBJECT_SHA256 name an object of at least 2 GiB in an
# assignment this Spark holds (the agent log shows both during a transfer).
# IPERF_HOST is the NAS address running `iperf3 -s`, for the raw network
# ceiling. Reads the agent's own configuration and identity; the object's
# bytes go to /dev/null.
set -euo pipefail

if (($# < 2 || $# > 3)); then
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 64
fi
plan=$1
object=$2
iperf_host=${3:-}
config=${VONK_AGENT_CONFIG:-/etc/vonk-forge-agent/agent.toml}
range=$((64 * 1024 * 1024))

toml_value() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$config" | head -n 1; }
controller=$(toml_value controller_url)
ca=$(toml_value ca_path)
data_dir=$(toml_value data_dir)
[[ -n $controller && -n $ca && -n $data_dir ]] || { echo "cannot read $config" >&2; exit 1; }

credentials=$data_dir/credentials
if [[ -f $credentials/active.json ]]; then
    generation=$(sed -n 's/.*"generation"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$credentials/active.json")
    credentials=$(printf '%s/generation-%020d' "$credentials" "$generation")
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
umask 077
cat "$credentials/certificate.pem" "$credentials/chain.pem" >"$work/certificate.pem"
url="${controller%/}/agent/distribution/objects/$object?plan_digest=$plan"

fetch() { # protocol-flag start end -> "MB/s seconds-to-first-byte"
    curl -sS "$1" --cacert "$ca" --cert "$work/certificate.pem" --key "$credentials/private-key.pem" \
        -H "Range: bytes=$2-$3" -H "If-Range: \"sha256:$object\"" -o /dev/null \
        -w '%{http_code} %{speed_download} %{time_starttransfer}\n' "$url"
}

sequential() { # protocol-flag [first range index]: eight ranges in a row, like one agent stream
    local start=$((${2:-0} * range)) rate total=0 first ok=0
    for _ in 1 2 3 4 5 6 7 8; do
        read -r code rate first < <(fetch "$1" "$start" $((start + range - 1)))
        [[ $code == 206 ]] || { echo "  HTTP $code (need 206: is the object/plan right?)"; return 1; }
        total=$(awk -v t="$total" -v r="$rate" 'BEGIN { printf "%.0f", t + r }')
        ok=$((ok + 1))
        start=$((start + range))
    done
    awk -v t="$total" -v n="$ok" -v f="$first" 'BEGIN { printf "  %.0f MB/s per stream, last time to first byte %.3f s\n", t / n / 1e6, f }'
}

parallel() { # protocol-flag: four streams at once, like the agent
    local out=$work/parallel
    for stream in 0 1 2 3; do
        (sequential "$1" $((stream * 8)) >"$out.$stream" 2>&1) &
    done
    wait
    cat "$out".*
}

if [[ -n $iperf_host ]] && command -v iperf3 >/dev/null; then
    echo "== network only (iperf3 to $iperf_host): expect about 2350 Mbit/s on 2.5 GbE"
    iperf3 -c "$iperf_host" -t 5 -P 1 | tail -n 3
    iperf3 -c "$iperf_host" -t 5 -P 4 | tail -n 3
elif [[ -n $iperf_host ]]; then
    echo "== iperf3 is not installed here; skipping the network ceiling"
fi

retrans_before=$(nstat -az TcpRetransSegs 2>/dev/null | awk 'NR == 2 { print $2 }' || true)
echo "== Controller object, 8 x 64 MiB ranges, one stream, HTTP/1.1 (what the agent uses)"
sequential --http1.1
echo "== four streams at once, HTTP/1.1"
parallel --http1.1
echo "== one stream, HTTP/2 for comparison"
sequential --http2
retrans_after=$(nstat -az TcpRetransSegs 2>/dev/null | awk 'NR == 2 { print $2 }' || true)
[[ -z $retrans_before || -z $retrans_after ]] || echo "== TCP retransmitted segments during this run: $((retrans_after - retrans_before))"
echo "Compare with the 47 MB/s seen in #861: about 280 MB/s is the 2.5 GbE ceiling."
