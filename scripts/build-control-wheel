#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "--root" ]]; then
    if (($# != 2)); then
        echo "usage: scripts/build-control-wheel [--root REPOSITORY_ROOT]" >&2
        exit 2
    fi
    root="$(cd "$2" && pwd)"
    shift 2
fi
if (($# != 0)); then
    echo "usage: scripts/build-control-wheel [--root REPOSITORY_ROOT]" >&2
    exit 2
fi

wheel_name="$(python3 "$(dirname "${BASH_SOURCE[0]}")/protocol-wheel-name" --root "$root")"
mkdir -p "$root/inventory/wheels"
# The image and the release carry this wheel; nothing compares it with a lock.
(cd "$root" && uv build --project agent_protocol --wheel --out-dir inventory/wheels)
test -f "$root/inventory/wheels/$wheel_name"
