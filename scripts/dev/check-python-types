#!/usr/bin/env -S uv run --project control --no-sync --offline python
"""Type-check Python with pyright under pyproject.toml's [tool.pyright].

No arguments: the configured ``include`` plus the extensionless Python scripts.
pyright globs only ``*.py``; Ruff's file selection (``extend-include``) is the one
owner of which files are Python, so the scripts come from ``ruff --show-files``.
File arguments: only those files (the commit hook passes the staged ones).

There is no baseline: a justified site carries ``# pyright: ignore[rule]`` with
its reason, and reportUnnecessaryTypeIgnoreComment fails an ignore that is stale.
"""

from __future__ import annotations

import os
import subprocess
import sys
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True  # repository tools never leave __pycache__ behind
# The sibling helper, however this file is loaded.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from check_environment import (  # noqa: E402 -- imports follow this entry point's sys.path setup
    pyright_environment,
)

ROOT = Path(__file__).resolve().parents[2]
TYPECHECK_TIMEOUT_SECONDS = 600


def extensionless_scripts() -> list[str]:
    """The Python files Ruff selects that pyright's ``*.py`` globbing misses."""
    shown = subprocess.run(
        [sys.executable, "-m", "ruff", "check", "--show-files", "."],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        text=True,
        check=True,
        timeout=60,
    ).stdout.splitlines()
    return sorted(
        Path(line).relative_to(ROOT).as_posix()
        for line in shown
        if line and not Path(line).suffix
    )


def full_scope() -> list[str]:
    config = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))
    return [*config["tool"]["pyright"]["include"], *extensionless_scripts()]


def main(arguments: list[str]) -> int:
    if (ROOT / "src/cluster_profiles").is_dir() and not (
        ROOT / "src/cluster_profiles/generated_control/__init__.py"
    ).is_file():
        subprocess.run(
            [str(ROOT / "scripts/dev/generate-control-clients"), "--python-only"],
            cwd=ROOT,
            check=True,
            timeout=1200,
        )
    files = arguments or full_scope()
    # pyright is locked in the control dev group and resolves imports from this
    # same interpreter; its version check is the only network access it would
    # otherwise attempt.
    try:
        completed = subprocess.run(
            [
                sys.executable,
                "-m",
                "pyright",
                "--pythonpath",
                sys.executable,
                *[str((ROOT / file).resolve()) for file in files],
            ],
            cwd=ROOT,
            env={
                **pyright_environment(),
                "PYRIGHT_PYTHON_IGNORE_WARNINGS": "1",
                # The whole scope exceeds Node's default ~2 GB heap.
                "NODE_OPTIONS": " ".join(
                    filter(
                        None,
                        (os.environ.get("NODE_OPTIONS"), "--max-old-space-size=6144"),
                    )
                ),
            },
            check=False,
            timeout=TYPECHECK_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        raise SystemExit(
            f"pyright exceeded its {TYPECHECK_TIMEOUT_SECONDS}-second execution timeout; "
            "type-check diagnostics are unavailable"
        ) from None
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
