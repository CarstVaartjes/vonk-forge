#!/usr/bin/env bash
# Run the local development graph from already-built images.  The public NAS
# artifact is rendered elsewhere; this wrapper never builds images or provides
# a local repository-origin override.
set -euo pipefail
umask 077

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
template="$repository_root/deploy/compose/compose.dev.images.yaml"
secrets_helper="$repository_root/scripts/dev-compose-secrets.py"
api_image='vonk-forge-api:dev-local'
worker_image='vonk-forge-worker:dev-local'
workspace=
overlay=

if [[ "$#" -eq 0 ]]; then
  set -- up -d --wait --pull never
elif [[ "$1" == up ]]; then
  has_wait=false
  has_pull=false
  for argument in "$@"; do
    [[ "$argument" == --wait ]] && has_wait=true
    [[ "$argument" == --pull || "$argument" == --pull=* ]] && has_pull=true
  done
  [[ "$has_wait" == true ]] || set -- "$@" --wait
  [[ "$has_pull" == true ]] || set -- "$@" --pull never
fi

if [[ -n ${VONK_DEV_SECRETS_DIR:-} ]]; then
  secrets_dir=$(python3 "$secrets_helper" \
    --repository-root "$repository_root" \
    --external-secrets-dir "$VONK_DEV_SECRETS_DIR")
else
  secrets_dir=$(python3 "$secrets_helper" --repository-root "$repository_root")
fi

expected_commit=$(git -C "$repository_root" rev-parse --verify 'refs/heads/main^{commit}')
[[ "$expected_commit" =~ ^[0-9a-f]{40}$ ]] || {
  printf '%s\n' 'local main must resolve to a full commit' >&2
  exit 2
}

workspace=$(mktemp -d /tmp/vonk-forge-dev-compose.XXXXXXXXXX)
cleanup() {
  status=$?
  trap - EXIT
  if [[ "$workspace" =~ ^/tmp/vonk-forge-dev-compose\.[A-Za-z0-9]{10}$ \
    && -d "$workspace" && ! -L "$workspace" ]]; then
    rm -rf -- "$workspace"
  fi
  exit "$status"
}
trap cleanup EXIT

[[ -f "$template" && ! -L "$template" ]] || {
  printf '%s\n' 'development image template is unavailable' >&2
  exit 2
}
[[ $(grep -o '__VONK_API_IMAGE__' "$template" | wc -l) -eq 1 ]] || exit 2
[[ $(grep -o '__VONK_WORKER_IMAGE__' "$template" | wc -l) -eq 1 ]] || exit 2
[[ $(grep -o '__VONK_EXPECTED_COMMIT__' "$template" | wc -l) -eq 1 ]] || exit 2
sed \
  -e "s|__VONK_API_IMAGE__|$api_image|" \
  -e "s|__VONK_WORKER_IMAGE__|$worker_image|" \
  -e "s|__VONK_EXPECTED_COMMIT__|$expected_commit|" \
  "$template" > "$workspace/docker-compose.yml"
ln -s "$secrets_dir" "$workspace/secrets"

if [[ "$1" == down ]]; then
  api_id="sha256:$(printf '%064d' 0)"
  worker_id="sha256:$(printf '%064d' 1)"
else
  api_id=$(docker image inspect --format '{{.Id}}' "$api_image")
  worker_id=$(docker image inspect --format '{{.Id}}' "$worker_image")
fi
[[ "$api_id" =~ ^sha256:[0-9a-f]{64}$ && "$worker_id" =~ ^sha256:[0-9a-f]{64}$ ]] || {
  printf '%s\n' 'local development images did not provide immutable IDs' >&2
  exit 2
}
overlay="$workspace/docker-compose.local.yaml"
cat > "$overlay" <<EOF
services:
  dev-init:
    environment:
      VONK_DEV_API_IMAGE: vonk-forge-api@$api_id
      VONK_DEV_WORKER_IMAGE: vonk-forge-worker@$worker_id
  control-api:
    environment:
      VONK_CONTROL_PROCESS_IMAGE: vonk-forge-api@$api_id
  control-worker:
    environment:
      VONK_CONTROL_PROCESS_IMAGE: vonk-forge-worker@$worker_id
EOF

docker compose \
  --project-name vonk-forge-dev \
  --project-directory "$workspace" \
  --file "$workspace/docker-compose.yml" \
  --file "$overlay" \
  "$@"
