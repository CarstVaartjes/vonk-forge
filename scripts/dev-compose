#!/usr/bin/env bash
set -euo pipefail
umask 077
unset VONK_DEV_ORIGIN_DIR

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
development_root="$repository_root/.dev"
current_uid=$(id -u)

if [[ -L "$development_root" ]]; then
  echo "development directory must not be a symlink" >&2
  exit 1
fi
if [[ ! -e "$development_root" ]]; then
  mkdir -m 700 "$development_root"
fi
if [[ ! -d "$development_root" ]] \
  || [[ $(stat -c %u "$development_root") != "$current_uid" ]] \
  || [[ $(stat -c %a "$development_root") != 700 ]]; then
  echo "development wrapper ownership or mode is unsafe" >&2
  exit 1
fi
if [[ "$#" -eq 0 ]]; then
  set -- up -d --build --wait
fi
case "$1" in
  up)
    wait_requested=false
    for argument in "$@"; do
      if [[ "$argument" == dev-init || "$argument" == migrate ]]; then
        echo "unsupported one-shot development Compose target: $argument" >&2
        exit 1
      fi
      if [[ "$argument" == --no-start || "$argument" == --no-start=* ]]; then
        echo "unsupported development Compose lifecycle: up --no-start" >&2
        exit 1
      fi
      if [[ "$argument" == --wait ]]; then
        wait_requested=true
      fi
    done
    if [[ "$wait_requested" == false ]]; then
      set -- "$@" --wait
    fi
    ;;
  create|start|run|restart|scale|watch)
    echo "unsupported development Compose lifecycle: $1" >&2
    exit 1
    ;;
  -*)
    echo "unsupported development Compose wrapper option: $1" >&2
    exit 1
    ;;
esac
secrets_dir=${VONK_DEV_SECRETS_DIR:-"$repository_root/.dev/vonk-forge-secrets"}
mkdir -p "$secrets_dir"
secrets_dir=$(cd "$secrets_dir" && pwd)
chmod 700 "$secrets_dir"

if [[ ! -e "$secrets_dir/postgres-password" ]]; then
  openssl rand -hex 24 > "$secrets_dir/postgres-password"
  chmod 600 "$secrets_dir/postgres-password"
fi
if [[ ! -e "$secrets_dir/database-url" ]]; then
  password=$(<"$secrets_dir/postgres-password")
  printf 'postgresql+psycopg://control:%s@postgres:5432/control\n' "$password" \
    > "$secrets_dir/database-url"
  chmod 600 "$secrets_dir/database-url"
fi
if [[ ! -e "$secrets_dir/git-signing-key" ]]; then
  ssh-keygen -q -t ed25519 -N '' -C vonk-forge-dev \
    -f "$secrets_dir/git-signing-key"
  chmod 600 "$secrets_dir/git-signing-key"
fi

expected_commit=$(git -C "$repository_root" rev-parse --verify 'HEAD^{commit}')
origin_dir=
cleanup_origin() {
  status=$?
  trap - EXIT
  if [[ "$origin_dir" =~ ^/tmp/vonk-forge-dev-origin\.[A-Za-z0-9]{10}$ ]]; then
    rm -rf -- "$origin_dir" || true
  fi
  exit "$status"
}
trap cleanup_origin EXIT

origin_dir=$(mktemp -d /tmp/vonk-forge-dev-origin.XXXXXXXXXX)
git init --bare -q "$origin_dir"
git --git-dir="$origin_dir" fetch -q --no-tags "$repository_root" "$expected_commit"
git --git-dir="$origin_dir" update-ref refs/heads/main "$expected_commit"
git --git-dir="$origin_dir" symbolic-ref HEAD refs/heads/main
chmod -R a+rX "$origin_dir"

export VONK_DEV_SECRETS_DIR="$secrets_dir"
export VONK_DEV_EXPECTED_COMMIT="$expected_commit"
export VONK_DEV_ORIGIN_DIR="$origin_dir"
docker compose \
  --project-name vonk-forge-dev \
  --file "$repository_root/deploy/compose/compose.dev.yaml" \
  "$@"
