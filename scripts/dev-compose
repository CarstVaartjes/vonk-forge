#!/usr/bin/env bash
# Run the production-shaped deployment with the selected published development
# application images. Development and production are mutually exclusive
# release channels; all other Compose inputs come from the same site config.
set -euo pipefail

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
compose_file="$repository_root/deploy/compose/compose.yaml"
api_image=${VONK_DEV_API_IMAGE:?set VONK_DEV_API_IMAGE to an immutable published GHCR API image}
worker_image=${VONK_DEV_WORKER_IMAGE:?set VONK_DEV_WORKER_IMAGE to an immutable published GHCR worker image}

for image in "$api_image" "$worker_image"; do
  [[ "$image" =~ ^ghcr\.io/carstvaartjes/vonk-forge-(api|worker):dev-sha-[0-9a-f]{40}@sha256:[0-9a-f]{64}$ ]] || {
    printf '%s\n' 'development images must be immutable dev-sha GHCR references' >&2
    exit 2
  }
done
[[ "$api_image" == ghcr.io/carstvaartjes/vonk-forge-api:* ]] || exit 2
[[ "$worker_image" == ghcr.io/carstvaartjes/vonk-forge-worker:* ]] || exit 2

if [[ "$#" -eq 0 ]]; then
  set -- up -d --wait --pull always
elif [[ "$1" == up ]]; then
  has_wait=false
  has_pull=false
  for argument in "$@"; do
    [[ "$argument" == --wait ]] && has_wait=true
    [[ "$argument" == --pull || "$argument" == --pull=* ]] && has_pull=true
  done
  [[ "$has_wait" == true ]] || set -- "$@" --wait
  [[ "$has_pull" == true ]] || set -- "$@" --pull always
fi

compose=(docker compose --project-directory "$repository_root" --file "$compose_file")
env_file=${VONK_DEPLOYMENT_ENV_FILE:-$repository_root/.env}
if [[ -f "$env_file" ]]; then
  compose+=(--env-file "$env_file")
fi
exec env "CONTROL_API_IMAGE=$api_image" "CONTROL_WORKER_IMAGE=$worker_image" \
  "${compose[@]}" "$@"
