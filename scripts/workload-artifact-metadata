#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path, PurePosixPath
from typing import Any

REQUEST_FIELDS = frozenset(
    {
        "architecture",
        "attestations",
        "base_images",
        "context",
        "context_digest",
        "dockerfile",
        "kind",
        "output_repository",
        "schema_version",
        "source_commit",
        "target",
    }
)
RESULT_FIELDS = frozenset(
    {
        "build_request_digest",
        "kind",
        "oci_manifest_digest",
        "provenance_digest",
        "sbom_digest",
        "schema_version",
        "source_commit",
    }
)
ATTESTATION_FIELDS = frozenset({"provenance", "sbom"})
REVIEWED_SOURCE_ROOTS = frozenset({"adapters"})
ARCHITECTURES = frozenset({"linux/amd64", "linux/arm64"})
COMMIT = re.compile(r"^[0-9a-f]{40}$")
DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")
TARGET = re.compile(r"^[a-z][a-z0-9_.-]{0,127}$")
SOURCE_PATH = re.compile(
    r"^adapters/(?!(?:\.{1,2})(?:/|$))[A-Za-z0-9_.-]+"
    r"(?:/(?!(?:\.{1,2})(?:/|$))[A-Za-z0-9_.-]+)*$"
)
OUTPUT_REPOSITORY = re.compile(
    r"^ghcr\.io/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*"
    r"(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*){1,7}$"
)
# A base image is identified by repository and version tag; a digest is not
# part of the identity. The tag must be present and must not be a floating
# channel name.
# A base image is pinned either by digest or by an explicit version tag.
# A bare or floating reference is refused.
VERSIONED_IMAGE = re.compile(
    r"^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*"
    r"(?:@sha256:[0-9a-f]{64}|:(?!(?:latest|main|edge|stable|master|dev)$)[a-z0-9][a-z0-9._-]*)$"
)
MAX_DOCUMENT_BYTES = 64 * 1024


def _canonical(document: object) -> bytes:
    return (
        json.dumps(document, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        + "\n"
    ).encode()


def _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    document: dict[str, object] = {}
    for key, value in pairs:
        if key in document:
            raise ValueError(f"duplicate JSON field: {key}")
        document[key] = value
    return document


def _exact_mapping(
    document: object, expected: frozenset[str], *, label: str
) -> Mapping[str, Any]:
    if not isinstance(document, Mapping) or set(document) != expected:
        raise ValueError(f"{label} must contain exact fields")
    if not all(isinstance(key, str) for key in document):
        raise ValueError(f"{label} must contain exact fields")
    return document


def _exact_string(value: object, pattern: re.Pattern[str], *, label: str) -> str:
    if not isinstance(value, str) or pattern.fullmatch(value) is None:
        raise ValueError(f"{label} is invalid")
    return value


def _safe_source_path(value: object, *, label: str) -> PurePosixPath:
    if (
        not isinstance(value, str)
        or not value
        or len(value) > 512
        or SOURCE_PATH.fullmatch(value) is None
    ):
        raise ValueError(f"{label} path is invalid")
    path = PurePosixPath(value)
    if (
        path.is_absolute()
        or str(path) != value
        or any(part in {"", ".", ".."} for part in path.parts)
    ):
        raise ValueError(f"{label} path is invalid")
    if path.parts[0] not in REVIEWED_SOURCE_ROOTS or len(path.parts) < 2:
        raise ValueError(f"{label} is outside a reviewed source root")
    return path


@dataclass(frozen=True)
class WorkloadArtifactBuild:
    source_commit: str
    context_digest: str
    context: str
    dockerfile: str
    target: str
    architecture: str
    output_repository: str
    base_images: tuple[str, ...]

    @classmethod
    def parse(cls, document: object) -> WorkloadArtifactBuild:
        data = _exact_mapping(document, REQUEST_FIELDS, label="build request")
        if data["schema_version"] != 1 or isinstance(data["schema_version"], bool):
            raise ValueError("build request schema version is invalid")
        if data["kind"] != "workload-artifact-build-request":
            raise ValueError("build request kind is invalid")

        attestations = _exact_mapping(
            data["attestations"], ATTESTATION_FIELDS, label="attestations"
        )
        if (
            attestations["provenance"] is not True
            or attestations["sbom"] is not True
        ):
            raise ValueError("attestations must require SBOM and provenance")

        context = _safe_source_path(data["context"], label="context")
        dockerfile = _safe_source_path(data["dockerfile"], label="dockerfile")
        if dockerfile.parts[: len(context.parts)] != context.parts:
            raise ValueError("dockerfile must be below the build context")

        base_images_value = data["base_images"]
        if (
            not isinstance(base_images_value, list)
            or not 1 <= len(base_images_value) <= 16
        ):
            raise ValueError("base images must be a bounded non-empty list")
        base_images: list[str] = []
        for value in base_images_value:
            if (
                not isinstance(value, str)
                or len(value) > 512
                or VERSIONED_IMAGE.fullmatch(value) is None
            ):
                raise ValueError("base image must be a canonical versioned reference")
            base_images.append(value)
        if len(set(base_images)) != len(base_images):
            raise ValueError("base images must be unique")

        architecture = data["architecture"]
        if not isinstance(architecture, str) or architecture not in ARCHITECTURES:
            raise ValueError("architecture is invalid")
        output_repository = data["output_repository"]
        if not isinstance(output_repository, str) or len(output_repository) > 256:
            raise ValueError("output repository is invalid")
        return cls(
            source_commit=_exact_string(
                data["source_commit"], COMMIT, label="source commit"
            ),
            context_digest=_exact_string(
                data["context_digest"], DIGEST, label="context digest"
            ),
            context=str(context),
            dockerfile=str(dockerfile),
            target=_exact_string(data["target"], TARGET, label="target"),
            architecture=architecture,
            output_repository=_exact_string(
                output_repository,
                OUTPUT_REPOSITORY,
                label="output repository",
            ),
            base_images=tuple(base_images),
        )

    def to_document(self) -> dict[str, object]:
        return {
            "architecture": self.architecture,
            "attestations": {"provenance": True, "sbom": True},
            "base_images": list(self.base_images),
            "context": self.context,
            "context_digest": self.context_digest,
            "dockerfile": self.dockerfile,
            "kind": "workload-artifact-build-request",
            "output_repository": self.output_repository,
            "schema_version": 1,
            "source_commit": self.source_commit,
            "target": self.target,
        }

    @property
    def digest(self) -> str:
        return "sha256:" + hashlib.sha256(_canonical(self.to_document())).hexdigest()


@dataclass(frozen=True)
class WorkloadArtifactResult:
    build_request_digest: str
    source_commit: str
    oci_manifest_digest: str
    sbom_digest: str
    provenance_digest: str

    @classmethod
    def parse(
        cls, document: object, *, request: WorkloadArtifactBuild | None = None
    ) -> WorkloadArtifactResult:
        data = _exact_mapping(document, RESULT_FIELDS, label="build result")
        if data["schema_version"] != 1 or isinstance(data["schema_version"], bool):
            raise ValueError("build result schema version is invalid")
        if data["kind"] != "workload-artifact-build-result":
            raise ValueError("build result kind is invalid")
        result = cls(
            build_request_digest=_exact_string(
                data["build_request_digest"], DIGEST, label="request digest"
            ),
            source_commit=_exact_string(
                data["source_commit"], COMMIT, label="source commit"
            ),
            oci_manifest_digest=_exact_string(
                data["oci_manifest_digest"], DIGEST, label="OCI manifest digest"
            ),
            sbom_digest=_exact_string(data["sbom_digest"], DIGEST, label="SBOM digest"),
            provenance_digest=_exact_string(
                data["provenance_digest"], DIGEST, label="provenance digest"
            ),
        )
        if request is not None:
            if result.build_request_digest != request.digest:
                raise ValueError("build result request digest does not bind the request")
            if result.source_commit != request.source_commit:
                raise ValueError("build result source commit does not bind the request")
        return result

    def to_document(self) -> dict[str, object]:
        return {
            "build_request_digest": self.build_request_digest,
            "kind": "workload-artifact-build-result",
            "oci_manifest_digest": self.oci_manifest_digest,
            "provenance_digest": self.provenance_digest,
            "sbom_digest": self.sbom_digest,
            "schema_version": 1,
            "source_commit": self.source_commit,
        }


def _load_document(path: Path) -> object:
    if not path.is_file() or path.is_symlink() or path.stat().st_size > MAX_DOCUMENT_BYTES:
        raise ValueError("metadata input must be a bounded regular file")
    try:
        return json.loads(path.read_bytes(), object_pairs_hook=_unique_object)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("metadata input must be valid JSON") from exc


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Validate workload artifact metadata")
    subparsers = parser.add_subparsers(dest="command", required=True)
    request = subparsers.add_parser("request")
    request.add_argument("document", type=Path)
    result = subparsers.add_parser("result")
    result.add_argument("document", type=Path)
    result.add_argument("--request", required=True, type=Path)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    arguments = _parser().parse_args(argv)
    try:
        if arguments.command == "request":
            request = WorkloadArtifactBuild.parse(_load_document(arguments.document))
            output: object = {
                "build_request_digest": request.digest,
                "request": request.to_document(),
            }
        else:
            request = WorkloadArtifactBuild.parse(_load_document(arguments.request))
            result = WorkloadArtifactResult.parse(
                _load_document(arguments.document), request=request
            )
            output = result.to_document()
    except ValueError as exc:
        print(f"workload artifact metadata is invalid: {exc}", file=sys.stderr)
        return 2
    sys.stdout.buffer.write(_canonical(output))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
