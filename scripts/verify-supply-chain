#!/usr/bin/env python3
"""Generate or offline-verify dependency SBOM and image-lock evidence."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import re
import shlex
import subprocess
import sys
import tempfile
import tomllib
import types
from dataclasses import dataclass
from pathlib import Path

IMAGE = re.compile(r"^[^\s@]+(?::[^\s@]+)?@sha256:[0-9a-f]{64}$")
PROTOCOL_WHEEL = "inventory/wheels/vonk_agent_protocol-2.1.0-py3-none-any.whl"
UV_LOCK_PACKAGE = re.compile(r"(?m)^\[\[package\]\]\n")
UV_LOCK_SCALAR = re.compile(r'(?m)^(name|version) = "([^"\\\r\n]+)"$')


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def control_deployment_bundle(root: Path) -> bytes:
    path = root / "src/cluster_profiles/deployment_bundle.py"
    spec = importlib.util.spec_from_file_location(
        "cluster_profiles.deployment_bundle",
        path,
    )
    if spec is None or spec.loader is None:
        raise ValueError("deployment bundle module cannot be loaded")
    package = types.ModuleType("cluster_profiles")
    package.__path__ = [str(root / "src/cluster_profiles")]
    platform_release = types.ModuleType("cluster_profiles.platform_release")

    @dataclass(frozen=True)
    class OciDeploymentBundle:
        reference: str
        manifest_digest: str
        manifest_size: int
        manifest_media_type: str
        layer_digest: str
        layer_size: int
        layer_media_type: str

    platform_release.OciDeploymentBundle = OciDeploymentBundle
    module = importlib.util.module_from_spec(spec)
    previous = {
        name: sys.modules.get(name)
        for name in (
            "cluster_profiles",
            "cluster_profiles.platform_release",
            spec.name,
        )
    }
    sys.modules["cluster_profiles"] = package
    sys.modules["cluster_profiles.platform_release"] = platform_release
    sys.modules[spec.name] = module
    try:
        spec.loader.exec_module(module)
        builder = module.build_deployment_bundle
    finally:
        for name, value in previous.items():
            if value is None:
                sys.modules.pop(name, None)
            else:
                sys.modules[name] = value
    return builder(root / "deploy/compose")


def uv_lock_packages(lock: bytes) -> list[dict[str, str]]:
    """Read uv's canonical package records without parsing the whole lock.

    Python 3.12's recursive ``tomllib`` parser can exhaust the C stack while
    parsing current uv locks containing very large arrays of wheel metadata.
    For supply-chain evidence we only need uv's canonical, top-level package
    name/version fields plus the original record for the protocol-wheel checks.
    Splitting records first is bounded and fail-closed for non-canonical locks.
    """

    text = lock.decode("utf-8")
    records = UV_LOCK_PACKAGE.split(text)[1:]
    if not records:
        raise ValueError("uv lock contains no package records")

    packages: list[dict[str, str]] = []
    for record in records:
        fields = UV_LOCK_SCALAR.findall(record)
        values = {key: value for key, value in fields}
        if len(fields) != 2 or set(values) != {"name", "version"}:
            raise ValueError("uv lock package record is not canonical")
        packages.append({**values, "record": record})
    return packages


def packages_python(lock: bytes) -> list[tuple[str, str]]:
    return sorted({(package["name"], package["version"]) for package in uv_lock_packages(lock)})


def packages_web(lock: bytes) -> list[tuple[str, str]]:
    raw = json.loads(lock)
    packages = set()
    for path, package in raw.get("packages", {}).items():
        if not path or not package.get("version"):
            continue
        name = package.get("name") or path.removeprefix("node_modules/")
        packages.add((name, package["version"]))
    return sorted(packages)


def workload_package_inputs(root: Path) -> tuple[str, ...]:
    """Return generic package implementation files bound by release evidence.

    The verifier is also used by small isolated fixture repositories in the
    test suite, so absent package trees are treated as an older baseline.  A
    complete Vonk Forge checkout always has all three boundaries and therefore
    gets every package implementation file hashed into the supply-chain
    manifest.
    """

    paths: list[str] = []
    roots = (
        root / "agent/src/vonk_agent/packages",
        root / "control/src/vonk_control",
        root / "src/cluster_profiles/workload_packages",
    )
    for directory in roots:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("package_*.py")):
            paths.append(path.relative_to(root).as_posix())
        if directory.name == "packages" or directory.name == "workload_packages":
            for path in sorted(directory.glob("*.py")):
                paths.append(path.relative_to(root).as_posix())
    for relative in (
        "agent/src/vonk_agent/workload_runtime.py",
        "agent/src/vonk_agent/package_operations.py",
        "agent/src/vonk_agent/package_trust.py",
        "agent/src/vonk_agent/package_helper.py",
        "agent/src/vonk_agent/package_helper_protocol.py",
        "agent/src/vonk_agent/package_helper_client.py",
    ):
        path = root / relative
        if path.is_file():
            paths.append(relative)
    protocol = root / "agent_protocol/src/vonk_agent_protocol/workload_packages.py"
    if protocol.is_file():
        paths.append(protocol.relative_to(root).as_posix())
    for acceptance in (
        root / "scripts/accept-workload-packages",
        root / "scripts/accept-workload-package-failures",
    ):
        if acceptance.is_file():
            paths.append(acceptance.relative_to(root).as_posix())
    return tuple(dict.fromkeys(paths))


def protocol_wheel(root: Path) -> bytes:
    """Build the release wheel in a temporary directory and return its bytes."""
    with tempfile.TemporaryDirectory(prefix="vonk-agent-protocol-") as directory:
        output = Path(directory)
        subprocess.run(
            [
                "uv", "build", "--offline", "--project", str(root / "agent_protocol"),
                "--wheel", "--out-dir", str(output),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        wheels = sorted(output.glob("vonk_agent_protocol-*.whl"))
        if len(wheels) != 1:
            raise ValueError("protocol build did not produce exactly one wheel")
        return wheels[0].read_bytes()


def protocol_version(lock: bytes) -> str:
    packages = [
        package for package in uv_lock_packages(lock)
        if package["name"] == "vonk-agent-protocol"
    ]
    expected_source = (
        'source = { path = "../inventory/wheels/'
        'vonk_agent_protocol-2.1.0-py3-none-any.whl" }'
    )
    if len(packages) != 1 or expected_source not in packages[0]["record"].splitlines():
        raise ValueError("control and agent must resolve the verified protocol wheel")
    return packages[0]["version"]


def protocol_wheel_hash(lock: bytes) -> str:
    packages = [
        package for package in uv_lock_packages(lock)
        if package["name"] == "vonk-agent-protocol"
    ]
    if len(packages) != 1:
        raise ValueError("protocol lock must contain the verified wheel")
    wheel_pattern = re.compile(
        r'(?m)^wheels = \[\n    \{ filename = "'
        + re.escape(Path(PROTOCOL_WHEEL).name)
        + r'", hash = "sha256:([0-9a-f]{64})" \},\n\]$',
    )
    wheels = wheel_pattern.findall(packages[0]["record"])
    if len(wheels) != 1:
        raise ValueError("protocol lock wheel hash is invalid")
    return wheels[0]


def spdx(
    name: str,
    lock: bytes,
    packages: list[tuple[str, str]],
    *,
    protocol_wheel_sha256: str | None = None,
) -> bytes:
    lock_digest = digest(lock)
    described = []
    relationships = []
    for package_name, version in packages:
        identity = hashlib.sha256(f"{package_name}\0{version}".encode()).hexdigest()[:16]
        spdx_id = f"SPDXRef-Package-{identity}"
        package = {
            "SPDXID": spdx_id,
            "name": package_name,
            "versionInfo": version,
            "downloadLocation": "NOASSERTION",
            "filesAnalyzed": False,
            "licenseConcluded": "NOASSERTION",
            "licenseDeclared": "NOASSERTION",
            "supplier": "NOASSERTION",
        }
        if package_name == "vonk-agent-protocol" and protocol_wheel_sha256 is not None:
            package["checksums"] = [{"algorithm": "SHA256", "checksumValue": protocol_wheel_sha256}]
        described.append(package)
        relationships.append({"spdxElementId": "SPDXRef-DOCUMENT", "relationshipType": "DESCRIBES", "relatedSpdxElement": spdx_id})
    document = {
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": name,
        "documentNamespace": f"https://vonk-forge.invalid/sbom/{name}/{lock_digest}",
        "creationInfo": {"created": "1970-01-01T00:00:00Z", "creators": ["Tool: Vonk Forge verify-supply-chain"]},
        "packages": described,
        "relationships": relationships,
    }
    if protocol_wheel_sha256 is not None:
        wheel_id = "SPDXRef-File-AgentProtocolWheel"
        document["files"] = [{
            "SPDXID": wheel_id,
            "fileName": PROTOCOL_WHEEL,
            "checksums": [{"algorithm": "SHA256", "checksumValue": protocol_wheel_sha256}],
            "fileTypes": ["BINARY"],
            "licenseConcluded": "NOASSERTION",
            "copyrightText": "NOASSERTION",
        }]
        protocol_id = next(
            package["SPDXID"] for package in described
            if package["name"] == "vonk-agent-protocol"
        )
        relationships.append({
            "spdxElementId": protocol_id,
            "relationshipType": "GENERATED_FROM",
            "relatedSpdxElement": wheel_id,
        })
    return canonical(document)


def expected(root: Path) -> tuple[dict[str, bytes], bytes, dict[str, object]]:
    python_lock = (root / "control/uv.lock").read_bytes()
    agent_lock = (root / "agent/uv.lock").read_bytes()
    protocol_lock = (root / "agent_protocol/uv.lock").read_bytes()
    web_lock = (root / "control/web/package-lock.json").read_bytes()
    protocol_project = tomllib.loads((root / "agent_protocol/pyproject.toml").read_text())
    version = protocol_project["project"]["version"]
    if not isinstance(version, str) or any(
        protocol_version(lock) != version for lock in (python_lock, agent_lock)
    ):
        raise ValueError("control and agent must resolve the exact protocol version")
    wheel = protocol_wheel(root)
    wheel_sha256 = digest(wheel)
    if any(protocol_wheel_hash(lock) != wheel_sha256 for lock in (python_lock, agent_lock)):
        raise ValueError("control and agent lock hashes must match the verified protocol wheel")
    sboms = {
        "inventory/sbom/control-python.spdx.json": spdx("control-python", python_lock, packages_python(python_lock), protocol_wheel_sha256=wheel_sha256),
        "inventory/sbom/agent-python.spdx.json": spdx("agent-python", agent_lock, packages_python(agent_lock), protocol_wheel_sha256=wheel_sha256),
        "inventory/sbom/agent-protocol.spdx.json": spdx("agent-protocol", protocol_lock, packages_python(protocol_lock), protocol_wheel_sha256=wheel_sha256),
        "inventory/sbom/control-web.spdx.json": spdx("control-web", web_lock, packages_web(web_lock)),
    }
    input_paths = (
        "pyproject.toml",
        ".github/workflows/ci.yml",
        ".github/workflows/agent-release.yml",
        ".github/workflows/agent-package-build.yml",
        ".github/workflows/agent-apt-publish.yml",
        ".github/workflows/dev-images.yml",
        ".github/workflows/workload-artifacts.yml",
        ".github/release-allowed-signers",
        ".github/dependabot.yml",
        "schemas/control-deployment-bundle.schema.json",
        "schemas/platform-update-manifest.schema.json",
        "schemas/workload-artifact-build.schema.json",
        "src/cluster_profiles/deployment_bundle.py",
        "src/cluster_profiles/platform_authority_client.py",
        "src/cluster_profiles/platform_publication.py",
        "src/cluster_profiles/platform_release.py",
        "src/cluster_profiles/schemas/control-deployment-bundle.schema.json",
        "src/cluster_profiles/schemas/platform-update-manifest.schema.json",
        "agent/pyproject.toml", "agent/uv.lock", "agent_protocol/pyproject.toml",
        "agent_protocol/uv.lock", "control/pyproject.toml", "control/uv.lock",
        "bin/vonk-control-offline",
        "control/src/vonk_control/offline.py",
        "control/src/vonk_control/dev_init.py",
        "control/src/vonk_control/generation_launch.py",
        "control/src/vonk_control/host_backup.py",
        "control/src/vonk_control/host_commands.py",
        "control/src/vonk_control/host_state.py",
        "control/src/vonk_control/oci_bundle.py",
        "control/src/vonk_control/upgrade.py",
        ".dockerignore", "control/web/package-lock.json", "control/Dockerfile",
        "deploy/compose/compose.yaml", "deploy/compose/images.lock.json",
        "deploy/compose/compose.dev.images.yaml",
        "deploy/compose/Caddyfile", "deploy/compose/caddy/entrypoint.sh",
        "deploy/compose/compose.builtin-ca.yaml",
        "deploy/compose/compose.step-ca.yaml",
        "deploy/compose/grafana/dashboards/fleet.json",
        "deploy/compose/grafana/dashboards/jobs.json",
        "deploy/compose/grafana/provisioning/dashboards/default.yaml",
        "deploy/compose/grafana/provisioning/datasources/prometheus.yaml",
        "deploy/compose/tailscale/compose.yaml",
        "deploy/compose/tailscale/configure.sh",
        "deploy/compose/tailscale/grants.example.hujson",
        "deploy/compose/hermes-agent/compose.yaml",
        "deploy/compose/hermes-agent/Dockerfile",
        "deploy/compose/hermes-agent/entrypoint.sh",
        "deploy/compose/bin/harden-hermes-egress",
        "config/hermes-agent-policy.toml",
        "deploy/compose/litellm/config.yaml",
        "deploy/compose/litellm/bootstrap-config.json",
        "deploy/compose/litellm/config_supervisor.py",
        "deploy/compose/litellm/entrypoint.sh",
        "deploy/compose/prometheus/alerts.yaml",
        "deploy/compose/prometheus/prometheus.yml",
        "deploy/compose/registry/config.yml",
        "deploy/compose/step-ca/ca.json",
        "deploy/compose/trust/litellm-cosign.pub",
        "scripts/build-control-deployment-bundle",
        "scripts/build-host-updater-artifact",
        "scripts/build-platform-manifest",
        "scripts/collect-platform-artifact-evidence",
        "scripts/agent-package-metadata",
        "scripts/agent-apt-metadata",
        "scripts/agent-apt-state",
        "scripts/container-release-metadata",
        "scripts/dev-image-acceptance",
        "scripts/dev-image-metadata",
        "scripts/promote-image-aliases",
        "scripts/render-dev-compose",
        "scripts/render-production-compose",
        "scripts/platform-release-authority",
        "scripts/publish-platform-target",
        "scripts/refuse-existing-image-version",
        "scripts/validate-container-release-digests",
        "scripts/verify-platform-release",
        "scripts/verify-public-image-inputs",
        "scripts/verify-dev-image-secrets",
        "scripts/verify-supply-chain",
        "scripts/workload-artifact-metadata",
        "src/cluster_profiles/update_trust.py",
    )
    input_paths += workload_package_inputs(root)
    deployment_bundle = control_deployment_bundle(root)
    manifest = {
        "schema_version": 2,
        "inputs": {path: digest((root / path).read_bytes()) for path in input_paths},
        "sboms": {path: digest(content) for path, content in sboms.items()},
        "protocol_wheel_sha256": wheel_sha256,
        "image_lock_sha256": digest((root / "deploy/compose/images.lock.json").read_bytes()),
        "signature_key_sha256": digest((root / "deploy/compose/trust/litellm-cosign.pub").read_bytes()),
        "control_deployment_bundle_sha256": digest(deployment_bundle),
    }
    return sboms, wheel, manifest


def image_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        lock = json.loads((root / "deploy/compose/images.lock.json").read_bytes())
    except (OSError, ValueError):
        return ["image lock is unreadable"]
    compose_paths = (
        "deploy/compose/compose.yaml",
        "deploy/compose/tailscale/compose.yaml",
        "deploy/compose/hermes-agent/compose.yaml",
    )
    try:
        compose = "\n".join((root / path).read_text() for path in compose_paths)
    except OSError:
        return ["included Compose image definitions are missing"]
    images = lock.get("images", {})
    if not isinstance(images, dict):
        errors.append("image lock images mapping is invalid")
        images = {}
    build_bases = lock.get("build_bases", {})
    if not isinstance(build_bases, dict):
        errors.append("image lock build_bases mapping is invalid")
        build_bases = {}
    for name, reference in {**images, **build_bases}.items():
        if not isinstance(reference, str):
            errors.append(f"{name} image is not pinned by digest")
            continue
        if IMAGE.fullmatch(reference) is None:
            errors.append(f"{name} image is not pinned by digest")
        if name in images and reference not in compose:
            errors.append(f"{name} Compose default is not the locked digest-pinned image")
    if re.search(r"(?m)^\s*image:\s*[^$\n]*(?::latest|:main|:edge)(?:\s|$)", compose):
        errors.append("Compose contains a floating image tag without digest")
    releases = lock.get("release_images", [])
    expected_releases = [
        {
            "context": ".",
            "dockerfile": "control/Dockerfile",
            "environment": "CONTROL_API_IMAGE",
            "package": "vonk-forge-api",
            "required": True,
            "target": "api",
        },
        {
            "context": ".",
            "dockerfile": "control/Dockerfile",
            "environment": "CONTROL_WORKER_IMAGE",
            "package": "vonk-forge-worker",
            "required": True,
            "target": "worker",
        },
        {
            "context": "deploy/compose/hermes-agent",
            "dockerfile": "deploy/compose/hermes-agent/Dockerfile",
            "environment": "HERMES_AGENT_IMAGE",
            "package": "vonk-forge-hermes",
            "required": True,
            "target": "managed",
        },
    ]
    if releases != expected_releases or any(
        f"${{{release['environment']}:?" not in compose
        for release in expected_releases
    ):
        errors.append(
            "API, worker, and Hermes release images must be explicitly "
            "digest-pinned at deployment"
        )
    for release in expected_releases:
        context = root / release["context"]
        dockerfile_path = root / release["dockerfile"]
        if not context.is_dir() or not dockerfile_path.is_file():
            errors.append(
                f"{release['package']} release build context or Dockerfile is missing"
            )
    dockerfile = (root / "control/Dockerfile").read_text()
    hermes_dockerfile = (root / "deploy/compose/hermes-agent/Dockerfile").read_text()
    for name in ("node", "python"):
        reference = build_bases.get(name)
        if not isinstance(reference, str):
            errors.append(f"{name} digest-pinned build base is missing or invalid")
        elif reference not in dockerfile:
            errors.append(f"{name} digest-pinned build base is absent from control Dockerfile")
    hermes_reference = build_bases.get("hermes")
    if not isinstance(hermes_reference, str):
        errors.append("hermes digest-pinned build base is missing or invalid")
    elif hermes_reference not in hermes_dockerfile:
        errors.append("hermes digest-pinned build base is absent from Hermes Dockerfile")
    if "ARG NODE_IMAGE" not in dockerfile or "ARG PYTHON_IMAGE" not in dockerfile:
        errors.append("control build bases are not explicit locked arguments")
    if "FROM scratch AS worker" not in dockerfile or "FROM scratch AS api" not in dockerfile:
        errors.append("control API and worker image targets are not isolated")
    if (
        "COPY control/pyproject.toml ./" not in dockerfile
        or f"COPY {PROTOCOL_WHEEL} /wheels/" not in dockerfile
        or not docker_installs_protocol_wheel(dockerfile)
    ):
        errors.append("control image does not install the standalone protocol wheel from root context")
    hermes_base = re.search(r"(?m)^ARG HERMES_IMAGE=(\S+)$", hermes_dockerfile)
    locked_hermes = build_bases.get("hermes")
    if (
        hermes_base is None
        or hermes_base.group(1) != locked_hermes
        or IMAGE.fullmatch(hermes_base.group(1)) is None
        or "FROM ${HERMES_IMAGE} AS managed" not in hermes_dockerfile
    ):
        errors.append("Hermes build base is not the exact digest-pinned locked image")
    return errors


def docker_installs_protocol_wheel(dockerfile: str) -> bool:
    """Require the copied protocol wheel in the control pip-install RUN command."""
    logical_lines = re.sub(r"\\\r?\n\s*", " ", dockerfile).splitlines()
    wheel = f"/wheels/{Path(PROTOCOL_WHEEL).name}"
    for line in logical_lines:
        stripped = line.strip()
        if not stripped.startswith("RUN "):
            continue
        lexer = shlex.shlex(
            stripped.removeprefix("RUN "),
            posix=True,
            punctuation_chars=";&|",
        )
        lexer.whitespace_split = True
        tokens = list(lexer)
        for pip_index in range(len(tokens) - 3):
            if tokens[pip_index:pip_index + 4] != ["python", "-m", "pip", "install"]:
                continue
            try:
                command_end = next(
                    index
                    for index in range(pip_index + 4, len(tokens))
                    if set(tokens[index]) <= {";", "&", "|"}
                )
            except StopIteration:
                command_end = len(tokens)
            installed = tokens[pip_index + 4:command_end]
            if wheel in installed and "." in installed:
                return True
    return False


def verify(root: Path, generate: bool) -> tuple[list[str], dict[str, object]]:
    errors = image_errors(root)
    try:
        sboms, wheel, manifest = expected(root)
    except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError, subprocess.CalledProcessError, tomllib.TOMLDecodeError) as error:
        return [*errors, f"could not generate expected supply-chain evidence: {type(error).__name__}: {error}"], {}
    manifest_path = root / "inventory/sbom/manifest.json"
    if generate:
        for path, content in sboms.items():
            target = root / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(content)
        wheel_path = root / PROTOCOL_WHEEL
        wheel_path.parent.mkdir(parents=True, exist_ok=True)
        wheel_path.write_bytes(wheel)
        manifest_path.write_bytes(canonical(manifest))
    else:
        for path, content in sboms.items():
            target = root / path
            if not target.is_file() or target.read_bytes() != content:
                errors.append(f"SBOM is missing or stale: {path}")
        wheel_path = root / PROTOCOL_WHEEL
        if not wheel_path.is_file() or wheel_path.read_bytes() != wheel:
            errors.append("protocol wheel is missing or stale")
        if not manifest_path.is_file() or manifest_path.read_bytes() != canonical(manifest):
            errors.append("supply-chain manifest is missing or stale")
    result = {"ok": not errors, "images": len(json.loads((root / "deploy/compose/images.lock.json").read_bytes()).get("images", {})), "sboms": sorted(sboms), "manifest_sha256": digest(canonical(manifest))}
    return errors, result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--generate", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    errors, result = verify(args.root.resolve(), args.generate)
    result["errors"] = errors
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    else:
        for error in errors:
            print(f"verify-supply-chain: {error}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
