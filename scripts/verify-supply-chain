#!/usr/bin/env python3
"""Generate or offline-verify dependency SBOM and image-lock evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shlex
import sys
import tomllib
from pathlib import Path

# Images are pinned by explicit version tag, not by digest. A tag with a
# version is reviewable and a patch release arrives through a dependency bump;
# a digest is more precise but requires hand-editing a value the tooling owns
# and, against a republished tag, stops resolving. Recipe base images are the
# exception: they stay digest-pinned in vonk-forge-recipes, where the digest
# enters the compiled runtime plan.
# An image reference: a registry path with an optional :tag. The tag must be
# present and must not be a floating channel name. The path excludes `@`, so a
# digest reference fails this check.
VERSIONED_IMAGE = re.compile(r"^[^\s@]+:[^\s@]+$")
FLOATING_TAGS = frozenset({"latest", "main", "edge", "stable", "master", "dev"})
PROTOCOL_WHEEL = "inventory/wheels/vonk_agent_protocol-4.1.0-py3-none-any.whl"
PUBLIC_CONTRACT_LOCK = "control/packaging/public-contracts.lock"
PUBLIC_CONTRACT_WHEEL = (
    "inventory/wheels/vonk_forge_public_contracts-2.2.0-py3-none-any.whl"
)
UV_LOCK_PACKAGE = re.compile(r"(?m)^\[\[package\]\]\n")
UV_LOCK_SCALAR = re.compile(r'(?m)^(name|version) = "([^"\\\r\n]+)"$')


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def uv_lock_packages(lock: bytes) -> list[dict[str, str]]:
    """Read uv's canonical package records without parsing the whole lock.

    Python 3.12's recursive ``tomllib`` parser can exhaust the C stack while
    parsing current uv locks containing very large arrays of wheel metadata.
    For supply-chain evidence we only need uv's canonical, top-level package
    name/version fields plus the original record for the protocol-wheel checks.
    Splitting records first is bounded and fail-closed for non-canonical locks.
    """

    text = lock.decode("utf-8")
    records = UV_LOCK_PACKAGE.split(text)[1:]
    if not records:
        raise ValueError("uv lock contains no package records")

    packages: list[dict[str, str]] = []
    for record in records:
        fields = UV_LOCK_SCALAR.findall(record)
        values = {key: value for key, value in fields}
        if len(fields) != 2 or set(values) != {"name", "version"}:
            raise ValueError("uv lock package record is not canonical")
        packages.append({**values, "record": record})
    return packages


def packages_python(lock: bytes) -> list[tuple[str, str]]:
    return sorted(
        {(package["name"], package["version"]) for package in uv_lock_packages(lock)}
    )


def packages_cargo(lock: bytes) -> list[tuple[str, str]]:
    document = tomllib.loads(lock.decode("utf-8"))
    packages = document.get("package")
    if not isinstance(packages, list) or not packages:
        raise ValueError("Cargo lock contains no package records")
    result: set[tuple[str, str]] = set()
    for package in packages:
        if not isinstance(package, dict):
            raise TypeError("Cargo lock package record is invalid")
        name = package.get("name")
        version = package.get("version")
        if not isinstance(name, str) or not isinstance(version, str):
            raise TypeError("Cargo lock package record is invalid")
        result.add((name, version))
    return sorted(result)


def packages_web(lock: bytes) -> list[tuple[str, str]]:
    raw = json.loads(lock)
    packages = set()
    for path, package in raw.get("packages", {}).items():
        if not path or not package.get("version"):
            continue
        name = package.get("name") or path.removeprefix("node_modules/")
        packages.add((name, package["version"]))
    return sorted(packages)


def verify_public_contract_lock(root: Path, control_lock: bytes) -> None:
    """Verify the pinned third-party contract wheel and its source revision."""

    lock = tomllib.loads((root / PUBLIC_CONTRACT_LOCK).read_text())
    expected = {
        "source": "https://github.com/CarstVaartjes/vonk-forge-recipes.git",
        "branch": "main",
        "subdirectory": "contracts",
        "package": "vonk-forge-public-contracts==2.2.0",
        "wheel": PUBLIC_CONTRACT_WHEEL,
    }
    if any(lock.get(key) != value for key, value in expected.items()):
        raise ValueError("public contract lock does not select the canonical package")
    revision = lock.get("revision")
    wheel_sha256 = lock.get("sha256")
    if not isinstance(revision, str) or re.fullmatch(r"[0-9a-f]{40}", revision) is None:
        raise ValueError("public contract source revision is invalid")
    if (
        not isinstance(wheel_sha256, str)
        or re.fullmatch(r"[0-9a-f]{64}", wheel_sha256) is None
    ):
        raise ValueError("public contract wheel digest is invalid")
    if digest((root / PUBLIC_CONTRACT_WHEEL).read_bytes()) != wheel_sha256:
        raise ValueError("public contract wheel does not match its reviewed lock")
    packages = [
        package
        for package in uv_lock_packages(control_lock)
        if package["name"] == "vonk-forge-public-contracts"
    ]
    source = (
        'source = { git = "https://github.com/CarstVaartjes/'
        f'vonk-forge-recipes.git?subdirectory=contracts&branch=main#{revision}" }}'
    )
    if (
        len(packages) != 1
        or packages[0]["version"] != "2.2.0"
        or source not in packages[0]["record"].splitlines()
    ):
        raise ValueError("control lock does not resolve the reviewed public contract")


def protocol_version(lock: bytes) -> str:
    packages = [
        package
        for package in uv_lock_packages(lock)
        if package["name"] == "vonk-agent-protocol"
    ]
    expected_source = (
        'source = { path = "../inventory/wheels/'
        'vonk_agent_protocol-4.1.0-py3-none-any.whl" }'
    )
    if len(packages) != 1 or expected_source not in packages[0]["record"].splitlines():
        raise ValueError("control and agent must resolve the verified protocol wheel")
    return packages[0]["version"]


def spdx(
    name: str,
    lock: bytes,
    packages: list[tuple[str, str]],
    *,
    protocol_wheel_sha256: str | None = None,
) -> bytes:
    lock_digest = digest(lock)
    described = []
    relationships = []
    for package_name, version in packages:
        identity = hashlib.sha256(f"{package_name}\0{version}".encode()).hexdigest()[
            :16
        ]
        spdx_id = f"SPDXRef-Package-{identity}"
        package = {
            "SPDXID": spdx_id,
            "name": package_name,
            "versionInfo": version,
            "downloadLocation": "NOASSERTION",
            "filesAnalyzed": False,
            "licenseConcluded": "NOASSERTION",
            "licenseDeclared": "NOASSERTION",
            "supplier": "NOASSERTION",
        }
        if package_name == "vonk-agent-protocol" and protocol_wheel_sha256 is not None:
            package["checksums"] = [
                {"algorithm": "SHA256", "checksumValue": protocol_wheel_sha256}
            ]
        described.append(package)
        relationships.append(
            {
                "spdxElementId": "SPDXRef-DOCUMENT",
                "relationshipType": "DESCRIBES",
                "relatedSpdxElement": spdx_id,
            }
        )
    document = {
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": name,
        "documentNamespace": f"https://vonk-forge.invalid/sbom/{name}/{lock_digest}",
        "creationInfo": {
            "created": "1970-01-01T00:00:00Z",
            "creators": ["Tool: Vonk Forge verify-supply-chain"],
        },
        "packages": described,
        "relationships": relationships,
    }
    if protocol_wheel_sha256 is not None:
        wheel_id = "SPDXRef-File-AgentProtocolWheel"
        document["files"] = [
            {
                "SPDXID": wheel_id,
                "fileName": PROTOCOL_WHEEL,
                "checksums": [
                    {"algorithm": "SHA256", "checksumValue": protocol_wheel_sha256}
                ],
                "fileTypes": ["BINARY"],
                "licenseConcluded": "NOASSERTION",
                "copyrightText": "NOASSERTION",
            }
        ]
        protocol_id = next(
            package["SPDXID"]
            for package in described
            if package["name"] == "vonk-agent-protocol"
        )
        relationships.append(
            {
                "spdxElementId": protocol_id,
                "relationshipType": "GENERATED_FROM",
                "relatedSpdxElement": wheel_id,
            }
        )
    return canonical(document)


def expected(root: Path) -> tuple[dict[str, bytes], bytes | None, dict[str, object]]:
    control_lock = (root / "control/uv.lock").read_bytes()
    cargo_lock = (root / "Cargo.lock").read_bytes()
    protocol_lock = (root / "agent_protocol/uv.lock").read_bytes()
    web_lock = (root / "control/web/package-lock.json").read_bytes()
    protocol_project = tomllib.loads(
        (root / "agent_protocol/pyproject.toml").read_text()
    )
    version = protocol_project["project"]["version"]
    if not isinstance(version, str) or protocol_version(control_lock) != version:
        raise ValueError("control must resolve the exact protocol version")
    verify_public_contract_lock(root, control_lock)
    public_contract_lock = tomllib.loads((root / PUBLIC_CONTRACT_LOCK).read_text())
    # The protocol wheel is pinned by version, not by rebuilding it and
    # comparing a content hash: a source edit (even formatting) must not
    # invalidate a lock that the lockfile tool owns.
    expected_wheel = f"vonk_agent_protocol-{version}-py3-none-any.whl"
    if Path(PROTOCOL_WHEEL).name != expected_wheel:
        raise ValueError("protocol wheel filename must match its version")
    wheel_path = root / PROTOCOL_WHEEL
    wheel = wheel_path.read_bytes() if wheel_path.is_file() else None
    wheel_sha256 = digest(wheel) if wheel is not None else None
    sboms = {
        "inventory/sbom/control-python.spdx.json": spdx(
            "control-python",
            control_lock,
            packages_python(control_lock),
            protocol_wheel_sha256=wheel_sha256,
        ),
        "inventory/sbom/agent-rust.spdx.json": spdx(
            "agent-rust", cargo_lock, packages_cargo(cargo_lock)
        ),
        "inventory/sbom/agent-protocol.spdx.json": spdx(
            "agent-protocol",
            protocol_lock,
            packages_python(protocol_lock),
            protocol_wheel_sha256=wheel_sha256,
        ),
        "inventory/sbom/control-web.spdx.json": spdx(
            "control-web", web_lock, packages_web(web_lock)
        ),
    }
    manifest = {
        "schema_version": 2,
        "sboms": {path: digest(content) for path, content in sboms.items()},
        "protocol_wheel_sha256": wheel_sha256,
        "lockfiles": {
            "control/uv.lock": digest(control_lock),
            "agent_protocol/uv.lock": digest(protocol_lock),
            "Cargo.lock": digest(cargo_lock),
            "control/web/package-lock.json": digest(web_lock),
            PUBLIC_CONTRACT_LOCK: digest((root / PUBLIC_CONTRACT_LOCK).read_bytes()),
        },
        "public_contract_wheel_sha256": public_contract_lock["sha256"],
        "image_lock_sha256": digest(
            (root / "deploy/compose/images.lock.json").read_bytes()
        ),
        "signature_key_sha256": digest(
            (root / "deploy/compose/trust/litellm-cosign.pub").read_bytes()
        ),
    }
    return sboms, wheel, manifest


def image_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        lock = json.loads((root / "deploy/compose/images.lock.json").read_bytes())
    except (OSError, ValueError):
        return ["image lock is unreadable"]
    compose_paths = (
        "deploy/compose/compose.yaml",
        "deploy/compose/tailscale/compose.yaml",
        "deploy/compose/hermes-agent/compose.yaml",
    )
    try:
        compose = "\n".join((root / path).read_text() for path in compose_paths)
    except OSError:
        return ["included Compose image definitions are missing"]
    images = lock.get("images", {})
    if not isinstance(images, dict):
        errors.append("image lock images mapping is invalid")
        images = {}
    build_bases = lock.get("build_bases", {})
    if not isinstance(build_bases, dict):
        errors.append("image lock build_bases mapping is invalid")
        build_bases = {}
    for name, reference in {**images, **build_bases}.items():
        if not isinstance(reference, str):
            errors.append(f"{name} image is not pinned by version")
            continue
        # Platform dependencies bind reviewed bytes, not a mutable tag. Recipe
        # references are owned by their separate canonical build contract.
        bare = reference.split("@", 1)[0]
        if "@sha256:" not in reference and VERSIONED_IMAGE.fullmatch(reference) is None:
            errors.append(f"{name} image is not pinned by an explicit version")
        elif bare.rsplit(":", 1)[-1].lower() in FLOATING_TAGS:
            errors.append(f"{name} image uses a floating tag: {reference}")
        if re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", reference) is None:
            errors.append(f"{name} image requires an immutable SHA-256 digest")
        if name in images and reference not in compose:
            errors.append(f"{name} Compose default is not the locked versioned image")
    if re.search(r"(?m)^\s*image:\s*[^$\n]*(?::latest|:main|:edge)(?:\s|$)", compose):
        errors.append("Compose contains a floating image tag without digest")
    releases = lock.get("release_images", [])
    expected_releases = [
        {
            "context": ".",
            "dockerfile": "control/Dockerfile",
            "environment": "CONTROL_API_IMAGE",
            "package": "vonk-forge-api",
            "required": True,
            "target": "api",
        },
        {
            "context": ".",
            "dockerfile": "control/Dockerfile",
            "environment": "CONTROL_WORKER_IMAGE",
            "package": "vonk-forge-worker",
            "required": True,
            "target": "worker",
        },
        {
            "context": "deploy/compose/hermes-agent",
            "dockerfile": "deploy/compose/hermes-agent/Dockerfile",
            "environment": "HERMES_AGENT_IMAGE",
            "package": "vonk-forge-hermes",
            "required": True,
            "target": "managed",
        },
        {
            "context": ".",
            "dockerfile": "deploy/compose/litellm/Dockerfile",
            "environment": "LITELLM_IMAGE",
            "package": "vonk-forge-litellm",
            "required": True,
            "target": "runtime",
        },
    ]
    required_deployment_releases = [
        expected_releases[0],
        expected_releases[1],
        expected_releases[3],
    ]
    hermes_is_opt_in = (
        "profiles: [hermes]" in compose
        and "HERMES_AGENT_IMAGE:-ghcr.io/carstvaartjes/vonk-forge-hermes:profile-required"
        in compose
    )
    if (
        releases != expected_releases
        or any(
            f"${{{release['environment']}:?" not in compose
            for release in required_deployment_releases
        )
        or not (
            f"${{{expected_releases[2]['environment']}:?" in compose or hermes_is_opt_in
        )
    ):
        errors.append(
            "API, worker, and LiteLLM release images must be explicitly "
            "version-pinned; Hermes must be either version-pinned or explicitly opt-in"
        )
    for release in expected_releases:
        context = root / release["context"]
        dockerfile_path = root / release["dockerfile"]
        if not context.is_dir() or not dockerfile_path.is_file():
            errors.append(
                f"{release['package']} release build context or Dockerfile is missing"
            )
    dockerfile = (root / "control/Dockerfile").read_text()
    hermes_dockerfile = (root / "deploy/compose/hermes-agent/Dockerfile").read_text()
    for name in ("node", "python"):
        reference = build_bases.get(name)
        if not isinstance(reference, str):
            errors.append(f"{name} build base is missing or invalid")
        elif reference not in dockerfile:
            errors.append(f"{name} build base is absent from control Dockerfile")
    hermes_reference = build_bases.get("hermes")
    if not isinstance(hermes_reference, str):
        errors.append("hermes build base is missing or invalid")
    elif hermes_reference not in hermes_dockerfile:
        errors.append("hermes build base is absent from Hermes Dockerfile")
    if "ARG NODE_IMAGE" not in dockerfile or "ARG PYTHON_IMAGE" not in dockerfile:
        errors.append("control build bases are not explicit locked arguments")
    if (
        "FROM scratch AS worker" not in dockerfile
        or "FROM scratch AS api" not in dockerfile
    ):
        errors.append("control API and worker image targets are not isolated")
    if (
        "COPY control/pyproject.toml ./" not in dockerfile
        or f"COPY {PROTOCOL_WHEEL} /wheels/" not in dockerfile
        or not docker_installs_protocol_wheel(dockerfile)
    ):
        errors.append(
            "control image does not install the standalone protocol wheel from root context"
        )
    hermes_base = re.search(r"(?m)^ARG HERMES_IMAGE=(\S+)$", hermes_dockerfile)
    locked_hermes = build_bases.get("hermes")
    if (
        hermes_base is None
        or hermes_base.group(1) != locked_hermes
        or re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", hermes_base.group(1)) is None
        or "FROM ${HERMES_IMAGE} AS managed" not in hermes_dockerfile
    ):
        errors.append("Hermes build base is not the exact versioned locked image")
    return errors


def docker_installs_protocol_wheel(dockerfile: str) -> bool:
    """Require the copied protocol wheel in the control pip-install RUN command."""
    logical_lines = re.sub(r"\\\r?\n\s*", " ", dockerfile).splitlines()
    wheel = f"/wheels/{Path(PROTOCOL_WHEEL).name}"
    for line in logical_lines:
        stripped = line.strip()
        if not stripped.startswith("RUN "):
            continue
        lexer = shlex.shlex(
            stripped.removeprefix("RUN "),
            posix=True,
            punctuation_chars=";&|",
        )
        lexer.whitespace_split = True
        tokens = list(lexer)
        for pip_index in range(len(tokens) - 3):
            if tokens[pip_index : pip_index + 4] != ["python", "-m", "pip", "install"]:
                continue
            try:
                command_end = next(
                    index
                    for index in range(pip_index + 4, len(tokens))
                    if set(tokens[index]) <= {";", "&", "|"}
                )
            except StopIteration:
                command_end = len(tokens)
            installed = tokens[pip_index + 4 : command_end]
            if wheel in installed and "." in installed:
                return True
    return False


def verify(root: Path, output_dir: Path | None) -> tuple[list[str], dict[str, object]]:
    errors = image_errors(root)
    try:
        sboms, _wheel, manifest = expected(root)
    except (
        OSError,
        ValueError,
        TypeError,
        KeyError,
        json.JSONDecodeError,
        tomllib.TOMLDecodeError,
    ) as error:
        return [
            *errors,
            f"could not generate expected supply-chain evidence: {type(error).__name__}: {error}",
        ], {}
    if output_dir is not None:
        output_dir.mkdir(parents=True, exist_ok=True)
        for path, content in sboms.items():
            target = output_dir / Path(path).name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(content)
        (output_dir / "manifest.json").write_bytes(canonical(manifest))
    result = {
        "ok": not errors,
        "images": len(
            json.loads((root / "deploy/compose/images.lock.json").read_bytes()).get(
                "images", {}
            )
        ),
        "sboms": [Path(path).name for path in sorted(sboms)],
        "manifest_sha256": digest(canonical(manifest)),
        "output_dir": str(output_dir) if output_dir is not None else None,
    }
    return errors, result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--root", type=Path, default=Path(__file__).resolve().parents[1]
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        help="write generated SBOMs and their source manifest into this directory",
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    errors, result = verify(
        args.root.resolve(), args.output_dir.resolve() if args.output_dir else None
    )
    result["errors"] = errors
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    else:
        for error in errors:
            print(f"verify-supply-chain: {error}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
