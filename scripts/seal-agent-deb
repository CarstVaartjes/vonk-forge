#!/usr/bin/env python3
"""Seal an unsealed Vonk Forge agent package with a release key, or unseal one.

Sealing adds only the trust material: the release keyring, the agent artifact
signature and the detached host signature. The same unsealed package sealed
with the same key is always the same sealed package, so publication can seal
exactly the package an earlier run built and accepted.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def _builder():
    loader = importlib.machinery.SourceFileLoader(
        "build_agent_deb", str(ROOT / "scripts/build-agent-deb")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main() -> int:
    parser = argparse.ArgumentParser(prog="seal-agent-deb")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--unsealed", type=Path, help="seal this unsealed package")
    source.add_argument(
        "--sealed", type=Path, help="recover the unsealed package this was sealed from"
    )
    parser.add_argument("--release-private-key", type=Path)
    parser.add_argument("--output-dir", required=True, type=Path)
    arguments = parser.parse_args()
    if (arguments.unsealed is None) != (arguments.release_private_key is None):
        parser.error("--release-private-key is required to seal, and only to seal")
    builder = _builder()
    try:
        if arguments.sealed is not None:
            package = builder.unseal(arguments.sealed.absolute(), arguments.output_dir)
        else:
            package = builder.seal(
                arguments.unsealed.absolute(),
                arguments.release_private_key.absolute(),
                arguments.output_dir,
            )
    except (builder.BuildError, OSError, ValueError) as error:
        print(f"seal-agent-deb: {error}", file=sys.stderr)
        return 2
    print(package)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
