#!/usr/bin/env python3
"""Fail closed when a final development image carries secret authority."""

from __future__ import annotations

import json
import re
import subprocess
import sys
import tarfile
from collections.abc import Iterable, Sequence
from typing import Any, BinaryIO

MAX_FILE_BYTES = 64 * 1024 * 1024
SCAN_CHUNK_BYTES = 64 * 1024
SCANNER_LABEL = "vonk-forge.secret-scan=true"
OCI_REVISION_LABEL = "org.opencontainers.image.revision"
OCI_SOURCE_LABEL = "org.opencontainers.image.source"

_IDENTITY_COMMAND = """
import stat
import sys

from vonk_control.dev_cohort import DEVELOPMENT_IMAGE_IDENTITY_PATH, read_identity

identity = read_identity(DEVELOPMENT_IMAGE_IDENTITY_PATH, expected_role=sys.argv[1])
if identity.source_commit != sys.argv[2]:
    raise SystemExit("source commit mismatch")
if identity.source_repository != sys.argv[3]:
    raise SystemExit("source repository mismatch")
if stat.S_IMODE(DEVELOPMENT_IMAGE_IDENTITY_PATH.stat().st_mode) != 0o444:
    raise SystemExit("identity mode mismatch")
sys.stdout.buffer.write(identity.to_bytes())
"""

# A PEM-bearing file is treated as compiled-like only when it is at least 1 KiB,
# has at least 32 NUL bytes, and has both >=1% NUL and >=5% non-text control
# bytes. This permits embedded upstream binary fixtures without allowing one or
# a few control bytes to turn otherwise textual key material into "binary".
COMPILED_LIKE_MIN_BYTES = 1024
COMPILED_LIKE_MIN_NUL_BYTES = 32
COMPILED_LIKE_MIN_NUL_PERCENT = 1
COMPILED_LIKE_MIN_CONTROL_PERCENT = 5
PEM_MAX_LINE_BYTES = 512

_SENSITIVE_COMPONENTS = frozenset(
    {
        ".aws",
        ".azure",
        ".dev",
        ".git",
        ".kube",
        ".ssh",
        "id_dsa",
        "id_ecdsa",
        "id_ed25519",
        "id_rsa",
    }
)
_SENSITIVE_FILENAMES = frozenset(
    {
        ".netrc",
        ".npmrc",
        ".pypirc",
        "admin-grant-private-key",
        "credentials.json",
        "credentials.yaml",
        "credentials.yml",
        "credentials.toml",
        "database-url",
        "git-signing-key",
        "git-signing-key.pub",
        "postgres-password",
        "secrets.json",
        "secrets.yaml",
        "secrets.yml",
        "secrets.toml",
        "worker-api-token",
    }
)
_SENSITIVE_PATH_SEQUENCES = (
    (".config", "gcloud"),
    (".docker", "config.json"),
)
_AUTHORITY_COMBINATIONS = (
    "accesskey",
    "apikey",
    "authkey",
    "encryptionkey",
    "gpgkey",
    "privatekey",
    "secretkey",
    "signingkey",
    "sshkey",
)
_ASSIGNMENT_NAME = re.compile(
    r"(?:^|[\s,;\"'])(?:--)?([A-Za-z][A-Za-z0-9_.-]{1,127})\s*(?:=|:)"
)
_FLAG_NAME = re.compile(
    r"(?:^|\s)--([A-Za-z][A-Za-z0-9_.-]{1,127})(?:[=\s]|$)"
)
_SECRET_FILE_PATH = re.compile(r"/run/secrets/[A-Za-z0-9][A-Za-z0-9._-]*\Z")
_HISTORY_ENVIRONMENT = re.compile(
    r"(?:/bin/sh -c #\(nop\)\s+)?ENV\s+([A-Z][A-Z0-9_]*)=([^\s]+)\Z"
)
_PRIVATE_KEY_BLOCK = re.compile(
    rb"-----BEGIN(?: [A-Z0-9]+)* PRIVATE KEY-----\r?\n"
    rb"(?:[A-Za-z0-9+/=]{1,76}\r?\n)+"
    rb"-----END(?: [A-Z0-9]+)* PRIVATE KEY-----"
)
_PRIVATE_KEY_BEGIN_LINE = re.compile(
    rb"-----BEGIN(?: [A-Z0-9]+)* PRIVATE KEY-----"
)
_PRIVATE_KEY_END_LINE = re.compile(
    rb"-----END(?: [A-Z0-9]+)* PRIVATE KEY-----"
)
_PRIVATE_KEY_BODY_LINE = re.compile(rb"[A-Za-z0-9+/=]{1,76}")
_PRIVATE_KEY_HEADER_LINE = re.compile(rb"[A-Za-z0-9-]+:[\x20-\x7e]+")
_BINARY_CONTROL_TRANSLATION = bytes(
    1 if (value < 32 and value not in (9, 10, 13)) or value == 127 else 0
    for value in range(256)
)
_ALLOWED_PATH_ENVIRONMENT = frozenset(
    {
        "VONK_DATABASE_URL_FILE",
        "VONK_WORKER_API_TOKEN_FILE",
        "VONK_GIT_SIGNING_KEY_FILE",
        "VONK_ADMIN_GRANT_PRIVATE_KEY_FILE",
    }
)


class ScanFailure(RuntimeError):
    """An image crosses the development secret boundary."""


def _run(arguments: Sequence[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(arguments, check=True, capture_output=True, text=True)


def _inspect(image: str) -> dict[str, Any]:
    result = _run(("docker", "image", "inspect", image))
    decoded = json.loads(result.stdout)
    if not isinstance(decoded, list) or len(decoded) != 1 or not isinstance(decoded[0], dict):
        raise ScanFailure("image inspection was not a single object")
    return decoded[0]


def _history(image: str) -> list[dict[str, Any]]:
    result = _run(("docker", "history", "--no-trunc", "--format", "{{json .}}", image))
    rows: list[dict[str, Any]] = []
    for line in result.stdout.splitlines():
        row = json.loads(line)
        if not isinstance(row, dict):
            raise ScanFailure("image history was malformed")
        rows.append(row)
    return rows


def _contains_sensitive_path(name: str) -> bool:
    components = [
        component.lower()
        for component in name.split("/")
        if component not in {"", "."}
    ]
    if any(component in _SENSITIVE_COMPONENTS for component in components):
        return True
    filename = components[-1] if components else ""
    if filename in _SENSITIVE_FILENAMES or filename == ".env" or filename.startswith(".env."):
        return True
    return any(
        tuple(components[index : index + len(sequence)]) == sequence
        for sequence in _SENSITIVE_PATH_SEQUENCES
        for index in range(len(components) - len(sequence) + 1)
    )


class _PrivateKeyBlockDetector:
    """Recognize complete line-oriented PEM blocks without retaining a file."""

    def __init__(self) -> None:
        self._line = bytearray()
        self._line_truncated = False
        self._in_block = False
        self._body_lines = 0
        self.found = False

    def feed(self, block: bytes) -> None:
        parts = block.split(b"\n")
        for part in parts[:-1]:
            self._append(part)
            self._finish_line()
        self._append(parts[-1])

    def finish(self) -> bool:
        if self._line:
            self._finish_line()
        return self.found

    def _append(self, fragment: bytes) -> None:
        combined = bytes(self._line) + fragment
        if len(combined) > PEM_MAX_LINE_BYTES:
            self._line_truncated = True
            combined = combined[-PEM_MAX_LINE_BYTES:]
        self._line = bytearray(combined)

    def _finish_line(self) -> None:
        line = bytes(self._line).removesuffix(b"\r")
        truncated = self._line_truncated
        self._line.clear()
        self._line_truncated = False
        if self.found:
            return
        if not self._in_block:
            self._start_if_present(line)
            return
        if _PRIVATE_KEY_END_LINE.search(line) and self._body_lines:
            self.found = True
            return
        if not truncated and _PRIVATE_KEY_BODY_LINE.fullmatch(line):
            self._body_lines += 1
            return
        if not truncated and not self._body_lines and (
            not line or _PRIVATE_KEY_HEADER_LINE.fullmatch(line)
        ):
            return
        self._in_block = False
        self._body_lines = 0
        self._start_if_present(line)

    def _start_if_present(self, line: bytes) -> None:
        match = _PRIVATE_KEY_BEGIN_LINE.search(line)
        if match is not None and not line[match.end() :]:
            self._in_block = True
            self._body_lines = 0


def _is_compiled_like(total: int, controls: int, nuls: int) -> bool:
    return (
        total >= COMPILED_LIKE_MIN_BYTES
        and nuls >= COMPILED_LIKE_MIN_NUL_BYTES
        and nuls * 100 >= total * COMPILED_LIKE_MIN_NUL_PERCENT
        and controls * 100 >= total * COMPILED_LIKE_MIN_CONTROL_PERCENT
    )


def _scan_file_contents(stream: BinaryIO, size: int) -> str | None:
    if size < 0:
        return "unreadable"
    if size > MAX_FILE_BYTES:
        return "oversized"
    remaining = size
    total = 0
    controls = 0
    nuls = 0
    detector = _PrivateKeyBlockDetector()
    while remaining:
        block = stream.read(min(SCAN_CHUNK_BYTES, remaining))
        if not block:
            return "unreadable"
        remaining -= len(block)
        total += len(block)
        controls += sum(block.translate(_BINARY_CONTROL_TRANSLATION))
        nuls += block.count(b"\0")
        detector.feed(block)
    if detector.finish() and not _is_compiled_like(total, controls, nuls):
        return "private-key"
    return None


def _scan_export(container: str) -> None:
    exported = subprocess.Popen(("docker", "export", container), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    assert exported.stdout is not None
    violation: ScanFailure | None = None
    try:
        with tarfile.open(fileobj=exported.stdout, mode="r|*") as archive:
            for member in archive:
                if _contains_sensitive_path(member.name) and violation is None:
                    violation = ScanFailure("forbidden filesystem entry")
                if member.isreg():
                    source = archive.extractfile(member)
                    if source is None:
                        if violation is None:
                            violation = ScanFailure("image filesystem entry was unreadable")
                    else:
                        with source:
                            content_result = _scan_file_contents(source, member.size)
                            if content_result is not None and violation is None:
                                violation = ScanFailure(f"forbidden {content_result} file content")
    finally:
        exported.stdout.close()
        export_returncode = exported.wait()
        if violation is not None:
            raise violation
        if export_returncode != 0:
            raise ScanFailure("image filesystem export failed") from None


def _metadata_strings(value: Any) -> Iterable[str]:
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for key, item in value.items():
            yield key
            yield from _metadata_strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from _metadata_strings(item)


def _has_authority_name(name: str) -> bool:
    lowered = name.lower()
    compact = re.sub(r"[^a-z0-9]", "", lowered)
    if any(word in compact for word in ("credential", "secret", "token", "password", "passphrase")):
        return True
    if any(authority in compact for authority in _AUTHORITY_COMBINATIONS):
        return True
    return any(component == "key" for component in re.split(r"[^a-z0-9]+", lowered))


def _contains_sensitive_metadata(value: str) -> bool:
    encoded = value.encode("utf-8", errors="surrogatepass")
    if _PRIVATE_KEY_BLOCK.search(encoded):
        return True
    if _has_authority_name(value):
        return True
    return any(
        _has_authority_name(match.group(1))
        for pattern in (_ASSIGNMENT_NAME, _FLAG_NAME)
        for match in pattern.finditer(value)
    )


def _check_environment(environment: Any) -> None:
    if environment is None:
        return
    if not isinstance(environment, list) or not all(isinstance(item, str) for item in environment):
        raise ScanFailure("image environment is malformed")
    for item in environment:
        name, separator, value = item.partition("=")
        if not separator or not name:
            raise ScanFailure("image environment is malformed")
        documented_secret_path = _is_documented_secret_file_path(name, value)
        if _has_authority_name(name) and not documented_secret_path:
            raise ScanFailure("forbidden environment authority")
        if not documented_secret_path and _contains_sensitive_metadata(value):
            raise ScanFailure("forbidden environment value")


def _is_documented_secret_file_path(name: str, value: str) -> bool:
    return name in _ALLOWED_PATH_ENVIRONMENT and _SECRET_FILE_PATH.fullmatch(value) is not None


def _check_metadata(inspected: dict[str, Any], history: list[dict[str, Any]]) -> None:
    config = inspected.get("Config")
    if not isinstance(config, dict):
        raise ScanFailure("image config is malformed")
    if config.get("User") != "10001:10001":
        raise ScanFailure("image must declare user 10001:10001")
    _check_environment(config.get("Env"))
    labels = config.get("Labels") or {}
    if not isinstance(labels, dict) or not all(isinstance(key, str) and isinstance(value, str) for key, value in labels.items()):
        raise ScanFailure("image labels are malformed")
    for key, value in labels.items():
        if _has_authority_name(key) or _contains_sensitive_metadata(value):
            raise ScanFailure("forbidden label authority")
    for field in ("Entrypoint", "Cmd"):
        for value in _metadata_strings(config.get(field)):
            if _contains_sensitive_metadata(value):
                raise ScanFailure("forbidden command authority")
    for row in history:
        for value in _metadata_strings(row):
            environment = _HISTORY_ENVIRONMENT.fullmatch(value)
            if environment is not None and _is_documented_secret_file_path(
                environment.group(1), environment.group(2)
            ):
                continue
            if _contains_sensitive_metadata(value):
                raise ScanFailure("forbidden build history authority")


def _cleanup_container(container: str) -> None:
    try:
        _run(("docker", "rm", "--force", container))
        remaining = _run(
            (
                "docker",
                "ps",
                "--all",
                "--filter",
                f"id={container}",
                "--filter",
                f"label={SCANNER_LABEL}",
                "--format",
                "{{.ID}}",
            )
        )
    except subprocess.CalledProcessError as error:
        raise ScanFailure("temporary container cleanup failed") from error
    if remaining.stdout.strip():
        raise ScanFailure("temporary container cleanup left scanner container present")


def _verify_image_identity(
    image: str,
    inspected: dict[str, Any],
    *,
    expected_role: str,
    expected_commit: str,
    expected_repository: str,
) -> None:
    config = inspected.get("Config")
    labels = config.get("Labels") if isinstance(config, dict) else None
    if not isinstance(labels, dict):
        raise ScanFailure("embedded identity verification failed")
    revision = labels.get(OCI_REVISION_LABEL)
    source = labels.get(OCI_SOURCE_LABEL)
    if revision != expected_commit or source != expected_repository:
        raise ScanFailure("embedded identity verification failed")
    try:
        result = _run(
            (
                "docker",
                "run",
                "--rm",
                "--network=none",
                "--read-only",
                "--pull=never",
                "--entrypoint",
                "python",
                image,
                "-c",
                _IDENTITY_COMMAND,
                expected_role,
                expected_commit,
                expected_repository,
            )
        )
        document = json.loads(result.stdout)
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError) as error:
        raise ScanFailure("embedded identity verification failed") from error
    canonical = (
        json.dumps(
            document,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
        )
        + "\n"
    )
    if (
        not isinstance(document, dict)
        or canonical != result.stdout
        or document.get("image_role") != expected_role
        or document.get("source_commit") != revision
        or document.get("source_repository") != source
    ):
        raise ScanFailure("embedded identity verification failed")


def scan_image(
    image: str,
    *,
    expected_role: str | None = None,
    expected_commit: str | None = None,
    expected_repository: str | None = None,
) -> None:
    inspected = _inspect(image)
    _check_metadata(inspected, _history(image))
    identity_arguments = (expected_role, expected_commit, expected_repository)
    if any(value is not None for value in identity_arguments):
        if not all(isinstance(value, str) and value for value in identity_arguments):
            raise ScanFailure("embedded identity verification failed")
        _verify_image_identity(
            image,
            inspected,
            expected_role=expected_role,
            expected_commit=expected_commit,
            expected_repository=expected_repository,
        )
    container = ""
    try:
        created = _run(("docker", "create", "--label", SCANNER_LABEL, image, "true"))
        container = created.stdout.strip()
        if not container:
            raise ScanFailure("image container creation returned no identifier")
        _scan_export(container)
    finally:
        if container:
            _cleanup_container(container)


def main(arguments: Sequence[str] | None = None) -> int:
    supplied = tuple(sys.argv[1:] if arguments is None else arguments)
    expected_commit: str | None = None
    expected_repository: str | None = None
    if len(supplied) == 2:
        images = supplied
    elif (
        len(supplied) == 6
        and supplied[0] == "--expected-commit"
        and supplied[2] == "--expected-repository"
    ):
        expected_commit = supplied[1]
        expected_repository = supplied[3]
        images = supplied[4:]
    else:
        print(
            "usage: verify-dev-image-secrets "
            "[--expected-commit COMMIT --expected-repository REPOSITORY] "
            "<api-image> <worker-image>",
            file=sys.stderr,
        )
        return 2
    try:
        for role, image in zip(("api", "worker"), images, strict=True):
            scan_image(
                image,
                expected_role=role if expected_commit is not None else None,
                expected_commit=expected_commit,
                expected_repository=expected_repository,
            )
    except ScanFailure as error:
        print(f"development image secret-boundary scan failed: {error}", file=sys.stderr)
        return 1
    except (subprocess.CalledProcessError, json.JSONDecodeError, tarfile.TarError, OSError):
        print("development image secret-boundary scan failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
