#!/usr/bin/env bash
# Re-fetch a release tag into an isolated ref and bind its immutable tag object
# and peeled commit to authority accepted by an earlier verification boundary.
set -euo pipefail

invalid() {
  printf '%s\n' 'release tag authority is invalid' >&2
  exit 64
}

[[ "$#" -eq 3 ]] || invalid
readonly tag_name=$1 expected_tag_oid=$2 expected_source_sha=$3
[[ "$tag_name" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
  || invalid
[[ "$expected_tag_oid" =~ ^[0-9a-f]{40}$ ]] || invalid
[[ "$expected_source_sha" =~ ^[0-9a-f]{40}$ ]] || invalid

readonly isolated_ref="refs/vonk/release-authority/${tag_name}-$$"
cleanup() {
  git update-ref -d "$isolated_ref" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM
cleanup

git fetch --force --no-tags origin \
  "+refs/tags/${tag_name}:${isolated_ref}"
[[ "$(git cat-file -t "$isolated_ref")" == tag ]]
readonly observed_tag_oid=$(git rev-parse --verify "$isolated_ref")
[[ "$observed_tag_oid" =~ ^[0-9a-f]{40}$ ]]
[[ "$observed_tag_oid" == "$expected_tag_oid" ]]
readonly observed_source_sha=$(git rev-parse --verify "${isolated_ref}^{commit}")
[[ "$observed_source_sha" =~ ^[0-9a-f]{40}$ ]]
[[ "$observed_source_sha" == "$expected_source_sha" ]]
