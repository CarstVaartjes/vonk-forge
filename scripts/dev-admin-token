#!/usr/bin/env python3
"""Write a short-lived development administrator token without revealing it."""

from __future__ import annotations

import argparse
import os
import stat
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "control/src"))

from vonk_control.development_tokens import (
    issue_development_admin_token,
)


class TokenFileError(RuntimeError):
    pass


def _ttl(value: str) -> int:
    try:
        ttl = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("token lifetime must be an integer") from error
    if not 60 <= ttl <= 86_400:
        raise argparse.ArgumentTypeError(
            "token lifetime must be from 60 to 86400 seconds"
        )
    return ttl


def write_token(output: Path, *, ttl_seconds: int) -> Path:
    destination = Path(os.path.abspath(output))
    parent = destination.parent
    try:
        parent_metadata = parent.stat(follow_symlinks=False)
    except OSError as error:
        raise TokenFileError("token parent directory is unavailable") from error
    if (
        not stat.S_ISDIR(parent_metadata.st_mode)
        or parent_metadata.st_uid != os.geteuid()
        or stat.S_IMODE(parent_metadata.st_mode) & 0o077
    ):
        raise TokenFileError(
            "token parent directory must be private and operator-owned"
        )

    token = issue_development_admin_token(
        ttl_seconds=ttl_seconds,
        now=int(time.time()),
    )
    descriptor = -1
    created = False
    complete = False
    try:
        descriptor = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
        created = True
        payload = (token + "\n").encode("ascii")
        remaining = memoryview(payload)
        while remaining:
            written = os.write(descriptor, remaining)
            if written <= 0:
                raise TokenFileError(
                    "development administrator token write was incomplete"
                )
            remaining = remaining[written:]
        os.fchmod(descriptor, 0o600)
        os.fsync(descriptor)
        complete = True
    except FileExistsError as error:
        raise TokenFileError(
            "development administrator token already exists"
        ) from error
    except OSError as error:
        raise TokenFileError(
            "development administrator token cannot be written"
        ) from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if created and not complete:
            destination.unlink(missing_ok=True)
    return destination


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--ttl-seconds", type=_ttl, default=21_600)
    arguments = parser.parse_args()
    os.umask(0o077)
    try:
        destination = write_token(
            arguments.output,
            ttl_seconds=arguments.ttl_seconds,
        )
    except TokenFileError as error:
        print(str(error), file=sys.stderr)
        return 1
    print(destination)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
