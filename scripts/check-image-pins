#!/usr/bin/env python3
"""Audit the digest-pinned container images recorded in the image lock.

It resolves every pin in ``deploy/compose/images.lock.json`` against its
registry and reports:

* ``missing`` - the recorded digest is gone, so every image build fails;
* ``unlisted`` - a digest-pinned reference the build or Compose inputs use is
  absent from the inventory;
* ``moved`` - the tag still exists but now points at a different digest, which
  is expected for a rolling tag and does not break anything;
* ``unverified`` - the registry could not be read at all, which is a network
  condition rather than a defect here.

It performs registry reads only: it never writes a file, pulls layers, or
mutates local image state. ``missing`` and ``unlisted`` exit non-zero; ``moved``
and ``unverified`` are reported but do not block, so the check can gate a pull
request without flaking on the network. Run it by hand when reviewing or
refreshing the pins. See ``docs/image-pin-refresh.md``.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INVENTORY = "deploy/compose/images.lock.json"
SECTIONS = ("images", "build_bases")

# Build and Compose inputs that declare upstream images. Keep this list in sync
# with the files named in docs/image-pin-refresh.md: a new digest-pinned
# reference anywhere in here that is absent from the inventory is a finding.
SCAN_PATHS = (
    "control/Dockerfile",
    "deploy/compose/.env.example",
    "deploy/compose/compose.yaml",
    "deploy/compose/tailscale/compose.yaml",
    "deploy/compose/hermes-agent/compose.yaml",
    "deploy/compose/hermes-agent/Dockerfile",
    "deploy/compose/litellm/Dockerfile",
    "scripts/verify-controller-skopeo",
    "scripts/dev-agent-wire-linux.Dockerfile",
)

# Pinned on purpose without a lock entry. The lock inventories deployment and
# build inputs; this one is the base of the developer wire-contract lane, so it
# has no lock key and would otherwise be reported as unlisted forever. Listing
# it here keeps that finding meaningful for a genuinely forgotten reference.
INTENTIONALLY_LOCKLESS = frozenset(
    {
        "ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254",
    }
)

PIN = re.compile(
    r"[A-Za-z0-9][A-Za-z0-9._/-]*"
    r"(?::[A-Za-z0-9][A-Za-z0-9._-]*)?"
    r"@sha256:[0-9a-f]{64}"
)
DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")


def tag_reference(reference: str) -> str | None:
    """Return ``NAME:TAG`` for a pin, or ``None`` for a digest-only reference."""
    name = reference.split("@", 1)[0]
    return name if ":" in name.rsplit("/", 1)[-1] else None


# A registry read can fail because the reference is gone or because the
# registry could not be reached. Only the first is this repository's problem:
# an unreachable registry must not fail a gate, or the check flakes whenever
# the network does. These markers identify the second case.
_UNREACHABLE = (
    "connection refused",
    "dial tcp",
    "i/o timeout",
    "network is unreachable",
    "no such host",
    "proxyconnect",
    "temporary failure",
    "tls",
    "timed out",
    "timeout",
    "unreachable",
    "unexpected eof",
)


def resolve(reference: str, timeout: float) -> tuple[str | None, str | None, str]:
    """Resolve a reference through the registry.

    Returns ``(digest, error, kind)`` where ``kind`` is ``"missing"`` when the
    registry answered that the reference does not exist, and ``"unverified"``
    when it could not be read at all.
    """

    if shutil.which("docker") is None:
        return None, "docker is not available on PATH", "unverified"
    try:
        result = subprocess.run(
            ["docker", "buildx", "imagetools", "inspect", "--raw", reference],
            capture_output=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return None, f"registry read timed out after {timeout:g}s", "unverified"
    if result.returncode != 0:
        lines = result.stderr.decode("utf-8", "replace").strip().splitlines()
        detail = lines[-1] if lines else f"exit status {result.returncode}"
        lowered = detail.lower()
        kind = "unverified" if any(m in lowered for m in _UNREACHABLE) else "missing"
        return None, detail, kind
    if not result.stdout:
        return None, "registry returned an empty manifest", "unverified"
    return "sha256:" + hashlib.sha256(result.stdout).hexdigest(), None, ""


def load_inventory(root: Path) -> dict[str, list[str]]:
    """Map each recorded reference to the inventory keys that hold it."""
    document = json.loads((root / INVENTORY).read_text(encoding="utf-8"))
    references: dict[str, list[str]] = {}
    for section in SECTIONS:
        entries = document.get(section)
        if not isinstance(entries, dict):
            raise TypeError(f"{INVENTORY} {section} mapping is missing or invalid")
        for name, reference in entries.items():
            digest = reference.rsplit("@", 1)[-1] if isinstance(reference, str) else ""
            if DIGEST.fullmatch(digest) is None:
                raise ValueError(f"{INVENTORY} {section}.{name} is not digest pinned")
            references.setdefault(reference, []).append(f"{section}.{name}")
    return references


def used_references(root: Path) -> dict[str, str]:
    """Map every digest-pinned reference in the scanned inputs to file:line."""
    used: dict[str, str] = {}
    for relative in SCAN_PATHS:
        path = root / relative
        if not path.is_file():
            raise ValueError(f"scan input is missing: {relative}")
        for number, line in enumerate(
            path.read_text(encoding="utf-8").splitlines(), start=1
        ):
            for reference in PIN.findall(line):
                used.setdefault(reference, f"{relative}:{number}")
    return used


def audit(root: Path, timeout: float) -> dict[str, object]:
    inventory = load_inventory(root)
    used = used_references(root)
    findings: list[dict[str, str]] = []
    checked: list[dict[str, str]] = []

    for reference, keys in sorted(inventory.items()):
        recorded = reference.rsplit("@", 1)[1]
        entry = {"reference": reference, "inventory": ", ".join(sorted(keys))}
        checked.append(entry)
        tag = tag_reference(reference)
        if tag is not None:
            entry["tag"] = tag
            tag_digest, tag_error, _tag_kind = resolve(tag, timeout)
            if tag_error is None and tag_digest == recorded:
                entry["tag_digest"] = tag_digest
                continue
            pinned_digest, pinned_error, pinned_kind = resolve(reference, timeout)
            if pinned_error is not None:
                findings.append(
                    {
                        "kind": pinned_kind,
                        "reference": reference,
                        "inventory": entry["inventory"],
                        "detail": pinned_error,
                    }
                )
                continue
            entry["tag_digest"] = tag_digest or ""
            entry["pinned_digest"] = pinned_digest or ""
            if tag_error is not None:
                detail = f"tag {tag} no longer resolves: {tag_error}"
            else:
                detail = f"tag {tag} now resolves to {tag_digest}"
            findings.append(
                {
                    "kind": "moved",
                    "reference": reference,
                    "inventory": entry["inventory"],
                    "detail": detail,
                }
            )
        else:
            pinned_digest, pinned_error, pinned_kind = resolve(reference, timeout)
            if pinned_error is not None:
                findings.append(
                    {
                        "kind": pinned_kind,
                        "reference": reference,
                        "inventory": entry["inventory"],
                        "detail": pinned_error,
                    }
                )
                continue
            entry["pinned_digest"] = pinned_digest or ""

    for reference, location in sorted(used.items()):
        if reference in INTENTIONALLY_LOCKLESS:
            continue
        if reference not in inventory:
            findings.append(
                {
                    "kind": "unlisted",
                    "reference": reference,
                    "inventory": "",
                    "detail": f"pinned at {location} but absent from {INVENTORY}",
                }
            )

    return {
        "inventory": INVENTORY,
        "inventoried": len(inventory),
        "checked": checked,
        "findings": findings,
        # A moved tag is expected -- upstream re-pushes rolling tags -- and an
        # unreadable registry is not this repository's defect. Only a missing
        # digest (the build will fail) or an unlisted pin blocks the gate.
        "ok": not any(
            finding["kind"] in {"missing", "unlisted"} for finding in findings
        ),
    }


def report(payload: dict[str, object]) -> None:
    findings = payload["findings"]
    assert isinstance(findings, list)
    print(f"check-image-pins: {payload['inventoried']} pins in {payload['inventory']}")
    if not findings:
        print("check-image-pins: every pin resolves and every tag matches")
        return
    for finding in findings:
        location = finding["inventory"] or "-"
        print(
            f"{finding['kind']}: {finding['reference']} [{location}] "
            f"- {finding['detail']}",
            file=sys.stderr,
        )
    print(f"check-image-pins: {len(findings)} finding(s)", file=sys.stderr)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument(
        "--timeout",
        type=float,
        default=120.0,
        help="seconds to wait for each registry read (default: 120)",
    )
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()
    try:
        payload = audit(arguments.root.resolve(), arguments.timeout)
    except (OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        print(f"check-image-pins: {error}", file=sys.stderr)
        return 2
    if arguments.json:
        print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    else:
        report(payload)
    return 0 if payload["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
