#!/usr/bin/env python3
"""Check changed languages, preparing locked dependencies when needed."""

from __future__ import annotations

import hashlib
import platform
import re
import shlex
import subprocess
import sys
import time
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True  # repository tools never leave __pycache__ behind
import os

# The sibling helper, however this file is loaded.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from check_environment import ensure_web
from hook_words_generated import HookFailureCode, HookFailureKind

ROOT = Path(__file__).resolve().parents[1]


def run(command: list[str], *, cwd: Path = ROOT) -> None:
    subprocess.run(command, cwd=cwd, check=True, timeout=600)


# One budget includes lock contention and execution, for both Rust checks.
VM_CARGO_BUDGET_SECONDS = 600
VM_LOCK_WAIT_SECONDS = 60
VM_BUSY_EXIT = 75
VM_CARGO_LOCK = "/tmp/vonk-ci-cargo.lock"


def vm_cargo_command(command: list[str], remaining: float) -> list[str]:
    # Keep the inode permanently: the kernel releases the flock on process death.
    # VM timeout bounds contention AND cargo, even if the host disconnects.
    # The inherited lock descriptor covers cargo descendants until they exit.
    grace = min(5.0, remaining / 2)
    target_key = hashlib.sha256(os.fsencode(ROOT)).hexdigest()[:16]
    cleanup_budget = min(2.0, remaining / 10)
    preparation = (
        f"timeout --kill-after={cleanup_budget / 2:.3f}s {cleanup_budget:.3f}s "
        f"python3 scripts/vm-cargo-cache {shlex.quote(str(ROOT))} "
        '"$HOME/target-vonk-ci" >/dev/null 2>&1 || true; '
        f"exec {shlex.join(command)}"
    )
    script = (
        f"cd {shlex.quote(str(ROOT))} && "
        f'export CARGO_TARGET_DIR="$HOME/target-vonk-ci/{target_key}" && '
        "export CARGO_BUILD_JOBS=2 && "
        f"exec timeout --signal=TERM --kill-after={grace:.3f}s "
        f"{remaining - grace:.3f}s "
        f"flock --wait {min(VM_LOCK_WAIT_SECONDS, remaining):.3f} "
        f"--conflict-exit-code {VM_BUSY_EXIT} {shlex.quote(VM_CARGO_LOCK)} "
        f"bash -c {shlex.quote(preparation)}"
    )
    return ["orb", "-m", "vonk-ci", "bash", "-lc", script]


def vm_fault(code: HookFailureCode, reason: str) -> None:
    raise SystemExit(
        f"{code.value} [{HookFailureKind.TEMPORARY_DEPENDENCY.value}]: {reason}"
    )


def run_vm_cargo(command: list[str], deadline: float) -> None:
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        vm_fault(HookFailureCode.HOOK_VM_TIMEOUT, "VM cargo budget exhausted")
    invocation = vm_cargo_command(command, remaining)
    try:
        result = subprocess.run(
            invocation,
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
            timeout=remaining,
        )
    except subprocess.TimeoutExpired:
        vm_fault(
            HookFailureCode.HOOK_VM_TIMEOUT, "VM cargo observation deadline elapsed"
        )
        return
    # Retain compiler diagnostics; an ordinary compile failure stays a compile failure.
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    if result.returncode == VM_BUSY_EXIT:
        vm_fault(HookFailureCode.HOOK_VM_BUSY, "VM busy: cargo lock deadline elapsed")
    if result.returncode in {-9, 137} or re.search(
        r"signal: 9, SIGKILL|(?:clippy-driver|rustc).*SIGKILL", result.stderr
    ):
        vm_fault(
            HookFailureCode.HOOK_VM_PROCESS_KILLED,
            "VM cargo process killed; possible memory exhaustion",
        )
    if result.returncode in {124, 143}:
        vm_fault(HookFailureCode.HOOK_VM_TIMEOUT, "VM cargo execution deadline elapsed")
    if result.returncode:
        raise subprocess.CalledProcessError(result.returncode, invocation)


def main() -> None:
    changed = (
        subprocess.check_output(
            ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR"],
            cwd=ROOT,
            timeout=30,
        )
        .decode()
        .split("\0")
    )
    web = [
        file
        for file in changed
        if file.startswith("control/web/") and file.endswith((".ts", ".tsx"))
    ]
    web_inputs = bool(
        set(changed)
        & {
            "control/web/package.json",
            "control/web/package-lock.json",
            "control/web/tsconfig.json",
            "control/web/tsconfig.check.json",
            "control/web/biome.json",
        }
    )
    rust = any(
        file.endswith(".rs")
        or file in {"Cargo.toml", "Cargo.lock", "rust-toolchain.toml"}
        or file.startswith("rust/")
        and file.endswith("Cargo.toml")
        for file in changed
    )
    run(["python3", "scripts/check-staged-python"])
    if web or web_inputs:
        directory = ROOT / "control/web"
        biome = directory / "node_modules/.bin/biome"
        ensure_web(ROOT)
        if web:
            run(
                [
                    str(biome),
                    "check",
                    "--no-errors-on-unmatched",
                    *[str(ROOT / file) for file in web],
                ],
                cwd=directory,
            )
        run(["npm", "run", "typecheck"], cwd=directory)
    if rust:
        toolchain = tomllib.loads((ROOT / "rust-toolchain.toml").read_text())[
            "toolchain"
        ]["channel"]
        commands = [
            ["rustup", "run", toolchain, "cargo", "fmt", "--all", "--check"],
            [
                "rustup",
                "run",
                toolchain,
                "cargo",
                "clippy",
                "--workspace",
                "--all-targets",
                "--frozen",
                "--",
                "-D",
                "warnings",
            ],
        ]
        deadline = time.monotonic() + VM_CARGO_BUDGET_SECONDS
        for command in commands:
            if platform.system() == "Darwin":
                run_vm_cargo(command, deadline)
            else:
                run(command)


if __name__ == "__main__":
    main()
