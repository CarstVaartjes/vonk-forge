#!/usr/bin/env python3
"""Check changed languages using prepared tools; never install dependencies."""

from __future__ import annotations

import platform
import shlex
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def run(command: list[str], *, cwd: Path = ROOT) -> None:
    subprocess.run(command, cwd=cwd, check=True, timeout=600)


def main() -> None:
    changed = (
        subprocess.check_output(
            ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR"],
            cwd=ROOT,
            timeout=30,
        )
        .decode()
        .split("\0")
    )
    python = [file for file in changed if file.endswith(".py")]
    web = [
        file
        for file in changed
        if file.startswith("control/web/") and file.endswith((".ts", ".tsx"))
    ]
    rust = any(
        file.endswith(".rs")
        or file in {"Cargo.toml", "Cargo.lock", "rust-toolchain.toml"}
        or file.startswith("rust/")
        and file.endswith("Cargo.toml")
        for file in changed
    )
    if python:
        uv = ["uv", "run", "--project", "control", "--no-sync", "--offline"]
        try:
            run([*uv, "python", "-c", "import ruff, pyright"])
        except subprocess.CalledProcessError:
            raise SystemExit(
                "Prepare tools: scripts/build-control-wheel && uv sync --project control --frozen"
            ) from None
        run([*uv, "ruff", "check", "--force-exclude", "--", *python])
        run([*uv, "ruff", "format", "--check", "--force-exclude", "--", *python])
        run([*uv, "python", "scripts/check-python-types", "--", *python])
    if web:
        directory = ROOT / "control/web"
        biome = directory / "node_modules/.bin/biome"
        if not biome.exists() or not (directory / "node_modules/.bin/tsc").exists():
            raise SystemExit("Prepare TypeScript tools: npm ci --prefix control/web")
        run([str(biome), "check", *[str(ROOT / file) for file in web]], cwd=directory)
        run(["npm", "run", "typecheck"], cwd=directory)
    if rust:
        commands = [
            ["rustup", "run", "1.98.1", "cargo", "fmt", "--all", "--check"],
            [
                "rustup",
                "run",
                "1.98.1",
                "cargo",
                "clippy",
                "--workspace",
                "--all-targets",
                "--frozen",
                "--",
                "-D",
                "warnings",
            ],
        ]
        for command in commands:
            if platform.system() == "Darwin":
                script = (
                    f"cd {shlex.quote(str(ROOT))} && "
                    'export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$HOME/target-vonk-ci-infra}" && '
                    f"{shlex.join(command)}"
                )
                run(["orb", "-m", "vonk-ci", "bash", "-lc", script])
            else:
                run(command)


if __name__ == "__main__":
    main()
