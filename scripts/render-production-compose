#!/usr/bin/env python3
"""Render the canonical production graph with digest-locked latest images."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import re
import tempfile
from pathlib import Path

import yaml

API_TOKEN = "${CONTROL_API_IMAGE:?set a digest-pinned control-api image}"
WORKER_TOKEN = "${CONTROL_WORKER_IMAGE:?set a digest-pinned control-worker image}"
HERMES_TOKEN = "${HERMES_AGENT_IMAGE:?set a digest-pinned Hermes image}"
TOKEN_COUNTS = {API_TOKEN: 1, WORKER_TOKEN: 1, HERMES_TOKEN: 1}
IMAGE_PATTERN = re.compile(
    r"ghcr\.io/carstvaartjes/vonk-forge-(?P<role>api|worker|hermes)"
    r":latest@sha256:[0-9a-f]{64}\Z"
)


def _validate_image(image: str, role: str) -> None:
    match = IMAGE_PATTERN.fullmatch(image)
    if match is None or match.group("role") != role:
        raise ValueError(
            f"{role} image must be the public production alias locked by digest"
        )


def _canonical_renderer():
    script = Path(__file__).with_name("render-dev-compose")
    loader = importlib.machinery.SourceFileLoader("canonical_compose_renderer", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ValueError("canonical Compose renderer is unavailable")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def render(
    template: Path,
    output: Path,
    api_image: str,
    worker_image: str,
    hermes_image: str,
) -> None:
    """Render one self-contained production Compose file."""
    if not template.is_file() or template.is_symlink():
        raise ValueError("template must be an existing regular file")
    if not output.parent.is_dir():
        raise ValueError("output parent must exist")
    try:
        if template.samefile(output):
            raise ValueError("template and output must be different files")
    except FileNotFoundError:
        if template.resolve() == output.resolve():
            raise ValueError("template and output must be different files")
    _validate_image(api_image, "api")
    _validate_image(worker_image, "worker")
    _validate_image(hermes_image, "hermes")

    text = template.read_text(encoding="utf-8")
    for token, count in TOKEN_COUNTS.items():
        actual = (
            text.count(token)
            if token in {API_TOKEN, WORKER_TOKEN}
            else _canonical_renderer()._count_template_token(template, token)
        )
        if actual != count:
            role = {
                API_TOKEN: "API",
                WORKER_TOKEN: "worker",
                HERMES_TOKEN: "Hermes",
            }[token]
            raise ValueError(f"template {role} image token count changed")
    canonical_renderer = _canonical_renderer()
    document = canonical_renderer._compose_document(template)
    document = canonical_renderer._replace_image_tokens(
        document,
        {
            API_TOKEN: api_image,
            WORKER_TOKEN: worker_image,
            HERMES_TOKEN: hermes_image,
        },
    )
    canonical_renderer._resolve_runtime_images(document)
    canonical_renderer._embed_runtime_assets(document, template.parent)
    rendered = yaml.safe_dump(document, sort_keys=False, default_flow_style=False)
    if "VONK_DEPLOYMENT_MODE: production" not in rendered:
        raise ValueError("template is not the production graph")

    descriptor, stage_name = tempfile.mkstemp(
        prefix=".render-production-compose-", dir=output.parent
    )
    stage = Path(stage_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(rendered)
            stream.flush()
            os.fsync(stream.fileno())
        stage.chmod(0o644)
        os.replace(stage, output)
    except BaseException:
        stage.unlink(missing_ok=True)
        raise


def _arguments() -> argparse.Namespace:
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--template", type=Path, default=root / "deploy/compose/compose.yaml"
    )
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--api-image", required=True)
    parser.add_argument("--worker-image", required=True)
    parser.add_argument("--hermes-image", required=True)
    return parser.parse_args()


def main() -> None:
    arguments = _arguments()
    render(
        arguments.template,
        arguments.output,
        arguments.api_image,
        arguments.worker_image,
        arguments.hermes_image,
    )


if __name__ == "__main__":
    main()
