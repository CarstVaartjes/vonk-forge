def marker_name(producer: str) -> str:
    return f"release-producer-{producer}"


def run(*args: str) -> str:
    return subprocess.check_output(args, text=True, timeout=60).strip()


def api(endpoint: str) -> dict:
    document = json.loads(run("gh", "api", endpoint))
    if not isinstance(document, dict):
        raise TypeError("unexpected API response")
    return document


def changed_matches(base: str, source: str, patterns: tuple[str, ...]) -> bool:
    # Disable rename detection: both the removed source and added destination
    # are inputs, even when Git recognizes their contents as one renamed file.
    names = run("git", "diff", "--name-only", "--no-renames", base, source).splitlines()
    # fnmatch is deliberately conservative: '*' may match '/' here, selecting
    # extra work rather than silently reusing a changed producer.
    return any(
        fnmatch.fnmatchcase(name, pattern) for name in names for pattern in patterns
    )


def is_ancestor(base: str, source: str) -> bool:
    status = subprocess.run(
        ["git", "merge-base", "--is-ancestor", base, source],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=30,
        check=False,
    ).returncode
    if status not in {0, 1}:
        raise ValueError("cannot establish producer ancestry")
    return status == 0


def available_artifacts(repo: str, run_id: int) -> set[str]:
    names: set[str] = set()
    page = 1
    while True:
        artifacts = api(
            f"repos/{repo}/actions/runs/{run_id}/artifacts"
            f"?per_page={PAGE_SIZE}&page={page}"
        )["artifacts"]
        names.update(
            artifact["name"] for artifact in artifacts if not artifact.get("expired")
        )
        if len(artifacts) < PAGE_SIZE:
            return names
        page += 1


def release_run_number(repo: str, run_id: int, base: str) -> int | None:
    record = api(f"repos/{repo}/actions/runs/{run_id}")
    if (
        record.get("path") == RELEASE_WORKFLOW
        and record.get("head_branch") == "main"
        and record.get("event") in RELEASE_EVENTS
        and record.get("head_sha") == base
        and isinstance(record.get("run_number"), int)
    ):
        return record["run_number"]
    return None


def resolve(
    producer: str, source: str, repo: str
) -> tuple[int, tuple[int, int, str] | None]:
    if producer not in PRODUCERS or not SHA.fullmatch(source):
        raise ValueError("invalid producer identity")
    spec = PRODUCERS[ProducerName(producer)]
    marker = marker_name(producer)
    page = 1
    while True:
        # The artifacts API lists the newest markers first.
        markers = api(
            f"repos/{repo}/actions/artifacts?name={marker}"
            f"&per_page={PAGE_SIZE}&page={page}"
        )["artifacts"]
        for record in markers:
            origin = record.get("workflow_run") or {}
            base = origin.get("head_sha", "")
            run_id = origin.get("id")
            if (
                record.get("expired")
                or record.get("name") != marker
                or origin.get("head_branch") != "main"
                or not isinstance(run_id, int)
                or not SHA.fullmatch(base)
                or not is_ancestor(base, source)
            ):
                continue
            # The newest ancestor that produced this evidence has different
            # inputs, so an older one can only match after a revert: build.
            if changed_matches(base, source, spec.paths):
                return 2, None
            if not spec.artifact_names(base) <= available_artifacts(repo, run_id):
                continue
            run_number = release_run_number(repo, run_id, base)
            if run_number is not None:
                return 0, (run_id, run_number, base)
        if len(markers) < PAGE_SIZE:
            return 2, None
        page += 1


def main() -> int:
    if len(sys.argv) != 3:
        return 64
    try:
        status, evidence = resolve(
            sys.argv[1], sys.argv[2], os.environ["GITHUB_REPOSITORY"]
        )
        if evidence is not None:
            print(*evidence, sep="\t")
        return status
    except (
        KeyError,
        TypeError,
        ValueError,
        subprocess.SubprocessError,
        OSError,
    ) as error:
        print(f"producer evidence: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
