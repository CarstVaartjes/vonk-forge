#!/usr/bin/env python3
"""Find accepted release evidence a development producer can reuse.

The release workflow runs a producer only when no earlier release run already
produced it from identical inputs. Every release run records each producer it
completed with a small ``release-producer-<name>`` marker artifact; this looks
up the newest marker on an ancestor of the source whose producer paths are
unchanged and whose producer artifacts are still available.

Exit 0 prints run ID, run number and producer source SHA; 2 means the producer
must run for this source; 1 rejects invalid input or unreadable evidence.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import subprocess
import sys
from typing import NamedTuple

RELEASE_WORKFLOW = ".github/workflows/installer-publication.yml"
RELEASE_EVENTS = {"push", "workflow_dispatch"}
SETUP_PLATFORMS = ("linux-amd64", "linux-arm64", "darwin-amd64", "darwin-arm64")
SHA = re.compile(r"[a-f0-9]{40}\Z")
PAGE_SIZE = 100
# Every producer is rebuilt when the release graph or this reuse rule changes.
ORCHESTRATION = (RELEASE_WORKFLOW, "scripts/resolve-publication-producer")


class Producer(NamedTuple):
    paths: tuple[str, ...]
    artifacts: tuple[str, ...]

    def artifact_names(self, sha: str) -> set[str]:
        return {name.format(sha=sha) for name in self.artifacts}


PRODUCERS = {
    "agent": Producer(
        paths=(
            *ORCHESTRATION,
            ".github/actions/agent-apt-publish/**",
            ".github/actions/agent-package-build/**",
            ".github/actions/agent-package-compile/**",
            ".github/actions/agent-package-security/**",
            ".github/workflows/agent-release.yml",
            "Cargo.lock",
            "Cargo.toml",
            "packaging/**",
            "rust/crates/vonk-agent/**",
            "rust/crates/vonk-monitor/**",
            "rust/crates/vonk-agent-helper/**",
            "rust/crates/vonk-agent-protocol/**",
            "rust/crates/vonk-build-egress/**",
            "rust/crates/vonk-repair-helper-probe/**",
            "scripts/agent-apt-metadata",
            "scripts/agent-apt-state",
            "scripts/agent-package-metadata",
            "scripts/build-agent-deb",
            "scripts/materialize-agent-tools",
            "scripts/test-agent-package-native-lifecycle",
            "tests/scripts/test_agent_deb.py",
            "tests/scripts/test_docker_firewall.sh",
            "scripts/verify-agent-binaries",
            "scripts/verify-agent-deb",
            "scripts/verify-agent-systemd",
            "scripts/verify-release-tag-authority",
        ),
        artifacts=(
            "vonk-agent-development-{sha}",
            "vonk-agent-development-{sha}-acceptance-baseline",
        ),
    ),
    "images": Producer(
        paths=(
            *ORCHESTRATION,
            ".dockerignore",
            ".github/actions/image-scan/**",
            ".github/workflows/dev-images.yml",
            "control/**",
            "deploy/compose/**",
            "inventory/wheels/**",
            "pyproject.toml",
            "uv.lock",
            "schemas/global/**",
            "scripts/accept-development-image-archive",
            "scripts/build-control-wheel",
            "scripts/dev-image-acceptance-receipt",
            "scripts/dev-image-metadata",
            "scripts/dev-image-inputs",
            "scripts/reuse-development-image",
            "scripts/prepare-journal-ca.py",
            "scripts/build-journal-ca",
            "agent_protocol/**",
            "scripts/promote-image-aliases",
            "scripts/publish-immutable-image",
            "scripts/render-dev-compose",
            "scripts/render-production-compose",
            "scripts/verify-public-image-inputs",
            "scripts/verify-published-image",
            "scripts/retry-dependency-fetch",
            "scripts/retry_dependency_fetch.py",
            "src/cluster_profiles/**",
        ),
        artifacts=("vonk-forge-dev-compose-{sha}",),
    ),
    "setups": Producer(
        paths=(
            *ORCHESTRATION,
            ".github/workflows/installer-setups.yml",
            "Cargo.lock",
            "Cargo.toml",
            "rust/crates/vonk-nas-setup/**",
            "rust/crates/vonk-spark-setup/**",
            "scripts/tests/run_installer_pty_recovery.sh",
        ),
        artifacts=tuple(
            f"installer-setup-{{sha}}-{platform}" for platform in SETUP_PLATFORMS
        ),
    ),
}


def marker_name(producer: str) -> str:
    return f"release-producer-{producer}"


def run(*args: str) -> str:
    return subprocess.check_output(args, text=True, timeout=60).strip()


def api(endpoint: str) -> dict:
    document = json.loads(run("gh", "api", endpoint))
    if not isinstance(document, dict):
        raise TypeError("unexpected API response")
    return document


def changed_matches(base: str, source: str, patterns: tuple[str, ...]) -> bool:
    # Disable rename detection: both the removed source and added destination
    # are inputs, even when Git recognizes their contents as one renamed file.
    names = run("git", "diff", "--name-only", "--no-renames", base, source).splitlines()
    # fnmatch is deliberately conservative: '*' may match '/' here, selecting
    # extra work rather than silently reusing a changed producer.
    return any(
        fnmatch.fnmatchcase(name, pattern) for name in names for pattern in patterns
    )


def is_ancestor(base: str, source: str) -> bool:
    status = subprocess.run(
        ["git", "merge-base", "--is-ancestor", base, source],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=30,
        check=False,
    ).returncode
    if status not in {0, 1}:
        raise ValueError("cannot establish producer ancestry")
    return status == 0


def available_artifacts(repo: str, run_id: int) -> set[str]:
    names: set[str] = set()
    page = 1
    while True:
        artifacts = api(
            f"repos/{repo}/actions/runs/{run_id}/artifacts"
            f"?per_page={PAGE_SIZE}&page={page}"
        )["artifacts"]
        names.update(
            artifact["name"] for artifact in artifacts if not artifact.get("expired")
        )
        if len(artifacts) < PAGE_SIZE:
            return names
        page += 1


def release_run_number(repo: str, run_id: int, base: str) -> int | None:
    record = api(f"repos/{repo}/actions/runs/{run_id}")
    if (
        record.get("path") == RELEASE_WORKFLOW
        and record.get("head_branch") == "main"
        and record.get("event") in RELEASE_EVENTS
        and record.get("head_sha") == base
        and isinstance(record.get("run_number"), int)
    ):
        return record["run_number"]
    return None


def resolve(
    producer: str, source: str, repo: str
) -> tuple[int, tuple[int, int, str] | None]:
    if producer not in PRODUCERS or not SHA.fullmatch(source):
        raise ValueError("invalid producer identity")
    spec = PRODUCERS[producer]
    marker = marker_name(producer)
    page = 1
    while True:
        # The artifacts API lists the newest markers first.
        markers = api(
            f"repos/{repo}/actions/artifacts?name={marker}"
            f"&per_page={PAGE_SIZE}&page={page}"
        )["artifacts"]
        for record in markers:
            origin = record.get("workflow_run") or {}
            base = origin.get("head_sha", "")
            run_id = origin.get("id")
            if (
                record.get("expired")
                or record.get("name") != marker
                or origin.get("head_branch") != "main"
                or not isinstance(run_id, int)
                or not SHA.fullmatch(base)
                or not is_ancestor(base, source)
            ):
                continue
            # The newest ancestor that produced this evidence has different
            # inputs, so an older one can only match after a revert: build.
            if changed_matches(base, source, spec.paths):
                return 2, None
            if not spec.artifact_names(base) <= available_artifacts(repo, run_id):
                continue
            run_number = release_run_number(repo, run_id, base)
            if run_number is not None:
                return 0, (run_id, run_number, base)
        if len(markers) < PAGE_SIZE:
            return 2, None
        page += 1


def main() -> int:
    if len(sys.argv) != 3:
        return 64
    try:
        status, evidence = resolve(
            sys.argv[1], sys.argv[2], os.environ["GITHUB_REPOSITORY"]
        )
        if evidence is not None:
            print(*evidence, sep="\t")
        return status
    except (
        KeyError,
        TypeError,
        ValueError,
        subprocess.SubprocessError,
        OSError,
    ) as error:
        print(f"producer evidence: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
