#!/usr/bin/env python3
"""Find accepted release evidence a development producer can reuse.

The release workflow runs a producer only when no earlier release run already
produced it from identical inputs. Every release run records each producer it
completed with a small ``release-producer-<name>`` marker artifact; this looks
up the newest marker on an ancestor of the source whose producer paths are
unchanged and whose producer artifacts are still available.

Exit 0 prints run ID, run number and producer source SHA; 2 means the producer
must run for this source; 1 rejects invalid input or unreadable evidence.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import subprocess
import sys
from enum import StrEnum
from typing import NamedTuple

RELEASE_WORKFLOW = ".github/workflows/installer-publication.yml"
RELEASE_EVENTS = {"push", "workflow_dispatch"}
SETUP_PLATFORMS = ("nas", "linux-arm64")
SHA = re.compile(r"[a-f0-9]{40}\Z")
PAGE_SIZE = 100
# Every producer is rebuilt when the release graph or this reuse rule changes.
ORCHESTRATION = (
    RELEASE_WORKFLOW,
    "scripts/resolve-publication-producer",
    ".tool-versions",
)
PROTOCOL_WHEEL_INPUTS = ("scripts/protocol-wheel-name", "scripts/protocol_wheel.py")


class ProducerName(StrEnum):
    """The development producers a release builds or reuses."""

    AGENT = "agent"
    IMAGES = "images"
    SETUPS = "setups"


class Producer(NamedTuple):
    paths: tuple[str, ...]
    artifacts: tuple[str, ...]

    def artifact_names(self, sha: str) -> set[str]:
        return {name.format(sha=sha) for name in self.artifacts}


