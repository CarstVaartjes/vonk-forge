#!/usr/bin/env python3
"""Print the reviewed guard selection or its complement's pytest exclusions."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from tests.repository_guards import GUARDS


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--exclusions", action="store_true")
    args = parser.parse_args()
    for guard in GUARDS:
        if args.exclusions:
            option = "--deselect" if "::" in guard else "--ignore"
            print(f"{option}={guard}")
        else:
            print(guard)


if __name__ == "__main__":
    main()
