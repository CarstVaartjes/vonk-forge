#!/usr/bin/env python3
"""Count the lifecycle debt a change adds or removes, and check a PR reports it.

The platform's lifecycle migration is measured by four numbers, all recorded in
the reviewed allowlists that the control suite already ratchets against the
code (a stale or moved count fails there), so they can be read from any commit
without running its code:

* ``writers``: lifecycle state writes outside the core
  (``tools/lifecycle-writers-allowlist.json``, the sum of the entry counts);
* ``operator_waits``: sites that produce an operator wait
  (``tools/blocker-allowlist.json``, ``operator_waits``);
* ``raises``: fail-closed raises in the audited modules
  (``tools/blocker-allowlist.json``, ``fail_closed``);
* ``debt``: operator-wait debt entries plus raises categorised
  ``bookkeeping-debt`` (``max_debt`` + ``debt_ceiling.total``).

Usage::

    scripts/lifecycle-counts                      # JSON of the working tree
    scripts/lifecycle-counts --ref origin/main    # JSON of another commit
    scripts/lifecycle-counts report --base origin/main
                                                  # the block to paste in a PR
    scripts/lifecycle-counts check --base origin/main --body-file body.md
                                                  # CI: does the PR report them?

``check`` applies to a pull request that touches lifecycle, raise or allowlist
files (see :func:`is_covered`).  Its description must carry ``before:`` and
``after:`` lines; ``before`` must equal the counts at the merge base with the
base branch and ``after`` the counts at the head.  The check does not decide
whether a rise is acceptable (the ratchets do); it makes the movement visible
and the report true.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections.abc import Callable, Iterable
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
WRITERS = "tools/lifecycle-writers-allowlist.json"
BLOCKERS = "tools/blocker-allowlist.json"
KEYS = ("writers", "operator_waits", "raises", "debt")

#: Files whose change must come with a before/after report.
COVERED_PREFIXES = (
    "control/src/vonk_control/lifecycle/",
    "rust/crates/vonk-agent/src/",
    "agent_protocol/src/vonk_agent_protocol/lifecycle_vocabulary.py",
)
COVERED_EXACT = (
    WRITERS,
    BLOCKERS,
    "tools/vocabulary-literals-baseline.json",
    "control/tests/lifecycle_writer_boundaries.py",
    "control/tests/blocker_boundaries.py",
    "control/tests/vocabulary_literals.py",
    "scripts/lifecycle-counts",
)

Reader = Callable[[str], str]


def count_documents(writers: dict, blockers: dict) -> dict[str, int]:
    """The four counts from the two allowlist documents."""

    wait_groups: dict[tuple[str, str, str], int] = {}
    for entry in blockers["operator_waits"]:
        key = (entry["path"], entry["function"], entry["kind"])
        wait_groups[key] = int(entry["sites"])
    raises = sum(
        int(site[4]) for family in blockers["fail_closed"] for site in family["sites"]
    )
    return {
        "writers": sum(int(entry["count"]) for entry in writers["writers"]),
        "operator_waits": sum(wait_groups.values()),
        "raises": raises,
        "debt": int(blockers["max_debt"]) + int(blockers["debt_ceiling"]["total"]),
    }


def counts_from(read: Reader) -> dict[str, int]:
    return count_documents(json.loads(read(WRITERS)), json.loads(read(BLOCKERS)))


def _git(*args: str) -> str:
    return subprocess.run(
        ("git", *args), cwd=REPO_ROOT, check=True, capture_output=True, text=True
    ).stdout


def reader_for(ref: str | None) -> Reader:
    if ref is None:
        return lambda path: (REPO_ROOT / path).read_text(encoding="utf-8")
    return lambda path: _git("show", f"{ref}:{path}")


def is_covered(path: str) -> bool:
    return path in COVERED_EXACT or path.startswith(COVERED_PREFIXES)


def covered_paths(paths: Iterable[str]) -> list[str]:
    return sorted(path for path in paths if is_covered(path.strip()))


_LINE = re.compile(r"^\s*[-*]?\s*(before|after)\s*:\s*(.+?)\s*$", re.I | re.M)
_PAIR = re.compile(r"([a-z_]+)\s*=\s*(\d+)")


def parse_report(body: str) -> dict[str, dict[str, int]]:
    """The ``before:`` / ``after:`` lines of a PR description."""

    found: dict[str, dict[str, int]] = {}
    for label, rest in _LINE.findall(body):
        found[label.lower()] = {key: int(value) for key, value in _PAIR.findall(rest)}
    return found


def render(counts: dict[str, int]) -> str:
    return " ".join(f"{key}={counts[key]}" for key in KEYS)


def report_block(before: dict[str, int], after: dict[str, int]) -> str:
    return f"before: {render(before)}\nafter: {render(after)}\n"


def check(
    body: str, before: dict[str, int], after: dict[str, int], changed: Iterable[str]
) -> list[str]:
    covered = covered_paths(changed)
    if not covered:
        return []
    reported = parse_report(body)
    template = report_block(before, after).rstrip()
    messages: list[str] = []
    for label, actual in (("before", before), ("after", after)):
        if label not in reported:
            messages.append(
                f"the description has no '{label}:' line; this change touches "
                f"lifecycle files ({', '.join(covered[:3])}"
                f"{', ...' if len(covered) > 3 else ''}). Add:\n{template}"
            )
        elif reported[label] != actual:
            messages.append(
                f"'{label}:' says {render(reported[label])} but the real counts are "
                f"{render(actual)}. Use:\n{template}"
            )
    return messages


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("command", nargs="?", choices=("report", "check"))
    parser.add_argument("--ref", help="print the counts of this commit (default: tree)")
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--head", default="HEAD")
    parser.add_argument("--body-file", type=Path)
    arguments = parser.parse_args(argv)

    if arguments.command is None:
        print(json.dumps(counts_from(reader_for(arguments.ref)), sort_keys=True))
        return 0
    merge_base = _git("merge-base", arguments.base, arguments.head).strip()
    before = counts_from(reader_for(merge_base))
    after = counts_from(reader_for(arguments.head))
    if arguments.command == "report":
        sys.stdout.write(report_block(before, after))
        return 0
    body = (
        arguments.body_file.read_text(encoding="utf-8") if arguments.body_file else ""
    )
    changed = _git("diff", "--name-only", merge_base, arguments.head).splitlines()
    messages = check(body, before, after, changed)
    for message in messages:
        print(f"lifecycle-counts: {message}", file=sys.stderr)
    if not messages:
        print(f"lifecycle counts: {render(before)} -> {render(after)}")
    return 1 if messages else 0


if __name__ == "__main__":
    raise SystemExit(main())
