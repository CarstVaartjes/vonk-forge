#!/usr/bin/env python3
"""Generate the admin-only OpenAPI and pinned upstream language clients.

Generator provenance:
- openapi-python-client==0.29.1 from the workspace uv.lock
- openapi-typescript==7.13.0 from tools/openapi-client/package-lock.json

The TypeScript transport uses pinned openapi-fetch. Its DTOs and standalone
runtime validators are generated together from this same canonical document.
"""

# ruff: noqa: E402 - the project imports follow run_in_control, which re-executes in the control environment
from __future__ import annotations

import argparse
import enum
import inspect
import json
import os
import re
import subprocess
import tempfile
from copy import deepcopy
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

if __name__ == "__main__":
    from check_environment import run_in_control

    run_in_control(ROOT)

import nodejs_wheel
from sqlalchemy.orm import sessionmaker
from vonk_forge_contracts.qualification_status import (
    QualificationOutcome,
    QualificationStatus,
)

from vonk_agent_protocol.job_wire import MEDIA_TYPE_PATTERN
from vonk_agent_protocol.lifecycle_vocabulary import (
    LIVE_LIFECYCLE_STATES,
    TERMINAL_LIFECYCLE_STATES,
    UNSUCCESSFUL_LIFECYCLE_STATES,
    LifecycleState,
    LifecycleVocabulary,
)
from vonk_agent_protocol.phase_words import BYTE_PHASES, PHASE_WORDS, WAIT_WORDS
from vonk_agent_protocol.reason_codes.vocabulary import ReasonCodeVocabulary
from vonk_agent_protocol.recipe_jobs import canonical_media_types
from vonk_control import control_limits
from vonk_control.api.application import create_app
from vonk_control.auth import TokenCodec
from vonk_control.browser_auth import BrowserAuthService
from vonk_control.cache_removal_review import CacheAssetDisposition
from vonk_control.cli_update_contract import cli_update_contract_schema
from vonk_control.fleet_model_removal_contract import (
    FleetRemovalDisposition,
    FleetRemovalReason,
)
from vonk_control.fleet_profile_contract.review import ProfileLoadAction
from vonk_control.library.contract import LibraryCacheState
from vonk_control.model_cache.contract import (
    CacheOperationKind,
    ModelStorageObservationReason,
)
from vonk_control.operation_api.openapi import admin_openapi_schema
from vonk_control.run_readiness import GroupHealth

OPENAPI = ROOT / "control/openapi.json"
PYTHON_OUTPUT = ROOT / "src/cluster_profiles/generated_control"
TYPESCRIPT_OUTPUT = ROOT / "control/web/src/api/generated.d.ts"
CLI_OPENAPI_OUTPUT = ROOT / "src/cluster_profiles/schemas/control-openapi.json"
TYPESCRIPT_VOCABULARY = ROOT / "control/web/src/api/vocabulary.generated.ts"


class _SchemaJobs:
    def enqueue(self, *_args: object, **_kwargs: object) -> object:
        raise RuntimeError("schema application cannot enqueue")

    def get(self, job_id: str) -> object:
        raise KeyError(job_id)


def _schema(*, include_browser_auth: bool) -> dict[str, object]:
    signing_key = b"schema-only-signing-key-32-bytes!"
    app = create_app(
        jobs=_SchemaJobs(),
        tokens=TokenCodec(signing_key),
        browser_auth=(
            BrowserAuthService(
                sessionmaker(),
                token_signing_key=signing_key,
                clock=lambda: datetime.now(UTC),
            )
            if include_browser_auth
            else None
        ),
    )
    return admin_openapi_schema(app)


def typescript_vocabulary() -> str:
    """Render the lifecycle vocabulary as runtime TypeScript constants.

    ``generated.d.ts`` carries the types only; the web app needs the words at run
    time (``state === LifecycleState.RUNNING``), and a guard keeps it from
    spelling them by hand.
    """

    lines = [
        "// Generated by scripts/generate-control-clients from",
        "// vonk_agent_protocol.lifecycle_vocabulary and",
        "// vonk_agent_protocol.reason_codes and Controller contracts. Do not edit.",
        "",
    ]
    word_types = [
        field.annotation
        for carrier in (LifecycleVocabulary, ReasonCodeVocabulary)
        for field in carrier.model_fields.values()
    ]
    word_types.extend(
        (
            FleetRemovalDisposition,
            FleetRemovalReason,
            CacheAssetDisposition,
            CacheOperationKind,
            LibraryCacheState,
            ProfileLoadAction,
            ModelStorageObservationReason,
            QualificationStatus,
            QualificationOutcome,
            GroupHealth,
        )
    )
    for words in word_types:
        assert isinstance(words, type)
        assert issubclass(words, enum.Enum)
        lines.append(f"export const {words.__name__} = {{")
        lines.extend(
            f"  {member.name}: {json.dumps(member.value)}," for member in words
        )
        lines.append("} as const;")
        lines.append(
            f"export type {words.__name__} = "
            f"(typeof {words.__name__})[keyof typeof {words.__name__}];"
        )
        lines.append("")
    # The one grouping of operation states every client reads: it ended, it
    # has not, or it ended as a failure (a cancel or a replacement is neither).
    for name, states in (
        ("TERMINAL_LIFECYCLE_STATES", TERMINAL_LIFECYCLE_STATES),
        ("LIVE_LIFECYCLE_STATES", LIVE_LIFECYCLE_STATES),
        ("UNSUCCESSFUL_LIFECYCLE_STATES", UNSUCCESSFUL_LIFECYCLE_STATES),
    ):
        members = ", ".join(
            json.dumps(state.value) for state in LifecycleState if state in states
        )
        lines.append(
            f"export const {name}: ReadonlySet<string> = new Set([{members}]);"
        )
    lines.append("")
    for name, table in (("PHASE_WORDS", PHASE_WORDS), ("WAIT_WORDS", WAIT_WORDS)):
        lines.append(f"export const {name}: Readonly<Record<string, string>> = {{")
        lines.extend(
            f"  {json.dumps(key)}: {json.dumps(text)}," for key, text in table.items()
        )
        lines.append("};")
        lines.append("")
    members = ", ".join(json.dumps(phase) for phase in BYTE_PHASES)
    lines.append(
        f"export const BYTE_PHASES: ReadonlySet<string> = new Set([{members}]);"
    )
    lines.append("")
    return "\n".join(lines).rstrip("\n") + "\n"


def _write_openapi(document: dict[str, object], *, path: Path = OPENAPI) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(document, sort_keys=True, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )


def _generated_client_schema(
    document: dict[str, object], *, python_compatibility: bool = False
) -> dict[str, object]:
    """Prepare a client schema without changing the server contract."""

    schema = deepcopy(document)
    paths = schema.get("paths", {})
    assert isinstance(paths, dict)
    for path, path_item in list(paths.items()):
        for method, operation in list(path_item.items()):
            if operation.get("x-vonk-streaming-transport") is True:
                del path_item[method]
        if not path_item:
            del paths[path]
    if python_compatibility:
        # openapi-python-client (still as of 0.29.1) cannot parse recursive
        # anyOf unions.
        # Keep the server and TypeScript schemas exact while making these
        # JSON-shaped values Any in the generated Python client.  An empty
        # schema is openapi-python-client's supported spelling for Any and
        # preserves scalar, array, null, and object values.
        components = schema.get("components", {})
        assert isinstance(components, dict)
        schemas = components.get("schemas", {})
        for name in list(schemas):
            # Pydantic uses a qualified component name when a recursive JSON
            # value comes from an imported contract module.  Match the leaf
            # name so that the compatibility copy stays correct after a
            # contract package is reorganized.
            if name.rsplit("__", 1)[-1] in {"JsonValue", "RuntimeArgumentValue"}:
                schemas[name] = {}
    return schema


def _node_wheel_root() -> Path:
    return Path(nodejs_wheel.__file__).parent


def _run(command: list[str]) -> None:
    subprocess.run(
        command,
        cwd=ROOT,
        env={
            **os.environ,
            "PYTHONHASHSEED": "0",
            "SOURCE_DATE_EPOCH": "0",
        },
        check=True,
        timeout=1200,
    )


def _normalize_generated_text(path: Path) -> None:
    """Remove generator-only trailing whitespace without changing semantics."""
    files = sorted(path.rglob("*.py")) if path.is_dir() else [path]
    for generated_file in files:
        lines = generated_file.read_text(encoding="utf-8").splitlines()
        while lines and not lines[-1].strip():
            lines.pop()
        normalized = [
            re.sub(r"(?<=[0-9'\"])and(?= not\b)", " and", line.rstrip())
            for line in lines
        ]
        generated_file.write_text(
            "\n".join(normalized) + "\n",
            encoding="utf-8",
            newline="\n",
        )


def _use_httpx2(path: Path) -> None:
    """Point the generated Python client at httpx2, the maintained httpx fork.

    openapi-python-client still emits ``httpx`` (0.29.1); drop this rewrite once
    it generates httpx2 itself (openapi-generators/openapi-python-client#1461).
    """
    for generated_file in sorted(path.rglob("*.py")):
        text = generated_file.read_text(encoding="utf-8")
        generated_file.write_text(
            re.sub(r"\bhttpx\b", "httpx2", text), encoding="utf-8", newline="\n"
        )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--schema-only",
        action="store_true",
        help="regenerate only the OpenAPI document without Node tooling",
    )
    parser.add_argument(
        "--cli-update-schema-only",
        action="store_true",
        help="emit the canonical CLI compatibility resource before package installation",
    )
    parser.add_argument(
        "--python-only",
        action="store_true",
        help="generate CLI resources and Python client without Node",
    )
    parser.add_argument("--output-root", type=Path, default=ROOT)
    arguments = parser.parse_args()
    output_root = arguments.output_root.resolve()
    python_output = output_root / PYTHON_OUTPUT.relative_to(ROOT)
    cli_openapi_output = output_root / CLI_OPENAPI_OUTPUT.relative_to(ROOT)

    _write_openapi(
        cli_update_contract_schema(),
        path=output_root
        / "src/cluster_profiles/schemas/cli-update-contract.schema.json",
    )
    if arguments.cli_update_schema_only:
        return

    if arguments.schema_only:
        _write_openapi(
            _schema(include_browser_auth=True),
            path=output_root / OPENAPI.relative_to(ROOT),
        )
        _write_openapi(_schema(include_browser_auth=False), path=cli_openapi_output)
        return

    # Keep the document complete. Generated clients receive a filtered
    # copy because large byte streams use the handwritten Python and browser
    # transports instead of buffered typed-client methods.
    with tempfile.TemporaryDirectory(prefix="vonk-openapi-clients-") as temporary:
        client_openapi = Path(temporary) / "openapi.json"

        admin_schema = _schema(include_browser_auth=False)
        _write_openapi(admin_schema, path=cli_openapi_output)
        _write_openapi(
            _generated_client_schema(admin_schema, python_compatibility=True),
            path=client_openapi,
        )
        _run(
            [
                "openapi-python-client",
                "generate",
                "--path",
                str(client_openapi),
                "--config",
                str(ROOT / "control/openapi-python-client.yaml"),
                "--meta",
                "none",
                "--output-path",
                str(python_output),
                "--overwrite",
                "--fail-on-warning",
            ],
        )
        # Ship the protocol's pure canonicalizer without making the standalone
        # CLI depend on the protocol package or Pydantic at runtime.
        python_output.mkdir(parents=True, exist_ok=True)
        (python_output / "media_types.py").write_text(
            '"""Generated from vonk_agent_protocol.recipe_jobs. Do not edit."""\n\n'
            "import re\nfrom collections.abc import Iterable\n\n"
            f"MEDIA_TYPE_PATTERN = {MEDIA_TYPE_PATTERN!r}\n\n\n"
            + inspect.getsource(canonical_media_types),
            encoding="utf-8",
        )
        # The Controller owns the document bound; the CLI reads a generated copy,
        # never the server package.
        (python_output / "limits.py").write_text(
            '"""Generated from vonk_control.control_limits. Do not edit."""\n\n'
            f"MAX_CONTROL_DOCUMENT_BYTES = {control_limits.MAX_CONTROL_DOCUMENT_BYTES}\n",
            encoding="utf-8",
        )
        _use_httpx2(python_output)
        _normalize_generated_text(python_output)

        if arguments.python_only:
            return

        browser_schema = _schema(include_browser_auth=True)
        _write_openapi(browser_schema)
        _write_openapi(_generated_client_schema(browser_schema), path=client_openapi)
        TYPESCRIPT_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
        if not (
            ROOT / "tools/openapi-client/node_modules/.package-lock.json"
        ).is_file():
            _run(
                [
                    str(_node_wheel_root() / "bin/node"),
                    # The wheel's bin/npm shim requires ../lib/cli.js, which the
                    # wheel does not ship; run npm's real entry point (as
                    # nodejs_wheel.executable.npm does) so a host without a
                    # system npm works.
                    str(_node_wheel_root() / "lib/node_modules/npm/bin/npm-cli.js"),
                    "ci",
                    "--prefix",
                    "tools/openapi-client",
                ],
            )

        _run(
            [
                str(_node_wheel_root() / "bin/node"),
                str(ROOT / "tools/openapi-client/generate-runtime.mjs"),
                str(OPENAPI),
            ],
        )
        _normalize_generated_text(TYPESCRIPT_OUTPUT)
        TYPESCRIPT_VOCABULARY.write_text(
            typescript_vocabulary(), encoding="utf-8", newline="\n"
        )


if __name__ == "__main__":
    main()
