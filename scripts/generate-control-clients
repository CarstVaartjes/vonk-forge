#!/usr/bin/env -S uv run --project control --frozen python
"""Generate the admin-only OpenAPI and pinned upstream language clients.

Generator provenance:
- openapi-python-client==0.29.1 from control/uv.lock
- openapi-typescript==7.13.0 from tools/openapi-client/package-lock.json

The TypeScript client transport is intentionally supplied by the separately
pinned openapi-fetch dependency; this task generates its schema types only.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import tempfile
from copy import deepcopy
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
OPENAPI = ROOT / "control/openapi.json"
PYTHON_OUTPUT = ROOT / "src/cluster_profiles/generated_control"
TYPESCRIPT_OUTPUT = ROOT / "control/web/src/api/generated.d.ts"
CLI_OPENAPI_OUTPUT = ROOT / "src/cluster_profiles/schemas/control-openapi.json"
TYPESCRIPT_VOCABULARY = ROOT / "control/web/src/api/vocabulary.generated.ts"


class _SchemaJobs:
    def enqueue(self, *_args: object, **_kwargs: object) -> object:
        raise RuntimeError("schema application cannot enqueue")

    def get(self, job_id: str) -> object:
        raise KeyError(job_id)


def _schema(*, include_browser_auth: bool) -> dict[str, object]:
    from sqlalchemy.orm import sessionmaker
    from vonk_control.api import create_app
    from vonk_control.auth import TokenCodec
    from vonk_control.browser_auth import BrowserAuthService
    from vonk_control.operation_api import admin_openapi_schema

    signing_key = b"schema-only-signing-key-32-bytes!"
    app = create_app(
        jobs=_SchemaJobs(),
        tokens=TokenCodec(signing_key),
        browser_auth=(
            BrowserAuthService(
                sessionmaker(),
                token_signing_key=signing_key,
                clock=lambda: datetime.now(UTC),
            )
            if include_browser_auth
            else None
        ),
    )
    return admin_openapi_schema(app)


def typescript_vocabulary() -> str:
    """Render the lifecycle vocabulary as runtime TypeScript constants.

    ``generated.d.ts`` carries the types only; the web app needs the words at run
    time (``state === LifecycleState.RUNNING``), and a guard keeps it from
    spelling them by hand.
    """

    import enum

    from vonk_agent_protocol import LifecycleVocabulary, ReasonCodeVocabulary

    lines = [
        "// Generated by scripts/generate-control-clients from",
        "// vonk_agent_protocol.lifecycle_vocabulary and",
        "// vonk_agent_protocol.reason_codes. Do not edit.",
        "",
    ]
    for carrier in (LifecycleVocabulary, ReasonCodeVocabulary):
        for field in carrier.model_fields.values():
            words = field.annotation
            assert isinstance(words, type) and issubclass(words, enum.Enum)
            lines.append(f"export const {words.__name__} = {{")
            lines.extend(
                f"  {member.name}: {json.dumps(member.value)}," for member in words
            )
            lines.append("} as const;")
            lines.append(
                f"export type {words.__name__} = "
                f"(typeof {words.__name__})[keyof typeof {words.__name__}];"
            )
            lines.append("")
    from vonk_agent_protocol import INPUT_ALIASES

    lines.append(
        "/** What a retired state spelling means, accepted as input for one release. */"
    )
    lines.append("export const STATE_INPUT_ALIASES = {")
    lines.extend(
        f"  {json.dumps(alias.value)}: LifecycleState.{state.name},"
        for alias, state in INPUT_ALIASES.items()
    )
    lines.append("} as const;")
    lines.append("")
    lines.append(
        "/** Retired wait spelling, adopted only when reading old rows. */"
    )
    lines.append(
        'export const LEGACY_WAIT_STATE = "waiting-for-operator";'
    )
    return "\n".join(lines) + "\n"


def _write_openapi(document: dict[str, object], *, path: Path = OPENAPI) -> None:
    path.write_text(
        json.dumps(document, sort_keys=True, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )


def _generated_client_schema(
    document: dict[str, object], *, python_compatibility: bool = False
) -> dict[str, object]:
    """Prepare a client schema without changing the tracked server contract."""

    schema = deepcopy(document)
    paths = schema.get("paths", {})
    for path, path_item in list(paths.items()):
        for method, operation in list(path_item.items()):
            if operation.get("x-vonk-streaming-transport") is True:
                del path_item[method]
        if not path_item:
            del paths[path]
    if python_compatibility:
        # openapi-python-client (still as of 0.29.1) cannot parse recursive
        # anyOf unions.
        # Keep the server and TypeScript schemas exact while making these
        # JSON-shaped values Any in the generated Python client.  An empty
        # schema is openapi-python-client's supported spelling for Any and
        # preserves scalar, array, null, and object values.
        components = schema.get("components", {})
        schemas = components.get("schemas", {})
        for name in list(schemas):
            # Pydantic uses a qualified component name when a recursive JSON
            # value comes from an imported contract module.  Match the leaf
            # name so that the compatibility copy stays correct after a
            # contract package is reorganized.
            if name.rsplit("__", 1)[-1] in {"JsonValue", "RuntimeArgumentValue"}:
                schemas[name] = {}
    return schema


def _run(command: list[str]) -> None:
    subprocess.run(
        command,
        cwd=ROOT,
        env={
            **os.environ,
            "PYTHONHASHSEED": "0",
            "SOURCE_DATE_EPOCH": "0",
        },
        check=True,
        timeout=1200,
    )


def _normalize_generated_text(path: Path) -> None:
    """Remove generator-only trailing whitespace without changing semantics."""
    files = sorted(path.rglob("*.py")) if path.is_dir() else [path]
    for generated_file in files:
        lines = generated_file.read_text(encoding="utf-8").splitlines()
        while lines and not lines[-1].strip():
            lines.pop()
        normalized = [
            re.sub(r"(?<=[0-9'\"])and(?= not\b)", " and", line.rstrip())
            for line in lines
        ]
        generated_file.write_text(
            "\n".join(normalized) + "\n",
            encoding="utf-8",
            newline="\n",
        )


def _use_httpx2(path: Path) -> None:
    """Point the generated Python client at httpx2, the maintained httpx fork.

    openapi-python-client still emits ``httpx`` (0.29.1); drop this rewrite once
    it generates httpx2 itself (openapi-generators/openapi-python-client#1461).
    """
    for generated_file in sorted(path.rglob("*.py")):
        text = generated_file.read_text(encoding="utf-8")
        generated_file.write_text(
            re.sub(r"\bhttpx\b", "httpx2", text), encoding="utf-8", newline="\n"
        )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--schema-only",
        action="store_true",
        help="regenerate only the tracked OpenAPI document without Node tooling",
    )
    arguments = parser.parse_args()

    if arguments.schema_only:
        _write_openapi(_schema(include_browser_auth=True))
        _write_openapi(_schema(include_browser_auth=False), path=CLI_OPENAPI_OUTPUT)
        return

    # Keep the tracked document complete. Generated clients receive a filtered
    # copy because large byte streams use the handwritten Python and browser
    # transports instead of buffered typed-client methods.
    with tempfile.TemporaryDirectory(prefix="vonk-openapi-clients-") as temporary:
        client_openapi = Path(temporary) / "openapi.json"

        admin_schema = _schema(include_browser_auth=False)
        _write_openapi(admin_schema)
        _write_openapi(admin_schema, path=CLI_OPENAPI_OUTPUT)
        _write_openapi(
            _generated_client_schema(admin_schema, python_compatibility=True),
            path=client_openapi,
        )
        _run(
            [
                "openapi-python-client",
                "generate",
                "--path",
                str(client_openapi),
                "--config",
                str(ROOT / "control/openapi-python-client.yaml"),
                "--meta",
                "none",
                "--output-path",
                str(PYTHON_OUTPUT),
                "--overwrite",
                "--fail-on-warning",
            ],
        )
        _use_httpx2(PYTHON_OUTPUT)
        _normalize_generated_text(PYTHON_OUTPUT)

        browser_schema = _schema(include_browser_auth=True)
        _write_openapi(browser_schema)
        _write_openapi(_generated_client_schema(browser_schema), path=client_openapi)
        TYPESCRIPT_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
        _run(
            [
                str(ROOT / "tools/openapi-client/node_modules/.bin/openapi-typescript"),
                str(client_openapi),
                "--output",
                str(TYPESCRIPT_OUTPUT),
            ],
        )
        _normalize_generated_text(TYPESCRIPT_OUTPUT)
        TYPESCRIPT_VOCABULARY.write_text(
            typescript_vocabulary(), encoding="utf-8", newline="\n"
        )


if __name__ == "__main__":
    main()
