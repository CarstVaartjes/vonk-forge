#!/usr/bin/env -S uv run --python 3.12 --project control --frozen --group dev --with-editable . --with-editable agent_protocol python
"""Generate the admin-only OpenAPI and pinned upstream language clients.

Generator provenance:
- openapi-python-client==0.26.2 from control/uv.lock
- openapi-typescript==7.13.0 from tools/openapi-client/package-lock.json

The TypeScript client transport is intentionally supplied by the separately
pinned openapi-fetch dependency; this task generates its schema types only.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import tempfile
from copy import deepcopy
from datetime import UTC, datetime
from pathlib import Path

from sqlalchemy.orm import sessionmaker
from vonk_control.api import create_app
from vonk_control.audit import MemoryAuditStore
from vonk_control.auth import TokenCodec
from vonk_control.browser_auth import BrowserAuthService
from vonk_control.operation_api import admin_openapi_schema

ROOT = Path(__file__).resolve().parents[1]
OPENAPI = ROOT / "control/openapi.json"
PYTHON_OUTPUT = ROOT / "src/cluster_profiles/generated_control"
TYPESCRIPT_OUTPUT = ROOT / "control/web/src/api/generated.d.ts"


class _SchemaJobs:
    def enqueue(self, *_args: object, **_kwargs: object) -> object:
        raise RuntimeError("schema application cannot enqueue")

    def get(self, job_id: str) -> object:
        raise KeyError(job_id)

    def list(self, *, limit: int = 100) -> list[object]:
        del limit
        return []

    def list_page(
        self,
        *,
        limit: int = 100,
        cursor: str | None = None,
        status: str | None = None,
        target: str | None = None,
    ) -> tuple[list[object], str | None, int]:
        del limit, cursor, status, target
        return [], None, 0


def _schema(*, include_browser_auth: bool) -> dict[str, object]:
    signing_key = b"schema-only-signing-key-32-bytes!"
    app = create_app(
        jobs=_SchemaJobs(),
        tokens=TokenCodec(signing_key),
        audits=MemoryAuditStore(),
        fleet=lambda: {"commit": "0" * 40, "nodes": []},
        browser_auth=(
            BrowserAuthService(
                sessionmaker(),
                token_signing_key=signing_key,
                clock=lambda: datetime.now(UTC),
            )
            if include_browser_auth
            else None
        ),
    )
    return admin_openapi_schema(app)


def _write_openapi(document: dict[str, object], *, path: Path = OPENAPI) -> None:
    path.write_text(
        json.dumps(document, sort_keys=True, indent=2) + "\n",
        encoding="utf-8",
        newline="\n",
    )


def _generated_client_schema(document: dict[str, object]) -> dict[str, object]:
    """Exclude byte streams that require the handwritten streaming transports."""

    schema = deepcopy(document)
    paths = schema.get("paths", {})
    for path, path_item in list(paths.items()):
        for method, operation in list(path_item.items()):
            if operation.get("x-vonk-streaming-transport") is True:
                del path_item[method]
        if not path_item:
            del paths[path]
    return schema


def _run(command: list[str]) -> None:
    subprocess.run(
        command,
        cwd=ROOT,
        env={
            **os.environ,
            "PYTHONHASHSEED": "0",
            "SOURCE_DATE_EPOCH": "0",
        },
        check=True,
    )


def _normalize_generated_text(path: Path) -> None:
    """Remove generator-only trailing whitespace without changing semantics."""
    files = sorted(path.rglob("*.py")) if path.is_dir() else [path]
    for generated_file in files:
        lines = generated_file.read_text(encoding="utf-8").splitlines()
        while lines and not lines[-1].strip():
            lines.pop()
        normalized = [
            re.sub(r"(?<=[0-9'\"])and(?= not\b)", " and", line.rstrip())
            for line in lines
        ]
        generated_file.write_text(
            "\n".join(normalized) + "\n",
            encoding="utf-8",
            newline="\n",
        )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--schema-only",
        action="store_true",
        help="regenerate only the tracked OpenAPI document without Node tooling",
    )
    arguments = parser.parse_args()

    if arguments.schema_only:
        _write_openapi(_schema(include_browser_auth=True))
        return

    # Keep the tracked document complete. Generated clients receive a filtered
    # copy because large byte streams use the handwritten Python and browser
    # transports instead of buffered typed-client methods.
    with tempfile.TemporaryDirectory(prefix="vonk-openapi-clients-") as temporary:
        client_openapi = Path(temporary) / "openapi.json"

        admin_schema = _schema(include_browser_auth=False)
        _write_openapi(admin_schema)
        _write_openapi(_generated_client_schema(admin_schema), path=client_openapi)
        _run(
            [
                "openapi-python-client",
                "generate",
                "--path",
                str(client_openapi),
                "--config",
                str(ROOT / "control/openapi-python-client.yaml"),
                "--meta",
                "none",
                "--output-path",
                str(PYTHON_OUTPUT),
                "--overwrite",
            ]
        )
        _normalize_generated_text(PYTHON_OUTPUT)

        browser_schema = _schema(include_browser_auth=True)
        _write_openapi(browser_schema)
        _write_openapi(_generated_client_schema(browser_schema), path=client_openapi)
        TYPESCRIPT_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
        _run(
            [
                str(ROOT / "tools/openapi-client/node_modules/.bin/openapi-typescript"),
                str(client_openapi),
                "--output",
                str(TYPESCRIPT_OUTPUT),
            ]
        )
        _normalize_generated_text(TYPESCRIPT_OUTPUT)


if __name__ == "__main__":
    main()
