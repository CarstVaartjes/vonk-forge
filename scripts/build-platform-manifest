#!/usr/bin/env python3
"""Assemble one canonical v2 platform manifest from reviewed release input."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path
from typing import Any

repository_src = Path(__file__).resolve().parents[1] / "src"
if str(repository_src) not in sys.path:
    sys.path.insert(0, str(repository_src))

from cluster_profiles.platform_release import PlatformRelease, PlatformReleaseError

_SEMVER = re.compile(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\Z")
_MAX_INPUT_BYTES = 1024 * 1024


class BuildError(RuntimeError):
    """Release input cannot produce the requested canonical manifest."""


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read_object(path: Path, label: str) -> dict[str, Any]:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise BuildError(f"{label} is unavailable or unsafe") from error
    try:
        details = os.fstat(descriptor)
        if (
            not stat.S_ISREG(details.st_mode)
            or details.st_nlink != 1
            or not 0 < details.st_size <= _MAX_INPUT_BYTES
        ):
            raise BuildError(f"{label} is unavailable or unsafe")
        raw = b""
        while len(raw) < details.st_size:
            chunk = os.read(descriptor, details.st_size - len(raw))
            if not chunk:
                raise BuildError(f"{label} changed while read")
            raw += chunk
    finally:
        os.close(descriptor)
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BuildError(f"{label} is invalid") from error
    if not isinstance(value, dict) or raw != _canonical(value):
        raise BuildError(f"{label} must use canonical JSON")
    return value


def _write_new(path: Path, raw: bytes) -> None:
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o644,
        )
    except OSError as error:
        raise BuildError("output already exists or is unsafe") from error
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fchmod(descriptor, 0o644)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _bind_artifact(document: dict[str, Any], evidence: dict[str, Any]) -> None:
    if (
        set(evidence) != {"artifact", "locator", "schema_version"}
        or evidence.get("schema_version") != 1
    ):
        raise BuildError("artifact evidence is invalid")
    locator = evidence.get("locator")
    artifact = evidence.get("artifact")
    if not isinstance(locator, str) or not isinstance(artifact, dict):
        raise BuildError("artifact evidence is invalid")
    if locator == "control.images.api":
        destination = document["control"]["images"]
        key = "api"
    elif locator == "control.images.worker":
        destination = document["control"]["images"]
        key = "worker"
    elif locator.startswith("control.assets."):
        name = locator.removeprefix("control.assets.")
        matches = [
            item
            for item in document["control"]["assets"]
            if isinstance(item, dict) and item.get("name") == name
        ]
        if len(matches) != 1:
            raise BuildError("artifact evidence locator is unknown")
        matches[0].clear()
        matches[0].update(artifact)
        return
    else:
        raise BuildError("artifact evidence locator is unknown")
    destination[key] = artifact


def _bind_agent_package(document: dict[str, Any], evidence: dict[str, Any]) -> None:
    if (
        set(evidence) != {"package", "locator", "schema_version"}
        or evidence.get("schema_version") != 1
    ):
        raise BuildError("agent package evidence is invalid")
    locator = evidence.get("locator")
    package = evidence.get("package")
    if (
        not isinstance(locator, str)
        or not locator.startswith("agent_packages.")
        or not isinstance(package, dict)
    ):
        raise BuildError("agent package evidence is invalid")
    architecture = locator.removeprefix("agent_packages.")
    matches = [
        item
        for item in document.get("agent_packages", [])
        if isinstance(item, dict) and item.get("architecture") == architecture
    ]
    if len(matches) != 1:
        raise BuildError("agent package evidence locator is unknown")
    matches[0].clear()
    matches[0].update(package)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="build-platform-manifest")
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--bundle-descriptor", required=True, type=Path)
    parser.add_argument("--artifact-evidence", action="append", default=[], type=Path)
    parser.add_argument(
        "--agent-package-evidence", action="append", default=[], type=Path
    )
    parser.add_argument("--version", required=True)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args(argv)
    try:
        if _SEMVER.fullmatch(args.version) is None:
            raise BuildError("platform version is invalid")
        release_input = _read_object(args.input, "platform release input")
        bundle = _read_object(args.bundle_descriptor, "deployment bundle descriptor")
        if "deployment_bundle" in release_input:
            raise BuildError("platform release input must not preselect a bundle")
        if release_input.get("platform_version") != args.version:
            raise BuildError("platform version disagrees with release input")
        seen_locators: set[str] = set()
        for evidence_path in args.artifact_evidence:
            evidence = _read_object(evidence_path, "artifact evidence")
            locator = evidence.get("locator")
            if not isinstance(locator, str) or locator in seen_locators:
                raise BuildError("artifact evidence locators overlap")
            seen_locators.add(locator)
            _bind_artifact(release_input, evidence)
        for evidence_path in args.agent_package_evidence:
            evidence = _read_object(evidence_path, "agent package evidence")
            locator = evidence.get("locator")
            if not isinstance(locator, str) or locator in seen_locators:
                raise BuildError("release evidence locators overlap")
            seen_locators.add(locator)
            _bind_agent_package(release_input, evidence)
        expected_agent_package_locators = {
            "agent_packages.linux-arm64",
            "agent_packages.linux-amd64",
        }
        declared_agent_package_locators = {
            f"agent_packages.{item.get('architecture')}"
            for item in release_input.get("agent_packages", [])
            if isinstance(item, dict)
        }
        evidence_agent_package_locators = {
            locator for locator in seen_locators if locator.startswith("agent_packages.")
        }
        if declared_agent_package_locators and (
            declared_agent_package_locators != expected_agent_package_locators
            or evidence_agent_package_locators != expected_agent_package_locators
        ):
            raise BuildError("release requires CI evidence for both agent package architectures")
        document = release_input | {"deployment_bundle": bundle}
        raw = _canonical(document)
        try:
            release = PlatformRelease.from_bytes(raw)
        except PlatformReleaseError as error:
            raise BuildError("assembled platform manifest is invalid") from error
        _write_new(args.output, raw)
        target_sha256 = hashlib.sha256(raw).hexdigest()
        receipt = {
            "platform_version": release.platform_version,
            "schema_version": 1,
            "target_name": (
                f"platform/releases/{release.platform_version}/{target_sha256}.json"
            ),
            "target_sha256": target_sha256,
        }
    except BuildError as error:
        print(f"build-platform-manifest: {error}", file=sys.stderr)
        return 2
    print(_canonical(receipt).decode(), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
