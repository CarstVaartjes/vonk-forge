#!/usr/bin/env python3
"""Create SkinTokens' deterministic mesh-only Khronos RiggedFigure fixture.

Run with trimesh 5.0.0. The source must be the immutable Khronos asset at
commit 5bad5aaa0bbb5d0f9cdc934e626f27d0df1e79b8. The derived work remains
CC-BY-4.0 and must retain the Cesium attribution recorded in the manifest.
"""

from __future__ import annotations

import hashlib
import struct
import sys
from pathlib import Path

import trimesh

SOURCE_SHA256 = "d6be85417d3e256861ee733eea6916093a7af7c79c16366181fd8abcaeb38cf5"


def normalized_trimesh_export(source: Path) -> bytes:
    content = source.read_bytes()
    if hashlib.sha256(content).hexdigest() != SOURCE_SHA256:
        raise SystemExit("source RiggedFigure GLB identity does not match")
    if trimesh.__version__ != "5.0.0":
        raise SystemExit("derivation requires trimesh 5.0.0")
    mesh = trimesh.load(source, force="mesh", process=True)
    if not isinstance(mesh, trimesh.Trimesh) or mesh.is_empty:
        raise SystemExit("source RiggedFigure did not produce a non-empty mesh")
    output = bytearray(mesh.export(file_type="glb"))
    json_length, json_type = struct.unpack_from("<II", output, 12)
    if json_type != 0x4E4F534A:
        raise SystemExit("trimesh export did not start with a JSON chunk")
    json_end = 20 + json_length
    stripped = bytes(output[20:json_end]).rstrip(b"\x00 \t\r\n")
    padding = b" " * (-len(stripped) % 4)
    remainder = bytes(output[json_end:])
    rebuilt = bytearray(output[:12])
    rebuilt.extend(struct.pack("<II", len(stripped) + len(padding), json_type))
    rebuilt.extend(stripped)
    rebuilt.extend(padding)
    rebuilt.extend(remainder)
    struct.pack_into("<I", rebuilt, 8, len(rebuilt))
    return bytes(rebuilt)


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: derive-skintokens-rigged-figure SOURCE OUTPUT")
    Path(sys.argv[2]).write_bytes(normalized_trimesh_export(Path(sys.argv[1])))


if __name__ == "__main__":
    main()
