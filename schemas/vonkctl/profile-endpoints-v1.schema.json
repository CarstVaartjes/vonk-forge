{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "application_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application Id"
    },
    "application_state": {
      "anyOf": [
        {
          "enum": [
            "queued",
            "running",
            "backoff",
            "succeeded",
            "failed",
            "cancelled",
            "superseded"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application State"
    },
    "assignments": {
      "anyOf": [
        {
          "items": {
            "$ref": "definitions.schema.json#/$defs/FleetProfileEndpointAssignmentView"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Assignments"
    },
    "number": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Number",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "profile_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Id"
    },
    "projection_issue": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/FleetProfileEndpointProjectionIssue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "number",
    "observed_at",
    "assignments",
    "schema_version"
  ],
  "title": "vonkctl profile-endpoints document (schema_version 1)",
  "type": "object"
}
