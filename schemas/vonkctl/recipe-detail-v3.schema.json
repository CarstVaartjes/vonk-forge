{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alignment": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignment"
    },
    "alternatives": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/RecipeAlternative"
      },
      "maxItems": 512,
      "title": "Alternatives",
      "type": "array"
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/RecipeReadiness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "creator": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creator"
    },
    "document": {
      "$ref": "definitions.schema.json#/$defs/RecipeDefinition"
    },
    "engine": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Engine",
      "type": "string"
    },
    "identity": {
      "$ref": "definitions.schema.json#/$defs/LibraryRecipeIdentity"
    },
    "local": {
      "$ref": "definitions.schema.json#/$defs/LibraryLocalState"
    },
    "model_documents": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/LibraryRecipeModel"
      },
      "maxItems": 32,
      "title": "Model Documents",
      "type": "array"
    },
    "model_selectors": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Model Selectors",
      "type": "array"
    },
    "node_count": {
      "minimum": 1,
      "title": "Node Count",
      "type": "integer"
    },
    "prebuilt_image": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/PrebuiltImage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "projected": {
      "$ref": "definitions.schema.json#/$defs/RecipeRevisionProjection"
    },
    "qualification": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/PublishedQualificationStatusView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recipe_display": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/RecipeDisplay"
        },
        {
          "type": "null"
        }
      ]
    },
    "resources": {
      "$ref": "definitions.schema.json#/$defs/LibraryResourceProjection"
    },
    "schema_version": {
      "const": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "selector": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Selector",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "usage": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "selector",
    "identity",
    "projected",
    "recipe_display",
    "model_selectors",
    "usage",
    "resources",
    "local",
    "updated_at",
    "node_count",
    "engine",
    "document",
    "model_documents",
    "schema_version"
  ],
  "title": "vonkctl recipe-detail document (schema_version 3)",
  "type": "object"
}
