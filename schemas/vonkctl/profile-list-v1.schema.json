{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "next_after": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next After"
    },
    "profiles": {
      "items": {
        "anyOf": [
          {
            "$ref": "definitions.schema.json#/$defs/FleetProfileView"
          },
          {
            "$ref": "definitions.schema.json#/$defs/UnavailableFleetProfileView"
          }
        ]
      },
      "maxItems": 128,
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "generated_at",
    "profiles",
    "schema_version"
  ],
  "title": "vonkctl profile-list document (schema_version 1)",
  "type": "object"
}
