{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "files": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/DownloadedFile"
      },
      "title": "Files",
      "type": "array"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "output_manifest_sha256": {
      "title": "Output Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "backoff",
        "observing",
        "needs-operator",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "total_bytes": {
      "minimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "state",
    "output_manifest_sha256",
    "files",
    "total_bytes",
    "schema_version"
  ],
  "title": "vonkctl artifact-download document (schema_version 1)",
  "type": "object"
}
