{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "catalog_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Observed At"
    },
    "facets": {
      "$ref": "definitions.schema.json#/$defs/LibraryFacetValues"
    },
    "filters": {
      "$ref": "definitions.schema.json#/$defs/LibraryFilterValues"
    },
    "freshness_policy": {
      "$ref": "definitions.schema.json#/$defs/FreshnessPolicy"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "library": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/LibraryRelease"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "recipes": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/LibraryRecipeProjection"
      },
      "maxItems": 512,
      "title": "Recipes",
      "type": "array"
    },
    "schema_version": {
      "const": 3,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "generated_at",
    "recipes",
    "facets",
    "next_cursor",
    "freshness_policy",
    "schema_version"
  ],
  "title": "vonkctl recipe-library document (schema_version 3)",
  "type": "object"
}
