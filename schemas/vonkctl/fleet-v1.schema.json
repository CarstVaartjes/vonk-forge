{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attention": {
      "anyOf": [
        {
          "items": {
            "$ref": "definitions.schema.json#/$defs/PrometheusAttention"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attention"
    },
    "attention_unavailable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attention Unavailable"
    },
    "authority_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authority Revision",
      "type": "string"
    },
    "event_cursor": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Event Cursor",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "event_cursor",
    "generated_at",
    "authority_revision",
    "nodes",
    "schema_version"
  ],
  "title": "vonkctl fleet document (schema_version 1)",
  "type": "object"
}
