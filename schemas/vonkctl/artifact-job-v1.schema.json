{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cancel_requested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancel Requested At"
    },
    "compiled_contract": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/CompiledArtifactContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "input_declarations": {
      "anyOf": [
        {
          "items": {
            "$ref": "definitions.schema.json#/$defs/ArtifactFileDeclaration"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Declarations"
    },
    "input_files": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/ArtifactFileDeclaration"
      },
      "title": "Input Files",
      "type": "array"
    },
    "input_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Manifest Sha256",
      "type": "string"
    },
    "input_total_bytes": {
      "minimum": 0,
      "title": "Input Total Bytes",
      "type": "integer"
    },
    "interface": {
      "enum": [
        "audio-job",
        "video-job",
        "image-job",
        "mesh-job",
        "artifact-job"
      ],
      "title": "Interface",
      "type": "string"
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "output_files": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/ArtifactOutputFile"
      },
      "title": "Output Files",
      "type": "array"
    },
    "output_limits": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/OutputLimits"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Manifest Sha256"
    },
    "preparation": {
      "anyOf": [
        {
          "enum": [
            "draft",
            "ready"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preparation"
    },
    "result_evidence": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/ArtifactJobResultEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "anyOf": [
        {
          "enum": [
            "queued",
            "running",
            "backoff",
            "observing",
            "needs-operator",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "State"
    },
    "status_reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Reason"
    },
    "submit_request_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submit Request Id"
    },
    "supported_actions": {
      "default": [],
      "items": {
        "const": "stop",
        "type": "string"
      },
      "title": "Supported Actions",
      "type": "array"
    },
    "timeout_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "run_id",
    "interface",
    "state",
    "contract_sha256",
    "compiled_contract",
    "input_manifest_sha256",
    "input_total_bytes",
    "input_declarations",
    "input_files",
    "output_limits",
    "output_files",
    "timeout_seconds",
    "created_at",
    "updated_at",
    "schema_version"
  ],
  "title": "vonkctl artifact-job document (schema_version 1)",
  "type": "object"
}
