{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "blockers": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/OperationBlocker"
      },
      "maxItems": 16,
      "title": "Blockers",
      "type": "array"
    },
    "cancellation": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/FleetProfileApplicationCancellationView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_operation_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Operation Id"
    },
    "current_step": {
      "maximum": 1024,
      "minimum": 0,
      "title": "Current Step",
      "type": "integer"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "next_attempt_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Attempt At"
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Digest",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Profile Id",
      "type": "string"
    },
    "progress": {
      "$ref": "definitions.schema.json#/$defs/FleetProfileApplicationProgress"
    },
    "projection_issue": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/FleetProfileApplicationProjectionIssue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/SupersedeCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_key": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Request Key",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/FleetProfileApplicationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_of_application_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of Application Id"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "backoff",
        "succeeded",
        "failed",
        "cancelled",
        "superseded"
      ],
      "title": "State",
      "type": "string"
    },
    "status_reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Status Reason"
    },
    "superseded_by": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "total_steps": {
      "maximum": 1024,
      "minimum": 0,
      "title": "Total Steps",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "wait": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/QueueWait"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "request_key",
    "profile_id",
    "profile_digest",
    "plan_digest",
    "state",
    "current_step",
    "total_steps",
    "current_operation_id",
    "status_reason",
    "progress",
    "result",
    "created_at",
    "updated_at",
    "schema_version"
  ],
  "title": "vonkctl profile-application document (schema_version 1)",
  "type": "object"
}
