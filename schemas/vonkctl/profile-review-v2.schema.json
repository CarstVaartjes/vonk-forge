{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "admission_decisions": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfileAdmissionDecision"
      },
      "maxItems": 64,
      "title": "Admission Decisions",
      "type": "array"
    },
    "allowed": {
      "title": "Allowed",
      "type": "boolean"
    },
    "assessments": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfileAssignmentAssessment"
      },
      "maxItems": 64,
      "title": "Assessments",
      "type": "array"
    },
    "assignments": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfileAssignmentPreview"
      },
      "maxItems": 64,
      "title": "Assignments",
      "type": "array"
    },
    "effects": {
      "$ref": "definitions.schema.json#/$defs/FleetProfileEffects"
    },
    "effects_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Effects Digest",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "next_action": {
      "$ref": "definitions.schema.json#/$defs/ProfileLoadAction",
      "default": "load"
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "preparation_decisions": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfilePreparationDecision"
      },
      "maxItems": 64,
      "title": "Preparation Decisions",
      "type": "array"
    },
    "preparation_steps": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfilePlanStep"
      },
      "maxItems": 128,
      "title": "Preparation Steps",
      "type": "array"
    },
    "preparations": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfileAssignmentPreparation"
      },
      "maxItems": 64,
      "title": "Preparations",
      "type": "array"
    },
    "profile_definition": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/FleetProfileDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Digest",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Profile Name",
      "type": "string"
    },
    "profile_revision": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile Revision"
    },
    "reasons": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfileReason"
      },
      "maxItems": 128,
      "title": "Reasons",
      "type": "array"
    },
    "resolved_assignments": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfileAssignment"
      },
      "maxItems": 64,
      "title": "Resolved Assignments",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "definitions.schema.json#/$defs/FleetProfileScopePreview"
    },
    "steps": {
      "items": {
        "$ref": "definitions.schema.json#/$defs/FleetProfilePlanStep"
      },
      "maxItems": 1024,
      "title": "Steps",
      "type": "array"
    },
    "summary": {
      "$ref": "definitions.schema.json#/$defs/FleetProfilePlanSummary"
    },
    "waits_for_preparation": {
      "default": false,
      "title": "Waits For Preparation",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "profile_name",
    "profile_digest",
    "profile_revision",
    "profile_definition",
    "allowed",
    "scope",
    "summary",
    "assignments",
    "resolved_assignments",
    "admission_decisions",
    "preparation_decisions",
    "effects",
    "steps",
    "reasons",
    "generated_at",
    "assessments",
    "plan_digest",
    "effects_digest"
  ],
  "title": "vonkctl profile-review document (schema_version 2)",
  "type": "object"
}
