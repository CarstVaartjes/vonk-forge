{
  "$defs": {
    "InstallerAcceptanceBaselineRelease": {
      "additionalProperties": false,
      "properties": {
        "acceptance_only": {
          "const": true,
          "title": "Acceptance Only",
          "type": "boolean"
        },
        "artifacts": {
          "$ref": "#/$defs/InstallerBaselineArtifacts"
        },
        "bootstraps": {
          "$ref": "#/$defs/InstallerBaselineBootstraps"
        },
        "channel": {
          "enum": [
            "dev",
            "stable"
          ],
          "title": "Channel",
          "type": "string"
        },
        "generation": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Generation",
          "type": "string"
        },
        "images": {
          "$ref": "#/$defs/InstallerReleaseImages"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Sha",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z.+:~-]{0,126}[0-9A-Za-z])?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "generation",
        "images",
        "schema_version",
        "source_sha",
        "version",
        "acceptance_only",
        "artifacts",
        "bootstraps"
      ],
      "title": "InstallerAcceptanceBaselineRelease",
      "type": "object"
    },
    "InstallerBaselineArtifacts": {
      "additionalProperties": false,
      "properties": {
        "agent-package-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "spark-setup-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "spark-setup-signature-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        }
      },
      "required": [
        "agent-package-linux-arm64",
        "spark-setup-linux-arm64",
        "spark-setup-signature-linux-arm64"
      ],
      "title": "InstallerBaselineArtifacts",
      "type": "object"
    },
    "InstallerBaselineBootstraps": {
      "additionalProperties": false,
      "properties": {
        "spark": {
          "$ref": "#/$defs/InstallerReleaseObject"
        }
      },
      "required": [
        "spark"
      ],
      "title": "InstallerBaselineBootstraps",
      "type": "object"
    },
    "InstallerCandidateArtifacts": {
      "additionalProperties": false,
      "properties": {
        "agent-package-linux-arm64": {
          "$ref": "#/$defs/InstallerPackageArtifact"
        },
        "agent-package-signature-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "nas-payload": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "nas-setup-darwin-amd64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "nas-setup-darwin-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "nas-setup-linux-amd64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "nas-setup-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "spark-setup-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "spark-setup-signature-linux-arm64": {
          "$ref": "#/$defs/InstallerReleaseObject"
        }
      },
      "required": [
        "agent-package-linux-arm64",
        "agent-package-signature-linux-arm64",
        "spark-setup-linux-arm64",
        "spark-setup-signature-linux-arm64",
        "nas-payload",
        "nas-setup-darwin-amd64",
        "nas-setup-darwin-arm64",
        "nas-setup-linux-amd64",
        "nas-setup-linux-arm64"
      ],
      "title": "InstallerCandidateArtifacts",
      "type": "object"
    },
    "InstallerCandidateBootstraps": {
      "additionalProperties": false,
      "properties": {
        "nas": {
          "$ref": "#/$defs/InstallerReleaseObject"
        },
        "spark": {
          "$ref": "#/$defs/InstallerReleaseObject"
        }
      },
      "required": [
        "spark",
        "nas"
      ],
      "title": "InstallerCandidateBootstraps",
      "type": "object"
    },
    "InstallerCandidateRelease": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "$ref": "#/$defs/InstallerCandidateArtifacts"
        },
        "bootstraps": {
          "$ref": "#/$defs/InstallerCandidateBootstraps"
        },
        "channel": {
          "enum": [
            "dev",
            "stable"
          ],
          "title": "Channel",
          "type": "string"
        },
        "generation": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Generation",
          "type": "string"
        },
        "images": {
          "$ref": "#/$defs/InstallerReleaseImages"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Sha",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z.+:~-]{0,126}[0-9A-Za-z])?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "generation",
        "images",
        "schema_version",
        "source_sha",
        "version",
        "artifacts",
        "bootstraps"
      ],
      "title": "InstallerCandidateRelease",
      "type": "object"
    },
    "InstallerPackageArtifact": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "linux-arm64",
          "title": "Architecture",
          "type": "string"
        },
        "host_signature": {
          "pattern": "^[0-9a-f]{128}$",
          "title": "Host Signature",
          "type": "string"
        },
        "package_version": {
          "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z.+:~-]{0,126}[0-9A-Za-z])?$",
          "title": "Package Version",
          "type": "string"
        },
        "path": {
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "target_binary_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Binary Digest",
          "type": "string"
        },
        "target_build_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Build Digest",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "architecture",
        "host_signature",
        "package_version",
        "target_binary_digest",
        "target_build_digest"
      ],
      "title": "InstallerPackageArtifact",
      "type": "object"
    },
    "InstallerReleaseImages": {
      "additionalProperties": false,
      "properties": {
        "api": {
          "pattern": "^[a-z0-9][a-z0-9./_-]*:[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$",
          "title": "Api",
          "type": "string"
        },
        "hermes": {
          "pattern": "^[a-z0-9][a-z0-9./_-]*:[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$",
          "title": "Hermes",
          "type": "string"
        },
        "litellm": {
          "pattern": "^[a-z0-9][a-z0-9./_-]*:[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$",
          "title": "Litellm",
          "type": "string"
        },
        "worker": {
          "pattern": "^[a-z0-9][a-z0-9./_-]*:[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "api",
        "worker",
        "hermes",
        "litellm"
      ],
      "title": "InstallerReleaseImages",
      "type": "object"
    },
    "InstallerReleaseObject": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "InstallerReleaseObject",
      "type": "object"
    }
  },
  "$id": "https://vonkforge.ai/schemas/install-release-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/InstallerCandidateRelease"
    },
    {
      "$ref": "#/$defs/InstallerAcceptanceBaselineRelease"
    }
  ],
  "description": "Candidate and acceptance-only baseline are the two current graph roles.",
  "title": "InstallerReleaseManifest"
}
