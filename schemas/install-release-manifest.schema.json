{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonkforge.ai/schemas/install-release-manifest.schema.json",
  "title": "Vonk Forge immutable installer release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_evidence_sha256",
    "artifacts",
    "bootstraps",
    "channel",
    "generation",
    "images",
    "schema_version",
    "source_sha",
    "version"
  ],
  "properties": {
    "accepted_evidence_sha256": {"$ref": "#/$defs/digest"},
    "artifacts": {
      "type": "object",
      "minProperties": 9,
      "maxProperties": 9,
      "additionalProperties": {"$ref": "#/$defs/object"}
    },
    "bootstraps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nas", "spark"],
      "properties": {
        "nas": {"$ref": "#/$defs/object"},
        "spark": {"$ref": "#/$defs/object"}
      }
    },
    "channel": {"enum": ["dev", "stable"]},
    "generation": {"$ref": "#/$defs/digest"},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "hermes", "worker"],
      "properties": {
        "api": {"$ref": "#/$defs/image"},
        "hermes": {"$ref": "#/$defs/image"},
        "worker": {"$ref": "#/$defs/image"}
      }
    },
    "schema_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./_-]*:[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}
