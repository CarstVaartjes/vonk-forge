{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.vonkforge.ai/schemas/test-report/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_sha256", "source_bundle_sha256", "build_input_sha256", "image_digest", "topology_name", "node_count", "runtime", "checks", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": 1},
    "recipe_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "build_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "topology_name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "node_count": {"type": "integer", "minimum": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_version", "container_runtime", "architecture"],
      "properties": {
        "agent_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "container_runtime": {"enum": ["podman", "docker"]},
        "architecture": {"const": "linux/arm64"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
