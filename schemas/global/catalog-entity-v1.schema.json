{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.vonkforge.ai/schemas/catalog-entity/v1.schema.json",
  "title": "Vonk Forge immutable catalog entity v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/modelGroup"},
    {"$ref": "#/$defs/model"},
    {"$ref": "#/$defs/modelVersion"},
    {"$ref": "#/$defs/executionHarness"},
    {"$ref": "#/$defs/runtimeDistribution"},
    {"$ref": "#/$defs/patchBundle"}
  ],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "publisher", "slug", "content_sha256"],
      "properties": {
        "kind": {"enum": ["model-group", "model", "model-version", "execution-harness", "runtime-distribution", "patch-bundle"]},
        "publisher": {"$ref": "#/$defs/slug"},
        "slug": {"$ref": "#/$defs/slug"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "modelGroupReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"kind": {"const": "model-group"}}}
      ]
    },
    "modelReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"kind": {"const": "model"}}}
      ]
    },
    "executionHarnessReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"kind": {"const": "execution-harness"}}}
      ]
    },
    "runtimeDistributionReference": {
      "allOf": [
        {"$ref": "#/$defs/reference"},
        {"properties": {"kind": {"const": "runtime-distribution"}}}
      ]
    },
    "sourceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "expected_bytes", "media_type"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "expected_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"const": "application/vnd.vonk-forge.source-bundle.v1+tar"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "tags"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "tags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,39}$"}}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "slug"],
      "properties": {"publisher": {"$ref": "#/$defs/slug"}, "slug": {"$ref": "#/$defs/slug"}}
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "kind", "identity", "metadata"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"enum": ["model-group", "model", "model-version", "execution-harness", "runtime-distribution", "patch-bundle"]},
        "identity": {"$ref": "#/$defs/identity"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "modelGroup": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"kind": {"const": "model-group"}, "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"}}, "required": ["family"]}
      ],
      "unevaluatedProperties": false
    },
    "model": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"kind": {"const": "model"}, "model_group": {"$ref": "#/$defs/modelGroupReference"}, "architecture": {"type": "string", "minLength": 1, "maxLength": 128}}, "required": ["model_group", "architecture"]}
      ],
      "unevaluatedProperties": false
    },
    "modelVersion": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {
          "kind": {"const": "model-version"},
          "model": {"$ref": "#/$defs/modelReference"},
          "version": {"type": "string", "minLength": 1, "maxLength": 128},
          "license": {"type": "object", "additionalProperties": false, "required": ["spdx", "attribution"], "properties": {"spdx": {"type": "string", "minLength": 1, "maxLength": 128}, "attribution": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512}}}},
          "artifacts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "repository", "revision", "sha256", "installed_bytes"], "properties": {"kind": {"enum": ["huggingface.snapshot", "http.file", "oci.artifact"]}, "repository": {"type": "string", "minLength": 1, "maxLength": 512}, "revision": {"type": "string", "minLength": 1, "maxLength": 256}, "sha256": {"$ref": "#/$defs/sha256"}, "installed_bytes": {"type": "integer", "minimum": 1}}}}
        }, "required": ["model", "version", "license", "artifacts"]}
      ],
      "unevaluatedProperties": false
    },
    "executionHarness": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"kind": {"const": "execution-harness"}, "runtime_interface": {"const": "vonk.runtime.v1"}, "adapters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["openai", "image-job", "audio-job", "video-job", "mesh-job", "artifact-job"]}}, "source_bundle": {"$ref": "#/$defs/sourceBundle"}}, "required": ["runtime_interface", "adapters", "source_bundle"]}
      ],
      "unevaluatedProperties": false
    },
    "runtimeDistribution": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"kind": {"const": "runtime-distribution"}, "implements_harness": {"$ref": "#/$defs/executionHarnessReference"}, "platform": {"const": "linux/arm64"}, "sha256": {"$ref": "#/$defs/sha256"}}, "required": ["implements_harness", "platform", "sha256"]}
      ],
      "unevaluatedProperties": false
    },
    "patchBundle": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"properties": {"kind": {"const": "patch-bundle"}, "applies_to": {"$ref": "#/$defs/runtimeDistributionReference"}, "sha256": {"$ref": "#/$defs/sha256"}}, "required": ["applies_to", "sha256"]}
      ],
      "unevaluatedProperties": false
    }
  }
}
