{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.local/schemas/workload-artifact-build.schema.json",
  "title": "Vonk Forge workload artifact build metadata",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_path": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512,
      "pattern": "^adapters/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9_.-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9_.-]+)*$"
    },
    "pinned_image": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?:@sha256:[0-9a-f]{64}|:(?!(?:latest|main|edge|stable|master|dev)$)[a-z0-9][a-z0-9._-]*)$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "attestations",
        "base_images",
        "context",
        "context_digest",
        "dockerfile",
        "kind",
        "output_repository",
        "schema_version",
        "source_commit",
        "target"
      ],
      "properties": {
        "architecture": {"enum": ["linux/amd64", "linux/arm64"]},
        "attestations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance", "sbom"],
          "properties": {
            "provenance": {"const": true},
            "sbom": {"const": true}
          }
        },
        "base_images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pinned_image"}
        },
        "context": {"$ref": "#/$defs/source_path"},
        "context_digest": {"$ref": "#/$defs/sha256"},
        "dockerfile": {"$ref": "#/$defs/source_path"},
        "kind": {"const": "workload-artifact-build-request"},
        "output_repository": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^ghcr\\.io/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*){1,7}$"
        },
        "schema_version": {"const": 1},
        "source_commit": {"$ref": "#/$defs/commit"},
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_request_digest",
        "kind",
        "oci_manifest_digest",
        "provenance_digest",
        "sbom_digest",
        "schema_version",
        "source_commit"
      ],
      "properties": {
        "build_request_digest": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "workload-artifact-build-result"},
        "oci_manifest_digest": {"$ref": "#/$defs/sha256"},
        "provenance_digest": {"$ref": "#/$defs/sha256"},
        "sbom_digest": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 1},
        "source_commit": {"$ref": "#/$defs/commit"}
      }
    }
  }
}
