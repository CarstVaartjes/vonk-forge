{
	admin off
	# The adapted config carries resolved secrets (the agent proxy-auth
	# header). Caddy must never write it to disk; it runs from this file.
	persist_config off
	auto_https disable_redirects
}

(edge_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Every body bound below admits at least what the Controller accepts on the
# same route (MAX_CONTROL_DOCUMENT_BYTES, MAX_ARTIFACT_*_UPLOAD_BYTES,
# MAX_RECIPE_IMAGE_BYTES); test_agent_ingress compares them. A smaller edge
# bound refuses a valid body with a bare 413 the Controller never sees.
(edge_guards) {
	request_body {
		max_size 1MiB
	}
	import edge_headers
}

(browser_edge_guards) {
	# Two large browser bodies. Artifact-job inputs: the API streams, hashes,
	# and enforces this same 512 MiB bound. Inference POSTs that LiteLLM serves
	# carry base64 image/audio data URIs, and /v1/audio/transcriptions carries
	# the raw audio file as multipart; 256 MiB (MAX_AUDIO_FILE_BYTES, the
	# largest upload a recipe's audio_transcription api document may declare)
	# admits both, and LiteLLM sets no body limit of its own. LiteLLM reads
	# the whole body before its key check, so litellm_large_body_gate checks
	# the key first for any body that may exceed 1 MB. /v1/audio/speech is
	# JSON text and stays at 1 MiB, with /v1/models. Nothing else exceeds 1 MiB.
	@artifact_input_upload {
		method PUT
		path /api/artifact-jobs/*/inputs/*
	}
	@inference_request {
		method POST
		path /v1/chat/completions /v1/completions /v1/responses /v1/messages /v1/systemone /v1/audio/transcriptions
	}
	@ordinary_browser_request {
		not {
			method PUT
			path /api/artifact-jobs/*/inputs/*
		}
		not {
			method POST
			path /v1/chat/completions /v1/completions /v1/responses /v1/messages /v1/systemone /v1/audio/transcriptions
		}
	}
	request_body @ordinary_browser_request {
		max_size 1MiB
	}
	request_body @artifact_input_upload {
		max_size 536870912
	}
	request_body @inference_request {
		max_size 268435456
	}
	import edge_headers
}

# Only Caddy handler errors enter this route. An upstream Controller 413
# passes through with its own typed code and must never be relabeled.
# LiteLLM v1.106.7 reads and parses the whole request body before it checks
# the key (litellm/proxy/auth/user_api_key_auth.py, user_api_key_auth: the
# body read precedes user_api_key_auth_builder), so an unauthenticated client
# could make it buffer every large inference body. Before such a body is read,
# Caddy asks LiteLLM to check the caller's own credential on a bodyless GET of
# /v1/models: forward_auth rewrites the method to GET, which drops the body,
# and passes every request header, so each key header LiteLLM accepts
# (Authorization, API-Key, x-api-key, x-goog-api-key, x-litellm-api-key,
# Ocp-Apim-Subscription-Key) is checked exactly as on the real route. Every
# managed key holds openai_routes, which include /v1/models. A refusal is
# LiteLLM's own answer; an unreachable LiteLLM refuses the large body only.
# A declared Content-Length under 1,000,000 bytes (six digits) skips the
# check: the server reads no more than that, so an unchecked body stays below
# 1 MB. A missing or larger length, chunked bodies included, is checked.
(litellm_large_body_gate) {
	@unverified_large_inference {
		method POST
		path /v1/chat/completions /v1/completions /v1/responses /v1/messages /v1/systemone /v1/audio/transcriptions
		not header_regexp Content-Length ^[0-9]{1,6}$
	}
	forward_auth @unverified_large_inference {args[0]} {
		uri /v1/models?
		# The key check, like every LiteLLM upstream, never sees a cookie.
		header_up -Cookie
		transport http {
			response_header_timeout 30s
		}
	}
}

(body_limit_errors) {
	handle_errors 413 {
		import edge_headers
		header X-Vonk-Error-Code edge.body_limit
		respond "edge body limit" 413
	}
}

(agent_edge_guards) {
	import body_limit_errors
	# Recipe OCI layouts and recipe-job outputs are the only large inbound
	# agent bodies. The API streams, hashes, and enforces these same bounds:
	# the 16 TiB image ceiling and the 1 GiB job output.
	@recipe_image_upload {
		method PUT
		path /agent/recipe-builds/*/image
	}
	@recipe_job_output_upload {
		method PUT
		path /agent/recipe-jobs/*/outputs/*
	}
	@ordinary_agent_request {
		not {
			method PUT
			path /agent/recipe-builds/*/image
		}
		not {
			method PUT
			path /agent/recipe-jobs/*/outputs/*
		}
	}
	request_body @ordinary_agent_request {
		max_size 1MiB
	}
	request_body @recipe_image_upload {
		max_size 17592186044416
	}
	request_body @recipe_job_output_upload {
		max_size 1073741824
	}
	import edge_headers
}

(stored_file_from_controller) {
	# The Controller authorizes a model or image download and names the
	# stored file; Caddy serves it, with native Range support, from the
	# read-only object stores. The name comes only from the Controller's
	# reply, never from the request, and must be one of the two content
	# addressed layouts: anything else, including any traversal, is a
	# 404. The reply, and so X-Vonk-File, never reaches the agent.
	@stored_file header X-Vonk-File *
	handle_response @stored_file {
		rewrite * /{rp.header.X-Vonk-File}
		@object_store path_regexp ^/(model-cache/objects/[0-9a-f]{2}/[0-9a-f]{64}|agent-artifacts/[0-9a-f]{64})$
		handle @object_store {
			root * /srv/state
			# The Controller vouched for this exact object at its range,
			# and the agent checks the ETag it names, so the file server
			# must not substitute its own validator.
			request_header -If-Range
			header >ETag {rp.header.Etag}
			header >Cache-Control {rp.header.Cache-Control}
			header >Content-Type {rp.header.Content-Type}
			header >-X-Vonk-File
			file_server
		}
		respond 404
	}
}

(runtime_image_store) {
	# Runtime images are one content-addressed OCI layout in the Controller's
	# image cache. Agents read it by digest only, through a loopback forwarder
	# that serves it to the Spark's Docker daemon: the registry ping, a
	# manifest and a blob. Uploads, tags, listings and every other path of the
	# layout are unreachable, and every route requires the verified agent
	# identity the site maps from the client certificate.
	@runtime_image_ping {
		method GET HEAD
		path /v2/
		expression {vonk_agent_node}.matches("^spk_[0-9a-f]{32}$")
	}
	handle @runtime_image_ping {
		header Docker-Distribution-API-Version registry/2.0
		respond 200
	}
	@runtime_image_manifest {
		method GET HEAD
		expression {vonk_agent_node}.matches("^spk_[0-9a-f]{32}$")
		path_regexp runtime_manifest ^/v2/vonk/runtime/manifests/sha256:([0-9a-f]{64})$
	}
	handle @runtime_image_manifest {
		root * /srv/state/agent-artifacts/image-cache/oci
		rewrite * /blobs/sha256/{re.runtime_manifest.1}
		# The Controller admits only OCI image manifests into the layout.
		header Content-Type application/vnd.oci.image.manifest.v1+json
		header Docker-Content-Digest sha256:{re.runtime_manifest.1}
		header Docker-Distribution-API-Version registry/2.0
		file_server
	}
	@runtime_image_blob {
		method GET HEAD
		expression {vonk_agent_node}.matches("^spk_[0-9a-f]{32}$")
		path_regexp runtime_blob ^/v2/vonk/runtime/blobs/sha256:([0-9a-f]{64})$
	}
	handle @runtime_image_blob {
		root * /srv/state/agent-artifacts/image-cache/oci
		rewrite * /blobs/sha256/{re.runtime_blob.1}
		header Content-Type application/octet-stream
		header Docker-Content-Digest sha256:{re.runtime_blob.1}
		header Docker-Distribution-API-Version registry/2.0
		file_server
	}
}

(control_proxy) {
	reverse_proxy control-api:8000 {
		# PostgreSQL migrations can keep the API socket closed briefly after a
		# Compose or host restart. Retry connection failures for a bounded
		# interval so agents do not see a startup burst of 502 responses.
		lb_try_duration 3s
		lb_try_interval 250ms
		# Never permit a caller to inject agent identity into control-api.
		header_up -X-Vonk-Agent-*
	}
}

(browser_proxy_headers) {
	# The trusted Host selects the browser boundary; no browser-controlled
	# forwarding or agent identity headers may reach any browser upstream.
	request_header -Forwarded
	request_header -X-Forwarded-*
	request_header -X-Vonk-Agent-*
}

# The Controller web app's own policy: every script, style, font, worker and
# request is same-origin (the build bundles the fonts and the hash worker as
# files, and its validators are precompiled, so nothing evaluates code). The
# favicon is a data: image. Results open as same-origin /api files and
# downloads use blob: links, which CSP does not govern. Only the Controller's
# own routes carry it; LiteLLM's routes and the agent sites set their own.
# Deferred, so Caddy alone owns these two headers.
(controller_page_policy) {
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
		defer
	}
}

(browser_control_proxy) {
	import browser_proxy_headers
	reverse_proxy control-api:8000 {
		lb_try_duration 3s
		lb_try_interval 250ms
	}
}

# Container readiness must not depend on a virtual host or any upstream. This
# listener is loopback-only and is never published by Compose.
http://127.0.0.1:8082 {
	bind 127.0.0.1
	handle /healthz {
		respond 200
	}
	respond 404
}

# Relay only the immutable documents needed to select the current signed agent
# package. The package URL returned to Sparks remains the public HTTPS origin.
http://:8084 {
	@agent_release_api {
		method GET
		path /artifacts/dev/current.manifest /artifacts/stable/current.manifest /artifacts/dev/releases/*/release.json /artifacts/stable/releases/*/release.json /artifacts/dev/releases/*/spark/current/linux-arm64/vonk-forge-agent.deb.host.sig /artifacts/stable/releases/*/spark/current/linux-arm64/vonk-forge-agent.deb.host.sig
	}
	@agent_package_api {
		method GET
		path_regexp agent_package ^/artifacts/(dev|stable)/agent-builds/[0-9a-f]{64}/[0-9a-f]{64}/package[.]json$
	}
	handle @agent_release_api {
		reverse_proxy https://install.vonkforge.ai {
			header_up Host install.vonkforge.ai
			header_up -Authorization
			header_up -Cookie
		}
	}
	handle @agent_package_api {
		reverse_proxy https://install.vonkforge.ai {
			header_up Host install.vonkforge.ai
			header_up -Authorization
			header_up -Cookie
		}
	}
	respond 404
}

# The Controller manages inference gateway client keys through this relay.
# Only LiteLLM's key routes pass; LiteLLM still requires its master key.
http://:8087 {
	@litellm_key_admin path /key/generate /key/list /key/info /key/update /key/delete
	handle @litellm_key_admin {
		reverse_proxy litellm:4000
	}
	respond 404
}

# Secure remote browser traffic arrives from Tailscale over the private
# tailnet-web-edge network. Tailscale terminates HTTPS before this HTTP
# listener; Lab mode also serves the control hostname on the local-CA HTTPS
# listener below. Docker does not publish port 8080.
:8080 {
	@canonical_browser_host host {$VONK_CONTROL_HOSTNAME}
	handle @canonical_browser_host {
		import browser_edge_guards
		handle /healthz {
			respond 200
		}

		@agent_path path /agent/*
		handle @agent_path {
			respond 404
		}
		@internal_path path /internal/*
		handle @internal_path {
			respond 404
		}
		handle /v1/* {
			# In written order: sanitize, check the key of a large body, then
			# rewrite and proxy.
			route {
				import browser_proxy_headers
				import litellm_large_body_gate litellm:4000
				@systemone path /v1/systemone
				rewrite @systemone /vllm/systemone
				reverse_proxy litellm:4000
			}
		}
		@litellm_repository_authority {
			method POST PUT PATCH DELETE
			path /litellm/model /litellm/model/* /litellm/model_group /litellm/model_group/* /litellm/config /litellm/config/*
		}
		handle @litellm_repository_authority {
			respond 403
		}
		# LiteLLM's Prometheus endpoint is scraped only on the internal
		# litellm-metrics network; it is never served to browsers.
		@litellm_metrics path /litellm/metrics /litellm/metrics/*
		handle @litellm_metrics {
			respond 404
		}
		handle_path /litellm/* {
			import browser_proxy_headers
			reverse_proxy litellm:4000
		}
		handle {
			import controller_page_policy
			import browser_control_proxy
		}
	}
	respond 421
}

# Lab mode serves the same browser surface directly on the LAN. This certificate
# is issued by the installer-created local CA; clients must trust that root.
https://{$VONK_CONTROL_HOSTNAME}:{$VONK_BACKEND_PORT:8443} {
	tls /run/secrets/controller-server-certificate /run/secrets/controller-server-key
	reverse_proxy 127.0.0.1:8080
}

# Internal inference clients reach the published routes without exposing
# LiteLLM's native listener or management routes.
:8081 {
	handle /v1/* {
			@systemone path /v1/systemone
			rewrite @systemone /vllm/systemone
		reverse_proxy litellm:4000
	}
	respond 404
}

# Bootstrap is server-authenticated but intentionally does not request a client
# certificate. It exposes only bounded discovery and enrollment submission.
https://{$VONK_AGENT_ENROLL_HOSTNAME:enroll.example.invalid}:{$VONK_BACKEND_PORT:8443} {
	import edge_guards
	tls /run/secrets/controller-server-certificate /run/secrets/controller-server-key

	@bootstrap {
		method GET
		path /agent/bootstrap
	}
	@enrollment {
		method POST
		path /agent/enroll /agent/renew/expired
	}
	handle @bootstrap {
		request_header -X-Vonk-Agent-*
		import control_proxy
	}
	handle @enrollment {
		request_header -X-Vonk-Agent-*
		import control_proxy
	}
	respond 404
}

# The agent endpoint is a distinct TLS SNI because client authentication cannot
# be conditional on an HTTP path. The subject is mapped strictly to the exact
# node-ID grammar before it reaches the application.
https://{$VONK_AGENT_HOSTNAME:agents.example.invalid}:{$VONK_BACKEND_PORT:8443} {
	import agent_edge_guards
	tls /run/secrets/controller-server-certificate /run/secrets/controller-server-key {
		client_auth {
			trust_pool file /run/secrets/agent-client-ca
			mode require_and_verify
		}
	}
	map {tls_client_subject} {vonk_agent_node} {
		~^CN=(spk_[0-9a-f]{32})$ "${1}"
		default ""
	}

	import runtime_image_store

	@agent_api {
		path /agent/*
		not path /agent/enroll /agent/renew/expired
	}
		handle @agent_api {
		# Remove caller-controlled identity before adding Caddy's verified values.
		request_header -X-Vonk-Agent-*
		reverse_proxy control-api:8000 {
		lb_try_duration 3s
			lb_try_interval 250ms
			header_up X-Vonk-Agent-Node {vonk_agent_node}
			header_up X-Vonk-Agent-Serial {tls_client_serial}
			header_up X-Vonk-Agent-Fingerprint {tls_client_fingerprint}
			header_up X-Vonk-Agent-Verified "1"
			header_up X-Vonk-Agent-Proxy-Auth "{$VONK_AGENT_PROXY_AUTH}"
			header_up X-Vonk-Agent-Source {http.request.remote.host}

			import stored_file_from_controller
		}
	}
	respond 404
}
