# Every production image reference must contain @sha256:<digest>.
COMPOSE_PROJECT_NAME=vonk-forge-control
POSTGRES_IMAGE=postgres:18.3@sha256:7e32e9833a6fb1c92c32552794cb6ed569d51b445a54907d35fc112ef39684db
CADDY_IMAGE=caddy:2.11.4@sha256:844f60b64e4724a5aa8245e019dace0d3f199f7433ce6c57676cb30a920dbad9
REGISTRY_IMAGE=registry:3.1.1@sha256:1be55279f18a2fe1a74edf2664cac61c1bea305b7b4642dab412e7affdcb3e33
REGISTRY_REPOSITORY=vonk/releases
CONTROL_API_IMAGE=ghcr.io/carstvaartjes/vonk-forge-api:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
CONTROL_WORKER_IMAGE=ghcr.io/carstvaartjes/vonk-forge-worker:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
HERMES_AGENT_IMAGE=ghcr.io/carstvaartjes/vonk-forge-hermes:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.83.14-stable@sha256:c81eb79cd4333c6cfe374c0ec929110fd23f0ee5f7fd198855a6fbddc77b83ba
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2@sha256:508729e0e2d18e11fd742a5a5ca70e557b940a93948c3c95fd0123a6fd538b69
GRAFANA_IMAGE=grafana/grafana:13.0.2@sha256:5dad0df181cb644a14e13617b913b261a54f7d4fd4510721dba420929f35bea2
STEP_CA_IMAGE=smallstep/step-ca:0.30.2@sha256:a2b17872915c193259b75a5474c398326f41bd199f0842093e52cf4182bc8270
TAILSCALE_IMAGE=tailscale/tailscale:v1.98.8@sha256:d54b2e6a9c09f0e5ec52e82b9ad4af3d446b54a7c08075e92f11c39dd410105f
DATABASE_URL_FILE=./secrets/database-url
POSTGRES_PASSWORD_FILE=./secrets/postgres-password
TOKEN_SIGNING_KEY_FILE=./secrets/token-signing-key
METRICS_TOKEN_FILE=./secrets/metrics-token
# Independent API-to-worker repository-authority token; unpadded base64url, 32+ characters.
WORKER_API_TOKEN_FILE=./secrets/worker-api-token
# Independent Ed25519 PKCS#8 PEM used only by the control API to issue
# short-lived workload-helper grants and object receipts. Never install these
# private keys on a GPU node.
PACKAGE_HELPER_GRANT_PRIVATE_KEY_FILE=./secrets/package-helper-grant-private-key.pem
PACKAGE_HELPER_RECEIPT_PRIVATE_KEY_FILE=./secrets/package-helper-receipt-private-key.pem
HOST_RUNTIME_GRANT_PRIVATE_KEY_FILE=./secrets/host-runtime-grant-private-key.pem
# Root-owned projection directory mounted read-only into selected control services.
CONTROL_IDENTITY_PATH=./secrets/control-identity
VONK_PLATFORM_VERSION=REPLACE_WITH_RELEASE_VERSION
VONK_PLATFORM_RELEASE_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
VONK_PLATFORM_BUILD_DIGEST=sha256:REPLACE_WITH_BUILD_DIGEST
# VONK_CONTROL_GENERATION_ID, VONK_DATABASE_REVISION, and
# VONK_CONTROL_START_NONCE are supplied by the root host updater for each
# selected launch. Do not persist the start nonce in this site environment.
# Comma-separated canonical CIDRs from which GPU nodes reach the agent SNI.
VONK_MANAGEMENT_CIDRS=10.0.0.0/24
# Optional canonical CIDRs that must never be accepted as management sources.
VONK_DIRECT_FABRIC_CIDRS=
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana-admin-password
LITELLM_MASTER_KEY_FILE=./secrets/litellm-master-key
LITELLM_UPSTREAM_KEY_FILE=./secrets/litellm-upstream-key
LITELLM_DATABASE_URL_FILE=./secrets/litellm-database-url
LITELLM_DATABASE_PASSWORD_FILE=./secrets/litellm-database-password
NAS_LAN_IP=10.0.0.2
VONK_CONTROL_HOSTNAME=control.example.invalid
VONK_AGENT_ENROLL_HOSTNAME=enroll.example.invalid
VONK_AGENT_HOSTNAME=agents.example.invalid
VONK_REGISTRY_HOSTNAME=registry.example.invalid
AGENT_CLIENT_CA_FILE=./secrets/agent-client-ca
AGENT_INTERMEDIATE_CERTIFICATE_FILE=./secrets/agent-intermediate-certificate
# One public PEM certificate used by agents to verify the controller listener.
# Never point this at the controller server private key.
CONTROLLER_CA_FILE=./secrets/controller-ca.pem
CONTROLLER_SERVER_CERTIFICATE_FILE=./secrets/controller-server-certificate
CONTROLLER_SERVER_KEY_FILE=./secrets/controller-server-key
# File content: one unpadded base64url token ([A-Za-z0-9_-]), at least 32 characters; a final CR/LF is allowed.
AGENT_PROXY_AUTH_FILE=./secrets/agent-proxy-auth
# Required for the production-shaped graph, including development.
AGENT_CA_CREDENTIAL_FILE=./secrets/agent-ca-credential
AGENT_CA_PROVISIONER_PUBLIC_JWK_FILE=./secrets/agent-ca-public.jwk
AGENT_CA_PROVISIONER_NAME=vonk-forge-agent
AGENT_CA_PROVISIONER_KID=REPLACE_WITH_DEPLOYMENT_KEY_ID
STEP_CA_CONFIG_FILE=./secrets/step-ca/ca.json
STEP_CA_ROOT_CERTIFICATE_FILE=./secrets/step-ca-root-certificate
STEP_CA_INTERMEDIATE_KEY_FILE=./secrets/step-ca-intermediate-key
STEP_CA_PASSWORD_FILE=./secrets/step-ca-password
# OAuth credentials are Tailscale values, not GitHub login credentials.
# Store one value per regular root:root 0400 file; never put either value here.
TAILSCALE_OAUTH_CLIENT_ID_FILE=./secrets/tailscale-oauth-client-id
TAILSCALE_OAUTH_CLIENT_SECRET_FILE=./secrets/tailscale-oauth-client-secret
# Persistent Hermes Agent. Official public images require the fixed UID/GID 1100:1100;
# these are not freely selectable runtime settings. Create data, workspaces, and cache below this root.
HERMES_UID=1100
HERMES_GID=1100
# One URL origin, for example the svc:hermes-dashboard MagicDNS HTTPS URL.
HERMES_DASHBOARD_ORIGIN=https://hermes-dashboard.example.ts.net
# File content: one 32+ character key using A-Z, a-z, 0-9, underscore, dot, tilde, or hyphen.
HERMES_API_KEY_FILE=./secrets/hermes-api-key
