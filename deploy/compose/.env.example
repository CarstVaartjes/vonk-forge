# Every production image reference must contain @sha256:<digest>.
COMPOSE_PROJECT_NAME=vonk-forge-control
POSTGRES_IMAGE=postgres:17.6@sha256:00bc86618629af00d2937fdc5a5d63db3ff8450acf52f0636ec813c7f4902929
CADDY_IMAGE=caddy:2.10.2@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb
REGISTRY_IMAGE=registry:3.1.1@sha256:1be55279f18a2fe1a74edf2664cac61c1bea305b7b4642dab412e7affdcb3e33
REGISTRY_REPOSITORY=vonk/releases
CONTROL_API_IMAGE=ghcr.io/carstvaartjes/vonk-forge-api:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
CONTROL_WORKER_IMAGE=ghcr.io/carstvaartjes/vonk-forge-worker:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
HERMES_AGENT_IMAGE=ghcr.io/carstvaartjes/vonk-forge-hermes:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.82.3-stable@sha256:b959a1816fa454a14d2842242d0fa1cd0d39f96fc94d3a1f4e1de4e48e2398c6
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
GRAFANA_IMAGE=grafana/grafana:13.0.2@sha256:5dad0df181cb644a14e13617b913b261a54f7d4fd4510721dba420929f35bea2
STEP_CA_IMAGE=smallstep/step-ca:0.30.2@sha256:a2b17872915c193259b75a5474c398326f41bd199f0842093e52cf4182bc8270
TAILSCALE_IMAGE=tailscale/tailscale:v1.98.8@sha256:d54b2e6a9c09f0e5ec52e82b9ad4af3d446b54a7c08075e92f11c39dd410105f
REPOSITORY_PATH=/srv/vonk-forge/repository
DATABASE_URL_FILE=/srv/vonk-forge/secrets/database-url
POSTGRES_PASSWORD_FILE=/srv/vonk-forge/secrets/postgres-password
TOKEN_SIGNING_KEY_FILE=/srv/vonk-forge/secrets/token-signing-key
METRICS_TOKEN_FILE=/srv/vonk-forge/secrets/metrics-token
GIT_SIGNING_KEY_FILE=/srv/vonk-forge/secrets/git-signing-key
# Independent API-to-worker repository-authority token; unpadded base64url, 32+ characters.
WORKER_API_TOKEN_FILE=/srv/vonk-forge/secrets/worker-api-token
# Ed25519 PKCS#8 PEM read only by the networkless control-signer.
AGENT_UPDATE_AUTHORITY_KEY_FILE=/srv/vonk-forge/secrets/agent-update-authority-key.pem
# Public half of the separate API admin-action grant authority.
ADMIN_GRANT_PUBLIC_KEY_FILE=/srv/vonk-forge/secrets/admin-grant-public-key.json
# Ed25519 PKCS#8 PEM used only by the API admin authority.
ADMIN_GRANT_PRIVATE_KEY_FILE=/srv/vonk-forge/secrets/admin-grant-private-key.pem
# Independent Ed25519 PKCS#8 PEM used only by the control API to issue
# short-lived workload-helper grants and object receipts. Never install these
# private keys on a GPU node.
PACKAGE_HELPER_GRANT_PRIVATE_KEY_FILE=/srv/vonk-forge/secrets/package-helper-grant-private-key.pem
PACKAGE_HELPER_RECEIPT_PRIVATE_KEY_FILE=/srv/vonk-forge/secrets/package-helper-receipt-private-key.pem
HOST_RUNTIME_GRANT_PRIVATE_KEY_FILE=/srv/vonk-forge/secrets/host-runtime-grant-private-key.pem
# Three independent online workload-TUF role keys. They are mounted only into
# workload-signer; the API receives only its Unix socket client.
WORKLOAD_RELEASES_KEY_FILE=/srv/vonk-forge/secrets/workload-releases-key.pem
WORKLOAD_SNAPSHOT_KEY_FILE=/srv/vonk-forge/secrets/workload-snapshot-key.pem
WORKLOAD_TIMESTAMP_KEY_FILE=/srv/vonk-forge/secrets/workload-timestamp-key.pem
# Public offline-root-signed TUF root used to verify platform release publication.
AGENT_TUF_BOOTSTRAP_ROOT_FILE=/srv/vonk-forge/secrets/agent-tuf-bootstrap-root.json
# Root-owned projection directory mounted read-only into selected control services.
CONTROL_IDENTITY_PATH=/srv/vonk-forge/control-identity
VONK_PLATFORM_VERSION=REPLACE_WITH_RELEASE_VERSION
VONK_PLATFORM_RELEASE_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
VONK_PLATFORM_BUILD_DIGEST=sha256:REPLACE_WITH_BUILD_DIGEST
# VONK_CONTROL_GENERATION_ID, VONK_DATABASE_REVISION, and
# VONK_CONTROL_START_NONCE are supplied by the root host updater for each
# selected launch. Do not persist the start nonce in this site environment.
DEPLOYMENT_BRANCH=deploy
REQUIRED_CHECKS=
# Comma-separated canonical CIDRs from which GPU nodes reach the agent SNI.
VONK_MANAGEMENT_CIDRS=10.0.0.0/24
# Optional canonical CIDRs that must never be accepted as management sources.
VONK_DIRECT_FABRIC_CIDRS=
GRAFANA_ADMIN_PASSWORD_FILE=/srv/vonk-forge/secrets/grafana-admin-password
LITELLM_MASTER_KEY_FILE=/srv/vonk-forge/secrets/litellm-master-key
LITELLM_UPSTREAM_KEY_FILE=/srv/vonk-forge/secrets/litellm-upstream-key
LITELLM_DATABASE_URL_FILE=/srv/vonk-forge/secrets/litellm-database-url
NAS_LAN_IP=10.0.0.2
VONK_BACKEND_PORT=8443
VONK_CONTROL_HOSTNAME=control.example.invalid
VONK_AGENT_ENROLL_HOSTNAME=enroll.example.invalid
VONK_AGENT_HOSTNAME=agents.example.invalid
VONK_REGISTRY_HOSTNAME=registry.example.invalid
AGENT_CLIENT_CA_FILE=/srv/vonk-forge/secrets/agent-client-ca
AGENT_INTERMEDIATE_CERTIFICATE_FILE=/srv/vonk-forge/secrets/agent-intermediate-certificate
# File content: one unpadded base64url token ([A-Za-z0-9_-]), at least 32 characters; a final CR/LF is allowed.
AGENT_PROXY_AUTH_FILE=/srv/vonk-forge/secrets/agent-proxy-auth
# Required only with -f deploy/compose/compose.step-ca.yaml (recommended production).
AGENT_CA_CREDENTIAL_FILE=/srv/vonk-forge/secrets/agent-ca-credential
AGENT_CA_PROVISIONER_PUBLIC_JWK_FILE=/srv/vonk-forge/secrets/agent-ca-public.jwk
AGENT_CA_PROVISIONER_NAME=vonk-forge-agent
AGENT_CA_PROVISIONER_KID=REPLACE_WITH_DEPLOYMENT_KEY_ID
STEP_CA_CONFIG_FILE=/srv/vonk-forge/step-ca/ca.json
STEP_CA_ROOT_CERTIFICATE_FILE=/srv/vonk-forge/secrets/step-ca-root-certificate
STEP_CA_INTERMEDIATE_KEY_FILE=/srv/vonk-forge/secrets/step-ca-intermediate-key
STEP_CA_PASSWORD_FILE=/srv/vonk-forge/secrets/step-ca-password
# Development-only, used only with -f deploy/compose/compose.builtin-ca.yaml.
AGENT_INTERMEDIATE_KEY_FILE=/srv/vonk-forge/secrets/agent-intermediate-key
# OAuth credentials are Tailscale values, not GitHub login credentials.
# Store one value per regular root:root 0400 file; never put either value here.
TAILSCALE_OAUTH_CLIENT_ID_FILE=/srv/vonk-forge/secrets/tailscale-oauth-client-id
TAILSCALE_OAUTH_CLIENT_SECRET_FILE=/srv/vonk-forge/secrets/tailscale-oauth-client-secret
# Persistent Hermes Agent. Official public images require the fixed UID/GID 1100:1100;
# these are not freely selectable runtime settings. Create data, workspaces, and cache below this root.
HERMES_UID=1100
HERMES_GID=1100
HERMES_DATA_ROOT=/srv/vonk-forge/hermes
# One URL origin, for example the svc:hermes-dashboard MagicDNS HTTPS URL.
HERMES_DASHBOARD_ORIGIN=https://hermes-dashboard.example.ts.net
# File content: one 32+ character key using A-Z, a-z, 0-9, underscore, dot, tilde, or hyphen.
HERMES_API_KEY_FILE=/srv/vonk-forge/secrets/hermes-api-key
