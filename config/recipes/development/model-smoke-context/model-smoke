#!/usr/bin/env bash
set -euo pipefail

if [[ ${VONK_RANK:-} != 0 && ${VONK_RANK:-} != 1 ]] ||
   [[ ${VONK_WORLD_SIZE:-} != 1 && ${VONK_WORLD_SIZE:-} != 2 ]] ||
   [[ ${VONK_LISTEN_HOST:-} != 0.0.0.0 ]] ||
   [[ ! ${VONK_LISTEN_PORT:-} =~ ^[0-9]+$ ]]; then
  echo "invalid Vonk runtime contract" >&2
  exit 2
fi

artifact() {
  local expected_bytes=$1 expected_sha256=$2
  local -a matches=()
  mapfile -t matches < <(
    find "${VONK_MODEL_ROOT:?}/sha256" -mindepth 2 -maxdepth 2 \
      -type f -name artifact -size "${expected_bytes}c" -print
  )
  if [[ ${#matches[@]} != 1 ]]; then
    echo "expected exactly one immutable model artifact" >&2
    return 1
  fi
  echo "${expected_sha256}  ${matches[0]}" | sha256sum --check --status
  printf '%s\n' "${matches[0]}"
}

base=$(artifact 86720111488 ca22ae2f838e14077c22bc1c1417b71b45b5e5a3687bd96c2ac6e17fdb6261c0)
drafter=$(artifact 6971241504 8fa269560dc76fd73e4233ad9b1938b5f65dd363381fd9b1a5c6183f7d12d686)
state=${VONK_STATE_ROOT:?}
install -d -m 0700 "${state}/kv"

export HOME="${state}"
export DS4_NO_UPDATE_CHECK=1
export DS4_SERVED_MODEL_NAME=development-deepseek-smoke
export DS4_CONT_MTP_MODE=2
export DS4_CONT_DSPARK=1
export DS4_DSPARK_MODEL="${drafter}"

exec /opt/ds4/ds4-server \
  --cuda \
  -m "${base}" \
  -c 4096 \
  --host "${VONK_LISTEN_HOST}" \
  --port "${VONK_LISTEN_PORT}" \
  --kv-disk-dir "${state}/kv" \
  --kv-disk-space-mb 2048
