#!/usr/bin/env bash
set -euo pipefail

busybox=${VONK_BUSYBOX:-/opt/vonk/busybox}
timeout_seconds=${VONK_FABRIC_RENDEZVOUS_SECONDS:-60}
rank=${VONK_RANK:-}
world_size=${VONK_WORLD_SIZE:-}
master_address=${VONK_MASTER_ADDR:-}
local_address=${VONK_LOCAL_ADDR:-}
master_port=${VONK_MASTER_PORT:-}
state=${VONK_STATE_ROOT:-}
marker=${state}/fabric/rank-1-ready
self=$(readlink -f "$0")

fail() {
  echo "fabric rendezvous failed: $1" >&2
  exit 1
}

valid_ipv4() {
  local address=$1 octet
  local -a octets=()
  [[ ${address} =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  IFS=. read -r -a octets <<<"${address}"
  [[ ${#octets[@]} == 4 ]] || return 1
  for octet in "${octets[@]}"; do
    [[ ${octet} =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    ((10#${octet} <= 255)) || return 1
  done
}

[[ -x ${busybox} ]] || fail "transport is unavailable"
[[ ${timeout_seconds} =~ ^[1-9][0-9]{0,2}$ ]] || fail "timeout is invalid"
((timeout_seconds <= 300)) || fail "timeout is invalid"
[[ ${rank} == 0 || ${rank} == 1 ]] || fail "rank is invalid"
[[ ${world_size} == 2 ]] || fail "world size is invalid"
valid_ipv4 "${master_address}" || fail "master address is invalid"
valid_ipv4 "${local_address}" || fail "local address is invalid"
[[ ${master_port} =~ ^[1-9][0-9]{0,4}$ ]] || fail "master port is invalid"
((master_port <= 65535)) || fail "master port is invalid"
[[ -n ${state} && ${state} == /* ]] || fail "state root is invalid"

master_message="vonk-fabric-v1 master rank=0 world=2 address=${master_address} port=${master_port}"

if [[ ${VONK_FABRIC_SERVE:-} == 1 ]]; then
  [[ ${rank} == 0 && ${local_address} == "${master_address}" ]] ||
    fail "coordinator identity is invalid"
  IFS= read -r -t "${timeout_seconds}" worker_message ||
    fail "worker sent no complete data"
  prefix='vonk-fabric-v1 worker rank=1 world=2 address='
  [[ ${worker_message} == "${prefix}"* ]] || fail "worker message is invalid"
  worker_address=${worker_message#"${prefix}"}
  valid_ipv4 "${worker_address}" || fail "worker address is invalid"
  [[ ${worker_address} != "${master_address}" ]] || fail "worker address is duplicated"
  install -d -m 0700 "$(dirname "${marker}")"
  marker_new=${marker}.new.$$
  printf '%s\n' "${worker_message}" >"${marker_new}"
  chmod 0600 "${marker_new}"
  mv -f "${marker_new}" "${marker}"
  printf '%s\n' "${master_message}"
  exit 0
fi

case ${1:-} in
  coordinator)
    [[ ${rank} == 0 && ${local_address} == "${master_address}" ]] ||
      fail "coordinator identity is invalid"
    install -d -m 0700 "$(dirname "${marker}")"
    rm -f "${marker}"
    export VONK_FABRIC_SERVE=1
    exec "${busybox}" nc -n -lk -s 0.0.0.0 -p "${master_port}" \
      -e "${self}"
    ;;
  await-worker)
    [[ ${rank} == 0 && ${local_address} == "${master_address}" ]] ||
      fail "coordinator identity is invalid"
    [[ ${VONK_RENDEZVOUS_PID:-} =~ ^[1-9][0-9]*$ ]] ||
      fail "coordinator process is invalid"
    started=${SECONDS}
    while ((SECONDS - started < timeout_seconds)); do
      if [[ -s ${marker} ]]; then
        echo "fabric rendezvous complete: rank 0 of 2"
        exit 0
      fi
      kill -0 "${VONK_RENDEZVOUS_PID}" 2>/dev/null ||
        fail "coordinator exited"
      sleep 0.1
    done
    fail "worker did not join"
    ;;
  join)
    [[ ${rank} == 1 && ${local_address} != "${master_address}" ]] ||
      fail "worker identity is invalid"
    worker_message="vonk-fabric-v1 worker rank=1 world=2 address=${local_address}"
    started=${SECONDS}
    while ((SECONDS - started < timeout_seconds)); do
      if response=$(
        printf '%s\n' "${worker_message}" |
          "${busybox}" nc -n -w 2 \
            "${master_address}" "${master_port}" 2>/dev/null
      ) && [[ ${response} == "${master_message}" ]]; then
        echo "fabric rendezvous complete: rank 1 of 2"
        exit 0
      fi
      sleep 0.1
    done
    fail "coordinator did not acknowledge worker"
    ;;
  *)
    fail "mode is invalid"
    ;;
esac
