          "port": "01:00.1",
          "active": true,
          "bytes": 3650000000,
          "window_seconds": 120
        },
        {
          "name": "roceP2p1s0f1",
          "port": "01:00.1",
          "active": true,
          "bytes": 3640000000,
          "window_seconds": 120
        }
      ],
      "underused": false
    },
