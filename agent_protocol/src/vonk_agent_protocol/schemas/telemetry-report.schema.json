{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.invalid/schemas/telemetry-report.schema.json",
  "$comment": "The authenticated agent telemetry envelope remains the current wire schema 1. Rich metrics are explicitly bound to nested schema 2. The canonical report is limited to 65536 UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "samples": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/sample"}}
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_id", "sequence", "observed_at", "cpu_utilization_percent",
        "load_average_1m", "memory_total_bytes", "memory_available_bytes",
        "disk_total_bytes", "disk_free_bytes", "gpu_utilization_percent",
        "gpu_memory_total_bytes", "gpu_memory_free_bytes", "temperature_c",
        "power_watts", "network_receive_bytes_per_second",
        "network_transmit_bytes_per_second", "gap_samples", "details"
      ],
      "properties": {
        "boot_id": {"type": "string", "format": "uuid"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "observed_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "cpu_utilization_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "load_average_1m": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
        "memory_total_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 17592186044416},
        "memory_available_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 17592186044416},
        "disk_total_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 17592186044416},
        "disk_free_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 17592186044416},
        "gpu_utilization_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "gpu_memory_total_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 17592186044416},
        "gpu_memory_free_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 17592186044416},
        "temperature_c": {"type": ["number", "null"], "minimum": -100, "maximum": 300},
        "power_watts": {"type": ["number", "null"], "minimum": 0, "maximum": 100000},
        "network_receive_bytes_per_second": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000000},
        "network_transmit_bytes_per_second": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000000},
        "gap_samples": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "details": {"$ref": "#/$defs/details"},
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accelerator_name", "accelerator_performance_state"],
      "properties": {
        "accelerator_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "accelerator_performance_state": {"type": ["string", "null"], "minLength": 1, "maxLength": 32}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "series", "capabilities", "runtimes", "workloads", "provenance"],
      "properties": {
        "schema_version": {"const": 2},
        "series": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/series"}},
        "capabilities": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/capability"}},
        "runtimes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/runtime"}},
        "workloads": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/workload"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "identity": {"type": "string", "minLength": 1, "maxLength": 128},
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "value", "unit", "source", "measurement_kind", "observed_at", "freshness", "freshness_threshold_seconds", "support_status", "aggregation"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identity"},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
        "scope": {"enum": ["node", "accelerator", "memory", "storage", "network", "runtime", "workload", "service", "benchmark"]},
        "device_id": {"$ref": "#/$defs/identity"},
        "process_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "process_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "interface_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "run_id": {"$ref": "#/$defs/identity"},
        "value": {"type": ["number", "integer", "string", "boolean", "null"]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "measurement_kind": {"enum": ["measured", "derived", "estimated", "configured"]},
        "observed_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "received_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "freshness": {"enum": ["fresh", "delayed", "stale"]},
        "freshness_threshold_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "support_status": {"enum": ["available", "unsupported", "unavailable", "stale"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256},
        "aggregation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}$"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "unit", "source", "measurement_kind", "supported", "freshness_threshold_seconds"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identity"},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
        "scope": {"enum": ["node", "accelerator", "memory", "storage", "network", "runtime", "workload", "service", "benchmark"]},
        "device_id": {"$ref": "#/$defs/identity"},
        "process_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "process_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "interface_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "run_id": {"$ref": "#/$defs/identity"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "measurement_kind": {"enum": ["measured", "derived", "estimated", "configured"]},
        "supported": {"type": "boolean"},
        "freshness_threshold_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "collector_version"],
      "properties": {
        "collector": {"type": "string", "minLength": 1, "maxLength": 64},
        "collector_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "host_uptime_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
        "source_observed_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|\\+00:00)$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "engine_id", "backend", "serving_node_ids", "ranks", "readiness", "adapter", "adapter_supported"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identity"},
        "engine_id": {"$ref": "#/$defs/identity"},
        "backend": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "endpoint": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "model_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "recipe_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "context_limit_tokens": {"type": ["integer", "null"], "minimum": 1, "maximum": 9223372036854775807},
        "serving_node_ids": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/identity"}},
        "ranks": {"type": "array", "maxItems": 64, "items": {"type": "integer", "minimum": 0}},
        "readiness": {"enum": ["starting", "ready", "running", "queued", "stopped", "failed", "unknown"]},
        "error": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 64},
        "adapter_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "adapter_supported": {"type": "boolean"},
        "adapter_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "engine_id", "state", "executor_node_ids"],
      "properties": {
        "request_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "job_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "run_id": {"$ref": "#/$defs/identity"},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "recipe_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "engine_id": {"$ref": "#/$defs/identity"},
        "state": {"enum": ["queued", "running", "completed", "failed", "cancelled", "unknown"]},
        "origin_node_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "executor_node_ids": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/identity"}},
        "created_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "started_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "ended_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 31536000},
        "failure": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "progress_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "progress_max": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000000},
        "eta_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 31536000},
        "eta_source": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
      }
    }
  }
}
