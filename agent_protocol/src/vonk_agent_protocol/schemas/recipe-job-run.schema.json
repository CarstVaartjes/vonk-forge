{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.invalid/schemas/recipe-job-run.schema.json",
  "title": "Vonk one-shot recipe job request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "run_id", "installation_id", "recipe_revision_id", "recipe_content_sha256", "image_digest", "plan_digest", "interface", "rank", "role", "reserved_memory_bytes", "contract_sha256", "input_manifest_sha256", "input_total_bytes", "inputs", "parameters", "output_mappings", "output_limits", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "installation_id": {"type": "string", "format": "uuid"},
    "recipe_revision_id": {"type": "string", "format": "uuid"},
    "recipe_content_sha256": {"$ref": "#/$defs/digest"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "interface": {"enum": ["audio-job", "video-job", "image-job", "mesh-job", "artifact-job"]},
    "rank": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "reserved_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 17592186044416},
    "contract_sha256": {"$ref": "#/$defs/digest"},
    "input_manifest_sha256": {"$ref": "#/$defs/digest"},
    "input_total_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
    "inputs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/input"}},
    "parameters": {"type": "object", "maxProperties": 128},
    "output_mappings": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/output-mapping"}},
    "output_limits": {"$ref": "#/$defs/output-limits"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^(?!manifest\\.json$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "slot": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
    "media-type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "name", "media_type", "size_bytes", "sha256"],
      "properties": {
        "slot": {"$ref": "#/$defs/slot"},
        "name": {"$ref": "#/$defs/name"},
        "media_type": {"$ref": "#/$defs/media-type"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "output-mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "media_type", "extensions"],
      "properties": {
        "slot": {"$ref": "#/$defs/slot"},
        "media_type": {"$ref": "#/$defs/media-type"},
        "extensions": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9][a-z0-9._-]{0,15}$"}}
      }
    },
    "output-limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_file_bytes", "max_total_bytes", "allowed_media_types"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "allowed_media_types": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/media-type"}}
      }
    }
  }
}
