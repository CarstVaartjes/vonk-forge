{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical payload UTF-8 JSON is limited to 65536 bytes by mandatory validate_schema_message runtime validation; JSON Schema cannot express aggregate encoded-byte size.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "operation_id", "attempt", "fence", "node_id", "operation", "authority_revision", "payload_digest", "payload", "deadline"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "fence": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"},
    "operation": {"enum": ["agent.upgrade.v1", "node.probe", "release.install", "workload.prepare", "workload.start", "workload.stop", "workload.health", "workload.verify", "recipe.build.v1", "recipe.image.import.v1", "recipe.install", "recipe.start", "recipe.job.run.v1", "recipe.stop", "recipe.uninstall"]},
    "authority_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"anyOf": [{"$ref": "#/$defs/safe-object"}, {"$ref": "#/$defs/agent-upgrade"}]},
    "deadline": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"}
  },
  "$defs": {
    "agent-upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "package_bytes", "package_sha256", "package_signature", "package_url", "package_version", "schema_version", "target_binary_digest", "target_build_digest"],
      "properties": {
        "architecture": {"const": "linux-arm64"},
        "package_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package_signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
        "package_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://install\\.vonkforge\\.ai/[A-Za-z0-9._~!$&'()*+,;=:%/-]{1,1900}/vonk-forge-agent\\.deb$"},
        "package_version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+~-]{0,127}$"},
        "schema_version": {"const": 1},
        "target_binary_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_build_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "safe-object": {
      "type": "object",
      "propertyNames": {
        "$comment": "The filesystem terms path, file, filename, filepath, directory, and folder start a forbidden key segment at the key edge, after '_'/'-', or as an uppercase term after lowercase/digit. The segment ends at the key edge, before '_'/'-', or before an uppercase continuation. Term matching is ASCII case-insensitive; lowercase continuations remain allowed.",
        "allOf": [
          {"not": {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee].?[Kk][Ee][Yy]|[Cc][Oo][Mm][Mm][Aa][Nn][Dd]|[Ss][Hh][Ee][Ll][Ll]|[Ee][Nn][Vv][Ii][Rr][Oo][Nn][Mm][Ee][Nn][Tt]"}},
          {"not": {"pattern": "(?:^|[_-])(?:[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee]|[Ff][Ii][Ll][Ee][Nn][Aa][Mm][Ee]|[Ff][Ii][Ll][Ee][Pp][Aa][Tt][Hh]|[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|[Ff][Oo][Ll][Dd][Ee][Rr])(?:$|[_-]|[A-Z])|[a-z0-9](?:P[Aa][Tt][Hh]|F[Ii][Ll][Ee]|F[Ii][Ll][Ee][Nn][Aa][Mm][Ee]|F[Ii][Ll][Ee][Pp][Aa][Tt][Hh]|D[Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|F[Oo][Ll][Dd][Ee][Rr])(?:$|[_-]|[A-Z])"}}
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/safe-value"}
    },
    "safe-value": {
      "anyOf": [
        {"type": ["null", "boolean", "number"]},
        {"type": "string", "not": {"pattern": "[/\\\\]"}},
        {"type": "array", "items": {"$ref": "#/$defs/safe-value"}},
        {"$ref": "#/$defs/safe-object"}
      ]
    }
  }
}
