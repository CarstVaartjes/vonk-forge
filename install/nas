#!/bin/sh
set -eu

kind=nas
base_url=${VONK_INSTALL_BASE_URL:-https://install.vonkforge.ai/artifacts}

fail() {
    printf '%s\n' "vonk-forge ${kind} installer: $*" >&2
    exit 1
}

case $(uname -s) in
    Linux) platform=linux ;;
    Darwin) platform=darwin ;;
    *) fail "this operating system is not supported" ;;
esac
case $(uname -m) in
    x86_64|amd64) architecture=amd64 ;;
    aarch64|arm64) architecture=arm64 ;;
    *) fail "this CPU architecture is not supported" ;;
esac

case "$platform-$architecture" in
    linux-amd64) expected='@NAS_LINUX_AMD64_SHA256@' ;;
    linux-arm64) expected='@NAS_LINUX_ARM64_SHA256@' ;;
    darwin-amd64) expected='@NAS_DARWIN_AMD64_SHA256@' ;;
    darwin-arm64) expected='@NAS_DARWIN_ARM64_SHA256@' ;;
    *) fail "this platform is not supported" ;;
esac
[ "${#expected}" -eq 64 ] || fail "this installer endpoint is not published correctly"
case "$expected" in *[!0-9a-f]*) fail "this installer endpoint is not published correctly" ;; esac
payload_expected='@NAS_PAYLOAD_SHA256@'
[ "${#payload_expected}" -eq 64 ] || fail "this installer endpoint is not published correctly"
case "$payload_expected" in *[!0-9a-f]*) fail "this installer endpoint is not published correctly" ;; esac

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        fail "sha256sum, shasum, or openssl is required"
    fi
}

temporary=$(mktemp -d "${TMPDIR:-/tmp}/vonk-${kind}.XXXXXX") || fail "cannot create a temporary directory"
cleanup() {
    rm -rf -- "$temporary"
}
trap cleanup EXIT HUP INT TERM

artifact="$temporary/vonk-${kind}-setup"
payload="$temporary/payload.json"
url="$base_url/$kind/current/$platform-$architecture/vonk-${kind}-setup"
payload_url="$base_url/$kind/current/payload.json"

curl -fsSL --proto '=https' --tlsv1.2 "$url" -o "$artifact" || fail "cannot download the setup program"
curl -fsSL --proto '=https' --tlsv1.2 "$payload_url" -o "$payload" || fail "cannot download the release payload"

[ "$(sha256 "$payload")" = "$payload_expected" ] || fail "the release payload failed checksum verification"
actual=$(sha256 "$artifact")
[ "$actual" = "$expected" ] || fail "the setup program failed checksum verification"

chmod 0700 "$artifact"
if [ -e ./vonk-forge ]; then
    "$artifact" --template "$payload" --upgrade
else
    "$artifact" --template "$payload"
fi
