#!/bin/sh
set -eu
umask 077

kind=nas
base_url=${VONK_INSTALL_BASE_URL:-https://install.vonkforge.ai/artifacts}

fail() {
    printf '%s\n' "vonk-forge ${kind} installer: $*" >&2
    exit 1
}

validate_arguments() {
    hermes_option=
    answers_file=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --enable-hermes|--disable-hermes)
                [ -z "$hermes_option" ] || fail "the Hermes mode may be selected only once"
                hermes_option=$1
                shift
                ;;
            --answers-file)
                [ -z "$answers_file" ] || fail "the answers file may be selected only once"
                [ "$#" -ge 2 ] && [ -n "$2" ] || fail "--answers-file requires a path"
                answers_file=$2
                shift 2
                ;;
            *) fail "this installer accepts only a Hermes mode and --answers-file PATH" ;;
        esac
    done
}
validate_arguments "$@"

command -v uv >/dev/null 2>&1 || fail "uv is required; install uv, then rerun this command"
expected='@NAS_WHEEL_SHA256@'
wheel_filename='@NAS_WHEEL_FILENAME@'
wheel_size='@NAS_WHEEL_SIZE@'
[ "${#expected}" -eq 64 ] || fail "this installer endpoint is not published correctly"
case "$expected" in *[!0-9a-f]*) fail "this installer endpoint is not published correctly" ;; esac
# The verified payload installs accepted channel images and the exact managed CA
# digest. Its checksum authenticates the complete Compose graph and trust inputs.
payload_expected='@NAS_PAYLOAD_SHA256@'
[ "${#payload_expected}" -eq 64 ] || fail "this installer endpoint is not published correctly"
case "$payload_expected" in *[!0-9a-f]*) fail "this installer endpoint is not published correctly" ;; esac

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        fail "sha256sum, shasum, or openssl is required"
    fi
}

download() {
    curl -fsSL --proto '=https' --tlsv1.2 \
        --retry 10 --retry-all-errors --retry-delay 2 --retry-max-time 45 \
        --connect-timeout 10 --max-time 60 "$1" -o "$2"
}

temporary=$(mktemp -d "${TMPDIR:-/tmp}/vonk-${kind}.XXXXXX") || fail "cannot create a temporary directory"
cleanup() {
    rm -rf -- "${temporary:?}"
}
trap cleanup EXIT HUP INT TERM

wheel="$temporary/$wheel_filename"
payload="$temporary/payload.json"
url="$base_url/$kind/current/$wheel_filename"
payload_url="$base_url/$kind/current/payload.json"

download "$url" "$wheel" || fail "cannot download the NAS setup wheel"
download "$payload_url" "$payload" || fail "cannot download the release payload"

[ "$(sha256 "$payload")" = "$payload_expected" ] || fail "the release payload failed checksum verification"
[ "$(wc -c <"$wheel" | tr -d ' ')" = "$wheel_size" ] || fail "the setup wheel size is invalid"
actual=$(sha256 "$wheel")
[ "$actual" = "$expected" ] || fail "the NAS setup wheel failed checksum verification"

if [ -e ./vonk-forge ]; then
    uv run --isolated --no-project --python 3.14 --with "$wheel" \
        vonk-nas-setup --template "$payload" --upgrade "$@"
else
    uv run --isolated --no-project --python 3.14 --with "$wheel" \
        vonk-nas-setup --template "$payload" "$@"
fi
