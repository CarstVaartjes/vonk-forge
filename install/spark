#!/bin/sh
set -eu

kind=spark
base_url=${VONK_INSTALL_BASE_URL:-https://install.vonkforge.ai/artifacts}

fail() {
    printf '%s\n' "vonk-forge ${kind} installer: $*" >&2
    exit 1
}

[ "$#" -eq 0 ] || fail "this installer does not accept arguments"

[ "$(uname -s)" = Linux ] || fail "Spark installation requires Linux"
platform=linux
case $(uname -m) in
    x86_64|amd64) architecture=amd64 ;;
    aarch64|arm64) architecture=arm64 ;;
    *) fail "this CPU architecture is not supported" ;;
esac

case "$platform-$architecture" in
    linux-amd64)
        expected='@SPARK_LINUX_AMD64_SHA256@'
        package_expected='@SPARK_LINUX_AMD64_PACKAGE_SHA256@'
        ;;
    linux-arm64)
        expected='@SPARK_LINUX_ARM64_SHA256@'
        package_expected='@SPARK_LINUX_ARM64_PACKAGE_SHA256@'
        ;;
    *) fail "this platform is not supported" ;;
esac
[ "${#expected}" -eq 64 ] || fail "this installer endpoint is not published correctly"
case "$expected" in *[!0-9a-f]*) fail "this installer endpoint is not published correctly" ;; esac
[ "${#package_expected}" -eq 64 ] || fail "this installer endpoint is not published correctly"
case "$package_expected" in *[!0-9a-f]*) fail "this installer endpoint is not published correctly" ;; esac

temporary=$(mktemp -d "${TMPDIR:-/tmp}/vonk-${kind}.XXXXXX") || fail "cannot create a temporary directory"
cleanup() {
    rm -rf -- "$temporary"
}
trap cleanup EXIT HUP INT TERM

artifact="$temporary/vonk-${kind}-setup"
url="$base_url/$kind/current/$platform-$architecture/vonk-${kind}-setup"
package="$temporary/vonk-forge-agent_0.0.0_${architecture}.deb"
package_url="$base_url/$kind/current/$platform-$architecture/vonk-forge-agent.deb"

curl -fsSL --proto '=https' --tlsv1.2 "$url" -o "$artifact" || fail "cannot download the setup program"
curl -fsSL --proto '=https' --tlsv1.2 "$package_url" -o "$package" || fail "cannot download the agent package"

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        fail "sha256sum, shasum, or openssl is required"
    fi
}
actual=$(sha256 "$artifact")
[ "$actual" = "$expected" ] || fail "the setup program failed checksum verification"
package_actual=$(sha256 "$package")
[ "$package_actual" = "$package_expected" ] || fail "the agent package failed checksum verification"

chmod 0700 "$artifact"
"$artifact" --package "$package" --package-sha256 "$package_expected"
