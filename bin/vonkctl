#!/usr/bin/env python3
"""Repository-local launcher for the developer workload profile controller."""

import sys
from pathlib import Path

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "src"))

from cluster_profiles.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(root=REPOSITORY_ROOT))
