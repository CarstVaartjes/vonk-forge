#!/usr/bin/env python3
"""Repository-local launcher for per-node installation mode."""

from pathlib import Path
import sys

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "src"))

from cluster_profiles.install.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(root=REPOSITORY_ROOT))
