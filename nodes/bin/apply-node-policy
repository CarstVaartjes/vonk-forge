#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s --policy FILE --check|--apply|--verify\n' "$0" >&2
    exit 64
}

[[ $# -eq 3 && "$1" == --policy ]] || usage
policy="$2"
action="$3"
case "$action" in
    --check|--apply|--verify) ;;
    *) usage ;;
esac

[[ -f "$policy" && ! -L "$policy" ]] || {
    printf '%s\n' 'ERROR: policy must be a regular non-symlink file' >&2
    exit 64
}
command -v jq >/dev/null 2>&1 || {
    printf '%s\n' 'ERROR: jq is required' >&2
    exit 64
}

if ! jq -e '
    type == "object" and
    (keys | sort) == ["earlyoom", "schema_version"] and
    .schema_version == 1 and
    .earlyoom == "disabled"
' "$policy" >/dev/null 2>&1; then
    printf '%s\n' 'ERROR: unsupported or invalid node policy' >&2
    exit 64
fi

earlyoom_bin="${VONK_DISABLE_EARLYOOM_BIN:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/disable-earlyoom}"
[[ -x "$earlyoom_bin" && ! -L "$earlyoom_bin" ]] || {
    printf '%s\n' 'ERROR: earlyoom policy helper is unavailable or unsafe' >&2
    exit 64
}
policy_sha256="$(sha256sum "$policy" | awk '{print $1}')"

emit_result() {
    local status="$1"
    jq -cn \
        --arg status "$status" \
        --arg policy_sha256 "$policy_sha256" \
        '{schema_version:1,status:$status,policy_sha256:$policy_sha256,earlyoom:"disabled"}'
}

check_earlyoom() {
    set +e
    "$earlyoom_bin" --check >/dev/null 2>&1
    earlyoom_rc=$?
    set -e
}

check_earlyoom
case "$action:$earlyoom_rc" in
    --check:0)
        emit_result unchanged
        exit 0
        ;;
    --check:2)
        emit_result change-required
        exit 2
        ;;
    --verify:0)
        emit_result verified
        exit 0
        ;;
    --verify:2)
        emit_result noncompliant
        exit 3
        ;;
    --apply:0)
        emit_result unchanged
        exit 0
        ;;
    --apply:2)
        emit_result operator-action-required
        exit 3
        ;;
    *)
        emit_result failed
        exit 3
        ;;
esac
