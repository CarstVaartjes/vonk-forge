#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s --check|--apply\n' "$0" >&2
  exit 64
}

[[ $# -eq 1 ]] || usage
mode="$1"
case "$mode" in
  --check|--apply) ;;
  *) usage ;;
esac

capture_state() {
  set +e
  load_output="$(systemctl show earlyoom --property=LoadState --value 2>&1)"
  load_rc=$?
  enabled_output="$(systemctl is-enabled earlyoom 2>&1)"
  enabled_rc=$?
  active_output="$(systemctl is-active earlyoom 2>&1)"
  active_rc=$?
  package_output="$(dpkg-query -W -f='${db:Status-Status} ${Version}' earlyoom 2>&1)"
  package_rc=$?
  set -e
}

print_state() {
  local prefix="$1"
  printf '%s.load_state=%q\n' "$prefix" "$load_output"
  printf '%s.load_state.exit_code=%s\n' "$prefix" "$load_rc"
  printf '%s.enabled.stdout=%q\n' "$prefix" "$enabled_output"
  printf '%s.enabled.exit_code=%s\n' "$prefix" "$enabled_rc"
  printf '%s.active.stdout=%q\n' "$prefix" "$active_output"
  printf '%s.active.exit_code=%s\n' "$prefix" "$active_rc"
  printf '%s.package.stdout=%q\n' "$prefix" "$package_output"
  printf '%s.package.exit_code=%s\n' "$prefix" "$package_rc"
}

classify_state() {
  classification=unexpected

  active_change_state=0
  case "$active_output:$active_rc" in
    active:0|reloading:0|activating:3|deactivating:3|failed:3)
      active_change_state=1
      ;;
  esac

  if [[ "$load_rc" -eq 0 && "$load_output" == not-found &&
        "$enabled_rc" -eq 4 && "$enabled_output" == not-found &&
        "$active_rc" -eq 4 && "$active_output" == inactive &&
        "$package_rc" -eq 1 ]]; then
    classification=absent
    return
  fi

  if [[ "$load_rc" -eq 0 && "$load_output" == loaded &&
        "$enabled_rc" -eq 1 && "$enabled_output" == disabled &&
        "$active_rc" -eq 3 && "$active_output" == inactive &&
        "$package_rc" -eq 0 && "$package_output" == installed\ * ]]; then
    classification=disabled
    return
  fi

  if [[ "$load_rc" -eq 0 && "$load_output" == masked &&
        "$enabled_rc" -eq 1 &&
        ( "$enabled_output" == masked || "$enabled_output" == masked-runtime ) &&
        "$active_rc" -eq 3 && "$active_output" == inactive &&
        "$package_rc" -eq 0 && "$package_output" == installed\ * ]]; then
    classification=masked
    return
  fi

  if [[ "$load_rc" -eq 0 && "$load_output" == loaded &&
        "$package_rc" -eq 0 && "$package_output" == installed\ * ]]; then
    if [[ "$enabled_rc" -eq 0 && "$enabled_output" == static &&
          ( "$active_change_state" -eq 1 ||
            ( "$active_rc" -eq 3 && "$active_output" == inactive ) ) ]]; then
      classification=static
      return
    fi
    if [[ "$enabled_rc" -eq 0 && "$enabled_output" == enabled &&
          ( "$active_change_state" -eq 1 ||
            ( "$active_rc" -eq 3 && "$active_output" == inactive ) ) ]]; then
      classification=change_required_enabled
      return
    fi
    if [[ "$enabled_rc" -eq 1 && "$enabled_output" == disabled &&
          "$active_change_state" -eq 1 ]]; then
      classification=change_required_disabled_active
      return
    fi
  fi

  if [[ "$load_rc" -eq 0 && "$load_output" == masked &&
        "$enabled_rc" -eq 1 &&
        ( "$enabled_output" == masked || "$enabled_output" == masked-runtime ) &&
        "$active_change_state" -eq 1 && "$package_rc" -eq 0 &&
        "$package_output" == installed\ * ]]; then
    classification=change_required_masked_active
    return
  fi
}

capture_state
print_state before
classify_state
printf 'classification=%s\n' "$classification"

case "$classification" in
  absent)
    printf 'PASS: earlyoom is absent; no change required\n'
    exit 0
    ;;
  disabled)
    printf 'PASS: earlyoom is disabled and inactive\n'
    exit 0
    ;;
  masked)
    printf 'PASS: earlyoom is masked and inactive\n'
    exit 0
    ;;
  static|unexpected)
    printf 'ERROR: unexpected earlyoom state; refusing to change it\n' >&2
    exit 3
    ;;
esac

if [[ "$mode" == --check ]]; then
  printf 'CHANGE_REQUIRED: earlyoom must be made inactive and non-enabled\n' >&2
  exit 2
fi

printf '%s\n' \
  'ERROR: refusing to mutate a platform-managed earlyoom service; stop workload admission and review the current NVIDIA platform policy' >&2
exit 3
