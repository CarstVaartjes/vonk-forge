#!/usr/bin/env bash
set -euo pipefail

# Upload and invoke this script only with `ssh -o ForwardAgent=no`; it never
# opens SSH itself and never handles private-key material.

netplan_directory="${DIRECT_FABRIC_NETPLAN_DIRECTORY:-/etc/netplan}"
managed_netplan="$netplan_directory/99-vonk-node-direct-fabric.yaml"
rollback_directory="${DIRECT_FABRIC_ROLLBACK_DIRECTORY:-/root/vonk-node-fabric-rollback}"
sys_class_net="${DIRECT_FABRIC_SYS_CLASS_NET:-/sys/class/net}"
sys_class_infiniband="${DIRECT_FABRIC_SYS_CLASS_INFINIBAND:-/sys/class/infiniband}"
node=''
action=''
runtime_before=()

usage() {
    cat <<'USAGE'
Usage: configure-direct-fabric --node node1|node2 --emit-netplan|--check|--apply|--local-postcheck|--postcheck|--rollback

--emit-netplan prints the reviewed persistent Netplan document without changing
anything. --check, --local-postcheck, and --postcheck are read-only. --apply is
retired and always refuses because NVIDIA Sync owns fresh fabric configuration.
--rollback remains available only to remove a plan previously owned by this
helper, requires root, and uses netplan try.
USAGE
}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        --node)
            (($# >= 2)) || fail '--node needs node1 or node2'
            node="$2"
            shift 2
            ;;
        --emit-netplan|--check|--apply|--local-postcheck|--postcheck|--rollback)
            [[ -z "$action" ]] || fail 'choose exactly one action'
            action="$1"
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

[[ "$node" == node1 || "$node" == node2 ]] || fail 'node must be node1 or node2'
[[ -n "$action" ]] || fail 'an action is required'

case "$node" in
    node1)
        addresses=('192.168.100.10/24' '192.168.101.10/24')
        peers=('192.168.100.11' '192.168.101.11')
        ;;
    node2)
        addresses=('192.168.100.11/24' '192.168.101.11/24')
        peers=('192.168.100.10' '192.168.101.10')
        ;;
esac

interfaces=('enp1s0f1np1' 'enP2p1s0f1np1')
hcas=('rocep1s0f1' 'roceP2p1s0f1')
mtu=1500

emit_netplan() {
    cat <<EOF
network:
  version: 2
  ethernets:
    ${interfaces[0]}:
      addresses:
        - ${addresses[0]}
      dhcp4: false
      mtu: ${mtu}
      optional: true
    ${interfaces[1]}:
      addresses:
        - ${addresses[1]}
      dhcp4: false
      mtu: ${mtu}
      optional: true
EOF
}

require_root() {
    if ((EUID != 0)) && [[ "${DIRECT_FABRIC_TEST_ALLOW_UNPRIVILEGED:-0}" != 1 ]]; then
        fail "$action must be run with sudo"
    fi
}

management_default_device() {
    ip -4 route show default | awk '/^default / { for (i = 1; i <= NF; ++i) if ($i == "dev") { print $(i + 1); exit } }'
}

management_route_is_preserved() {
    local default_device interface
    default_device="$(management_default_device)"
    [[ -n "$default_device" ]] || return 1
    for interface in "${interfaces[@]}"; do
        [[ "$default_device" != "$interface" ]] || return 1
    done
}

assert_management_route_is_preserved() {
    management_route_is_preserved || fail 'management default route is absent or uses a fabric interface'
}

no_fabric_default_routes() {
    local interface
    for interface in "${interfaces[@]}"; do
        [[ -z "$(ip route show default dev "$interface")" ]] || return 1
    done
}

assert_no_fabric_default_routes() {
    no_fabric_default_routes || fail 'a fabric interface has a default route'
}

assert_interfaces_present() {
    local interface
    for interface in "${interfaces[@]}"; do
        [[ -d "$sys_class_net/$interface" ]] || fail "missing expected CX-7 interface: $interface"
        [[ "$(cat "$sys_class_net/$interface/operstate")" == up ]] || \
            fail "expected CX-7 interface is not up: $interface"
        [[ "$(cat "$sys_class_net/$interface/speed")" == 200000 ]] || \
            fail "expected 200000 Mb/s link on $interface"
    done
}

assert_no_foreign_fabric_plan() {
    local interface plan
    [[ ! -e "$netplan_directory/99-nvidia-sync-cluster.yaml" ]] || \
        fail 'NVIDIA Sync cluster Netplan exists; do not mix managed and manual fabric plans'
    for plan in "$netplan_directory"/*.yaml "$netplan_directory"/*.yml; do
        [[ -e "$plan" && "$plan" != "$managed_netplan" ]] || continue
        [[ -r "$plan" ]] || fail "cannot inspect foreign Netplan as the current user: $plan"
        for interface in "${interfaces[@]}"; do
            if grep -Fq -- "$interface" "$plan"; then
                fail "foreign Netplan claims fabric interface $interface: $plan"
            fi
        done
    done
    if [[ -e "$managed_netplan" ]] && ! cmp -s "$managed_netplan" <(emit_netplan); then
        fail "existing managed Netplan differs: $managed_netplan"
    fi
}

check() {
    command -v ip >/dev/null || fail 'ip command is unavailable'
    command -v netplan >/dev/null || fail 'netplan command is unavailable'
    assert_interfaces_present
    assert_management_route_is_preserved
    assert_no_foreign_fabric_plan
    printf 'PASS: fabric preflight passed for %s; management default=%s\n' \
        "$node" "$(management_default_device)"
}

capture_runtime_state() {
    local interface
    runtime_before=()
    for interface in "${interfaces[@]}"; do
        runtime_before+=("$(ip -4 -o addr show dev "$interface" 2>/dev/null || true)")
    done
}

runtime_state_matches_before() {
    local index interface current
    for index in 0 1; do
        interface="${interfaces[$index]}"
        current="$(ip -4 -o addr show dev "$interface" 2>/dev/null || true)"
        [[ "$current" == "${runtime_before[$index]}" ]] || return 1
    done
}

restore_plan_without_runtime_change() {
    local prior_plan="$1"
    local had_prior_plan="$2"
    if [[ "$had_prior_plan" == true ]]; then
        install -m 0600 "$prior_plan" "$managed_netplan"
    else
        rm -f "$managed_netplan"
    fi
    runtime_state_matches_before || fail 'Netplan failure did not restore the previous runtime state'
    assert_management_route_is_preserved
    assert_no_fabric_default_routes
    printf '%s\n' 'ROLLBACK: restored previous Netplan and runtime state'
}

restore_plan_and_runtime() {
    local prior_plan="$1"
    local had_prior_plan="$2"
    if [[ "$had_prior_plan" == true ]]; then
        install -m 0600 "$prior_plan" "$managed_netplan"
    else
        rm -f "$managed_netplan"
    fi
    netplan generate || fail 'could not regenerate restored Netplan configuration'
    netplan apply || fail 'could not reapply restored Netplan configuration'
    runtime_state_matches_before || fail 'Netplan failure did not restore the previous runtime state'
    assert_management_route_is_preserved
    assert_no_fabric_default_routes
    printf '%s\n' 'ROLLBACK: restored previous Netplan and runtime state'
}

retired_apply() {
    printf '%s\n' \
        'ERROR: --apply is retired; use NVIDIA Sync Cluster Assistant for fabric configuration' >&2
    exit 3
}

gid_for_ipv4() {
    local hca="$1" interface="$2" address="$3"
    local gid_file gid_index gid_type gid ndev
    for gid_file in "$sys_class_infiniband/$hca/ports/1/gids"/[0-9]*; do
        [[ -e "$gid_file" ]] || continue
        gid_index="${gid_file##*/}"
        gid_type="$(cat "$sys_class_infiniband/$hca/ports/1/gid_attrs/types/$gid_index" 2>/dev/null || true)"
        ndev="$(cat "$sys_class_infiniband/$hca/ports/1/gid_attrs/ndevs/$gid_index" 2>/dev/null || true)"
        [[ "$gid_type" == 'RoCE v2' && "$ndev" == "$interface" ]] || continue
        gid="$(cat "$gid_file")"
        if python3 - "$address" "$gid" <<'PY'
import ipaddress
import sys
address = ipaddress.IPv4Address(sys.argv[1])
gid = ipaddress.IPv6Address(sys.argv[2])
raise SystemExit(0 if gid.ipv4_mapped == address else 1)
PY
        then
            printf '%s\n' "$gid_index"
            return 0
        fi
    done
    return 1
}

local_postcheck() {
    local index interface address hca gid_index current_mtu
    check
    assert_no_fabric_default_routes
    for index in 0 1; do
        interface="${interfaces[$index]}"
        address="${addresses[$index]%%/*}"
        hca="${hcas[$index]}"
        current_mtu="$(cat "$sys_class_net/$interface/mtu")"
        [[ "$current_mtu" == "$mtu" ]] || fail "unexpected MTU on $interface: $current_mtu"
        ip -4 -o addr show dev "$interface" | grep -Fq "$address/24" || \
            fail "missing $address/24 on $interface"
        gid_index="$(gid_for_ipv4 "$hca" "$interface" "$address")" || \
            fail "no RoCE v2 GID maps $hca/$interface to $address"
        printf 'PASS: interface=%s fabric_ip=%s hca=%s gid_index=%s mtu=%s link_rate=200000Mb/s\n' \
            "$interface" "$address" "$hca" "$gid_index" "$current_mtu"
    done
    printf 'PASS: local fabric validation passed for %s\n' "$node"
}

postcheck() {
    local index interface peer payload
    local_postcheck
    for index in 0 1; do
        interface="${interfaces[$index]}"
        peer="${peers[$index]}"
        ip route get "$peer" | grep -Fq "dev $interface" || \
            fail "peer $peer does not route through $interface"
        payload=$((mtu - 28))
        ping -I "$interface" -c 3 "$peer"
        ping -I "$interface" -M 'do' -s "$payload" -c 3 "$peer"
    done
    printf 'PASS: bidirectional fabric validation passed for %s\n' "$node"
}

rollback() {
    local retained_plan prior_plan
    require_root
    [[ -e "$managed_netplan" ]] || fail "managed Netplan is absent: $managed_netplan"
    capture_runtime_state
    prior_plan="$(mktemp "$netplan_directory/.99-vonk-node-direct-fabric.previous.XXXXXX")"
    cp -p "$managed_netplan" "$prior_plan"
    rm -f "$managed_netplan"
    if ! netplan generate; then
        restore_plan_without_runtime_change "$prior_plan" true
        rm -f "$prior_plan"
        fail 'netplan generate failed during rollback; prior plan was restored'
    fi
    printf '%s\n' 'ACTION REQUIRED: review netplan try before accepting removal of the fabric plan.'
    if ! netplan try; then
        restore_plan_and_runtime "$prior_plan" true
        rm -f "$prior_plan"
        fail 'netplan try was rejected or failed during rollback; prior plan was restored'
    fi
    if ! management_route_is_preserved || ! no_fabric_default_routes; then
        restore_plan_and_runtime "$prior_plan" true
        rm -f "$prior_plan"
        fail 'rollback changed routing unexpectedly; prior plan was restored'
    fi
    install -d -m 0700 "$rollback_directory"
    retained_plan="$rollback_directory/$(basename "$managed_netplan").$(date -u +%Y%m%dT%H%M%SZ)"
    install -m 0600 "$prior_plan" "$retained_plan"
    rm -f "$prior_plan"
    printf 'PASS: manual fabric plan removed; retained at %s\n' "$retained_plan"
}

case "$action" in
    --emit-netplan) emit_netplan ;;
    --check) check ;;
    --apply) retired_apply ;;
    --local-postcheck) local_postcheck ;;
    --postcheck) postcheck ;;
    --rollback) rollback ;;
esac
