#!/usr/bin/env bash
set -euo pipefail

cuda_image='nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04@sha256:7d2f6a8c2071d911524f95061a0db363e24d27aa51ec831fcccf9e76eb72bc92'

docker run --rm --pull=never --gpus=all "$cuda_image" nvidia-smi

current_boot_id="$(cat /proc/sys/kernel/random/boot_id)"
current_boot_id="${current_boot_id//-/}"

if ! kernel_log_json="$(journalctl -k -b --output=json --no-pager)"; then
    printf 'FAIL: could not read the current boot kernel log\n' >&2
    exit 1
fi

if [[ -z "$kernel_log_json" ]]; then
    printf 'FAIL: no current-boot kernel journal entries\n' >&2
    exit 1
fi

if ! jq -e -s . >/dev/null 2>&1 <<<"$kernel_log_json"; then
    printf 'FAIL: current-boot kernel journal is not valid JSON\n' >&2
    exit 1
fi

if ! jq -e --arg boot_id "$current_boot_id" -s \
    'length > 0 and all(.[]; (._BOOT_ID // "") == $boot_id)' \
    >/dev/null <<<"$kernel_log_json"
then
    printf 'FAIL: kernel journal does not match the running boot\n' >&2
    exit 1
fi

kernel_log="$(jq -r '.MESSAGE // empty' <<<"$kernel_log_json")"
if [[ -z "$kernel_log" ]]; then
    printf 'FAIL: no current-boot kernel journal entries\n' >&2
    exit 1
fi

if grep -Eai \
    'I/O error|nvme.*I/O .*timeout|nvme.*controller is down; will reset|nvme.*reset controller|nvme.*failed to reset|EXT4-fs error|XFS.*corrupt|BTRFS.*error' \
    <<<"$kernel_log"
then
    printf 'FAIL: storage or filesystem error in current boot\n' >&2
    exit 1
fi

printf 'PASS: GPU container and current-boot storage checks passed\n'
