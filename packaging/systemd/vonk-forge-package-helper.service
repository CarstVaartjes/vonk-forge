[Unit]
StartLimitIntervalSec=0
Description=Vonk Forge narrow privileged agent helper
Requires=vonk-forge-package-helper.socket
Requires=vonk-forge-docker-firewall.service
Wants=docker.service
After=local-fs.target docker.service vonk-forge-docker-firewall.service

[Service]
OOMScoreAdjust=-900
MemoryMin=512M
MemoryLow=512M
Restart=always
RestartSec=30s
Type=exec
ExecStart=/usr/lib/vonk-forge/vonk-agent-helper
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# The signed GPU-clock operation needs NVML's O_RDWR device opens. Keep the
# device cgroup closed and expose only the same NVIDIA nodes as the boot cap.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia0 rw
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @raw-io @obsolete @debug
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# NVIDIA's privileged clock ioctl checks CAP_SYS_ADMIN; argv stays compiled
# and the unit still denies mount/raw-I/O syscalls and all other device nodes.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_KILL CAP_NET_ADMIN CAP_SETGID CAP_SETUID
AmbientCapabilities=
RuntimeDirectory=vonk-forge-package-candidates
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ReadWritePaths=/var/lib/vonk-forge /var/lib/dpkg /var/log /var/cache/apt /var/cache/debconf /etc/vonk-forge-agent /usr/lib/vonk-forge /usr/bin /lib/systemd/system
ReadWritePaths=/usr/share/keyrings /usr/share/doc/vonk-forge-agent
# dpkg maintainer scripts run deb-systemd-helper, which records enablement in
# these state directories and links units under /etc/systemd/system. The
# directories are optional so a host without them still starts the helper.
ReadWritePaths=/etc/systemd/system
ReadWritePaths=-/var/lib/systemd/deb-systemd-helper-enabled -/var/lib/systemd/deb-systemd-helper-masked
BindReadOnlyPaths=-/run/docker.sock -/run/vonk-forge-agent/runtime-requests -/var/lib/vonk-forge-agent/image-imports
ReadWritePaths=-/var/lib/vonk-forge-agent/installations -/var/lib/vonk-forge-agent/runs -/var/lib/vonk-forge-agent/run-metadata
# The host memory guard stops a managed container through the kernel (cgroup.kill,
# else SIGKILL of its non-root members), never through the daemon a thrashing
# host starves. Docker places container cgroups under one of these parents.
ReadWritePaths=-/sys/fs/cgroup/system.slice -/sys/fs/cgroup/docker
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=mixed

[Install]
WantedBy=multi-user.target
