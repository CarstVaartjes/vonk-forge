[Unit]
StartLimitIntervalSec=0
Description=Vonk Forge Spark GPU clock ceiling
Documentation=https://vonkforge.ai/docs/operations/install-vonk-agent
# A ceiling, not a pin: sustained load at full clock can hard power off a
# Spark. The lock is lost with the driver, so it is set again every boot; the
# package helper starts this unit when it is not active.
# A host without the NVIDIA tools has no clock to cap.
ConditionPathExists=/usr/bin/nvidia-smi
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service

[Service]
Restart=on-failure
RestartSec=30s
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -lgc 300,2200
TimeoutStartSec=30s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
# Locking clocks is an administrator operation in the NVIDIA driver; the
# bounding set is narrowed further only once proven on a Spark.
CapabilityBoundingSet=~CAP_SYS_PTRACE
AmbientCapabilities=
PrivateTmp=yes
# nvidia-smi opens the NVIDIA device nodes O_RDWR; nothing else is exposed.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia0 rw
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
# nvidia-smi reads /proc/driver/nvidia.
ProcSubset=all
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
