[Unit]
Description=Vonk Forge privileged agent-helper socket
Wants=vonk-forge-package-upgrade-recover.service

[Socket]
ListenStream=/run/vonk-forge-package-helper/package-helper.sock
FileDescriptorName=helper
SocketMode=0660
SocketUser=root
SocketGroup=vonk-agent
DirectoryMode=0711
RemoveOnStop=yes
Service=vonk-forge-package-helper.service

[Install]
WantedBy=sockets.target
