[Unit]
Description=Vonk Forge Docker forwarding policy
Documentation=https://vonkforge.ai/docs/operations/install-vonk-agent
Requires=docker.service
BindsTo=docker.service
After=local-fs.target docker.service
Before=vonk-forge-package-helper.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/vonk-forge/vonk-forge-docker-firewall --config /etc/vonk-forge-agent/docker-firewall.conf apply
ExecReload=/usr/lib/vonk-forge/vonk-forge-docker-firewall --config /etc/vonk-forge-agent/docker-firewall.conf apply
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @raw-io @obsolete @debug @reboot
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadOnlyPaths=/etc/vonk-forge-agent/docker-firewall.conf /usr/lib/vonk-forge/vonk-forge-docker-firewall

[Install]
WantedBy=multi-user.target docker.service
