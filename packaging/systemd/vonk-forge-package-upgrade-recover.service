[Unit]
Description=Vonk Forge durable package upgrade recovery
After=local-fs.target vonk-forge-package-helper.socket
ConditionPathExists=/var/lib/vonk-forge/package-upgrade/intent
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/vonk-forge/vonk-forge-package-upgrade-recover recover
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78
TimeoutStartSec=600s
UMask=0077
User=root
Group=root
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
