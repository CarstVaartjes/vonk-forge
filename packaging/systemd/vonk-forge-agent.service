[Unit]
Description=Vonk Forge outbound agent
Wants=network-online.target
After=network-online.target vonk-forge-package-helper.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vonk-agent
Group=vonk-agent
SupplementaryGroups=
ExecStart=/usr/lib/vonk-forge/vonk-agent --config /etc/vonk-forge-agent/agent.toml run
Environment=HOME=/var/lib/vonk-forge-agent
Environment=XDG_CONFIG_HOME=/var/lib/vonk-forge-agent/.config
Environment=XDG_DATA_HOME=/var/lib/vonk-forge-agent
Environment=XDG_RUNTIME_DIR=/run/vonk-forge-agent
Environment=TMPDIR=/var/lib/vonk-forge-agent/tmp
Environment=CONTAINERS_STORAGE_CONF=/etc/vonk-forge-agent/containers-storage.conf
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=vonk-forge-agent
RuntimeDirectoryMode=0700
NoNewPrivileges=no
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SETGID CAP_SETUID CAP_SYS_ADMIN
AmbientCapabilities=
# The bounding set is the tested minimum required by the distribution's setuid
# newuidmap/newgidmap helpers. The agent itself receives no ambient capabilities.
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/fuse rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=char-231:* rw
# NVIDIA visibility is retained for trusted inventory collection only. Recipe
# builds cannot declare devices; accepted workloads use the signed Docker
# helper boundary. Raw InfiniBand devices are intentionally not exposed.
BindPaths=-/dev/fuse -/dev/nvidiactl -/dev/nvidia-uvm -/dev/nvidia-uvm-tools -/dev/nvidia-modeset -/dev/nvidia0
InaccessiblePaths=/home /root -/run/docker.sock
ProtectSystem=strict
# Rootless Podman must update its own mode-0700 /run/user/<uid> runtime while
# Unix ownership prevents this service account from traversing another user's
# runtime. Hide persistent homes explicitly and leave only that runtime usable.
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# The rootless OCI runtime creates a private UTS namespace and must set that container's
# hostname. The dedicated service user has no ambient host capability, so the
# host hostname remains protected by normal kernel capability checks.
ProtectHostname=no
# newuidmap/newgidmap must inspect the Podman child under /proc. Other procfs
# protections remain enabled and the service still runs as the dedicated user.
ProtectProc=default
ProcSubset=all
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictNamespaces=user mnt pid ipc uts cgroup net
Delegate=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/etc/vonk-forge-agent /usr/lib/vonk-forge
ReadWritePaths=/var/lib/vonk-forge-agent /var/lib/vonk-forge/incoming /run/vonk-forge-agent

[Install]
WantedBy=multi-user.target
