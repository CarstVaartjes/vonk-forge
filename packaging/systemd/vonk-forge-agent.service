[Unit]
Description=Vonk Forge outbound agent
Wants=network-online.target
After=network-online.target vonk-forge-package-helper.socket
PartOf=vonk-forge-agent-supervisor.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vonk-agent
Group=vonk-agent
SupplementaryGroups=
ExecStart=/usr/lib/vonk-forge/vonk-agent-supervisor run-agent
Environment=HOME=/var/lib/vonk-forge-agent
Environment=XDG_DATA_HOME=/var/lib/vonk-forge-agent
Environment=XDG_RUNTIME_DIR=/run/vonk-forge-agent
Environment=CONTAINERS_STORAGE_CONF=/etc/vonk-forge-agent/containers-storage.conf
LoadCredential=activation-challenge:/var/lib/vonk-forge/supervisor/activation-challenge
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=vonk-forge-agent
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Rootless Podman must preserve ordinary SUID/SGID mode bits while unpacking
# OCI layers. NoNewPrivileges and the empty capability sets keep those files
# from granting host privilege to this package-dedicated account.
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/fuse rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=char-231:* rw
BindPaths=-/dev/fuse -/dev/nvidiactl -/dev/nvidia-uvm -/dev/nvidia-uvm-tools -/dev/nvidia-modeset -/dev/nvidia0 -/dev/infiniband
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictNamespaces=user mnt pid ipc uts cgroup net
Delegate=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/vonk-forge/slots /var/lib/vonk-forge/supervisor /etc/vonk-forge-agent /usr/lib/vonk-forge
ReadWritePaths=/var/lib/vonk-forge-agent /run/vonk-forge-agent

[Install]
WantedBy=multi-user.target
