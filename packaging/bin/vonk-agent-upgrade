#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C

usage() {
  printf 'Usage: %s apt\n' "$0" >&2
  printf '       %s install-local /absolute/path/to/verified-package.deb SHA256\n' "$0" >&2
  printf '%s\n' \
    'apt is the networked package-manager convenience mode.' \
    'install-local performs no download or signature verification; the caller must verify the local package before invoking root.' >&2
}

case "${1:-}" in
  apt)
    [[ $# == 1 ]] || { usage; exit 2; }
    mode=apt
    ;;
  install-local)
    [[ $# == 3 ]] || { usage; exit 2; }
    mode=install-local
    local_package=$2
    expected_sha256=$3
    ;;
  *)
    usage
    exit 2
    ;;
esac
if (( EUID != 0 )) && [[ "${VONK_AGENT_UPGRADE_TEST_MODE:-0}" != 1 ]]; then
  printf '%s\n' 'vonk-agent-upgrade must run as root (use sudo)' >&2
  exit 1
fi

root="${VONK_AGENT_UPGRADE_ROOT:-}"
path() {
  if [[ -n "$root" ]]; then
    printf '%s%s' "$root" "$1"
  else
    printf '%s' "$1"
  fi
}

apt_get="${VONK_AGENT_UPGRADE_APT_GET:-/usr/bin/apt-get}"
dpkg="${VONK_AGENT_UPGRADE_DPKG:-/usr/bin/dpkg}"
dpkg_query="${VONK_AGENT_UPGRADE_DPKG_QUERY:-/usr/bin/dpkg-query}"
agent="${VONK_AGENT_UPGRADE_AGENT:-$(path /usr/lib/vonk-forge/vonk-agent)}"
systemctl="${VONK_AGENT_UPGRADE_SYSTEMCTL:-/usr/bin/systemctl}"
config="${VONK_AGENT_UPGRADE_CONFIG:-$(path /etc/vonk-forge-agent/agent.toml)}"
receipt="${VONK_AGENT_UPGRADE_RECEIPT:-$(path /run/vonk-forge-agent/readiness.json)}"
attempts="${VONK_AGENT_UPGRADE_ATTEMPTS:-30}"
sustained_required="${VONK_AGENT_UPGRADE_SUSTAINED:-3}"
interval_seconds="${VONK_AGENT_UPGRADE_INTERVAL_SECONDS:-2}"

required_commands=("$apt_get" "$dpkg" "$dpkg_query" "$systemctl" /usr/bin/sha256sum)
for required in "${required_commands[@]}"; do
  if [[ ! -x "$required" ]]; then
    printf 'required executable is unavailable: %s\n' "$required" >&2
    exit 1
  fi
done

fresh_install=false
case "$mode" in
  apt)
    printf '%s\n' 'Updating the Vonk Forge agent package with apt...'
    "$apt_get" update
    "$apt_get" --fix-broken install --yes
    "$dpkg" --configure -a
    "$apt_get" install --only-upgrade --yes vonk-forge-agent
    ;;
  install-local)
    if [[ "$local_package" != /* ]] \
      || [[ "$local_package" == *://* ]] \
      || [[ ! -f "$local_package" || -L "$local_package" ]] \
      || [[ ! "$expected_sha256" =~ ^[0-9a-f]{64}$ ]] \
      || [[ ! "${local_package##*/}" =~ ^vonk-forge-agent_[A-Za-z0-9.+~:-]+_(amd64|arm64)\.deb$ ]]; then
      printf 'verified local package is invalid: %s\n' "$local_package" >&2
      exit 2
    fi
    actual_sha256=$(/usr/bin/sha256sum -- "$local_package")
    actual_sha256=${actual_sha256%% *}
    if [[ "$actual_sha256" != "$expected_sha256" ]]; then
      printf '%s\n' 'verified local package SHA-256 changed before installation' >&2
      exit 1
    fi
    # shellcheck disable=SC2016
    if ! "$dpkg_query" -W -f='${db:Status-Status}' vonk-forge-agent \
      >/dev/null 2>&1; then
      fresh_install=true
    fi
    printf '%s\n' 'Installing caller-verified local Vonk Forge agent package with dependency resolution...'
    export DEBIAN_FRONTEND=noninteractive
    "$apt_get" update
    "$apt_get" install --yes --no-install-recommends \
      -o Dpkg::Options::=--force-confold "$local_package"
    ;;
esac

if [[ ! -x "$agent" ]]; then
  printf 'installed agent is unavailable: %s\n' "$agent" >&2
  exit 1
fi
version="$("$agent" --version)"
if [[ ! "$version" =~ ^vonk-agent\ [0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  printf 'installed agent version is invalid: %s\n' "$version" >&2
  exit 1
fi
binary_semantic="${version#vonk-agent }"
# shellcheck disable=SC2016
package_version="$("$dpkg_query" -W -f='${Version}' vonk-forge-agent)"
if [[ ! "$package_version" =~ ^([0-9]+\.[0-9]+\.[0-9]+)([~+.-].*)?$ ]]; then
  printf 'installed package version is invalid: %s\n' "$package_version" >&2
  exit 1
fi
package_semantic="${BASH_REMATCH[1]}"
if [[ "$binary_semantic" != "$package_semantic" ]]; then
  printf 'installed agent %s does not match package semantic version %s\n' \
    "$binary_semantic" "$package_semantic" >&2
  exit 1
fi
if [[ "$fresh_install" == true ]]; then
  printf 'fresh package installed: %s; pair the agent before starting the service\n' \
    "$version"
  exit 0
fi

"$agent" --config "$config" self-test >/dev/null

if [[ ! "$attempts" =~ ^[1-9][0-9]*$ ]] \
  || [[ ! "$sustained_required" =~ ^[1-9][0-9]*$ ]] \
  || [[ ! "$interval_seconds" =~ ^[0-9]+$ ]] \
  || (( sustained_required > attempts )); then
  printf '%s\n' 'upgrade health policy is invalid' >&2
  exit 1
fi

sustained=0
sustained_pid=
for (( attempt = 1; attempt <= attempts; attempt++ )); do
  if "$systemctl" is-active --quiet vonk-forge-agent.service; then
    main_pid="$(
      "$systemctl" show --property MainPID --value vonk-forge-agent.service
    )"
    if [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] \
      && "$agent" --config "$config" verify-readiness \
        --receipt "$receipt" --pid "$main_pid" --max-age-seconds 90; then
      if [[ -n "$sustained_pid" && "$main_pid" != "$sustained_pid" ]]; then
        sustained=0
      fi
      sustained_pid="$main_pid"
      (( sustained += 1 ))
      if (( sustained >= sustained_required )); then
        printf 'upgrade complete: %s is healthy\n' "$version"
        exit 0
      fi
    else
      sustained=0
      sustained_pid=
    fi
  else
    sustained=0
    sustained_pid=
  fi
  if (( attempt < attempts )); then
    sleep "$interval_seconds"
  fi
done

printf '%s\n' 'controller readiness receipt was not sustained' >&2
exit 1
