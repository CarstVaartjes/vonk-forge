#!/bin/sh
set -eu

if [ "${1:-}" != configure ]; then
    exit 0
fi

if ! getent group vonk-agent >/dev/null; then
    addgroup --system vonk-agent
fi
if ! getent passwd vonk-agent >/dev/null; then
    adduser --system --ingroup vonk-agent --home /var/lib/vonk-forge-agent \
        --no-create-home --shell /usr/sbin/nologin vonk-agent
fi

# Podman needs a standard subordinate range to map both OCI image ownership
# and the required numeric non-root runtime identity. Allocate the first free
# range from login.defs without disturbing host-managed ranges.
login_value() {
    key=$1
    fallback=$2
    value=$(awk -v key="$key" '$1 == key && $2 ~ /^[0-9]+$/ { value=$2 } END { print value }' /etc/login.defs)
    if [ -n "$value" ]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$fallback"
    fi
}

allocate_subid_range() {
    file=$1
    minimum=$2
    maximum=$3
    count=$4
    LC_ALL=C sort -t: -k2,2n "$file" | awk -F: \
        -v minimum="$minimum" -v maximum="$maximum" -v count="$count" '
        BEGIN { candidate=minimum; found=0 }
        $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 {
            start=$2
            after=start+$3
            if (after <= candidate) next
            if (start >= candidate+count) {
                print candidate "-" candidate+count-1
                found=1
                exit
            }
            if (start <= candidate && after > candidate) candidate=after
        }
        END {
            if (!found && candidate+count-1 <= maximum)
                print candidate "-" candidate+count-1
        }'
}

ensure_subid_range() {
    file=$1
    minimum=$2
    maximum=$3
    count=$4
    option=$5
    agent_uid=$6
    if awk -F: -v user=vonk-agent -v uid="$agent_uid" -v count="$count" '
        ($1 == user || $1 == uid) && $3 ~ /^[0-9]+$/ { total += $3 }
        END { exit !(total >= count) }
    ' "$file"; then
        return
    fi
    range=$(allocate_subid_range "$file" "$minimum" "$maximum" "$count")
    if [ -z "$range" ]; then
        echo "vonk-forge-agent: no subordinate ID range is available" >&2
        exit 1
    fi
    case "$option" in
        uid) usermod --add-subuids "$range" vonk-agent ;;
        gid) usermod --add-subgids "$range" vonk-agent ;;
        *) exit 1 ;;
    esac
}

sub_uid_min=$(login_value SUB_UID_MIN 100000)
sub_uid_max=$(login_value SUB_UID_MAX 600100000)
sub_uid_count=$(login_value SUB_UID_COUNT 65536)
sub_gid_min=$(login_value SUB_GID_MIN 100000)
sub_gid_max=$(login_value SUB_GID_MAX 600100000)
sub_gid_count=$(login_value SUB_GID_COUNT 65536)
if [ "$sub_uid_count" -lt 65536 ]; then sub_uid_count=65536; fi
if [ "$sub_gid_count" -lt 65536 ]; then sub_gid_count=65536; fi
if [ ! -f /etc/subuid ]; then install -o root -g root -m 0644 /dev/null /etc/subuid; fi
if [ ! -f /etc/subgid ]; then install -o root -g root -m 0644 /dev/null /etc/subgid; fi
agent_uid=$(id -u vonk-agent)
ensure_subid_range /etc/subuid "$sub_uid_min" "$sub_uid_max" "$sub_uid_count" uid "$agent_uid"
ensure_subid_range /etc/subgid "$sub_gid_min" "$sub_gid_max" "$sub_gid_count" gid "$agent_uid"

install -d -o root -g root -m 0755 /var/lib/vonk-forge
install -d -o vonk-agent -g vonk-agent -m 0700 /var/lib/vonk-forge-agent
install -d -o vonk-agent -g vonk-agent -m 0750 \
    /var/lib/vonk-forge-agent/models \
    /var/lib/vonk-forge-agent/containers \
    /var/lib/vonk-forge-agent/state \
    /var/lib/vonk-forge-agent/workloads
install -d -o vonk-agent -g vonk-agent -m 0700 \
    /var/lib/vonk-forge-agent/image-imports \
    /var/lib/vonk-forge-agent/installations \
    /var/lib/vonk-forge-agent/run-metadata \
    /var/lib/vonk-forge-agent/runs
install -d -o root -g root -m 0755 /var/lib/vonk-forge/slots
install -d -o root -g root -m 0700 \
    /var/lib/vonk-forge/helper \
    /var/lib/vonk-forge/helper/requests \
    /var/lib/vonk-forge/incoming \
    /var/lib/vonk-forge/runtime-images
# The supervisor remains root-owned and non-writable by the runtime account,
# while the dedicated group may traverse it to read the verified state and
# execute the active slot selected by the root supervisor.
install -d -o root -g vonk-agent -m 0750 /var/lib/vonk-forge/supervisor

release=/usr/lib/vonk-forge/release
state=/var/lib/vonk-forge/supervisor/state.json
if [ ! -e "$state" ]; then
    target=a
else
    saved_umask=$(umask)
    umask 077
    exec 9>/var/lib/vonk-forge/supervisor/supervisor.lock
    umask "$saved_umask"
    /usr/bin/flock -x 9
    target=$(
        /usr/lib/vonk-forge/vonk-agent-supervisor package-staging-slot
    )
    case "$target" in
        a|b) ;;
        *) echo "vonk-forge-agent: package staging slot is invalid" >&2; exit 1 ;;
    esac
fi

slot=/var/lib/vonk-forge/slots/$target
install -d -o root -g root -m 0755 "$slot"
install -o root -g root -m 0555 "$release/vonk-agent" "$slot/.vonk-agent.new"
install -o root -g root -m 0644 "$release/manifest-$target.json" "$slot/.manifest.json.new"
sync -f "$slot/.vonk-agent.new" "$slot/.manifest.json.new"
mv -f "$slot/.vonk-agent.new" "$slot/vonk-agent"
mv -f "$slot/.manifest.json.new" "$slot/manifest.json"
sync -f "$slot"

if [ ! -e "$state" ]; then
    /usr/lib/vonk-forge/vonk-agent-supervisor initialize --slot a
fi

deb-systemd-helper enable vonk-forge-package-helper.socket >/dev/null || true
deb-systemd-helper enable vonk-forge-agent-supervisor.service >/dev/null || true
if [ -f /etc/vonk-forge-agent/docker-firewall.conf ]; then
    deb-systemd-helper enable vonk-forge-docker-firewall.service >/dev/null || true
fi
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

exit 0
