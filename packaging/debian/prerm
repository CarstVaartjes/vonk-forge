#!/bin/sh
set -eu

pending=/var/lib/vonk-forge/helper-upgrade.pending
receipt=/var/lib/vonk-forge/helper-upgrade.receipt

safe_pending() {
    [ -f "$pending" ] && [ ! -L "$pending" ] \
        && [ "$(/usr/bin/stat -c %u:%a "$pending")" = 0:600 ] \
        && /usr/bin/sed -n '1p' "$pending" \
            | grep -Eq '^version=[0-9A-Za-z.+~:-]+$' || return 1
    lines=$(/usr/bin/wc -l < "$pending")
    if [ "$lines" -eq 2 ]; then
        /usr/bin/sed -n '2p' "$pending" \
            | grep -Eq '^(state=pre-unpack|helper_sha256=[0-9a-f]{64})$'
    elif [ "$lines" -eq 3 ]; then
        /usr/bin/sed -n '2p' "$pending" \
            | grep -Eq '^helper_sha256=[0-9a-f]{64}$' \
            && /usr/bin/sed -n '3p' "$pending" \
                | grep -Eq '^agent_sha256=[0-9a-f]{64}$'
    else
        return 1
    fi
}

safe_receipt() {
    [ -f "$receipt" ] && [ ! -L "$receipt" ] \
        && [ "$(/usr/bin/stat -c %u:%a "$receipt")" = 0:600 ] || return 1
    receipt_lines=$(/usr/bin/wc -l < "$receipt")
    if [ "$receipt_lines" -eq 8 ]; then
        /usr/bin/sed -n '1p' "$receipt" | grep -Fxq 'schema_version=1' \
        && /usr/bin/sed -n '2p' "$receipt" \
            | grep -Eq '^version=[0-9A-Za-z.+~:-]+$' \
        && /usr/bin/sed -n '3p' "$receipt" \
            | grep -Eq '^helper_sha256=[0-9a-f]{64}$' \
        && /usr/bin/sed -n '4p' "$receipt" \
            | grep -Eq '^agent_sha256=[0-9a-f]{64}$' \
        && /usr/bin/sed -n '5p' "$receipt" \
            | grep -Eq '^boot_id=[0-9a-f-]+$' \
        && /usr/bin/sed -n '6p' "$receipt" \
            | grep -Eq '^activated_at=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
        && /usr/bin/sed -n '7p' "$receipt" \
            | grep -Eq '^helper_main_pid=[0-9]+$' \
        && /usr/bin/sed -n '8p' "$receipt" \
            | grep -Eq '^helper_start_time=[0-9]+$'
    elif [ "$receipt_lines" -eq 10 ]; then
        /usr/bin/sed -n '1p' "$receipt" | grep -Fxq 'schema_version=2' \
        && /usr/bin/sed -n '2p' "$receipt" \
            | grep -Eq '^version=[0-9A-Za-z.+~:-]+$' \
        && /usr/bin/sed -n '3p' "$receipt" \
            | grep -Eq '^package_sha256=[0-9a-f]{64}$' \
        && /usr/bin/sed -n '4p' "$receipt" \
            | grep -Eq '^helper_sha256=[0-9a-f]{64}$' \
        && /usr/bin/sed -n '5p' "$receipt" \
            | grep -Eq '^agent_sha256=[0-9a-f]{64}$' \
        && /usr/bin/sed -n '6p' "$receipt" \
            | grep -Eq '^boot_id=[0-9a-f-]+$' \
        && /usr/bin/sed -n '7p' "$receipt" \
            | grep -Eq '^activated_at=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
        && /usr/bin/sed -n '8p' "$receipt" \
            | grep -Eq '^helper_main_pid=[0-9]+$' \
        && /usr/bin/sed -n '9p' "$receipt" \
            | grep -Eq '^helper_start_time=[0-9]+$' \
        && /usr/bin/sed -n '10p' "$receipt" \
            | grep -Eq '^intent_sha256=[0-9a-f]{64}$'
    else
        return 1
    fi
}

if [ "${1:-}" = remove ]; then
    if [ -e /var/lib/vonk-forge/package-upgrade/intent ] \
        || [ -L /var/lib/vonk-forge/package-upgrade/intent ]; then
        echo 'vonk-forge-agent: cannot remove package during durable upgrade recovery' >&2
        exit 1
    fi
    /usr/bin/systemctl --system stop \
        vonk-forge-package-helper-upgrade-finish.service >/dev/null 2>&1 || true
    /usr/bin/systemctl --system stop \
        vonk-forge-package-upgrade-recover.service >/dev/null 2>&1 || true
    deb-systemd-invoke stop vonk-forge-agent.service >/dev/null || true
    deb-systemd-invoke stop vonk-forge-package-helper.socket >/dev/null || true
    deb-systemd-invoke stop vonk-forge-package-helper.service >/dev/null || true
    deb-systemd-invoke stop vonk-forge-docker-firewall.service >/dev/null || true
    if [ -e "$pending" ] || [ -L "$pending" ]; then
        safe_pending || {
            echo 'vonk-forge-agent: pending helper upgrade state is unsafe' >&2
            exit 1
        }
    fi
    if [ -e "$receipt" ] || [ -L "$receipt" ]; then
        safe_receipt || {
            echo 'vonk-forge-agent: helper upgrade receipt is unsafe' >&2
            exit 1
        }
    fi
    /usr/bin/rm -f -- "$pending" "$receipt"
    if [ -d /var/lib/vonk-forge ] && [ ! -L /var/lib/vonk-forge ]; then
        /usr/bin/sync -f /var/lib/vonk-forge
    fi
    deb-systemd-helper disable vonk-forge-agent.service >/dev/null || true
    deb-systemd-helper disable vonk-forge-package-helper.socket >/dev/null || true
    deb-systemd-helper disable vonk-forge-docker-firewall.service >/dev/null || true
    /usr/bin/loginctl disable-linger vonk-agent >/dev/null || true
fi

exit 0
